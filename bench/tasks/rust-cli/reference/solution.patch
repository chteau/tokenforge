+    assert!(err.contains("amount must be greater than zero"), "{err}");
+    let (code, _) = t.fail(&["budget", "set", "eating out", "5"]);
+    assert_eq!(code, 1);
+    assert_eq!(t.fail(&["budget"]).0, 2);
