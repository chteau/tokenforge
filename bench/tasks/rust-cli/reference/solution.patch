+/// Spending against each budget in `month`. `warn_percent` is the share of
+/// the limit from which a category is flagged as `warning`.
+pub fn budget_status(
+    budgets: &Budgets,
+    entries: &[Entry],
+    month: YearMonth,
+    warn_percent: usize,
+) -> Table {
+    let mut table = Table::new(vec![
+        Column::left("category"),
+        Column::right("limit"),
+        Column::right("spent"),
+        Column::right("remaining"),
+        Column::right("used"),
+        Column::left("status"),
+    ]);
+    let (mut total_limit, mut total_spent) = (Money::ZERO, Money::ZERO);
+    for (category, limit) in budgets {
+        let spent: Money = entries
+            .iter()
+            .filter(|e| {
+                e.kind == Kind::Expense && month.contains(e.date) && &e.category == category
+            })
+            .map(|e| e.amount)
+            .sum();
+        let used = percent_tenths(spent.cents(), limit.cents());
+        let status = if spent > *limit {
+            "over"
+        } else if spent.cents() * 100 >= limit.cents() * warn_percent as i64 {
+            "warning"
+        } else {
+            "ok"
+        };
+        table.push(vec![
+            Cell::text(category.clone()),
+            Cell::Money(*limit),
+            Cell::Money(spent),
+            Cell::Money(*limit - spent),
+            Cell::Percent(used),
+            Cell::text(status),
+        ]);
+        total_limit += *limit;
+        total_spent += spent;
+    }
+    table.footer = Some(vec![
+        Cell::text("total"),
+        Cell::Money(total_limit),
+        Cell::Money(total_spent),
+        Cell::Money(total_limit - total_spent),
+        Cell::Percent(percent_tenths(total_spent.cents(), total_limit.cents())),
+        Cell::Empty,
+    ]);
+    table
+}
+
