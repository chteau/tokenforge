@@ -0,0 +1,68 @@
+//! Monthly budgets, stored in `<dir>/budgets.txt`:
+//!
+//! ```text
+//! # tally budgets v1
+//! groceries|300.00
+//! ```
+
+use std::collections::BTreeMap;
+use std::fs;
+use std::io::ErrorKind;
+use std::path::PathBuf;
+
+use super::{atomic, codec, Store};
+use crate::error::{Error, Result};
+use crate::util::Money;
+
+pub const BUDGETS_FILE: &str = "budgets.txt";
+const HEADER: &str = "# tally budgets v1";
+
+/// Monthly limit per category, sorted by category.
+pub type Budgets = BTreeMap<String, Money>;
+
+impl Store {
+    pub fn budgets_path(&self) -> PathBuf {
+        self.dir().join(BUDGETS_FILE)
+    }
+
+    /// All budgets; an absent file means no budgets.
+    pub fn load_budgets(&self) -> Result<Budgets> {
+        let path = self.budgets_path();
+        let text = match fs::read_to_string(&path) {
+            Ok(t) => t,
+            Err(e) if e.kind() == ErrorKind::NotFound => return Ok(Budgets::new()),
+            Err(e) => return Err(Error::io_at(path, e)),
+        };
+        let mut budgets = Budgets::new();
+        for (idx, line) in text.lines().enumerate() {
+            let line = line.trim_end_matches('\r');
+            if line.trim().is_empty() || line.starts_with('#') {
+                continue;
+            }
+            let corrupt = |message: String| Error::Corrupt {
+                path: path.clone(),
+                line: idx + 1,
+                message,
+            };
+            let fields = codec::split_fields(line).map_err(corrupt)?;
+            if fields.len() != 2 {
+                return Err(corrupt(format!(
+                    "expected 2 fields, found {}",
+                    fields.len()
+                )));
+            }
+            let limit = Money::parse(&fields[1]).map_err(corrupt)?;
+            budgets.insert(fields[0].clone(), limit);
+        }
+        Ok(budgets)
+    }
+
+    pub fn save_budgets(&self, budgets: &Budgets) -> Result<()> {
+        let mut out = format!("{HEADER}\n");
+        for (category, limit) in budgets {
+            out.push_str(&codec::join_fields(&[category.clone(), limit.to_decimal()]));
+            out.push('\n');
+        }
+        atomic::write_atomic(&self.budgets_path(), out.as_bytes())
+    }
+}
