+fn parse_budget(rest: &[String]) -> Result<Command> {
+    let Some(action) = rest.first() else {
+        return Err(Error::usage(
+            "'budget' needs an action: set, list, remove or status",
+        ));
+    };
+    let rest = &rest[1..];
+    let args = match action.as_str() {
+        "set" => {
+            let a = Args::split("budget set", rest, &[])?;
+            a.expect_positionals(&["CATEGORY", "AMOUNT"])?;
+            BudgetArgs::Set {
+                category: a.positionals[0].clone(),
+                amount: Money::parse(&a.positionals[1]).map_err(Error::Usage)?,
+            }
+        }
+        "list" => {
+            Args::split("budget list", rest, &[])?.expect_positionals(&[])?;
+            BudgetArgs::List
+        }
+        "remove" | "rm" => {
+            let a = Args::split("budget remove", rest, &[])?;
+            a.expect_positionals(&["CATEGORY"])?;
+            BudgetArgs::Remove {
+                category: a.positionals[0].clone(),
+            }
+        }
+        "status" => {
+            let a = Args::split("budget status", rest, &[("month", true)])?;
+            a.expect_positionals(&[])?;
+            BudgetArgs::Status {
+                month: a.typed::<YearMonth>("month")?,
+            }
+        }
+        other => {
+            return Err(Error::usage(format!(
+                "unknown budget action '{other}' (expected set, list, remove or status)"
+            )))
+        }
+    };
+    Ok(Command::Budget(args))
+}
