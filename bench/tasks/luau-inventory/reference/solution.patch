index 0000000..3feca79
--- /dev/null
+++ b/src/shared/Inventory.luau
@@ -0,0 +1,289 @@
+--!strict
+-- Slot-based inventory with item stacking, change events and DataStore-friendly saves.
+
+local Items = require("./Items")
+local Signal = require("./Signal")
+
+export type Stack = { itemId: string, count: number }
+
+export type SaveData = {
+	version: number,
+	capacity: number,
+	slots: { { slot: number, itemId: string, count: number } },
+}
+
+export type Inventory = {
+	capacity: number,
+	changed: Signal.Signal,
+	getSlot: (self: Inventory, slot: number) -> Stack?,
+	count: (self: Inventory, itemId: string) -> number,
+	add: (self: Inventory, itemId: string, count: number) -> number,
+	canAdd: (self: Inventory, itemId: string, count: number) -> boolean,
+	remove: (self: Inventory, itemId: string, count: number) -> boolean,
+	move: (self: Inventory, from: number, to: number) -> boolean,
+	serialize: (self: Inventory) -> SaveData,
+	batch: (self: Inventory, fn: () -> ()) -> (),
+	_slots: { [number]: Stack },
+	_dirty: { [number]: boolean }?,
+}
+
+local SAVE_VERSION = 2
+
+local Inventory = {}
+Inventory.SAVE_VERSION = SAVE_VERSION
+local methods = {}
+local metatable = { __index = methods }
+
+local function isPositiveInteger(n: any): boolean
+	return type(n) == "number" and n >= 1 and n == math.floor(n) and n ~= math.huge
+end
+
+local function checkSlot(self: Inventory, slot: any)
+	if type(slot) ~= "number" or slot < 1 or slot > self.capacity or slot ~= math.floor(slot) then
+		error("invalid slot", 3)
+	end
+end
+
+local function checkItemAndCount(itemId: any, count: any)
+	if type(itemId) ~= "string" or Items.get(itemId) == nil then
+		error("unknown item: " .. tostring(itemId), 3)
+	end
+	if not isPositiveInteger(count) then
+		error("invalid count", 3)
+	end
+end
+
+-- Records changed slots; fires `changed` once when the outermost operation finishes.
+local function track(self: Inventory, fn: (mark: (number) -> ()) -> ())
+	local outer = self._dirty == nil
+	if outer then
+		self._dirty = {}
+	end
+	local dirty = self._dirty :: { [number]: boolean }
+	local ok, err = pcall(fn, function(slot: number)
+		dirty[slot] = true
+	end)
+	if outer then
+		self._dirty = nil
+	end
+	if not ok then
+		error(err, 0)
+	end
+	if outer then
+		local list = {}
+		for slot in dirty do
+			table.insert(list, slot)
+		end
+		if #list > 0 then
+			table.sort(list)
+			self.changed:Fire(list)
+		end
+	end
+end
+
+function Inventory.new(capacity: number): Inventory
+	if not isPositiveInteger(capacity) then
+		error("invalid capacity", 2)
+	end
+	local self = setmetatable({
+		capacity = capacity,
+		changed = Signal.new(),
+		_slots = {},
+		_dirty = nil,
+	}, metatable) :: any
+	return self :: Inventory
+end
+
+function methods.getSlot(self: Inventory, slot: number): Stack?
+	checkSlot(self, slot)
+	local stack = self._slots[slot]
+	return if stack then { itemId = stack.itemId, count = stack.count } else nil
+end
+
+function methods.count(self: Inventory, itemId: string): number
+	local total = 0
+	for _, stack in self._slots do
+		if stack.itemId == itemId then
+			total += stack.count
+		end
+	end
+	return total
+end
+
+-- Free room for an item: partial stacks of it plus empty slots.
+local function room(self: Inventory, itemId: string): number
+	local max = Items.maxStack(itemId)
+	local total = 0
+	for slot = 1, self.capacity do
+		local stack = self._slots[slot]
+		if stack == nil then
+			total += max
+		elseif stack.itemId == itemId then
+			total += max - stack.count
+		end
+	end
+	return total
+end
+
+function methods.canAdd(self: Inventory, itemId: string, count: number): boolean
+	checkItemAndCount(itemId, count)
+	return room(self, itemId) >= count
+end
+
+function methods.add(self: Inventory, itemId: string, count: number): number
+	checkItemAndCount(itemId, count)
+	local max = Items.maxStack(itemId)
+	local left = count
+	track(self, function(mark)
+		for slot = 1, self.capacity do
+			local stack = self._slots[slot]
+			if left > 0 and stack and stack.itemId == itemId and stack.count < max then
+				local n = math.min(max - stack.count, left)
+				stack.count += n
+				left -= n
+				mark(slot)
+			end
+		end
+		for slot = 1, self.capacity do
+			if left > 0 and self._slots[slot] == nil then
+				local n = math.min(max, left)
+				self._slots[slot] = { itemId = itemId, count = n }
+				left -= n
+				mark(slot)
+			end
+		end
+	end)
+	return left
+end
+
+function methods.remove(self: Inventory, itemId: string, count: number): boolean
+	checkItemAndCount(itemId, count)
+	if self:count(itemId) < count then
+		return false
+	end
+	local left = count
+	track(self, function(mark)
+		for slot = self.capacity, 1, -1 do
+			local stack = self._slots[slot]
+			if left > 0 and stack and stack.itemId == itemId then
+				local n = math.min(stack.count, left)
+				stack.count -= n
+				left -= n
+				if stack.count == 0 then
+					self._slots[slot] = nil
+				end
+				mark(slot)
+			end
+		end
+	end)
+	return true
+end
+
+function methods.move(self: Inventory, from: number, to: number): boolean
+	checkSlot(self, from)
+	checkSlot(self, to)
+	local a, b = self._slots[from], self._slots[to]
+	if a == nil or from == to then
+		return false
+	end
+	if b ~= nil and a.itemId == b.itemId then
+		local n = math.min(Items.maxStack(a.itemId) - b.count, a.count)
+		if n <= 0 then
+			return false
+		end
+		track(self, function(mark)
+			b.count += n
+			a.count -= n
+			if a.count == 0 then
+				self._slots[from] = nil
+			end
+			mark(from)
+			mark(to)
+		end)
+		return true
+	end
+	track(self, function(mark)
+		self._slots[from], self._slots[to] = b, a
+		mark(from)
+		mark(to)
+	end)
+	return true
+end
+
+-- Runs fn so that every change it makes fires `changed` once, together.
+function methods.batch(self: Inventory, fn: () -> ())
+	track(self, function()
+		fn()
+	end)
+end
+
+function methods.serialize(self: Inventory): SaveData
+	local slots = {}
+	for slot = 1, self.capacity do
+		local stack = self._slots[slot]
+		if stack then
+			table.insert(slots, { slot = slot, itemId = stack.itemId, count = stack.count })
+		end
+	end
+	return { version = SAVE_VERSION, capacity = self.capacity, slots = slots }
+end
+
+local function invalid(): never
+	error("invalid save data", 3)
+end
+
+local function place(inv: Inventory, slot: any, itemId: any, count: any)
+	if type(itemId) ~= "string" then
+		invalid()
+	end
+	if Items.get(itemId) == nil then
+		error("unknown item: " .. itemId, 3)
+	end
+	if not isPositiveInteger(slot) or slot > inv.capacity or inv._slots[slot] ~= nil then
+		invalid()
+	end
+	if not isPositiveInteger(count) or count > Items.maxStack(itemId) then
+		invalid()
+	end
+	inv._slots[slot] = { itemId = itemId, count = count }
+end
+
+function Inventory.deserialize(data: any): Inventory
+	if type(data) ~= "table" or type(data.version) ~= "number" then
+		invalid()
+	end
+	local version = data.version
+	if version ~= 1 and version ~= 2 then
+		error("unsupported save version: " .. tostring(version), 2)
+	end
+	if not isPositiveInteger(data.capacity) then
+		invalid()
+	end
+	local inv = Inventory.new(data.capacity)
+	if version == 1 then
+		local items = data.items
+		if type(items) ~= "table" or #items > inv.capacity then
+			invalid()
+		end
+		for i, entry in items do
+			if type(entry) ~= "table" or type(i) ~= "number" then
+				invalid()
+			end
+			place(inv, i, entry.id, entry.count)
+		end
+	else
+		local slots = data.slots
+		if type(slots) ~= "table" then
+			invalid()
+		end
+		for _, entry in slots do
+			if type(entry) ~= "table" then
+				invalid()
+			end
+			place(inv, entry.slot, entry.itemId, entry.count)
+		end
+	end
+	return inv
+end
+
+return Inventory
