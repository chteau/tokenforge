+--!strict
+-- Item catalogue: ids, display names and stack limits.
+
+export type ItemDef = {
+	id: string,
+	name: string,
+	maxStack: number,
+}
+
+local DEFINITIONS: { [string]: ItemDef } = {
+	wood = { id = "wood", name = "Wood", maxStack = 64 },
+	plank = { id = "plank", name = "Plank", maxStack = 64 },
+	stick = { id = "stick", name = "Stick", maxStack = 64 },
+	stone = { id = "stone", name = "Stone", maxStack = 64 },
+	iron_ingot = { id = "iron_ingot", name = "Iron Ingot", maxStack = 32 },
+	apple = { id = "apple", name = "Apple", maxStack = 16 },
+	pickaxe = { id = "pickaxe", name = "Pickaxe", maxStack = 1 },
+	sword = { id = "sword", name = "Sword", maxStack = 1 },
+}
+
+local Items = {}
+
+function Items.get(itemId: string): ItemDef?
+	local def = DEFINITIONS[itemId]
+	if def == nil then
+		return nil
+	end
+	return table.clone(def)
+end
+
+function Items.maxStack(itemId: string): number
+	local def = DEFINITIONS[itemId]
+	if def == nil then
+		error("unknown item: " .. tostring(itemId), 2)
+	end
+	return def.maxStack
+end
+
+return Items
diff --git a/src/shared/Signal.luau b/src/shared/Signal.luau
new file mode 100644
index 0000000..7f93cb6
--- /dev/null
+++ b/src/shared/Signal.luau
@@ -0,0 +1,60 @@
+--!strict
+-- Minimal synchronous Roblox-style signal.
+
+export type Connection = {
+	Connected: boolean,
+	Disconnect: (self: Connection) -> (),
+}
+
+export type Signal = {
+	Connect: (self: Signal, fn: (...any) -> ()) -> Connection,
+	Fire: (self: Signal, ...any) -> (),
+	DisconnectAll: (self: Signal) -> (),
+}
+
+type Handler = { connection: Connection, fn: (...any) -> () }
+
+local Signal = {}
+
+function Signal.new(): Signal
+	local handlers: { Handler } = {}
+	local self = {} :: Signal
+
+	function self:Connect(fn: (...any) -> ()): Connection
+		local connection = { Connected = true } :: Connection
+		function connection:Disconnect()
+			if not self.Connected then
+				return
+			end
+			self.Connected = false
+			for i, h in handlers do
+				if h.connection == self then
+					table.remove(handlers, i)
+					break
+				end
+			end
+		end
+		table.insert(handlers, { connection = connection, fn = fn })
+		return connection
+	end
+
+	function self:Fire(...: any)
+		local snapshot = table.clone(handlers)
+		for _, h in snapshot do
+			if h.connection.Connected then
+				h.fn(...)
+			end
+		end
+	end
+
+	function self:DisconnectAll()
+		for _, h in handlers do
+			h.connection.Connected = false
+		end
+		table.clear(handlers)
+	end
+
+	return self
+end
+
+return Signal
diff --git a/tests/run.luau b/tests/run.luau
new file mode 100644
index 0000000..7cb4997
--- /dev/null
+++ b/tests/run.luau
@@ -0,0 +1,115 @@
+-- Run with: lune run tests/run.luau
+local Inventory = require("../src/shared/Inventory")
+local Crafting = require("../src/shared/Crafting")
+local Signal = require("../src/shared/Signal")
+local Items = require("../src/shared/Items")
+
+local failures = 0
+local function test(name: string, fn: () -> ())
+	local ok, err = pcall(fn)
+	if ok then
+		print("PASS " .. name)
+	else
+		failures += 1
+		print("FAIL " .. name .. ": " .. tostring(err))
+	end
+end
+
+local function expectEq(actual: any, expected: any)
+	if actual ~= expected then
+		error(string.format("expected %s, got %s", tostring(expected), tostring(actual)), 2)
+	end
+end
+
+local function expectError(fn: () -> any, needle: string)
+	local ok, err = pcall(fn)
+	assert(not ok, "expected an error")
+	assert(string.find(tostring(err), needle, 1, true), "unexpected error: " .. tostring(err))
+end
+
+test("items have stack limits", function()
+	expectEq(Items.maxStack("apple"), 16)
+	expectEq(Items.get("nope"), nil)
+	expectError(function() return Items.maxStack("nope") end, "unknown item: nope")
+end)
+
+test("signal connects, fires and disconnects", function()
+	local s = Signal.new()
+	local got = {}
+	local c = s:Connect(function(v) table.insert(got, v) end)
+	s:Fire(1)
+	c:Disconnect()
+	s:Fire(2)
+	expectEq(#got, 1)
+	expectEq(c.Connected, false)
+end)
+
+test("add stacks and reports leftover", function()
+	local inv = Inventory.new(2)
+	expectEq(inv:add("iron_ingot", 70), 6)
+	expectEq(inv:getSlot(1).count, 32)
+	expectEq(inv:count("iron_ingot"), 64)
+	expectError(function() return inv:add("wood", 0) end, "invalid count")
+end)
+
+test("remove is all or nothing", function()
+	local inv = Inventory.new(3)
+	inv:add("wood", 70)
+	expectEq(inv:remove("wood", 71), false)
+	expectEq(inv:remove("wood", 10), true)
+	expectEq(inv:getSlot(1).count, 60)
+	expectEq(inv:getSlot(2), nil)
+end)
+
+test("move merges and swaps", function()
+	local inv = Inventory.new(3)
+	inv:add("wood", 5)
+	inv:add("sword", 1)
+	expectEq(inv:move(1, 2), true)
+	expectEq(inv:getSlot(1).itemId, "sword")
+	expectEq(inv:move(3, 1), false)
+	expectError(function() return inv:move(1, 9) end, "invalid slot")
+end)
+
+test("changed fires once with sorted slots", function()
+	local inv = Inventory.new(3)
+	local events = {}
+	inv.changed:Connect(function(slots) table.insert(events, table.concat(slots, ",")) end)
+	inv:add("apple", 20)
+	inv:remove("apple", 99)
+	expectEq(#events, 1)
+	expectEq(events[1], "1,2")
+end)
+
+test("serialize round trip and legacy saves", function()
+	local inv = Inventory.new(4)
+	inv:add("stone", 3)
+	inv:move(1, 3)
+	local data = inv:serialize()
+	expectEq(data.version, Inventory.SAVE_VERSION)
+	expectEq(data.slots[1].slot, 3)
+	local copy = Inventory.deserialize(data)
+	expectEq(copy:getSlot(3).count, 3)
+	local old = Inventory.deserialize({ version = 1, capacity = 2, items = { { id = "apple", count = 2 } } })
+	expectEq(old:getSlot(1).itemId, "apple")
+	expectError(function() return Inventory.deserialize({ version = 9, capacity = 1, slots = {} }) end, "unsupported save version: 9")
+	expectError(function() return Inventory.deserialize({ version = 2, capacity = 1, slots = { { slot = 2, itemId = "wood", count = 1 } } }) end, "invalid save data")
+end)
+
+test("crafting is atomic", function()
+	local inv = Inventory.new(3)
+	inv:add("wood", 2)
+	local fired = 0
+	inv.changed:Connect(function() fired += 1 end)
+	expectEq(Crafting.craft(inv, "planks", 2), true)
+	expectEq(fired, 1)
+	expectEq(inv:count("plank"), 8)
+	expectEq(Crafting.craft(inv, "sword"), false)
+	expectEq(fired, 1)
+	expectError(function() return Crafting.canCraft(inv, "boat") end, "unknown recipe: boat")
+end)
+
+if failures > 0 then
+	error(failures .. " test(s) failed", 0)
+end
+print("all tests passed")
