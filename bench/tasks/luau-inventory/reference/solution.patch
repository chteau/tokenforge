@@ -0,0 +1,71 @@
+--!strict
+-- Crafting recipes; crafts consume inputs and produce outputs atomically.
+
+local Inventory = require("./Inventory")
+
+export type Ingredient = { itemId: string, count: number }
+export type Recipe = { id: string, inputs: { Ingredient }, output: Ingredient }
+
+local Crafting = {}
+
+Crafting.recipes = {
+	planks = { id = "planks", inputs = { { itemId = "wood", count = 1 } }, output = { itemId = "plank", count = 4 } },
+	sticks = { id = "sticks", inputs = { { itemId = "plank", count = 2 } }, output = { itemId = "stick", count = 4 } },
+	pickaxe = {
+		id = "pickaxe",
+		inputs = { { itemId = "stone", count = 3 }, { itemId = "stick", count = 2 } },
+		output = { itemId = "pickaxe", count = 1 },
+	},
+	sword = {
+		id = "sword",
+		inputs = { { itemId = "iron_ingot", count = 2 }, { itemId = "stick", count = 1 } },
+		output = { itemId = "sword", count = 1 },
+	},
+} :: { [string]: Recipe }
+
+local function resolve(recipeId: string, times: number?): (Recipe, number)
+	local recipe = Crafting.recipes[recipeId]
+	if recipe == nil then
+		error("unknown recipe: " .. tostring(recipeId), 3)
+	end
+	local n = if times == nil then 1 else times
+	if type(n) ~= "number" or n < 1 or n ~= math.floor(n) then
+		error("invalid count", 3)
+	end
+	return recipe, n
+end
+
+local function check(inv: Inventory.Inventory, recipe: Recipe, times: number): boolean
+	for _, input in recipe.inputs do
+		if inv:count(input.itemId) < input.count * times then
+			return false
+		end
+	end
+	-- Simulate on a copy so the space freed by the inputs counts.
+	local copy = Inventory.deserialize(inv:serialize())
+	for _, input in recipe.inputs do
+		copy:remove(input.itemId, input.count * times)
+	end
+	return copy:canAdd(recipe.output.itemId, recipe.output.count * times)
+end
+
+function Crafting.canCraft(inv: Inventory.Inventory, recipeId: string, times: number?): boolean
+	local recipe, n = resolve(recipeId, times)
+	return check(inv, recipe, n)
+end
+
+function Crafting.craft(inv: Inventory.Inventory, recipeId: string, times: number?): boolean
+	local recipe, n = resolve(recipeId, times)
+	if not check(inv, recipe, n) then
+		return false
+	end
+	inv:batch(function()
+		for _, input in recipe.inputs do
+			inv:remove(input.itemId, input.count * n)
+		end
+		inv:add(recipe.output.itemId, recipe.output.count * n)
+	end)
+	return true
+end
+
+return Crafting
