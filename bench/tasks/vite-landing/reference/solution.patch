@@ -0,0 +1,88 @@
+:root {
+  --bg: #0f1222;
+  --surface: #181c33;
+  --text: #e8eaf6;
+  --muted: #a3a8c7;
+  --accent: #7c6cff;
+  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
+  color: var(--text);
+  background: var(--bg);
+  line-height: 1.5;
+}
+
+* { box-sizing: border-box; }
+body { margin: 0; }
+html { scroll-behavior: smooth; }
+a { color: inherit; }
+
+.site-header {
+  position: sticky;
+  top: 0;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  padding: 1rem clamp(1rem, 5vw, 4rem);
+  background: rgb(15 18 34 / 0.9);
+  backdrop-filter: blur(6px);
+  z-index: 10;
+}
+.brand { font-weight: 700; font-size: 1.25rem; text-decoration: none; }
+nav { display: flex; gap: 1.25rem; }
+nav a { text-decoration: none; color: var(--muted); }
+nav a:hover { color: var(--text); }
+
+main { padding: 0 clamp(1rem, 5vw, 4rem); max-width: 72rem; margin: 0 auto; }
+.hero { text-align: center; padding: 6rem 0 4rem; }
+.hero h1 { font-size: clamp(2.25rem, 6vw, 4rem); margin: 0 0 1rem; }
+.lead { color: var(--muted); font-size: 1.15rem; max-width: 36rem; margin: 0 auto 2rem; }
+
+.section { padding: 4rem 0; scroll-margin-top: 4rem; }
+.section h2 { text-align: center; margin-bottom: 2rem; }
+.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1.25rem; }
+.card { background: var(--surface); border-radius: 12px; padding: 1.5rem; }
+.card h3 { margin-top: 0; }
+.card p { color: var(--muted); margin-bottom: 0; }
+.plan.featured { outline: 2px solid var(--accent); }
+.price { font-size: 2rem; font-weight: 700; color: var(--text) !important; margin: 0.5rem 0; }
+
+.btn, .toggle button {
+  font: inherit;
+  border: 0;
+  border-radius: 999px;
+  padding: 0.75rem 1.5rem;
+  cursor: pointer;
+}
+.btn-primary { background: var(--accent); color: white; }
+.toggle { display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 2rem; }
+.toggle button { background: var(--surface); color: var(--muted); }
+.toggle button[aria-pressed="true"] { background: var(--accent); color: white; }
+
+.faq-item { background: var(--surface); border-radius: 12px; padding: 1rem 1.5rem; margin: 0 auto 0.75rem; max-width: 44rem; }
+.faq-item summary { cursor: pointer; font-weight: 600; }
+.faq-item p { color: var(--muted); margin-bottom: 0; }
+
+.site-footer { text-align: center; color: var(--muted); padding: 2rem 1rem; border-top: 1px solid var(--surface); }
+
+.modal {
+  border: 0;
+  border-radius: 16px;
+  padding: 2rem;
+  width: min(28rem, calc(100% - 2rem));
+  background: var(--surface);
+  color: var(--text);
+}
+.modal::backdrop { background: rgb(0 0 0 / 0.6); }
+.modal form { display: flex; flex-wrap: wrap; gap: 0.75rem; }
+.modal input {
+  flex: 1 1 12rem;
+  font: inherit;
+  padding: 0.75rem 1rem;
+  border-radius: 999px;
+  border: 1px solid var(--muted);
+  background: var(--bg);
+  color: var(--text);
+}
+.close { position: absolute; top: 0.75rem; right: 1rem; background: none; border: 0; color: var(--muted); font-size: 1.5rem; cursor: pointer; }
+.form-message { flex-basis: 100%; margin: 0; min-height: 1.5em; }
+.form-message[data-state="error"] { color: #ff8a8a; }
+.form-message[data-state="success"] { color: #7ee2a8; }
