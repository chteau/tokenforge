@@ -0,0 +1,40 @@
+export interface Feature {
+  title: string;
+  description: string;
+}
+
+export type Billing = "monthly" | "yearly";
+
+export interface Plan {
+  name: string;
+  monthly: number;
+  yearly: number;
+  blurb: string;
+  featured?: boolean;
+}
+
+export interface FaqEntry {
+  question: string;
+  answer: string;
+}
+
+export const features: Feature[] = [
+  { title: "Shared timelines", description: "See every project and deadline on one calendar your whole team can edit." },
+  { title: "Smart reminders", description: "Orbitly nudges the right person before a task slips, not after." },
+  { title: "Workload balance", description: "Spot overloaded teammates at a glance and rebalance work in one drag." },
+  { title: "Integrations", description: "Connect GitHub, Slack and Google Calendar in under a minute." },
+  { title: "Reports that write themselves", description: "Weekly progress summaries land in your inbox every Monday." },
+  { title: "Private by default", description: "Granular permissions keep client work visible only to the people on it." },
+];
+
+export const plans: Plan[] = [
+  { name: "Starter", monthly: 0, yearly: 0, blurb: "For small teams getting organised." },
+  { name: "Team", monthly: 12, yearly: 120, blurb: "Everything a growing team needs.", featured: true },
+  { name: "Business", monthly: 29, yearly: 290, blurb: "Advanced controls and reporting." },
+];
+
+export const faqs: FaqEntry[] = [
+  { question: "Is there a free plan?", answer: "Yes. Starter is free forever for up to 3 people." },
+  { question: "Can I cancel anytime?", answer: "Yes. Paid plans can be cancelled at any time from your settings." },
+  { question: "Do you offer discounts for nonprofits?", answer: "Yes. Nonprofits get 50% off any paid plan." },
+];
diff --git a/src/main.ts b/src/main.ts
new file mode 100644
index 0000000..e9f39ae
--- /dev/null
+++ b/src/main.ts
@@ -0,0 +1,149 @@
+import "./style.css";
+import { faqs, features, plans, type Billing } from "./data.ts";
+import { formatPrice, validateEmail } from "./validation.ts";
+
+function el<K extends keyof HTMLElementTagNameMap>(
+  tag: K,
+  attrs: Record<string, string> = {},
+  ...children: (Node | string)[]
+): HTMLElementTagNameMap[K] {
+  const node = document.createElement(tag);
+  for (const [key, value] of Object.entries(attrs)) node.setAttribute(key, value);
+  node.append(...children);
+  return node;
+}
+
+function renderHeader(): HTMLElement {
+  const links = [
+    ["Features", "#features"],
+    ["Pricing", "#pricing"],
+    ["FAQ", "#faq"],
+  ].map(([text, href]) => el("a", { href }, text));
+  return el(
+    "header",
+    { class: "site-header", "data-testid": "site-header" },
+    el("a", { class: "brand", href: "#top" }, "Orbitly"),
+    el("nav", { "aria-label": "Main" }, ...links),
+  );
+}
+
+function renderHero(openModal: () => void): HTMLElement {
+  const cta = el("button", { type: "button", class: "btn btn-primary", "data-testid": "cta-button" }, "Get early access");
+  cta.addEventListener("click", openModal);
+  return el(
+    "section",
+    { class: "hero", id: "top", "data-testid": "hero" },
+    el("h1", {}, "Plan less. Ship more."),
+    el("p", { class: "lead" }, "Orbitly keeps your team's projects, deadlines and workload in one calm place."),
+    cta,
+  );
+}
+
+function renderFeatures(): HTMLElement {
+  const cards = features.map((feature) =>
+    el("article", { class: "card", "data-testid": "feature-card" }, el("h3", {}, feature.title), el("p", {}, feature.description)),
+  );
+  return el("section", { id: "features", class: "section" }, el("h2", {}, "Features"), el("div", { class: "grid" }, ...cards));
+}
+
+function renderPricing(): HTMLElement {
+  let billing: Billing = "monthly";
+  const toggles: Record<Billing, HTMLButtonElement> = {
+    monthly: el("button", { type: "button", "data-testid": "billing-monthly" }, "Monthly"),
+    yearly: el("button", { type: "button", "data-testid": "billing-yearly" }, "Yearly"),
+  };
+  const priceEls = plans.map(() => el("p", { class: "price", "data-testid": "plan-price" }));
+  const cards = plans.map((plan, i) =>
+    el(
+      "article",
+      { class: plan.featured ? "card plan featured" : "card plan", "data-testid": "plan-card" },
+      el("h3", { "data-testid": "plan-name" }, plan.name),
+      priceEls[i],
+      el("p", {}, plan.blurb),
+    ),
+  );
+  const update = (): void => {
+    for (const key of Object.keys(toggles) as Billing[]) toggles[key].setAttribute("aria-pressed", String(key === billing));
+    plans.forEach((plan, i) => {
+      priceEls[i].textContent = formatPrice(plan[billing], billing);
+    });
+  };
+  for (const key of Object.keys(toggles) as Billing[]) {
+    toggles[key].addEventListener("click", () => {
+      billing = key;
+      update();
+    });
+  }
+  update();
+  return el(
+    "section",
+    { id: "pricing", class: "section" },
+    el("h2", {}, "Pricing"),
+    el("div", { class: "toggle", role: "group", "aria-label": "Billing period" }, toggles.monthly, toggles.yearly),
+    el("div", { class: "grid" }, ...cards),
+  );
+}
+
+function renderFaq(): HTMLElement {
+  const items = faqs.map((entry) =>
+    el(
+      "details",
+      { class: "faq-item", "data-testid": "faq-item" },
+      el("summary", { "data-testid": "faq-question" }, entry.question),
+      el("p", { "data-testid": "faq-answer" }, entry.answer),
+    ),
+  );
+  return el("section", { id: "faq", class: "section" }, el("h2", {}, "Frequently asked questions"), ...items);
+}
+
+function renderFooter(): HTMLElement {
+  const year = new Date().getFullYear();
+  return el(
+    "footer",
+    { class: "site-footer", "data-testid": "site-footer" },
+    el("p", { "data-testid": "copyright" }, `© ${year} Orbitly. All rights reserved.`),
+  );
+}
+
+function renderModal(): HTMLDialogElement {
+  const input = el("input", {
+    type: "email",
+    name: "email",
+    placeholder: "you@company.com",
+    "aria-label": "Email address",
+    "data-testid": "email-input",
+  });
+  const message = el("p", { class: "form-message", role: "status", "data-testid": "form-message" });
+  const form = el(
+    "form",
+    { novalidate: "", "data-testid": "signup-form" },
+    input,
+    el("button", { type: "submit", class: "btn btn-primary", "data-testid": "signup-submit" }, "Join the waitlist"),
+    message,
+  );
+  form.addEventListener("submit", (event) => {
+    event.preventDefault();
+    const result = validateEmail(input.value);
+    message.textContent = result.message;
+    message.dataset.state = result.ok ? "success" : "error";
+    if (result.ok) input.value = "";
+  });
+  const close = el("button", { type: "button", class: "close", "aria-label": "Close", "data-testid": "modal-close" }, "×");
+  const dialog = el(
+    "dialog",
+    { class: "modal", "aria-labelledby": "signup-title", "data-testid": "signup-modal" },
+    close,
+    el("h2", { id: "signup-title" }, "Get early access"),
+    el("p", {}, "Leave your email and we'll let you know when Orbitly opens up."),
+    form,
+  );
+  close.addEventListener("click", () => dialog.close());
+  return dialog;
+}
+
+const app = document.querySelector<HTMLDivElement>("#app");
+if (app) {
+  const modal = renderModal();
+  const main = el("main", {}, renderHero(() => modal.showModal()), renderFeatures(), renderPricing(), renderFaq());
+  app.append(renderHeader(), main, renderFooter(), modal);
+}
