@@ -0,0 +1,27 @@
+import { describe, expect, it } from "vitest";
+import { formatPrice, validateEmail } from "./validation.ts";
+
+describe("validateEmail", () => {
+  it("rejects empty input", () => {
+    expect(validateEmail("   ")).toEqual({ ok: false, message: "Please enter your email address." });
+  });
+
+  it.each(["ada", "ada@example", "ada@example.", "a b@c.com", "a@@b.com"])("rejects %s", (value) => {
+    expect(validateEmail(value)).toEqual({ ok: false, message: "Please enter a valid email address." });
+  });
+
+  it("trims and lowercases valid emails", () => {
+    expect(validateEmail("  Ada@Example.COM ")).toEqual({
+      ok: true,
+      email: "ada@example.com",
+      message: "Thanks! We'll be in touch at ada@example.com.",
+    });
+  });
+});
+
+describe("formatPrice", () => {
+  it("formats monthly and yearly prices", () => {
+    expect(formatPrice(12, "monthly")).toBe("$12/mo");
+    expect(formatPrice(120, "yearly")).toBe("$120/yr");
+  });
+});
diff --git a/src/validation.ts b/src/validation.ts
new file mode 100644
index 0000000..147d7db
--- /dev/null
+++ b/src/validation.ts
@@ -0,0 +1,19 @@
+import type { Billing } from "./data.ts";
+
+export type SignupResult =
+  | { ok: true; email: string; message: string }
+  | { ok: false; message: string };
+
+const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+export function validateEmail(raw: string): SignupResult {
+  const email = raw.trim();
+  if (email === "") return { ok: false, message: "Please enter your email address." };
+  if (!EMAIL_PATTERN.test(email)) return { ok: false, message: "Please enter a valid email address." };
+  const normalized = email.toLowerCase();
+  return { ok: true, email: normalized, message: `Thanks! We'll be in touch at ${normalized}.` };
+}
+
+export function formatPrice(amount: number, billing: Billing): string {
+  return `$${amount}/${billing === "monthly" ? "mo" : "yr"}`;
+}
