@@ -0,0 +1,66 @@
+package shorty;
+
+import java.time.Instant;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** A short link. Mutable only through {@link LinkStore}, which guards it with its lock. */
+public final class Link {
+    final String code;
+    final String url;
+    final Instant createdAt;
+    final Instant expiresAt; // null: never expires
+    long hits;
+
+    Link(String code, String url, Instant createdAt, Instant expiresAt, long hits) {
+        this.code = code;
+        this.url = url;
+        this.createdAt = createdAt;
+        this.expiresAt = expiresAt;
+        this.hits = hits;
+    }
+
+    public String code() {
+        return code;
+    }
+
+    public String url() {
+        return url;
+    }
+
+    public long hits() {
+        return hits;
+    }
+
+    public Instant expiresAt() {
+        return expiresAt;
+    }
+
+    public boolean isExpired(Instant now) {
+        return expiresAt != null && !now.isBefore(expiresAt);
+    }
+
+    /** The fields stored in the data file. */
+    Map<String, Object> toStored() {
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("code", code);
+        m.put("url", url);
+        m.put("created_at", createdAt.toString());
+        m.put("expires_at", expiresAt == null ? null : expiresAt.toString());
+        m.put("hits", hits);
+        return m;
+    }
+
+    /** The representation returned by the API. */
+    Map<String, Object> toApi(String baseUrl, Instant now) {
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("code", code);
+        m.put("url", url);
+        m.put("short_url", baseUrl + "/" + code);
+        m.put("created_at", createdAt.toString());
+        m.put("expires_at", expiresAt == null ? null : expiresAt.toString());
+        m.put("hits", hits);
+        m.put("expired", isExpired(now));
+        return m;
+    }
+}
