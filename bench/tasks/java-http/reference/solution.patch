@@ -0,0 +1,178 @@
+package shorty;
+
+import java.security.SecureRandom;
+import java.time.Clock;
+import java.time.Instant;
+import java.time.temporal.ChronoUnit;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.Iterator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import java.util.regex.Pattern;
+
+/** Business rules: validation, code generation, de-duplication, listing and statistics. */
+public final class LinkService {
+    static final int MAX_URL_LENGTH = 2048;
+    static final int CODE_LENGTH = 7;
+    private static final Pattern CODE = Pattern.compile("[A-Za-z0-9_-]{3,32}");
+    private static final Pattern URL = Pattern.compile("(?i)https?://[^/?#\\s][^\\s]*");
+    private static final Set<String> RESERVED = Set.of("api", "healthz");
+    private static final String ALPHABET =
+            "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
+
+    /** The outcome of a create request: the link and whether it was newly created. */
+    public record Created(Map<String, Object> link, boolean isNew) {
+    }
+
+    private final LinkStore store;
+    private final Clock clock;
+    private final String baseUrl;
+    private final SecureRandom random = new SecureRandom();
+
+    public LinkService(LinkStore store, Clock clock, String baseUrl) {
+        this.store = store;
+        this.clock = clock;
+        this.baseUrl = baseUrl;
+    }
+
+    private Instant now() {
+        return clock.instant().truncatedTo(ChronoUnit.SECONDS);
+    }
+
+    public static boolean isValidUrl(Object url) {
+        if (!(url instanceof String s) || s.length() > MAX_URL_LENGTH) {
+            return false;
+        }
+        for (int i = 0; i < s.length(); i++) {
+            if (s.charAt(i) < 0x20 || s.charAt(i) == 0x7f) {
+                return false;
+            }
+        }
+        return URL.matcher(s).matches();
+    }
+
+    public static boolean isValidCode(Object code) {
+        return code instanceof String s && CODE.matcher(s).matches() && !RESERVED.contains(s);
+    }
+
+    public Created create(Map<String, Object> body) throws ApiException {
+        Object url = body.get("url");
+        if (!isValidUrl(url)) {
+            throw new ApiException(400, "invalid url");
+        }
+        Object code = body.get("code");
+        if (code != null && !isValidCode(code)) {
+            throw new ApiException(400, "invalid code");
+        }
+        Object ttl = body.get("ttl_seconds");
+        if (ttl != null && !(ttl instanceof Long t && t >= 1 && t <= 315_360_000L)) {
+            throw new ApiException(400, "invalid ttl_seconds");
+        }
+        Instant now = now();
+        Instant expiresAt = ttl == null ? null : now.plusSeconds((Long) ttl);
+        String target = (String) url;
+
+        if (code == null && ttl == null) {
+            Optional<Link> same = store.find(l -> l.url().equals(target) && l.expiresAt() == null);
+            if (same.isPresent()) {
+                return new Created(view(same.get()), false);
+            }
+        }
+        Iterable<String> candidates = code != null ? List.of((String) code) : this::randomCodes;
+        Optional<Link> added = store.add(candidates, c -> new Link(c, target, now, expiresAt, 0));
+        if (added.isEmpty()) {
+            throw new ApiException(409, "code already exists");
+        }
+        return new Created(view(added.get()), true);
+    }
+
+    private Iterator<String> randomCodes() {
+        return new Iterator<>() {
+            private int left = 100;
+
+            @Override
+            public boolean hasNext() {
+                return left > 0;
+            }
+
+            @Override
+            public String next() {
+                left--;
+                StringBuilder sb = new StringBuilder(CODE_LENGTH);
+                for (int i = 0; i < CODE_LENGTH; i++) {
+                    sb.append(ALPHABET.charAt(random.nextInt(ALPHABET.length())));
+                }
+                return sb.toString();
+            }
+        };
+    }
+
+    private Map<String, Object> view(Link link) {
+        Instant now = clock.instant();
+        return store.read(all -> link.toApi(baseUrl, now));
+    }
+
+    public Map<String, Object> get(String code) throws ApiException {
+        return view(store.get(code).orElseThrow(() -> new ApiException(404, "not found")));
+    }
+
+    /** Resolves a code for a redirect, counting the visit. Returns the target URL. */
+    public String visit(String code) throws ApiException {
+        Link link = store.get(code).orElseThrow(() -> new ApiException(404, "not found"));
+        if (link.isExpired(clock.instant())) {
+            throw new ApiException(410, "link expired");
+        }
+        store.recordHit(link);
+        return link.url();
+    }
+
+    public void delete(String code) throws ApiException {
+        if (!store.delete(code)) {
+            throw new ApiException(404, "not found");
+        }
+    }
+
+    public Map<String, Object> list(int limit, int offset) {
+        Instant now = clock.instant();
+        return store.read(all -> {
+            List<Object> page = new ArrayList<>();
+            for (int i = offset; i < all.size() && page.size() < limit; i++) {
+                page.add(all.get(i).toApi(baseUrl, now));
+            }
+            Map<String, Object> m = new LinkedHashMap<>();
+            m.put("total", (long) all.size());
+            m.put("links", page);
+            return m;
+        });
+    }
+
+    public Map<String, Object> stats() {
+        return store.read(all -> {
+            long hits = 0;
+            for (Link l : all) {
+                hits += l.hits();
+            }
+            List<Object> top = new ArrayList<>();
+            all.stream()
+                    .filter(l -> l.hits() > 0)
+                    .sorted(Comparator.comparingLong(Link::hits).reversed().thenComparing(Link::code))
+                    .limit(5)
+                    .forEach(l -> {
+                        Map<String, Object> e = new LinkedHashMap<>();
+                        e.put("code", l.code());
+                        e.put("url", l.url());
+                        e.put("hits", l.hits());
+                        top.add(e);
+                    });
+            Map<String, Object> m = new LinkedHashMap<>();
+            m.put("total_links", (long) all.size());
+            m.put("total_hits", hits);
+            m.put("top", top);
+            return m;
+        });
+    }
+}
