index 0000000..9e4189e
--- /dev/null
+++ b/src/main/java/shorty/LinkStore.java
@@ -0,0 +1,155 @@
+package shorty;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.time.Instant;
+import java.time.format.DateTimeParseException;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.function.Function;
+import java.util.function.Predicate;
+
+/**
+ * Thread-safe link storage backed by a JSON data file. Every mutation rewrites the file
+ * atomically (write a temporary file, then rename it over the data file).
+ */
+public final class LinkStore {
+
+    /** Thrown when the data file exists but cannot be understood. */
+    public static final class CorruptDataException extends Exception {
+        private static final long serialVersionUID = 1L;
+
+        CorruptDataException(String message) {
+            super(message);
+        }
+    }
+
+    private final Path file;
+    private final Map<String, Link> links = new LinkedHashMap<>();
+
+    private LinkStore(Path file) {
+        this.file = file;
+    }
+
+    /** Opens the store; a missing file means an empty store. */
+    public static LinkStore open(Path file) throws IOException, CorruptDataException {
+        LinkStore store = new LinkStore(file);
+        if (Files.exists(file)) {
+            store.load(Files.readString(file, StandardCharsets.UTF_8));
+        }
+        return store;
+    }
+
+    private void load(String text) throws CorruptDataException {
+        Object root;
+        try {
+            root = Json.parse(text);
+        } catch (Json.ParseException e) {
+            throw new CorruptDataException("invalid JSON: " + e.getMessage());
+        }
+        if (!(root instanceof Map<?, ?> m) || !(m.get("links") instanceof List<?> list)) {
+            throw new CorruptDataException("expected an object with a \"links\" array");
+        }
+        for (Object item : list) {
+            Link link = parseLink(item);
+            if (links.putIfAbsent(link.code, link) != null) {
+                throw new CorruptDataException("duplicate code " + link.code);
+            }
+        }
+    }
+
+    private static Link parseLink(Object item) throws CorruptDataException {
+        if (!(item instanceof Map<?, ?> m)
+                || !(m.get("code") instanceof String code)
+                || !(m.get("url") instanceof String url)
+                || !(m.get("created_at") instanceof String created)
+                || !(m.get("hits") instanceof Long hits) || hits < 0) {
+            throw new CorruptDataException("invalid link entry");
+        }
+        Object exp = m.get("expires_at");
+        try {
+            Instant expiresAt;
+            if (exp == null) {
+                expiresAt = null;
+            } else if (exp instanceof String s) {
+                expiresAt = Instant.parse(s);
+            } else {
+                throw new CorruptDataException("invalid expires_at for " + code);
+            }
+            return new Link(code, url, Instant.parse(created), expiresAt, hits);
+        } catch (DateTimeParseException e) {
+            throw new CorruptDataException("invalid timestamp for " + code);
+        }
+    }
+
+    private void save() {
+        List<Object> items = new ArrayList<>();
+        for (Link l : links.values()) {
+            items.add(l.toStored());
+        }
+        Map<String, Object> root = new LinkedHashMap<>();
+        root.put("links", items);
+        try {
+            Path dir = file.toAbsolutePath().getParent();
+            if (dir != null) {
+                Files.createDirectories(dir);
+            }
+            Path tmp = file.resolveSibling(file.getFileName() + ".tmp");
+            Files.writeString(tmp, Json.write(root) + "\n", StandardCharsets.UTF_8);
+            Files.move(tmp, file, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    public synchronized Optional<Link> get(String code) {
+        return Optional.ofNullable(links.get(code));
+    }
+
+    /** Returns the first link matching the predicate, in creation order. */
+    public synchronized Optional<Link> find(Predicate<Link> p) {
+        return links.values().stream().filter(p).findFirst();
+    }
+
+    /**
+     * Adds a link built by {@code factory} for the first code (from {@code codes}) that is
+     * not taken yet. Returns the new link, or empty if every candidate was taken.
+     */
+    public synchronized Optional<Link> add(Iterable<String> codes, Function<String, Link> factory) {
+        for (String code : codes) {
+            if (!links.containsKey(code)) {
+                Link link = factory.apply(code);
+                links.put(code, link);
+                save();
+                return Optional.of(link);
+            }
+        }
+        return Optional.empty();
+    }
+
+    public synchronized boolean delete(String code) {
+        if (links.remove(code) == null) {
+            return false;
+        }
+        save();
+        return true;
+    }
+
+    /** Counts a visit to the link and persists the new count. */
+    public synchronized void recordHit(Link link) {
+        link.hits++;
+        save();
+    }
+
+    /** Runs {@code f} on the links (in creation order) while holding the lock. */
+    public synchronized <T> T read(Function<List<Link>, T> f) {
+        return f.apply(new ArrayList<>(links.values()));
+    }
+}
diff --git a/src/main/java/shorty/Main.java b/src/main/java/shorty/Main.java
new file mode 100644
index 0000000..8785024
--- /dev/null
+++ b/src/main/java/shorty/Main.java
@@ -0,0 +1,79 @@
+package shorty;
+
+import java.io.IOException;
+import java.nio.file.Path;
+import java.time.Clock;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+
+/** Command-line entry point: {@code shorty --port N --data FILE [--base-url URL] [--rate-limit N]}. */
+public final class Main {
+    private static final Set<String> OPTIONS = Set.of("--port", "--data", "--base-url", "--rate-limit");
+
+    private Main() {
+    }
+
+    public static void main(String[] args) {
+        Map<String, String> opts = new HashMap<>();
+        for (int i = 0; i < args.length; i++) {
+            String a = args[i];
+            if (!OPTIONS.contains(a)) {
+                usage("unknown argument: " + a);
+            }
+            if (i + 1 >= args.length) {
+                usage("option " + a + " requires a value");
+            }
+            opts.put(a, args[++i]);
+        }
+        if (!opts.containsKey("--port") || !opts.containsKey("--data")) {
+            usage("--port and --data are required");
+        }
+        int port = parseInt(opts.get("--port"), 1, 65535, "invalid port");
+        int rate = parseInt(opts.getOrDefault("--rate-limit", "30"), 1, 1_000_000, "invalid rate limit");
+        String baseUrl = opts.getOrDefault("--base-url", "http://localhost:" + port);
+        while (baseUrl.endsWith("/")) {
+            baseUrl = baseUrl.substring(0, baseUrl.length() - 1);
+        }
+
+        Path data = Path.of(opts.get("--data"));
+        LinkStore store;
+        try {
+            store = LinkStore.open(data);
+        } catch (IOException | LinkStore.CorruptDataException e) {
+            System.err.println("error: cannot load " + data + ": " + e.getMessage());
+            System.exit(1);
+            return;
+        }
+        Clock clock = Clock.systemUTC();
+        LinkService service = new LinkService(store, clock, baseUrl);
+        ApiServer server = new ApiServer(service, new RateLimiter(rate, 60_000, clock));
+        try {
+            server.start(port);
+        } catch (IOException e) {
+            System.err.println("error: cannot listen on port " + port + ": " + e.getMessage());
+            System.exit(1);
+        }
+        System.out.println("listening on http://127.0.0.1:" + server.port());
+        System.out.flush();
+    }
+
+    private static int parseInt(String v, int min, int max, String error) {
+        try {
+            int n = Integer.parseInt(v);
+            if (n >= min && n <= max) {
+                return n;
+            }
+        } catch (NumberFormatException e) {
+            // fall through
+        }
+        usage(error + ": " + v);
+        return 0;
+    }
+
+    private static void usage(String message) {
+        System.err.println("error: " + message);
+        System.err.println("usage: shorty --port N --data FILE [--base-url URL] [--rate-limit N]");
+        System.exit(2);
+    }
+}
