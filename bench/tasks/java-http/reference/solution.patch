+#!/usr/bin/env bash
+# Compile the service and package it as build/shorty.jar.
+set -euo pipefail
+cd "$(dirname "$0")"
+rm -rf build/classes
+mkdir -p build/classes
+javac -Xlint:all -Werror --release 21 -d build/classes $(find src/main/java -name '*.java')
+jar --create --file build/shorty.jar --main-class shorty.Main -C build/classes .
