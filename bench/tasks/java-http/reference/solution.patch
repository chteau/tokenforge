--- /dev/null
+++ b/src/main/java/shorty/RateLimiter.java
@@ -0,0 +1,39 @@
+package shorty;
+
+import java.time.Clock;
+import java.util.ArrayDeque;
+import java.util.Deque;
+import java.util.HashMap;
+import java.util.Map;
+
+/** Sliding-window rate limiter: at most {@code limit} requests per client per window. */
+public final class RateLimiter {
+    private final int limit;
+    private final long windowMillis;
+    private final Clock clock;
+    private final Map<String, Deque<Long>> requests = new HashMap<>();
+
+    public RateLimiter(int limit, long windowMillis, Clock clock) {
+        this.limit = limit;
+        this.windowMillis = windowMillis;
+        this.clock = clock;
+    }
+
+    /**
+     * Records a request from {@code client}. Returns 0 if it is allowed, otherwise the
+     * number of whole seconds (at least 1) until the client may try again.
+     */
+    public synchronized long acquire(String client) {
+        long now = clock.millis();
+        Deque<Long> q = requests.computeIfAbsent(client, k -> new ArrayDeque<>());
+        while (!q.isEmpty() && q.peekFirst() <= now - windowMillis) {
+            q.pollFirst();
+        }
+        if (q.size() >= limit) {
+            long waitMillis = q.peekFirst() + windowMillis - now;
+            return Math.max(1, (waitMillis + 999) / 1000);
+        }
+        q.addLast(now);
+        return 0;
+    }
+}
diff --git a/src/test/java/shorty/AllTests.java b/src/test/java/shorty/AllTests.java
new file mode 100644
index 0000000..a10d42b
--- /dev/null
+++ b/src/test/java/shorty/AllTests.java
@@ -0,0 +1,169 @@
+package shorty;
+
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Clock;
+import java.time.Instant;
+import java.time.ZoneOffset;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/** A tiny self-contained test runner: every {@code test*} method below is a test. */
+public final class AllTests {
+    private static int failures = 0;
+    private static final List<String> RAN = new ArrayList<>();
+
+    interface Body {
+        void run() throws Exception;
+    }
+
+    private static void test(String name, Body body) {
+        RAN.add(name);
+        try {
+            body.run();
+            System.out.println("ok   " + name);
+        } catch (Throwable t) {
+            failures++;
+            System.out.println("FAIL " + name + ": " + t);
+        }
+    }
+
+    private static void check(boolean cond, String what) {
+        if (!cond) {
+            throw new AssertionError(what);
+        }
+    }
+
+    private static void checkEq(Object expected, Object actual) {
+        if (expected == null ? actual != null : !expected.equals(actual)) {
+            throw new AssertionError("expected " + expected + ", got " + actual);
+        }
+    }
+
+    /** A clock that tests can move forward. */
+    static final class FakeClock extends Clock {
+        Instant now = Instant.parse("2026-03-01T10:00:00Z");
+
+        @Override
+        public ZoneOffset getZone() {
+            return ZoneOffset.UTC;
+        }
+
+        @Override
+        public Clock withZone(java.time.ZoneId zone) {
+            return this;
+        }
+
+        @Override
+        public Instant instant() {
+            return now;
+        }
+    }
+
+    public static void main(String[] args) throws Exception {
+        test("json round trip", () -> {
+            Object v = Json.parse("{\"a\": [1, 2.5, true, null], \"s\": \"x\\\"\\u00e9\\n\"}");
+            checkEq("{\"a\":[1,2.5,true,null],\"s\":\"x\\\"é\\n\"}", Json.write(v));
+        });
+        test("json rejects malformed input", () -> {
+            for (String bad : new String[] {"", "{", "{\"a\":}", "[1,]", "01", "\"x", "{} x", "tru"}) {
+                try {
+                    Json.parse(bad);
+                    throw new AssertionError("accepted " + bad);
+                } catch (Json.ParseException expected) {
+                    // ok
+                }
+            }
+        });
+        test("url validation", () -> {
+            check(LinkService.isValidUrl("https://example.com/a?b=c"), "https");
+            check(LinkService.isValidUrl("HTTP://x"), "upper-case scheme");
+            check(!LinkService.isValidUrl("ftp://x"), "ftp");
+            check(!LinkService.isValidUrl("https://"), "no host");
+            check(!LinkService.isValidUrl("https://a b"), "space");
+            check(!LinkService.isValidUrl(42L), "number");
+            check(!LinkService.isValidUrl("https://x/" + "a".repeat(2048)), "too long");
+        });
+        test("code validation", () -> {
+            check(LinkService.isValidCode("my-code_1"), "valid");
+            check(!LinkService.isValidCode("ab"), "short");
+            check(!LinkService.isValidCode("a".repeat(33)), "long");
+            check(!LinkService.isValidCode("api"), "reserved");
+            check(!LinkService.isValidCode("no/slash"), "slash");
+        });
+        test("rate limiter sliding window", () -> {
+            FakeClock clock = new FakeClock();
+            RateLimiter rl = new RateLimiter(2, 60_000, clock);
+            checkEq(0L, rl.acquire("a"));
+            clock.now = clock.now.plusSeconds(30);
+            checkEq(0L, rl.acquire("a"));
+            checkEq(30L, rl.acquire("a"));
+            checkEq(0L, rl.acquire("b"));
+            clock.now = clock.now.plusSeconds(30);
+            checkEq(0L, rl.acquire("a"));
+        });
+        test("service create, dedupe, expire and persist", () -> {
+            Path dir = Files.createTempDirectory("shorty-test");
+            Path file = dir.resolve("links.json");
+            FakeClock clock = new FakeClock();
+            LinkService svc = new LinkService(LinkStore.open(file), clock, "http://s");
+            LinkService.Created a = svc.create(Map.of("url", "https://a.example"));
+            check(a.isNew(), "new");
+            checkEq(7, ((String) a.link().get("code")).length());
+            LinkService.Created again = svc.create(Map.of("url", "https://a.example"));
+            check(!again.isNew(), "deduplicated");
+            checkEq(a.link().get("code"), again.link().get("code"));
+            svc.create(Map.of("url", "https://b.example", "code", "bee", "ttl_seconds", 10L));
+            try {
+                svc.create(Map.of("url", "https://c.example", "code", "bee"));
+                throw new AssertionError("duplicate code accepted");
+            } catch (ApiException e) {
+                checkEq(409, e.status());
+            }
+            checkEq("https://b.example", svc.visit("bee"));
+            clock.now = clock.now.plusSeconds(10);
+            try {
+                svc.visit("bee");
+                throw new AssertionError("expired link visited");
+            } catch (ApiException e) {
+                checkEq(410, e.status());
+            }
+            LinkService reopened = new LinkService(LinkStore.open(file), clock, "http://s");
+            checkEq(1L, reopened.get("bee").get("hits"));
+            checkEq(2L, reopened.stats().get("total_links"));
+        });
+        test("http end to end", () -> {
+            Path dir = Files.createTempDirectory("shorty-http");
+            Clock clock = Clock.systemUTC();
+            LinkService svc = new LinkService(LinkStore.open(dir.resolve("d.json")), clock, "http://s");
+            ApiServer server = new ApiServer(svc, new RateLimiter(2, 60_000, clock));
+            server.start(0);
+            try {
+                HttpClient client = HttpClient.newHttpClient();
+                String base = "http://127.0.0.1:" + server.port();
+                HttpRequest post = HttpRequest.newBuilder(URI.create(base + "/api/links"))
+                        .header("Content-Type", "application/json")
+                        .POST(HttpRequest.BodyPublishers.ofString("{\"url\":\"https://x.example\",\"code\":\"xyz\"}"))
+                        .build();
+                checkEq(201, client.send(post, HttpResponse.BodyHandlers.ofString()).statusCode());
+                HttpResponse<String> r = client.send(HttpRequest.newBuilder(URI.create(base + "/xyz")).build(),
+                        HttpResponse.BodyHandlers.ofString());
+                checkEq(302, r.statusCode());
+                checkEq("https://x.example", r.headers().firstValue("Location").orElse(""));
+                checkEq(409, client.send(post, HttpResponse.BodyHandlers.ofString()).statusCode());
+                HttpResponse<String> limited = client.send(post, HttpResponse.BodyHandlers.ofString());
+                checkEq(429, limited.statusCode());
+                check(limited.headers().firstValue("Retry-After").isPresent(), "Retry-After");
+            } finally {
+                server.stop();
+            }
+        });
+        System.out.println(RAN.size() + " tests, " + failures + " failures");
+        System.exit(failures == 0 ? 0 : 1);
+    }
+}
diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..16017cf
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+# Build, then compile and run the tests against the compiled classes.
+set -euo pipefail
+cd "$(dirname "$0")"
+./build.sh
+rm -rf build/test-classes
+mkdir -p build/test-classes
+javac -Xlint:all -Werror --release 21 -cp build/classes -d build/test-classes \
+  $(find src/test/java -name '*.java')
+java -cp build/classes:build/test-classes shorty.AllTests
