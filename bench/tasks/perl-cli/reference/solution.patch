+#!/usr/bin/perl
+# cfgmerge: lint, merge, validate and explain layered INI/.env configuration.
+use strict;
+use warnings;
+use FindBin;
+use lib "$FindBin::RealBin/../lib";
+use CfgMerge::CLI;
+
+exit CfgMerge::CLI::main(@ARGV);
diff --git a/lib/CfgMerge/CLI.pm b/lib/CfgMerge/CLI.pm
new file mode 100644
index 0000000..8f7c005
--- /dev/null
+++ b/lib/CfgMerge/CLI.pm
@@ -0,0 +1,205 @@
+package CfgMerge::CLI;
+
+# Command-line parsing and the five commands.
+use strict;
+use warnings;
+use CfgMerge::Error;
+use CfgMerge::Parser qw(detect_format to_template is_valid_key);
+use CfgMerge::Layers qw(parse_file load_layers merge);
+use CfgMerge::Interpolate qw(expand_all literal);
+use CfgMerge::Schema qw(build_schema apply_defaults validate);
+use CfgMerge::Output qw(show render_ini render_env);
+
+our $USAGE = <<'TXT';
+usage: cfgmerge <command> [options] FILE...
+
+commands:
+  lint FILE...                     report syntax problems
+  merge [--schema S [--strict]] [--set KEY=VALUE]... [--format ini|env] FILE...
+  get [--set KEY=VALUE]... KEY FILE...
+  explain [--schema S [--strict]] [--set KEY=VALUE]... FILE...
+  diff FILE_A FILE_B
+
+Later files override earlier ones; --set values override all files.
+TXT
+
+my %OPTIONS = (
+    lint    => {},
+    merge   => { schema => 1, strict => 1, set => 1, format => 1 },
+    get     => { set    => 1 },
+    explain => { schema => 1, strict => 1, set => 1 },
+    diff    => {},
+);
+my %ARITY = (lint => [1, undef], merge => [1, undef], get => [2, undef], explain => [1, undef], diff => [2, 2]);
+
+# Entry point: returns the exit code.
+sub main {
+    my (@argv) = @_;
+    if (@argv == 1 && ($argv[0] eq '--help' || $argv[0] eq '-h')) {
+        print $USAGE;
+        return 0;
+    }
+    my $code = eval { run(@argv) };
+    return $code if defined $code;
+    my $err = $@;
+    die $err unless ref $err && $err->isa('CfgMerge::Error');
+    print STDERR map {"$_\n"} $err->lines;
+    return $err->code;
+}
+
+sub parse_args {
+    my ($command, @args) = @_;
+    CfgMerge::Error->usage('missing command (try --help)') unless defined $command;
+    my $allowed = $OPTIONS{$command} or CfgMerge::Error->usage("unknown command: $command");
+    my (%opt, @sets, @positional);
+    my $options_done = 0;
+    while (@args) {
+        my $arg = shift @args;
+        if ($options_done || $arg !~ /\A-./) {
+            push @positional, $arg;
+        }
+        elsif ($arg eq '--') {
+            $options_done = 1;
+        }
+        elsif ($arg =~ /\A--(schema|strict|set|format)\z/ && $allowed->{$1}) {
+            my $name = $1;
+            CfgMerge::Error->usage("repeated option --$name") if exists $opt{$name};
+            if ($name eq 'strict') {
+                $opt{strict} = 1;
+                next;
+            }
+            CfgMerge::Error->usage("option --$name needs a value") unless @args;
+            my $value = shift @args;
+            if   ($name eq 'set') { push @sets, $value }
+            else                  { $opt{$name} = $value }
+        }
+        else {
+            CfgMerge::Error->usage("unknown option for $command: $arg");
+        }
+    }
+    my ($min, $max) = @{ $ARITY{$command} };
+    CfgMerge::Error->usage("wrong number of arguments for $command")
+      if @positional < $min || (defined $max && @positional > $max);
+    CfgMerge::Error->usage('--strict needs --schema') if $opt{strict} && !defined $opt{schema};
+    CfgMerge::Error->usage("unknown format: $opt{format}") if defined $opt{format} && $opt{format} !~ /\A(?:ini|env)\z/;
+    $opt{sets} = [map { parse_set($_) } @sets];
+    return (\%opt, @positional);
+}
+
+sub parse_set {
+    my ($arg) = @_;
+    my ($key, $value) = $arg =~ /\A([^=]*)=(.*)\z/s or CfgMerge::Error->usage("invalid --set: $arg");
+    $key = lc $key;
+    my ($template) = to_template($value);
+    CfgMerge::Error->usage("invalid --set: $arg") unless is_valid_key($key) && defined $template;
+    return { key => $key, template => $template };
+}
+
+sub check_formats {
+    for my $path (@_) {
+        CfgMerge::Error->usage("cannot tell the format of $path") unless detect_format($path);
+    }
+}
+
+sub load_schema {
+    my ($path) = @_;
+    return unless defined $path;
+    my $parsed = parse_file($path, 'ini');
+    my @errors = grep { $_->{level} eq 'error' } @{ $parsed->{diagnostics} };
+    CfgMerge::Error->usage("invalid schema: $path:$errors[0]{line}: $errors[0]{message}") if @errors;
+    my ($schema, $why) = build_schema($parsed->{entries});
+    CfgMerge::Error->usage("invalid schema: $why") unless $schema;
+    return $schema;
+}
+
+# Merge files and --set values, expand references, apply the schema.
+# Returns (values, history, sources) where sources maps key -> source label.
+sub resolve {
+    my ($opt, @files) = @_;
+    check_formats(@files);
+    my $schema = load_schema($opt->{schema});
+    my @layers = load_layers(@files);
+    push @layers, { name => '--set', entries => [$_] } for @{ $opt->{sets} };
+    my $history = merge(@layers);
+    my $values  = expand_all({ map { $_ => $history->{$_}[-1]{template} } keys %$history });
+    my %sources = map { $_ => $history->{$_}[-1]{source} } keys %$history;
+    if ($schema) {
+        $sources{$_} = 'default' for apply_defaults($schema, $values);
+        my @errors = validate($schema, $values, $opt->{strict});
+        CfgMerge::Error->throw(1, @errors) if @errors;
+    }
+    return ($values, $history, \%sources);
+}
+
+sub run {
+    my ($command, @rest) = @_;
+    my ($opt, @args) = parse_args($command, @rest);
+    my $handler = __PACKAGE__->can("cmd_$command");
+    return $handler->($opt, @args);
+}
+
+sub cmd_lint {
+    my ($opt, @files) = @_;
+    check_formats(@files);
+    my ($errors, $warnings) = (0, 0);
+    my @out;
+    for my $path (@files) {
+        my $parsed = parse_file($path);
+        for my $d (@{ $parsed->{diagnostics} }) {
+            push @out, "$path:$d->{line}: $d->{level}: $d->{message}";
+            $d->{level} eq 'error' ? $errors++ : $warnings++;
+        }
+    }
+    print map {"$_\n"} @out, "$errors error(s), $warnings warning(s)";
+    return $errors ? 1 : 0;
+}
+
+sub cmd_merge {
+    my ($opt, @files) = @_;
+    my ($values) = resolve($opt, @files);
+    print(($opt->{format} // 'ini') eq 'env' ? render_env($values) : render_ini($values));
+    return 0;
+}
+
+sub cmd_get {
+    my ($opt, $key, @files) = @_;
+    my ($values) = resolve($opt, @files);
+    my $norm = lc $key;
+    CfgMerge::Error->throw(1, "error: key not found: $key") unless exists $values->{$norm};
+    print "$values->{$norm}\n";
+    return 0;
+}
+
+sub cmd_explain {
+    my ($opt, @files) = @_;
+    my ($values, $history, $sources) = resolve($opt, @files);
+    for my $key (sort keys %$values) {
+        print "$key = ", show($values->{$key}), "  [$sources->{$key}]\n";
+        my @earlier = @{ $history->{$key} // [] };
+        pop @earlier unless $sources->{$key} eq 'default';
+        print "  overrides ", show(literal($_->{template})), "  [$_->{source}]\n" for reverse @earlier;
+    }
+    return 0;
+}
+
+sub cmd_diff {
+    my ($opt, $file_a, $file_b) = @_;
+    my ($left, $right) = map {
+        my $o = { sets => [] };
+        (resolve($o, $_))[0]
+    } $file_a, $file_b;
+    my %keys = map { $_ => 1 } keys %$left, keys %$right;
+    my $changes = 0;
+    for my $key (sort keys %keys) {
+        my $line;
+        if    (!exists $right->{$key}) { $line = "- $key = " . show($left->{$key}) }
+        elsif (!exists $left->{$key}) { $line = "+ $key = " . show($right->{$key}) }
+        elsif ($left->{$key} ne $right->{$key}) { $line = "~ $key: " . show($left->{$key}) . ' -> ' . show($right->{$key}) }
+        next unless defined $line;
+        print "$line\n";
+        $changes++;
+    }
+    return $changes ? 1 : 0;
+}
+
+1;
