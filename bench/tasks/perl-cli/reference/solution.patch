@@ -0,0 +1,19 @@
+package CfgMerge::Error;
+
+# A failure that ends the program: an exit code plus the lines for stderr.
+use strict;
+use warnings;
+
+sub new {
+    my ($class, $code, @lines) = @_;
+    return bless { code => $code, lines => [@lines] }, $class;
+}
+
+sub throw { my $class = shift; die $class->new(@_) }
+
+sub usage { my ($class, $msg) = @_; $class->throw(2, "error: $msg") }
+
+sub code  { $_[0]{code} }
+sub lines { @{ $_[0]{lines} } }
+
+1;
