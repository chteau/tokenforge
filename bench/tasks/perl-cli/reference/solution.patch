@@ -0,0 +1,59 @@
+package CfgMerge::Layers;
+
+# Reads configuration files and merges layers, remembering where each value came from.
+use strict;
+use warnings;
+use Exporter 'import';
+use CfgMerge::Error;
+use CfgMerge::Parser qw(detect_format parse_text);
+
+our @EXPORT_OK = qw(read_file parse_file load_layers merge);
+
+sub read_file {
+    my ($path) = @_;
+    CfgMerge::Error->throw(3, "error: cannot read $path: Is a directory") if -d $path;
+    open my $fh, '<:raw', $path or CfgMerge::Error->throw(3, "error: cannot read $path: $!");
+    local $/;
+    my $text = <$fh>;
+    close $fh;
+    return $text // '';
+}
+
+# Parse one file whose format is already known to be valid.
+sub parse_file {
+    my ($path, $format) = @_;
+    return parse_text(read_file($path), $format // detect_format($path));
+}
+
+# Parse every file; any error in any of them ends the command with exit code 1.
+sub load_layers {
+    my (@paths) = @_;
+    my (@layers, @errors);
+    for my $path (@paths) {
+        my $parsed = parse_file($path);
+        push @errors, map {"$path:$_->{line}: error: $_->{message}"}
+          grep { $_->{level} eq 'error' } @{ $parsed->{diagnostics} };
+        push @layers, { name => $path, entries => $parsed->{entries} };
+    }
+    CfgMerge::Error->throw(1, @errors) if @errors;
+    return @layers;
+}
+
+# Merge layers (lowest precedence first). Returns { key => [ {template, source}, ... ] },
+# oldest first; within a layer only the last definition of a key counts.
+sub merge {
+    my (@layers) = @_;
+    my %history;
+    for my $layer (@layers) {
+        my %last;
+        $last{ $_->{key} } = $_ for @{ $layer->{entries} };
+        for my $key (keys %last) {
+            my $e = $last{$key};
+            my $source = defined $e->{line} ? "$layer->{name}:$e->{line}" : $layer->{name};
+            push @{ $history{$key} }, { template => $e->{template}, source => $source };
+        }
+    }
+    return \%history;
+}
+
+1;
diff --git a/lib/CfgMerge/Output.pm b/lib/CfgMerge/Output.pm
