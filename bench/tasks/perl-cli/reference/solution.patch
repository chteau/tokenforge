+++ b/lib/CfgMerge/Output.pm
@@ -0,0 +1,51 @@
+package CfgMerge::Output;
+
+# Rendering of values and merged configurations.
+use strict;
+use warnings;
+use Exporter 'import';
+
+our @EXPORT_OK = qw(escape show render_ini render_env);
+
+# Backslash-escape a value for a double-quoted string.
+sub escape {
+    my ($v, $with_dollar) = @_;
+    my %map = ('\\' => '\\\\', '"' => '\\"', "\n" => '\\n', "\t" => '\\t', '$' => $with_dollar ? '\\$' : '$');
+    $v =~ s/([\\"\n\t\$])/$map{$1}/g;
+    return $v;
+}
+
+# A value as shown by explain, diff and error messages.
+sub show { my ($v) = @_; return '"' . escape($v, 0) . '"' }
+
+# A value as written to a config file: bare when that is unambiguous.
+sub file_value {
+    my ($v) = @_;
+    return $v unless $v eq '' || $v =~ /\A\s|\s\z/ || $v =~ /["'\\#;\$\t\n]/;
+    return '"' . escape($v, 1) . '"';
+}
+
+sub render_ini {
+    my ($values) = @_;
+    my (%sections, @out);
+    for my $key (keys %$values) {
+        my ($section, $name) = $key =~ /\A(?:(.*)\.)?([^.]+)\z/;
+        $sections{ $section // '' }{$name} = $values->{$key};
+    }
+    for my $section (sort keys %sections) {
+        if ($section ne '') {
+            push @out, '' if @out;
+            push @out, "[$section]";
+        }
+        push @out, map { "$_ = " . file_value($sections{$section}{$_}) } sort keys %{ $sections{$section} };
+    }
+    return join '', map {"$_\n"} @out;
+}
+
+sub render_env {
+    my ($values) = @_;
+    my %named = map { (uc($_) =~ s/\./__/gr) => $values->{$_} } keys %$values;
+    return join '', map { "$_=" . file_value($named{$_}) . "\n" } sort keys %named;
+}
+
+1;
diff --git a/lib/CfgMerge/Parser.pm b/lib/CfgMerge/Parser.pm
