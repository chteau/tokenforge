@@ -0,0 +1,73 @@
+package CfgMerge::Interpolate;
+
+# Expands `${...}` references in merged value templates, detecting cycles.
+use strict;
+use warnings;
+use Exporter 'import';
+use CfgMerge::Error;
+use CfgMerge::Parser qw(parse_ref);
+
+our @EXPORT_OK = qw(expand_all literal);
+
+# A template's text with no expansion: `$$` -> `$`, references left as written.
+sub literal {
+    my ($template) = @_;
+    my $out = '';
+    for my $piece (_pieces($template)) {
+        $out .= ref $piece ? '${' . $piece->{text} . '}' : $piece;
+    }
+    return $out;
+}
+
+# Split a template into literal strings and reference hashrefs, in order.
+sub _pieces {
+    my ($t) = @_;
+    my @out;
+    while (length $t) {
+        if    ($t =~ s/\A\$\$//)          { push @out, '$' }
+        elsif ($t =~ s/\A\$\{([^}]*)\}//) { push @out, { %{ parse_ref($1) }, text => $1 } }
+        else                              { $t =~ s/\A([^\$]+|\$)//; push @out, $1 }
+    }
+    return @out;
+}
+
+# Expand every template in %$templates; returns a hashref of final values.
+sub expand_all {
+    my ($templates, $env) = @_;
+    my $state = { templates => $templates, env => $env // \%ENV, done => {}, stack => [] };
+    _resolve($state, $_) for sort keys %$templates;
+    return $state->{done};
+}
+
+sub _resolve {
+    my ($st, $key) = @_;
+    return $st->{done}{$key} if exists $st->{done}{$key};
+    my @stack = @{ $st->{stack} };
+    for my $i (0 .. $#stack) {
+        next unless $stack[$i] eq $key;
+        CfgMerge::Error->throw(1, 'error: reference cycle: ' . join(' -> ', @stack[$i .. $#stack], $key));
+    }
+    push @{ $st->{stack} }, $key;
+    my $out = '';
+    for my $piece (_pieces($st->{templates}{$key})) {
+        if (!ref $piece) {
+            $out .= $piece;
+            next;
+        }
+        my $value;
+        if (defined $piece->{env}) {
+            $value = $st->{env}{ $piece->{env} };
+        }
+        elsif (exists $st->{templates}{ $piece->{key} }) {
+            $value = _resolve($st, $piece->{key});
+        }
+        $value //= $piece->{default};
+        CfgMerge::Error->throw(1, "error: undefined reference '\${$piece->{text}}' in key '$key'")
+          unless defined $value;
+        $out .= $value;
+    }
+    pop @{ $st->{stack} };
+    return $st->{done}{$key} = $out;
+}
+
+1;
