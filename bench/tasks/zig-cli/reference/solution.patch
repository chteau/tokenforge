index 0000000..64abbd9
--- /dev/null
+++ b/src/query.zig
@@ -0,0 +1,153 @@
+//! Path expressions such as `.users[*].emails[0]` and their evaluation.
+const std = @import("std");
+const json = @import("json.zig");
+const Allocator = std.mem.Allocator;
+const Value = json.Value;
+
+pub const Segment = union(enum) {
+    key: []const u8,
+    index: i64,
+    wildcard,
+};
+
+pub const PathError = error{ InvalidPath, OutOfMemory };
+
+/// Parses a path. `.` alone yields no segments (the whole document).
+pub fn parsePath(arena: Allocator, path: []const u8) PathError![]Segment {
+    if (std.mem.eql(u8, path, ".")) return &.{};
+    var segments: std.ArrayList(Segment) = .empty;
+    var i: usize = 0;
+    if (path.len >= 2 and path[0] == '.' and path[1] == '[') i = 1;
+    if (i >= path.len) return error.InvalidPath;
+    while (i < path.len) {
+        switch (path[i]) {
+            '.' => {
+                const start = i + 1;
+                var end = start;
+                while (end < path.len and isIdentByte(path[end], end == start)) end += 1;
+                if (end == start) return error.InvalidPath;
+                try segments.append(arena, .{ .key = path[start..end] });
+                i = end;
+            },
+            '[' => {
+                const close = try bracketEnd(path, i);
+                try segments.append(arena, try parseBracket(arena, path[i + 1 .. close]));
+                i = close + 1;
+            },
+            else => return error.InvalidPath,
+        }
+    }
+    return segments.toOwnedSlice(arena);
+}
+
+fn isIdentByte(c: u8, first: bool) bool {
+    return switch (c) {
+        'A'...'Z', 'a'...'z', '_' => true,
+        '0'...'9' => !first,
+        else => false,
+    };
+}
+
+/// Index of the `]` closing the bracket at `open`, skipping over a quoted key.
+fn bracketEnd(path: []const u8, open: usize) PathError!usize {
+    var i = open + 1;
+    if (i < path.len and path[i] == '"') {
+        i += 1;
+        while (i < path.len and path[i] != '"') : (i += 1) {
+            if (path[i] == '\\') i += 1;
+        }
+        i += 1;
+    }
+    while (i < path.len and path[i] != ']') i += 1;
+    if (i >= path.len) return error.InvalidPath;
+    return i;
+}
+
+fn parseBracket(arena: Allocator, inner: []const u8) PathError!Segment {
+    if (std.mem.eql(u8, inner, "*")) return .wildcard;
+    if (inner.len > 0 and inner[0] == '"') {
+        var diag: json.Diagnostic = .{};
+        const v = json.parse(arena, inner, &diag) catch |err| switch (err) {
+            error.InvalidJson => return error.InvalidPath,
+            error.OutOfMemory => return error.OutOfMemory,
+        };
+        if (v != .string or inner[inner.len - 1] != '"') return error.InvalidPath;
+        return .{ .key = v.string };
+    }
+    const negative = inner.len > 0 and inner[0] == '-';
+    const digits = if (negative) inner[1..] else inner;
+    if (digits.len == 0) return error.InvalidPath;
+    for (digits) |c| if (c < '0' or c > '9') return error.InvalidPath;
+    if (digits.len > 1 and digits[0] == '0') return error.InvalidPath;
+    if (negative and std.mem.eql(u8, digits, "0")) return error.InvalidPath;
+    const n = std.fmt.parseInt(i64, digits, 10) catch return error.InvalidPath;
+    return .{ .index = if (negative) -n else n };
+}
+
+/// Applies `segments` to `root`, returning every match in document order.
+pub fn evaluate(arena: Allocator, root: Value, segments: []const Segment) Allocator.Error![]Value {
+    var current: std.ArrayList(Value) = .empty;
+    try current.append(arena, root);
+    for (segments) |seg| {
+        var next: std.ArrayList(Value) = .empty;
+        for (current.items) |v| try step(arena, &next, v, seg);
+        current = next;
+    }
+    return current.items;
+}
+
+fn step(arena: Allocator, out: *std.ArrayList(Value), v: Value, seg: Segment) Allocator.Error!void {
+    switch (seg) {
+        .key => |k| if (v == .object) {
+            for (v.object) |m| if (std.mem.eql(u8, m.key, k)) return out.append(arena, m.value);
+        },
+        .index => |n| if (v == .array) {
+            const len: i64 = @intCast(v.array.len);
+            const idx = if (n < 0) len + n else n;
+            if (idx >= 0 and idx < len) try out.append(arena, v.array[@intCast(idx)]);
+        },
+        .wildcard => switch (v) {
+            .array => |items| try out.appendSlice(arena, items),
+            .object => |members| for (members) |m| try out.append(arena, m.value),
+            else => {},
+        },
+    }
+}
+
+// ---------------------------------------------------------------- tests
+
+const testing = std.testing;
+
+test "parse paths" {
+    var arena: std.heap.ArenaAllocator = .init(testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    try testing.expectEqual(@as(usize, 0), (try parsePath(a, ".")).len);
+    const segs = try parsePath(a, ".a.b_2[3][*][\"x ]y\"][-1]");
+    try testing.expectEqual(@as(usize, 6), segs.len);
+    try testing.expectEqualStrings("b_2", segs[1].key);
+    try testing.expectEqual(@as(i64, 3), segs[2].index);
+    try testing.expect(segs[3] == .wildcard);
+    try testing.expectEqualStrings("x ]y", segs[4].key);
+    try testing.expectEqual(@as(i64, -1), segs[5].index);
+    try testing.expectEqual(@as(usize, 1), (try parsePath(a, ".[0]")).len);
+    for ([_][]const u8{ "", "a", "..a", ".1a", "[01]", "[-0]", "[", "[x]", ".a.", "[\"a\"", ".[" }) |bad| {
+        try testing.expectError(error.InvalidPath, parsePath(a, bad));
+    }
+}
+
+test "evaluate paths" {
+    var arena: std.heap.ArenaAllocator = .init(testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var diag: json.Diagnostic = .{};
+    const doc = try json.parse(a, "{\"u\":[{\"n\":\"a\"},{\"n\":\"b\"},{\"m\":1}],\"é\":5}", &diag);
+    const names = try evaluate(a, doc, try parsePath(a, ".u[*].n"));
+    try testing.expectEqual(@as(usize, 2), names.len);
+    try testing.expectEqualStrings("b", names[1].string);
+    const last = try evaluate(a, doc, try parsePath(a, ".u[-1].m"));
+    try testing.expectEqualStrings("1", last[0].number);
+    const esc = try evaluate(a, doc, try parsePath(a, "[\"\\u00e9\"]"));
+    try testing.expectEqualStrings("5", esc[0].number);
+    try testing.expectEqual(@as(usize, 0), (try evaluate(a, doc, try parsePath(a, ".u[9]"))).len);
+}
