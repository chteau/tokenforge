@@ -0,0 +1,42 @@
+import { validationError } from "../../packages/shared/src/errors.ts";
+import { parseOrThrow, v } from "../../packages/shared/src/validation.ts";
+import { json } from "../http/response.ts";
+import type { Route } from "../http/types.ts";
+import { api, header } from "./helpers.ts";
+import { presentScheduledTransfer } from "./presenters.ts";
+import { transferFields } from "./transfer-routes.ts";
+
+const scheduleSchema = v.object({ ...transferFields, scheduledDate: v.isoDate() });
+
+export function scheduledTransferRoutes(): Route[] {
+  return [
+    api("POST", "/api/scheduled-transfers", "user", (ctx) => {
+      const input = parseOrThrow(scheduleSchema, ctx.body);
+      const idempotencyKey = header(ctx, "idempotency-key");
+      if (!idempotencyKey) throw validationError([{ field: "Idempotency-Key", message: "header is required" }]);
+      const { scheduledTransfer, replayed } = ctx.deps.services.scheduledTransfers.schedule(ctx.actor, {
+        ...input,
+        idempotencyKey,
+      });
+      return json(replayed ? 200 : 201, { scheduledTransfer: presentScheduledTransfer(scheduledTransfer), replayed });
+    }),
+
+    api("GET", "/api/scheduled-transfers", "user", (ctx) => {
+      return json(200, { items: ctx.deps.services.scheduledTransfers.list(ctx.actor).map(presentScheduledTransfer) });
+    }),
+
+    api("GET", "/api/scheduled-transfers/:id", "user", (ctx) => {
+      const row = ctx.deps.services.scheduledTransfers.get(ctx.actor, ctx.params["id"] ?? "");
+      return json(200, { scheduledTransfer: presentScheduledTransfer(row) });
+    }),
+
+    api("DELETE", "/api/scheduled-transfers/:id", "user", (ctx) => {
+      const row = ctx.deps.services.scheduledTransfers.cancel(ctx.actor, ctx.params["id"] ?? "");
+      return json(200, { scheduledTransfer: presentScheduledTransfer(row) });
+    }),
+
+    api("POST", "/api/admin/scheduled-transfers/run", ["admin"], (ctx) => {
+      return json(200, ctx.deps.services.scheduledTransfers.runDue());
+    }),
+  ];
+}
