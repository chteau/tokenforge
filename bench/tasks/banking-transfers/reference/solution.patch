diff --git a/tests/api/scheduled-transfers.api.test.ts b/tests/api/scheduled-transfers.api.test.ts
new file mode 100644
index 0000000..1d57cce
--- /dev/null
+++ b/tests/api/scheduled-transfers.api.test.ts
@@ -0,0 +1,121 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { idemKey, setup } from "../support/harness.ts";
+
+async function scheduleAs(t: ReturnType<typeof setup>, username: "alice" | "bob", body: Record<string, unknown>, key = idemKey("sch")) {
+  const client = await t.login(username);
+  return client.post("/api/scheduled-transfers", body, { "idempotency-key": key });
+}
+
+async function runExecutor(t: ReturnType<typeof setup>) {
+  const olive = await t.login("olive");
+  return olive.post("/api/admin/scheduled-transfers/run");
+}
+
+describe("scheduled transfers API", () => {
+  it("schedules at 09:00 in the customer's time zone, across DST", async () => {
+    const t = setup();
+    const from = t.accountId("QM-1000-0001");
+    const before = await scheduleAs(t, "alice", { fromAccountId: from, toAccount: "QM-1000-0005", amount: "25.00", scheduledDate: "2026-10-30" });
+    assert.equal(before.status, 201);
+    assert.equal(before.json().scheduledTransfer.executeAt, "2026-10-30T13:00:00.000Z");
+    const after = await scheduleAs(t, "alice", { fromAccountId: from, toAccount: "QM-1000-0005", amount: "25.00", scheduledDate: "2026-11-02" });
+    assert.equal(after.json().scheduledTransfer.executeAt, "2026-11-02T14:00:00.000Z");
+  });
+
+  it("rejects past, too distant and impossible dates", async () => {
+    const t = setup();
+    const from = t.accountId("QM-1000-0001");
+    for (const scheduledDate of ["2026-10-07", "2026-02-30", "2027-10-08"]) {
+      const res = await scheduleAs(t, "alice", { fromAccountId: from, toAccount: "QM-1000-0002", amount: "1.00", scheduledDate });
+      assert.equal(res.status, 400, scheduledDate);
+      assert.equal(res.json().error.details[0].field, "scheduledDate");
+    }
+  });
+
+  it("is idempotent per key", async () => {
+    const t = setup();
+    const body = { fromAccountId: t.accountId("QM-1000-0001"), toAccount: "QM-1000-0002", amount: "9.00", scheduledDate: "2026-10-12" };
+    const key = idemKey("sch");
+    assert.equal((await scheduleAs(t, "alice", body, key)).status, 201);
+    assert.equal((await scheduleAs(t, "alice", body, key)).status, 200);
+    assert.equal((await scheduleAs(t, "alice", { ...body, amount: "10.00" }, key)).status, 409);
+  });
+
+  it("lets only the owner cancel, and only before execution", async () => {
+    const t = setup();
+    const created = await scheduleAs(t, "alice", {
+      fromAccountId: t.accountId("QM-1000-0001"),
+      toAccount: "QM-1000-0002",
+      amount: "3.00",
+      scheduledDate: "2026-10-09",
+    });
+    const id = created.json().scheduledTransfer.id;
+    const bob = await t.login("bob");
+    assert.equal((await bob.delete(`/api/scheduled-transfers/${id}`)).status, 404);
+    const alice = await t.login("alice");
+    assert.equal((await alice.delete(`/api/scheduled-transfers/${id}`)).json().scheduledTransfer.status, "cancelled");
+    assert.equal((await alice.delete(`/api/scheduled-transfers/${id}`)).status, 409);
+  });
+});
+
+describe("scheduled transfer executor", () => {
+  it("executes due transfers once through the transfer service", async () => {
+    const t = setup();
+    const created = await scheduleAs(t, "alice", {
+      fromAccountId: t.accountId("QM-1000-0001"),
+      toAccount: "QM-1000-0005",
+      amount: "25.00",
+      scheduledDate: "2026-10-09",
+    });
+    const id = created.json().scheduledTransfer.id;
+    assert.equal((await runExecutor(t)).json().processed, 0);
+    t.clock.set("2026-10-09T13:00:00.000Z");
+    assert.deepEqual((await runExecutor(t)).json(), { processed: 1, completed: 1, failed: 0 });
+    assert.deepEqual((await runExecutor(t)).json(), { processed: 0, completed: 0, failed: 0 });
+    const alice = await t.login("alice");
+    const row = (await alice.get(`/api/scheduled-transfers/${id}`)).json().scheduledTransfer;
+    assert.equal(row.status, "completed");
+    const transfer = (await alice.get(`/api/transfers/${row.transferId}`)).json().transfer;
+    assert.equal(transfer.channel, "scheduled");
+    assert.equal(t.deps.repos.accounts.findByNumber("QM-1000-0005")?.balanceMinor, 36_500 + 2500);
+  });
+
+  it("marks transfers failed when funds are short at execution and notifies the owner", async () => {
+    const t = setup();
+    await scheduleAs(t, "bob", {
+      fromAccountId: t.accountId("QM-1000-0005"),
+      toAccount: "QM-1000-0001",
+      amount: "400.00",
+      scheduledDate: "2026-10-09",
+    });
+    t.clock.set("2026-10-09T08:00:00.000Z");
+    assert.deepEqual((await runExecutor(t)).json(), { processed: 1, completed: 0, failed: 1 });
+    const bob = await t.login("bob");
+    const [row] = (await bob.get("/api/scheduled-transfers")).json().items;
+    assert.equal(row.status, "failed");
+    assert.equal(row.failureReason, "INSUFFICIENT_FUNDS");
+    assert.equal((await bob.get("/api/notifications")).json().items[0].kind, "scheduled_transfer_failed");
+  });
+});
+
+describe("scheduled transfers page", () => {
+  it("creates and cancels through forms", async () => {
+    const t = setup();
+    const alice = await t.login("alice");
+    const created = await alice.form("/transfers/scheduled", {
+      fromAccountId: t.accountId("QM-1000-0001"),
+      toAccount: "QM-1000-0002",
+      amount: "8.00",
+      scheduledDate: "2026-10-20",
+      memo: "Weekly saving",
+      idempotencyKey: "web-test-key-1",
+    });
+    assert.equal(created.status, 303);
+    const page = await alice.page("/transfers/scheduled");
+    assert.match(page.body, /Weekly saving/);
+    const id = (await alice.get("/api/scheduled-transfers")).json().items[0].id;
+    assert.equal((await alice.form(`/transfers/scheduled/${id}/cancel`, {})).status, 303);
+    assert.equal((await alice.get(`/api/scheduled-transfers/${id}`)).json().scheduledTransfer.status, "cancelled");
+  });
+});
