+import type { Account } from "../../../packages/accounts/src/types.ts";
+import type { ScheduledTransfer } from "../../../packages/transfers/src/scheduled-types.ts";
+import { html } from "../html.ts";
+import { dateTime, money, statusBadge } from "./format.ts";
+import { layout } from "./layout.ts";
+import { type TransferFormValues, fieldError } from "./transfer-form.ts";
+
+export interface ScheduledTransfersModel {
+  user: { displayName: string; timezone: string; unreadNotifications: number };
+  accounts: Account[];
+  scheduled: ScheduledTransfer[];
+  values: TransferFormValues & { scheduledDate?: string };
+  errors: Record<string, string>;
+  idempotencyKey: string;
+}
+
+export function renderScheduledTransfersPage(model: ScheduledTransfersModel): string {
+  const { user, values, errors } = model;
+  const names = new Map(model.accounts.map((a) => [a.id, `${a.name} (${a.number})`]));
+  return layout(
+    {
+      title: "Scheduled transfers",
+      nav: "transfers",
+      user,
+      flash: errors["form"] ? { kind: "error", message: errors["form"] } : undefined,
+    },
+    html`<h1>Scheduled transfers</h1>
+    <section class="card">
+      ${model.scheduled.length === 0
+        ? html`<p class="empty">No scheduled transfers.</p>`
+        : html`<table class="scheduled-transfers">
+            <thead><tr><th>Date</th><th>From</th><th>To</th><th>Memo</th><th>Status</th><th class="num">Amount</th><th></th></tr></thead>
+            <tbody>
+              ${model.scheduled.map(
+                (s) => html`<tr data-scheduled-id="${s.id}">
+                  <td>${s.scheduledDate}<br><small>${dateTime(s.executeAt, user.timezone)}</small></td>
+                  <td>${names.get(s.fromAccountId) ?? s.fromAccountId}</td>
+                  <td>${names.get(s.toAccountId) ?? s.toAccountId}</td>
+                  <td>${s.memo}</td>
+                  <td>${statusBadge(s.status)}${s.failureReason ? html`<br><small>${s.failureReason}</small>` : ""}</td>
+                  <td class="num">${money(s.amountMinor, s.currency)}</td>
+                  <td>${s.status === "scheduled"
+                    ? html`<form method="post" action="/transfers/scheduled/${s.id}/cancel"><button type="submit">Cancel</button></form>`
+                    : ""}</td>
+                </tr>`,
+              )}
+            </tbody>
+          </table>`}
+    </section>
+    <section class="card narrow">
+      <h2>Schedule a transfer</h2>
+      <p class="muted">Scheduled transfers run at 09:00 (${user.timezone}) on the chosen date.</p>
+      <form method="post" action="/transfers/scheduled" class="stack">
+        <input type="hidden" name="idempotencyKey" value="${model.idempotencyKey}">
+        <label>From
+          <select name="fromAccountId" required>
+            ${model.accounts
+              .filter((a) => a.status === "active")
+              .map((a) => html`<option value="${a.id}"${a.id === values.fromAccountId ? html` selected` : ""}>${a.name} (${a.number})</option>`)}
+          </select>
+          ${fieldError(errors, "fromAccountId")}
+        </label>
+        <label>To account number <input name="toAccount" required value="${values.toAccount ?? ""}">${fieldError(errors, "toAccount")}</label>
+        <label>Amount <input name="amount" inputmode="decimal" required value="${values.amount ?? ""}">${fieldError(errors, "amount")}</label>
+        <label>Date <input type="date" name="scheduledDate" required value="${values.scheduledDate ?? ""}">${fieldError(errors, "scheduledDate")}</label>
+        <label>Memo <small>(optional)</small> <input name="memo" maxlength="140" value="${values.memo ?? ""}">${fieldError(errors, "memo")}</label>
+        <button type="submit" class="primary">Schedule transfer</button>
+      </form>
+    </section>`,
+  );
+}
