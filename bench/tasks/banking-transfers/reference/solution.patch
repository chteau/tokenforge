diff --git a/server/repositories/memory/scheduled-transfers.ts b/server/repositories/memory/scheduled-transfers.ts
new file mode 100644
index 0000000..0ae501c
--- /dev/null
+++ b/server/repositories/memory/scheduled-transfers.ts
@@ -0,0 +1,22 @@
+import type { ScheduledTransfer, ScheduledTransferRepository } from "../../../packages/transfers/src/scheduled-types.ts";
+import { type Persistable, createTable } from "./table.ts";
+
+const byExecution = (a: ScheduledTransfer, b: ScheduledTransfer): number =>
+  a.executeAt.localeCompare(b.executeAt) || a.createdAt.localeCompare(b.createdAt) || a.id.localeCompare(b.id);
+
+export function createMemoryScheduledTransferRepository(): ScheduledTransferRepository & Persistable {
+  const table = createTable<ScheduledTransfer>("scheduledTransfers", (s) => s.id);
+  return {
+    insert: (row) => table.insert(row),
+    update: (row) => table.update(row),
+    findById: (id) => table.get(id),
+    findByIdempotencyKey: (userId, key) => table.find((s) => s.userId === userId && s.idempotencyKey === key),
+    listByUser: (userId) => table.filter((s) => s.userId === userId).sort(byExecution),
+    listDue: (now) => {
+      const cutoff = now.toISOString();
+      return table.filter((s) => s.status === "scheduled" && s.executeAt <= cutoff).sort(byExecution);
+    },
+    snapshot: () => table.snapshot(),
+    restore: (rows) => table.restore(rows),
+  };
+}
