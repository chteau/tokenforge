+    scheduledDate: s.scheduledDate,
+    timezone: s.timezone,
+    executeAt: s.executeAt,
+    status: s.status,
+    transferId: s.transferId,
+    failureReason: s.failureReason,
+    createdAt: s.createdAt,
+  };
+}
