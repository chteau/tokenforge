@@ -0,0 +1,48 @@
+import { invalidTransition } from "../../shared/src/errors.ts";
+import type { Currency } from "../../shared/src/money.ts";
+
+export type ScheduledTransferStatus = "scheduled" | "completed" | "failed" | "cancelled";
+
+export interface ScheduledTransfer {
+  id: string;
+  userId: string;
+  fromAccountId: string;
+  toAccountId: string;
+  amountMinor: number;
+  currency: Currency;
+  memo: string;
+  /** Calendar date in `timezone` on which the transfer runs. */
+  scheduledDate: string;
+  timezone: string;
+  /** The instant of EXECUTION_TIME on scheduledDate in timezone (UTC ISO). */
+  executeAt: string;
+  status: ScheduledTransferStatus;
+  transferId: string | null;
+  failureReason: string | null;
+  idempotencyKey: string;
+  requestHash: string;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface ScheduledTransferRepository {
+  insert(row: ScheduledTransfer): ScheduledTransfer;
+  update(row: ScheduledTransfer): ScheduledTransfer;
+  findById(id: string): ScheduledTransfer | undefined;
+  findByIdempotencyKey(userId: string, key: string): ScheduledTransfer | undefined;
+  /** Sorted by executeAt, then createdAt. */
+  listByUser(userId: string): ScheduledTransfer[];
+  /** Status "scheduled" with executeAt <= now, sorted by executeAt, then createdAt. */
+  listDue(now: Date): ScheduledTransfer[];
+}
+
+const NEXT: Record<ScheduledTransferStatus, readonly ScheduledTransferStatus[]> = {
+  scheduled: ["completed", "failed", "cancelled"],
+  completed: [],
+  failed: [],
+  cancelled: [],
+};
+
+export function assertScheduledTransition(from: ScheduledTransferStatus, to: ScheduledTransferStatus): void {
+  if (!NEXT[from].includes(to)) throw invalidTransition("scheduled transfer", from, to);
+}
