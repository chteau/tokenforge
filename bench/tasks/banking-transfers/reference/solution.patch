diff --git a/packages/transfers/src/scheduled-service.ts b/packages/transfers/src/scheduled-service.ts
new file mode 100644
index 0000000..5b49a94
--- /dev/null
+++ b/packages/transfers/src/scheduled-service.ts
@@ -0,0 +1,158 @@
+import type { NotificationService } from "../../notifications/src/notification-service.ts";
+import type { Actor, UserRepository } from "../../auth/src/types.ts";
+import { toActor } from "../../auth/src/types.ts";
+import type { Clock } from "../../shared/src/clock.ts";
+import { addDays, compareIsoDates, localDateString, parseIsoDate, zonedDateTimeToInstant } from "../../shared/src/dates.ts";
+import { isDomainError, notFound, validationError } from "../../shared/src/errors.ts";
+import { DomainError } from "../../shared/src/errors.ts";
+import type { IdGenerator } from "../../shared/src/ids.ts";
+import { formatDecimal, formatMoney } from "../../shared/src/money.ts";
+import { type ScheduledTransfer, type ScheduledTransferRepository, assertScheduledTransition } from "./scheduled-types.ts";
+import { type TransferService, assertIdempotencyKey, fingerprint } from "./transfer-service.ts";
+import type { CreateTransferInput } from "./types.ts";
+
+/** Local wall-clock time at which scheduled transfers run. */
+export const EXECUTION_TIME = "09:00";
+export const MAX_SCHEDULE_AHEAD_DAYS = 365;
+
+export interface ScheduleTransferInput extends Omit<CreateTransferInput, "channel"> {
+  scheduledDate: string;
+}
+
+export interface RunSummary {
+  processed: number;
+  completed: number;
+  failed: number;
+}
+
+export interface ScheduledTransferService {
+  schedule(actor: Actor, input: ScheduleTransferInput): { scheduledTransfer: ScheduledTransfer; replayed: boolean };
+  list(actor: Actor): ScheduledTransfer[];
+  get(actor: Actor, id: string): ScheduledTransfer;
+  cancel(actor: Actor, id: string): ScheduledTransfer;
+  /** Execute every due scheduled transfer through the regular transfer service. */
+  runDue(): RunSummary;
+}
+
+export interface ScheduledTransferDeps {
+  scheduled: ScheduledTransferRepository;
+  transfers: TransferService;
+  users: UserRepository;
+  notifications: NotificationService;
+  clock: Clock;
+  ids: IdGenerator;
+}
+
+export function createScheduledTransferService(deps: ScheduledTransferDeps): ScheduledTransferService {
+  const { scheduled, transfers, users, notifications, clock, ids } = deps;
+
+  function owned(actor: Actor, id: string): ScheduledTransfer {
+    const row = scheduled.findById(id);
+    if (!row || row.userId !== actor.userId) throw notFound("Scheduled transfer");
+    return row;
+  }
+
+  function executeAtFor(scheduledDate: string, timezone: string, now: Date): Date {
+    if (!parseIsoDate(scheduledDate)) {
+      throw validationError([{ field: "scheduledDate", message: "must be a valid date (YYYY-MM-DD)" }]);
+    }
+    const executeAt = zonedDateTimeToInstant(scheduledDate, EXECUTION_TIME, timezone);
+    if (executeAt.getTime() <= now.getTime()) {
+      throw validationError([{ field: "scheduledDate", message: `must be in the future (transfers run at ${EXECUTION_TIME} local time)` }]);
+    }
+    const latest = addDays(localDateString(now, timezone), MAX_SCHEDULE_AHEAD_DAYS);
+    if (compareIsoDates(scheduledDate, latest) > 0) {
+      throw validationError([{ field: "scheduledDate", message: `must be at most ${MAX_SCHEDULE_AHEAD_DAYS} days ahead` }]);
+    }
+    return executeAt;
+  }
+
+  function finish(row: ScheduledTransfer, changes: Partial<ScheduledTransfer> & Pick<ScheduledTransfer, "status">): ScheduledTransfer {
+    assertScheduledTransition(row.status, changes.status);
+    return scheduled.update({ ...row, ...changes, updatedAt: clock.now().toISOString() });
+  }
+
+  return {
+    schedule(actor, input) {
+      assertIdempotencyKey(input.idempotencyKey);
+      const prepared = transfers.prepare(actor, input);
+      const requestHash = fingerprint({
+        from: prepared.from.id,
+        to: prepared.to.id,
+        amountMinor: prepared.amountMinor,
+        memo: prepared.memo,
+        scheduledDate: input.scheduledDate,
+      });
+      const existing = scheduled.findByIdempotencyKey(actor.userId, input.idempotencyKey);
+      if (existing) {
+        if (existing.requestHash !== requestHash) {
+          throw new DomainError("IDEMPOTENCY_CONFLICT", "Idempotency key was already used for a different scheduled transfer");
+        }
+        return { scheduledTransfer: existing, replayed: true };
+      }
+      const now = clock.now();
+      const executeAt = executeAtFor(input.scheduledDate, actor.timezone, now);
+      const row = scheduled.insert({
+        id: ids.next("sch"),
+        userId: actor.userId,
+        fromAccountId: prepared.from.id,
+        toAccountId: prepared.to.id,
+        amountMinor: prepared.amountMinor,
+        currency: prepared.from.currency,
+        memo: prepared.memo,
+        scheduledDate: input.scheduledDate,
+        timezone: actor.timezone,
+        executeAt: executeAt.toISOString(),
+        status: "scheduled",
+        transferId: null,
+        failureReason: null,
+        idempotencyKey: input.idempotencyKey,
+        requestHash,
+        createdAt: now.toISOString(),
+        updatedAt: now.toISOString(),
+      });
+      return { scheduledTransfer: row, replayed: false };
+    },
+
+    list(actor) {
+      return scheduled.listByUser(actor.userId);
+    },
+
+    get: owned,
+
+    cancel(actor, id) {
+      return finish(owned(actor, id), { status: "cancelled" });
+    },
+
+    runDue() {
+      const summary: RunSummary = { processed: 0, completed: 0, failed: 0 };
+      for (const row of scheduled.listDue(clock.now())) {
+        summary.processed += 1;
+        const user = users.findById(row.userId);
+        try {
+          if (!user) throw notFound("User");
+          const { transfer } = transfers.createTransfer(toActor(user), {
+            fromAccountId: row.fromAccountId,
+            toAccount: row.toAccountId,
+            amount: formatDecimal(row.amountMinor, row.currency),
+            memo: row.memo,
+            idempotencyKey: `scheduled:${row.id}`,
+            channel: "scheduled",
+          });
+          finish(row, { status: "completed", transferId: transfer.id });
+          summary.completed += 1;
+        } catch (error) {
+          if (!isDomainError(error)) throw error;
+          finish(row, { status: "failed", failureReason: error.code });
+          summary.failed += 1;
+          notifications.notify(row.userId, {
+            kind: "scheduled_transfer_failed",
+            title: "Scheduled transfer failed",
+            body: `Your scheduled transfer of ${formatMoney(row.amountMinor, row.currency)} on ${row.scheduledDate} could not be made: ${error.message}.`,
+          });
+        }
+      }
+      return summary;
+    },
+  };
+}
