--- /dev/null
+++ b/src/App.php
@@ -0,0 +1,57 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Boxoffice;
+
+use Boxoffice\Http\HttpError;
+use Boxoffice\Http\Request;
+use Boxoffice\Http\Response;
+use Boxoffice\Http\Router;
+use Throwable;
+
+/** Wires routes to handlers and turns every outcome into a JSON response. */
+final class App
+{
+    public function __construct(private readonly Repository $repo)
+    {
+    }
+
+    public static function create(string $dbPath): self
+    {
+        return new self(new Repository(Database::connect($dbPath)));
+    }
+
+    public function handle(Request $request): Response
+    {
+        try {
+            $clock = $request->header('X-Clock');
+            $now = $clock === null ? time() : Clock::parse($clock);
+            if ($now === null) {
+                throw new HttpError(400, 'invalid_clock', 'X-Clock must look like 2026-05-01T19:30:00Z.');
+            }
+            $router = $this->routes(new Api(new Ticketing($this->repo), new Idempotency($this->repo), $now));
+            return $this->repo->transaction(static fn (): Response => $router->dispatch($request));
+        } catch (HttpError $e) {
+            return $e->toResponse();
+        } catch (Throwable $e) {
+            error_log((string) $e);
+            return new Response(500, ['error' => ['code' => 'internal_error', 'message' => 'Internal server error.']]);
+        }
+    }
+
+    private function routes(Api $api): Router
+    {
+        $r = new Router();
+        $r->add('GET', '/events', $api->listEvents(...));
+        $r->add('POST', '/events', $api->createEvent(...));
+        $r->add('GET', '/events/{id}', $api->showEvent(...));
+        $r->add('POST', '/events/{id}/holds', $api->createHold(...));
+        $r->add('GET', '/holds/{id}', $api->showHold(...));
+        $r->add('DELETE', '/holds/{id}', $api->releaseHold(...));
+        $r->add('POST', '/purchases', $api->createPurchase(...));
+        $r->add('GET', '/purchases/{id}', $api->showPurchase(...));
+        $r->add('POST', '/purchases/{id}/refunds', $api->createRefund(...));
+        return $r;
+    }
+}
