@@ -0,0 +1,111 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Boxoffice;
+
+use PDO;
+
+/** Row-level data access; every query uses bound parameters. */
+final class Repository
+{
+    private const TABLES = ['events', 'holds', 'purchases', 'refunds', 'idempotency_keys'];
+
+    public function __construct(private readonly PDO $pdo)
+    {
+    }
+
+    /** @param array<string, int|string> $row */
+    public function insert(string $table, array $row): int
+    {
+        $cols = array_keys($row);
+        $sql = sprintf('INSERT INTO %s (%s) VALUES (%s)', self::table($table), implode(', ', $cols),
+            implode(', ', array_map(static fn ($c) => ':' . $c, $cols)));
+        $this->run($sql, $row);
+        return (int) $this->pdo->lastInsertId();
+    }
+
+    /** @return array<string, mixed>|null */
+    public function find(string $table, int $id): ?array
+    {
+        $row = $this->run(sprintf('SELECT * FROM %s WHERE id = :id', self::table($table)), ['id' => $id])->fetch();
+        return $row === false ? null : $row;
+    }
+
+    /** @return list<array<string, mixed>> */
+    public function events(?int $after): array
+    {
+        if ($after === null) {
+            return $this->run('SELECT * FROM events ORDER BY starts_at, id')->fetchAll();
+        }
+        return $this->run('SELECT * FROM events WHERE starts_at > :t ORDER BY starts_at, id', ['t' => $after])
+            ->fetchAll();
+    }
+
+    public function heldQuantity(int $eventId, int $now): int
+    {
+        return $this->scalar("SELECT COALESCE(SUM(quantity), 0) FROM holds
+            WHERE event_id = :e AND state = 'open' AND expires_at > :now", ['e' => $eventId, 'now' => $now]);
+    }
+
+    public function soldQuantity(int $eventId): int
+    {
+        return $this->scalar('SELECT COALESCE(SUM(quantity), 0) FROM purchases WHERE event_id = :e', ['e' => $eventId])
+            - $this->scalar('SELECT COALESCE(SUM(r.quantity), 0) FROM refunds r
+                JOIN purchases p ON p.id = r.purchase_id WHERE p.event_id = :e', ['e' => $eventId]);
+    }
+
+    public function setHoldState(int $holdId, string $state): void
+    {
+        $this->run('UPDATE holds SET state = :s WHERE id = :id', ['s' => $state, 'id' => $holdId]);
+    }
+
+    /** @return list<array<string, mixed>> */
+    public function refunds(int $purchaseId): array
+    {
+        return $this->run('SELECT * FROM refunds WHERE purchase_id = :p ORDER BY id', ['p' => $purchaseId])
+            ->fetchAll();
+    }
+
+    /** @return array<string, mixed>|null */
+    public function idempotencyRecord(string $key): ?array
+    {
+        $row = $this->run('SELECT * FROM idempotency_keys WHERE idem_key = :k', ['k' => $key])->fetch();
+        return $row === false ? null : $row;
+    }
+
+    public function transaction(callable $fn): mixed
+    {
+        $this->pdo->exec('BEGIN IMMEDIATE');
+        try {
+            $result = $fn();
+            $this->pdo->exec('COMMIT');
+            return $result;
+        } catch (\Throwable $e) {
+            $this->pdo->exec('ROLLBACK');
+            throw $e;
+        }
+    }
+
+    private static function table(string $table): string
+    {
+        if (!in_array($table, self::TABLES, true)) {
+            throw new \InvalidArgumentException("unknown table $table");
+        }
+        return $table;
+    }
+
+    /** @param array<string, mixed> $params */
+    private function scalar(string $sql, array $params): int
+    {
+        return (int) $this->run($sql, $params)->fetchColumn();
+    }
+
+    /** @param array<string, mixed> $params */
+    private function run(string $sql, array $params = []): \PDOStatement
+    {
+        $stmt = $this->pdo->prepare($sql);
+        $stmt->execute($params);
+        return $stmt;
+    }
+}
diff --git a/src/Ticketing.php b/src/Ticketing.php
new file mode 100644
index 0000000..aa8d9ca
--- /dev/null
+++ b/src/Ticketing.php
@@ -0,0 +1,178 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Boxoffice;
+
+use Boxoffice\Http\HttpError;
+
+/** Ticketing rules: availability, holds, purchases and refunds. Returns API-shaped arrays. */
+final class Ticketing
+{
+    public function __construct(private readonly Repository $repo)
+    {
+    }
+
+    /** @param array{name: string, venue: string, starts_at: int, capacity: int, price_cents: int} $data */
+    public function createEvent(array $data, int $now): array
+    {
+        return $this->event($this->repo->insert('events', $data), $now);
+    }
+
+    /** @return list<array<string, mixed>> */
+    public function listEvents(int $now, bool $upcomingOnly): array
+    {
+        return array_map(fn (array $row) => $this->presentEvent($row, $now),
+            $this->repo->events($upcomingOnly ? $now : null));
+    }
+
+    public function event(int $id, int $now): array
+    {
+        return $this->presentEvent($this->eventRow($id), $now);
+    }
+
+    public function createHold(int $eventId, int $quantity, int $ttl, int $now): array
+    {
+        $event = $this->event($eventId, $now);
+        if ($now >= Clock::parse($event['starts_at'])) {
+            throw new HttpError(409, 'event_closed', 'The event has already started.');
+        }
+        if ($quantity > $event['available']) {
+            throw new HttpError(409, 'insufficient_seats', "Only {$event['available']} seats are available.");
+        }
+        $id = $this->repo->insert('holds', ['event_id' => $eventId, 'quantity' => $quantity,
+            'expires_at' => $now + $ttl, 'created_at' => $now]);
+        return $this->hold($id, $now);
+    }
+
+    public function hold(int $id, int $now): array
+    {
+        return $this->presentHold($this->holdRow($id), $now);
+    }
+
+    public function releaseHold(int $id, int $now): array
+    {
+        $hold = $this->hold($id, $now);
+        if ($hold['status'] !== 'active') {
+            throw new HttpError(409, 'hold_not_active', "The hold is {$hold['status']}.");
+        }
+        $this->repo->setHoldState($id, 'released');
+        return $this->hold($id, $now);
+    }
+
+    public function purchase(int $holdId, string $email, int $now): array
+    {
+        $hold = $this->hold($holdId, $now);
+        if ($hold['status'] === 'expired') {
+            throw new HttpError(409, 'hold_expired', 'The hold has expired.');
+        }
+        if ($hold['status'] !== 'active') {
+            throw new HttpError(409, 'hold_not_active', "The hold is {$hold['status']}.");
+        }
+        $event = $this->eventRow($hold['event_id']);
+        $this->repo->setHoldState($holdId, 'purchased');
+        $id = $this->repo->insert('purchases', ['event_id' => $hold['event_id'], 'hold_id' => $holdId,
+            'email' => $email, 'quantity' => $hold['quantity'],
+            'amount_cents' => $hold['quantity'] * $event['price_cents'], 'created_at' => $now]);
+        return $this->purchaseById($id);
+    }
+
+    public function purchaseById(int $id): array
+    {
+        $row = $this->repo->find('purchases', $id)
+            ?? throw new HttpError(404, 'purchase_not_found', 'No such purchase.');
+        $refunds = array_map(fn (array $r) => $this->presentRefund($r), $this->repo->refunds($id));
+        $refundedQty = array_sum(array_column($refunds, 'quantity'));
+        return [
+            'id' => $row['id'],
+            'event_id' => $row['event_id'],
+            'hold_id' => $row['hold_id'],
+            'email' => $row['email'],
+            'quantity' => $row['quantity'],
+            'amount_cents' => $row['amount_cents'],
+            'refunded_quantity' => $refundedQty,
+            'refunded_cents' => array_sum(array_column($refunds, 'amount_cents')),
+            'status' => match (true) {
+                $refundedQty === 0 => 'paid',
+                $refundedQty < $row['quantity'] => 'partially_refunded',
+                default => 'refunded',
+            },
+            'created_at' => Clock::format($row['created_at']),
+            'refunds' => $refunds,
+        ];
+    }
+
+    public function refund(int $purchaseId, ?int $quantity, int $now): array
+    {
+        $purchase = $this->purchaseById($purchaseId);
+        if ($now >= $this->eventRow($purchase['event_id'])['starts_at']) {
+            throw new HttpError(409, 'event_closed', 'Refunds close when the event starts.');
+        }
+        $remaining = $purchase['quantity'] - $purchase['refunded_quantity'];
+        if ($remaining === 0) {
+            throw new HttpError(409, 'already_refunded', 'Every ticket has already been refunded.');
+        }
+        $quantity ??= $remaining;
+        if ($quantity > $remaining) {
+            throw new HttpError(409, 'refund_exceeds_purchase', "Only $remaining tickets can be refunded.");
+        }
+        $unit = intdiv($purchase['amount_cents'], $purchase['quantity']);
+        $id = $this->repo->insert('refunds', ['purchase_id' => $purchaseId, 'quantity' => $quantity,
+            'amount_cents' => $quantity * $unit, 'created_at' => $now]);
+        return $this->presentRefund($this->repo->find('refunds', $id));
+    }
+
+    private function eventRow(int $id): array
+    {
+        return $this->repo->find('events', $id) ?? throw new HttpError(404, 'event_not_found', 'No such event.');
+    }
+
+    private function holdRow(int $id): array
+    {
+        return $this->repo->find('holds', $id) ?? throw new HttpError(404, 'hold_not_found', 'No such hold.');
+    }
+
+    private function presentEvent(array $row, int $now): array
+    {
+        $held = $this->repo->heldQuantity($row['id'], $now);
+        $sold = $this->repo->soldQuantity($row['id']);
+        return [
+            'id' => $row['id'],
+            'name' => $row['name'],
+            'venue' => $row['venue'],
+            'starts_at' => Clock::format($row['starts_at']),
+            'capacity' => $row['capacity'],
+            'price_cents' => $row['price_cents'],
+            'available' => $row['capacity'] - $held - $sold,
+            'held' => $held,
+            'sold' => $sold,
+        ];
+    }
+
+    private function presentHold(array $row, int $now): array
+    {
+        $status = match ($row['state']) {
+            'open' => $now < $row['expires_at'] ? 'active' : 'expired',
+            default => $row['state'],
+        };
+        return [
+            'id' => $row['id'],
+            'event_id' => $row['event_id'],
+            'quantity' => $row['quantity'],
+            'status' => $status,
+            'expires_at' => Clock::format($row['expires_at']),
+            'created_at' => Clock::format($row['created_at']),
+        ];
+    }
+
+    private function presentRefund(array $row): array
+    {
+        return [
+            'id' => $row['id'],
+            'purchase_id' => $row['purchase_id'],
+            'quantity' => $row['quantity'],
+            'amount_cents' => $row['amount_cents'],
+            'created_at' => Clock::format($row['created_at']),
+        ];
+    }
+}
diff --git a/src/Validator.php b/src/Validator.php
new file mode 100644
index 0000000..c7c13d4
--- /dev/null
+++ b/src/Validator.php
@@ -0,0 +1,84 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Boxoffice;
+
+use Boxoffice\Http\HttpError;
+
+/** Collects field errors for one request body and reports them all at once. */
+final class Validator
+{
+    /** @var array<string, string> */
+    private array $errors = [];
+
+    /** @param array<string, mixed> $data */
+    public function __construct(private readonly array $data)
+    {
+    }
+
+    public function string(string $field, int $max): ?string
+    {
+        $value = $this->data[$field] ?? null;
+        if (!is_string($value)) {
+            return $this->fail($field, $value === null ? 'is required' : 'must be a string');
+        }
+        $value = trim($value);
+        $len = mb_strlen($value, 'UTF-8');
+        if ($len < 1 || $len > $max) {
+            return $this->fail($field, "must be 1 to $max characters");
+        }
+        return $value;
+    }
+
+    public function int(string $field, int $min, int $max, ?int $default = null): ?int
+    {
+        if (!array_key_exists($field, $this->data) && $default !== null) {
+            return $default;
+        }
+        $value = $this->data[$field] ?? null;
+        if (!is_int($value)) {
+            return $this->fail($field, $value === null ? 'is required' : 'must be an integer');
+        }
+        if ($value < $min || $value > $max) {
+            return $this->fail($field, "must be between $min and $max");
+        }
+        return $value;
+    }
+
+    public function optionalInt(string $field, int $min, int $max): ?int
+    {
+        return array_key_exists($field, $this->data) ? $this->int($field, $min, $max) : null;
+    }
+
+    public function timestamp(string $field): ?int
+    {
+        $value = $this->data[$field] ?? null;
+        $ts = is_string($value) ? Clock::parse($value) : null;
+        return $ts ?? $this->fail($field, 'must be a timestamp like 2026-05-01T19:30:00Z');
+    }
+
+    public function email(string $field): ?string
+    {
+        $value = $this->data[$field] ?? null;
+        $parts = is_string($value) ? explode('@', $value) : [];
+        $valid = count($parts) === 2 && strlen($value) <= 254
+            && preg_match('/^\S+$/', $parts[0]) && preg_match('/^\S+$/', $parts[1])
+            && str_contains(substr($parts[1], 1, -1), '.');
+        return $valid ? $value : $this->fail($field, 'must be a valid email address');
+    }
+
+    /** Throws a 422 if any field failed. */
+    public function check(): void
+    {
+        if ($this->errors !== []) {
+            throw HttpError::validation($this->errors);
+        }
+    }
+
+    private function fail(string $field, string $message): null
+    {
+        $this->errors[$field] = $message;
+        return null;
+    }
+}
diff --git a/src/autoload.php b/src/autoload.php
new file mode 100644
