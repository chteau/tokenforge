@@ -0,0 +1,44 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Boxoffice\Http;
+
+/** Maps "METHOD /path/{id}" routes onto handlers; {id} matches a positive integer. */
+final class Router
+{
+    /** @var array<string, array<string, callable>> pattern => method => handler */
+    private array $routes = [];
+
+    public function add(string $method, string $pattern, callable $handler): void
+    {
+        $this->routes[$pattern][$method] = $handler;
+    }
+
+    public function dispatch(Request $request): Response
+    {
+        foreach ($this->routes as $pattern => $handlers) {
+            $params = $this->match($pattern, $request->path);
+            if ($params === null) {
+                continue;
+            }
+            $handler = $handlers[$request->method] ?? null;
+            if ($handler === null) {
+                throw new HttpError(405, 'method_not_allowed', 'Method not allowed.', [],
+                    ['Allow' => implode(', ', array_keys($handlers))]);
+            }
+            return $handler($request, ...$params);
+        }
+        throw new HttpError(404, 'not_found', 'No such resource.');
+    }
+
+    /** @return list<int>|null */
+    private function match(string $pattern, string $path): ?array
+    {
+        $regex = '#^' . str_replace('\{id\}', '([1-9][0-9]{0,17})', preg_quote($pattern, '#')) . '$#';
+        if (!preg_match($regex, $path, $m)) {
+            return null;
+        }
+        return array_map('intval', array_slice($m, 1));
+    }
+}
