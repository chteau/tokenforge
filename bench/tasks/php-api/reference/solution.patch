--- /dev/null
+++ b/src/autoload.php
@@ -0,0 +1,14 @@
+<?php
+
+declare(strict_types=1);
+
+spl_autoload_register(static function (string $class): void {
+    $prefix = 'Boxoffice\\';
+    if (!str_starts_with($class, $prefix)) {
+        return;
+    }
+    $file = __DIR__ . '/' . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
+    if (is_file($file)) {
+        require $file;
+    }
+});
diff --git a/tests/ApiTest.php b/tests/ApiTest.php
new file mode 100644
index 0000000..8da12ff
--- /dev/null
+++ b/tests/ApiTest.php
@@ -0,0 +1,64 @@
+<?php
+
+declare(strict_types=1);
+
+return [
+    'event validation reports every field' => function (): void {
+        $r = call(fresh_app(), 'POST', '/events', ['name' => '  ', 'capacity' => '5']);
+        assert_same(422, $r->status);
+        assert_same(['name', 'venue', 'starts_at', 'capacity', 'price_cents'],
+            array_keys($r->body['error']['fields']));
+    },
+    'hold reduces availability and expires' => function (): void {
+        $app = fresh_app();
+        $event = make_event($app, 4);
+        $hold = call($app, 'POST', "/events/{$event['id']}/holds", ['quantity' => 3, 'ttl_seconds' => 60]);
+        assert_same(201, $hold->status);
+        assert_same(1, call($app, 'GET', "/events/{$event['id']}")->body['available']);
+        $later = ['X-Clock' => '2026-05-01T10:01:00Z'];
+        assert_same('expired', call($app, 'GET', '/holds/1', null, $later)->body['status']);
+        assert_same(4, call($app, 'GET', "/events/{$event['id']}", null, $later)->body['available']);
+    },
+    'insufficient seats' => function (): void {
+        $app = fresh_app();
+        make_event($app, 2);
+        $r = call($app, 'POST', '/events/1/holds', ['quantity' => 3]);
+        assert_same('insufficient_seats', $r->body['error']['code']);
+    },
+    'purchase then partial refund' => function (): void {
+        $app = fresh_app();
+        make_event($app, 10, 1500);
+        call($app, 'POST', '/events/1/holds', ['quantity' => 4]);
+        $p = call($app, 'POST', '/purchases', ['hold_id' => 1, 'email' => 'fan@example.com']);
+        assert_same(201, $p->status);
+        assert_same(6000, $p->body['amount_cents']);
+        $r = call($app, 'POST', '/purchases/1/refunds', ['quantity' => 1]);
+        assert_same(1500, $r->body['amount_cents']);
+        $p = call($app, 'GET', '/purchases/1');
+        assert_same('partially_refunded', $p->body['status']);
+        assert_same(7, call($app, 'GET', '/events/1')->body['available']);
+        call($app, 'POST', '/purchases/1/refunds');
+        assert_same('already_refunded', call($app, 'POST', '/purchases/1/refunds')->body['error']['code']);
+    },
+    'idempotent purchase is replayed' => function (): void {
+        $app = fresh_app();
+        make_event($app);
+        call($app, 'POST', '/events/1/holds', ['quantity' => 1]);
+        $h = ['Idempotency-Key' => 'k-1'];
+        $a = call($app, 'POST', '/purchases', ['hold_id' => 1, 'email' => 'a@b.co'], $h);
+        $b = call($app, 'POST', '/purchases', ['email' => 'a@b.co', 'hold_id' => 1], $h);
+        assert_same($a->body, $b->body);
+        assert_same('true', $b->headers['Idempotent-Replayed'] ?? null);
+        $c = call($app, 'POST', '/purchases', ['hold_id' => 2, 'email' => 'a@b.co'], $h);
+        assert_same('idempotency_key_reused', $c->body['error']['code']);
+    },
+    'routing errors' => function (): void {
+        $app = fresh_app();
+        assert_same(404, call($app, 'GET', '/nope')->status);
+        assert_same(404, call($app, 'GET', '/events/0')->status);
+        $r = call($app, 'DELETE', '/events');
+        assert_same(405, $r->status);
+        assert_same('GET, POST', $r->headers['Allow']);
+        assert_same(400, call($app, 'GET', '/events', null, ['X-Clock' => 'tomorrow'])->status);
+    },
+];
