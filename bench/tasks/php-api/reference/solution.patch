new file mode 100644
index 0000000..2859f1c
--- /dev/null
+++ b/tests/helpers.php
@@ -0,0 +1,38 @@
+<?php
+
+declare(strict_types=1);
+
+use Boxoffice\App;
+use Boxoffice\Http\Request;
+use Boxoffice\Http\Response;
+
+/** An App backed by a fresh temporary database. */
+function fresh_app(): App
+{
+    $path = tempnam(sys_get_temp_dir(), 'boxoffice-test-');
+    register_shutdown_function(static fn () => @unlink($path));
+    return App::create($path);
+}
+
+function call(App $app, string $method, string $path, ?array $body = null, array $headers = []): Response
+{
+    $headers += ['X-Clock' => '2026-05-01T10:00:00Z'];
+    $raw = $body === null ? '' : json_encode($body);
+    return $app->handle(new Request($method, $path, $headers, [], $raw));
+}
+
+function assert_same(mixed $expected, mixed $actual, string $what = ''): void
+{
+    if ($expected !== $actual) {
+        throw new RuntimeException(sprintf('%s expected %s, got %s', $what,
+            var_export($expected, true), var_export($actual, true)));
+    }
+}
+
+function make_event(App $app, int $capacity = 10, int $price = 1000): array
+{
+    $r = call($app, 'POST', '/events', ['name' => 'Show', 'venue' => 'Hall',
+        'starts_at' => '2026-06-01T20:00:00Z', 'capacity' => $capacity, 'price_cents' => $price]);
+    assert_same(201, $r->status, 'create event');
+    return $r->body;
+}
diff --git a/tests/run.php b/tests/run.php
new file mode 100644
index 0000000..9d5dde9
--- /dev/null
+++ b/tests/run.php
@@ -0,0 +1,24 @@
+<?php
+
+declare(strict_types=1);
+
+// Minimal test runner: every *Test.php file returns an array of name => closure.
+require __DIR__ . '/../src/autoload.php';
+require __DIR__ . '/helpers.php';
+
+$failures = 0;
+$count = 0;
+foreach (glob(__DIR__ . '/*Test.php') as $file) {
+    foreach (require $file as $name => $test) {
+        $count++;
+        try {
+            $test();
+            echo "ok   $name\n";
+        } catch (Throwable $e) {
+            $failures++;
+            echo "FAIL $name: {$e->getMessage()}\n";
+        }
+    }
+}
+echo "\n$count tests, $failures failures\n";
+exit($failures === 0 ? 0 : 1);
