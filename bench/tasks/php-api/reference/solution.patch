@@ -0,0 +1,91 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Boxoffice;
+
+use Boxoffice\Http\Request;
+use Boxoffice\Http\Response;
+
+/** Endpoint handlers: validate input, call the ticketing rules, shape the response. */
+final class Api
+{
+    public function __construct(
+        private readonly Ticketing $tickets,
+        private readonly Idempotency $idempotency,
+        private readonly int $now,
+    ) {
+    }
+
+    public function createEvent(Request $request): Response
+    {
+        return $this->idempotency->run($request, function () use ($request): Response {
+            $v = new Validator($request->json());
+            $data = [
+                'name' => $v->string('name', 200),
+                'venue' => $v->string('venue', 200),
+                'starts_at' => $v->timestamp('starts_at'),
+                'capacity' => $v->int('capacity', 1, 100000),
+                'price_cents' => $v->int('price_cents', 0, 1000000),
+            ];
+            $v->check();
+            return new Response(201, $this->tickets->createEvent($data, $this->now));
+        });
+    }
+
+    public function listEvents(Request $request): Response
+    {
+        $upcoming = ($request->query['upcoming'] ?? '') === '1';
+        return new Response(200, ['events' => $this->tickets->listEvents($this->now, $upcoming)]);
+    }
+
+    public function showEvent(Request $request, int $id): Response
+    {
+        return new Response(200, $this->tickets->event($id, $this->now));
+    }
+
+    public function createHold(Request $request, int $eventId): Response
+    {
+        $v = new Validator($request->json());
+        $quantity = $v->int('quantity', 1, 10);
+        $ttl = $v->int('ttl_seconds', 60, 3600, 600);
+        $v->check();
+        return new Response(201, $this->tickets->createHold($eventId, $quantity, $ttl, $this->now));
+    }
+
+    public function showHold(Request $request, int $id): Response
+    {
+        return new Response(200, $this->tickets->hold($id, $this->now));
+    }
+
+    public function releaseHold(Request $request, int $id): Response
+    {
+        return new Response(200, $this->tickets->releaseHold($id, $this->now));
+    }
+
+    public function createPurchase(Request $request): Response
+    {
+        return $this->idempotency->run($request, function () use ($request): Response {
+            $v = new Validator($request->json());
+            $holdId = $v->int('hold_id', 1, PHP_INT_MAX);
+            $email = $v->email('email');
+            $v->check();
+            return new Response(201, $this->tickets->purchase($holdId, $email, $this->now));
+        });
+    }
+
+    public function showPurchase(Request $request, int $id): Response
+    {
+        return new Response(200, $this->tickets->purchaseById($id));
+    }
+
+    public function createRefund(Request $request, int $purchaseId): Response
+    {
+        return $this->idempotency->run($request, function () use ($request, $purchaseId): Response {
+            $v = new Validator($request->json(allowEmpty: true));
+            $quantity = $v->optionalInt('quantity', 1, PHP_INT_MAX);
+            $v->check();
+            return new Response(201, $this->tickets->refund($purchaseId, $quantity, $this->now));
+        });
+    }
+}
diff --git a/src/App.php b/src/App.php
