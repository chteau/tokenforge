index 0000000..b1f6526
--- /dev/null
+++ b/src/Idempotency.php
@@ -0,0 +1,72 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Boxoffice;
+
+use Boxoffice\Http\HttpError;
+use Boxoffice\Http\Request;
+use Boxoffice\Http\Response;
+
+/** Stores the first response for an Idempotency-Key and replays it for identical retries. */
+final class Idempotency
+{
+    public function __construct(private readonly Repository $repo)
+    {
+    }
+
+    /** @param callable(): Response $handler */
+    public function run(Request $request, callable $handler): Response
+    {
+        $key = $request->header('Idempotency-Key');
+        if ($key === null) {
+            return $handler();
+        }
+        if (!preg_match('/^[\x21-\x7E]{1,255}$/', $key)) {
+            throw new HttpError(400, 'invalid_idempotency_key', 'Idempotency-Key must be 1-255 printable ASCII characters.');
+        }
+        $fingerprint = self::fingerprint($request->body);
+        $stored = $this->repo->idempotencyRecord($key);
+        if ($stored !== null) {
+            if ($stored['method'] !== $request->method || $stored['path'] !== $request->path
+                || $stored['fingerprint'] !== $fingerprint) {
+                throw new HttpError(422, 'idempotency_key_reused',
+                    'This Idempotency-Key was already used for a different request.');
+            }
+            return (new Response((int) $stored['status'], json_decode($stored['response'], true)))
+                ->withHeader('Idempotent-Replayed', 'true');
+        }
+        try {
+            $response = $handler();
+        } catch (HttpError $e) {
+            $response = $e->toResponse();
+        }
+        if ($response->status < 500) {
+            $this->repo->insert('idempotency_keys', ['idem_key' => $key, 'method' => $request->method,
+                'path' => $request->path, 'fingerprint' => $fingerprint, 'status' => $response->status,
+                'response' => json_encode($response->body, JSON_PRESERVE_ZERO_FRACTION)]);
+        }
+        return $response;
+    }
+
+    /** Canonical form of the body: decoded JSON with object keys sorted, or the raw text. */
+    private static function fingerprint(string $body): string
+    {
+        $data = json_decode($body, true);
+        if ($data === null && trim($body) !== 'null') {
+            return hash('sha256', 'raw:' . $body);
+        }
+        return hash('sha256', 'json:' . json_encode(self::canonical($data)));
+    }
+
+    private static function canonical(mixed $value): mixed
+    {
+        if (!is_array($value)) {
+            return $value;
+        }
+        if (!array_is_list($value)) {
+            ksort($value, SORT_STRING);
+        }
+        return array_map(self::canonical(...), $value);
+    }
+}
