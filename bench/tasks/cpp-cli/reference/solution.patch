diff --git a/src/storage.cpp b/src/storage.cpp
new file mode 100644
index 0000000..30f40ba
--- /dev/null
+++ b/src/storage.cpp
@@ -0,0 +1,142 @@
+#include "storage.h"
+
+#include <cerrno>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <system_error>
+#include <utility>
+
+#include <fcntl.h>
+#include <unistd.h>
+
+namespace kvdb {
+namespace {
+
+namespace fs = std::filesystem;
+
+std::string errno_message(const std::string& what, const fs::path& path) {
+    return what + " " + path.string() + ": " + std::strerror(errno);
+}
+
+// RAII wrapper around a POSIX file descriptor.
+class FileHandle {
+public:
+    FileHandle(const fs::path& path, int flags) : path_(path) {
+        fd_ = ::open(path.c_str(), flags | O_CLOEXEC, 0644);
+        if (fd_ < 0) throw StorageError(errno_message("cannot open", path));
+    }
+    ~FileHandle() {
+        if (fd_ >= 0) ::close(fd_);
+    }
+    FileHandle(const FileHandle&) = delete;
+    FileHandle& operator=(const FileHandle&) = delete;
+
+    void write_all(const std::string& data) {
+        const char* p = data.data();
+        std::size_t left = data.size();
+        while (left > 0) {
+            const ssize_t n = ::write(fd_, p, left);
+            if (n < 0) {
+                if (errno == EINTR) continue;
+                throw StorageError(errno_message("cannot write", path_));
+            }
+            p += n;
+            left -= static_cast<std::size_t>(n);
+        }
+    }
+
+    void truncate(std::uint64_t size) {
+        if (::ftruncate(fd_, static_cast<off_t>(size)) != 0)
+            throw StorageError(errno_message("cannot truncate", path_));
+    }
+
+    void sync() {
+        if (::fsync(fd_) != 0) throw StorageError(errno_message("cannot sync", path_));
+    }
+
+private:
+    fs::path path_;
+    int fd_ = -1;
+};
+
+void sync_directory(const fs::path& dir) {
+    FileHandle d(dir, O_RDONLY | O_DIRECTORY);
+    d.sync();
+}
+
+}  // namespace
+
+LogFile::LogFile(fs::path dir) : dir_(std::move(dir)), path_(dir_ / "data.log") {
+    std::error_code ec;
+    if (fs::exists(dir_, ec)) {
+        if (!fs::is_directory(dir_, ec))
+            throw StorageError("not a directory: " + dir_.string());
+        return;
+    }
+    fs::create_directories(dir_, ec);
+    if (ec) throw StorageError("cannot create " + dir_.string() + ": " + ec.message());
+}
+
+std::vector<Record> LogFile::load() {
+    std::error_code ec;
+    if (!fs::exists(path_, ec)) {
+        valid_bytes_ = file_size_ = 0;
+        return {};
+    }
+    std::ifstream in(path_, std::ios::binary);
+    if (!in) throw StorageError("cannot read " + path_.string());
+    std::string buf((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    if (in.bad()) throw StorageError("cannot read " + path_.string());
+    DecodeResult decoded = decode_records(buf);
+    valid_bytes_ = decoded.valid_bytes;
+    file_size_ = buf.size();
+    return std::move(decoded.records);
+}
+
+void LogFile::discard_tail() {
+    if (file_size_ == valid_bytes_) return;
+    FileHandle f(path_, O_WRONLY);
+    f.truncate(valid_bytes_);
+    f.sync();
+    file_size_ = valid_bytes_;
+}
+
+void LogFile::append(const Record& record) {
+    discard_tail();
+    const std::string bytes = encode_record(record);
+    const bool created = file_size_ == 0 && !fs::exists(path_);
+    {
+        FileHandle f(path_, O_WRONLY | O_CREAT | O_APPEND);
+        f.write_all(bytes);
+        f.sync();
+    }
+    if (created) sync_directory(dir_);
+    valid_bytes_ += bytes.size();
+    file_size_ = valid_bytes_;
+}
+
+void LogFile::rewrite(const std::vector<Record>& records) {
+    std::string bytes;
+    for (const Record& r : records) bytes += encode_record(r);
+    const fs::path tmp = dir_ / "data.log.compact";
+    try {
+        FileHandle f(tmp, O_WRONLY | O_CREAT | O_TRUNC);
+        f.write_all(bytes);
+        f.sync();
+    } catch (...) {
+        std::error_code ec;
+        fs::remove(tmp, ec);
+        throw;
+    }
+    std::error_code ec;
+    fs::rename(tmp, path_, ec);
+    if (ec) {
+        fs::remove(tmp, ec);
+        throw StorageError("cannot replace " + path_.string() + ": " + ec.message());
+    }
+    sync_directory(dir_);
+    valid_bytes_ = file_size_ = bytes.size();
+}
+
+}  // namespace kvdb
diff --git a/src/storage.h b/src/storage.h
new file mode 100644
