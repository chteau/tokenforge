@@ -0,0 +1,43 @@
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "codec.h"
+
+namespace kvdb {
+
+class StorageError : public std::runtime_error {
+public:
+    using std::runtime_error::runtime_error;
+};
+
+// Owns <dir>/data.log. All file-system writes of the database happen here.
+class LogFile {
+public:
+    explicit LogFile(std::filesystem::path dir);
+
+    // Reads every valid record; remembers where the valid part of the file ends.
+    std::vector<Record> load();
+
+    // Appends one record durably, discarding any ignored tail first.
+    void append(const Record& record);
+
+    // Atomically replaces the log with exactly these records.
+    void rewrite(const std::vector<Record>& records);
+
+    std::uint64_t valid_bytes() const { return valid_bytes_; }
+
+private:
+    void discard_tail();
+
+    std::filesystem::path dir_;
+    std::filesystem::path path_;
+    std::uint64_t valid_bytes_ = 0;
+    std::uint64_t file_size_ = 0;
+};
+
+}  // namespace kvdb
diff --git a/src/store.cpp b/src/store.cpp
new file mode 100644
index 0000000..a9be6e8
--- /dev/null
+++ b/src/store.cpp
@@ -0,0 +1,60 @@
+#include "store.h"
+
+namespace kvdb {
+
+Store::Store(const std::filesystem::path& dir) : log_(dir) {
+    for (Record& r : log_.load()) {
+        if (r.type == RecordType::Put)
+            index_[r.key] = std::move(r.value);
+        else
+            index_.erase(r.key);
+        ++records_;
+    }
+}
+
+std::optional<std::string> Store::get(const std::string& key) const {
+    auto it = index_.find(key);
+    if (it == index_.end()) return std::nullopt;
+    return it->second;
+}
+
+void Store::set(const std::string& key, const std::string& value) {
+    log_.append(Record{RecordType::Put, key, value});
+    index_[key] = value;
+    ++records_;
+}
+
+bool Store::del(const std::string& key) {
+    auto it = index_.find(key);
+    if (it == index_.end()) return false;
+    log_.append(Record{RecordType::Delete, key, ""});
+    index_.erase(it);
+    ++records_;
+    return true;
+}
+
+std::vector<std::pair<std::string, std::string>> Store::scan(const std::string& prefix,
+                                                             std::size_t limit) const {
+    std::vector<std::pair<std::string, std::string>> out;
+    for (auto it = index_.lower_bound(prefix); it != index_.end() && out.size() < limit; ++it) {
+        if (it->first.compare(0, prefix.size(), prefix) != 0) break;
+        out.emplace_back(it->first, it->second);
+    }
+    return out;
+}
+
+Stats Store::stats() const { return Stats{index_.size(), records_, log_.valid_bytes()}; }
+
+CompactResult Store::compact() {
+    CompactResult result;
+    result.before = log_.valid_bytes();
+    std::vector<Record> live;
+    live.reserve(index_.size());
+    for (const auto& [key, value] : index_) live.push_back(Record{RecordType::Put, key, value});
+    log_.rewrite(live);
+    records_ = live.size();
+    result.after = log_.valid_bytes();
+    return result;
+}
+
+}  // namespace kvdb
diff --git a/src/store.h b/src/store.h
new file mode 100644
index 0000000..1e79f69
--- /dev/null
+++ b/src/store.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <map>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "storage.h"
+
+namespace kvdb {
+
+struct Stats {
+    std::size_t keys = 0;
+    std::size_t records = 0;
+    std::uint64_t log_bytes = 0;
+};
+
+struct CompactResult {
+    std::uint64_t before = 0;
+    std::uint64_t after = 0;
+};
+
+// In-memory index of the live keys, rebuilt from the log on open.
+class Store {
+public:
+    explicit Store(const std::filesystem::path& dir);
+
+    std::optional<std::string> get(const std::string& key) const;
+    void set(const std::string& key, const std::string& value);
+    bool del(const std::string& key);  // false if the key does not exist
+    std::vector<std::pair<std::string, std::string>> scan(const std::string& prefix,
+                                                          std::size_t limit) const;
+    Stats stats() const;
+    CompactResult compact();
+
+private:
+    LogFile log_;
+    std::map<std::string, std::string> index_;
+    std::size_t records_ = 0;
+};
+
+}  // namespace kvdb
diff --git a/tests/kvdb_tests.cpp b/tests/kvdb_tests.cpp
new file mode 100644
index 0000000..e8a058c
--- /dev/null
+++ b/tests/kvdb_tests.cpp
@@ -0,0 +1,142 @@
+// Minimal assertion harness: each test is a function; failures are counted and reported.
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <iostream>
+#include <random>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "cli.h"
+#include "codec.h"
+#include "store.h"
+
+namespace fs = std::filesystem;
+
+namespace {
+
+int failures = 0;
+
+#define CHECK(cond)                                                                 \
+    do {                                                                            \
+        if (!(cond)) {                                                              \
+            std::cerr << __FILE__ << ":" << __LINE__ << ": CHECK failed: " #cond "\n"; \
+            ++failures;                                                             \
+        }                                                                           \
+    } while (0)
+
+class TempDir {
+public:
+    TempDir() {
+        std::random_device rd;
+        path_ = fs::temp_directory_path() / ("kvdb-test-" + std::to_string(rd()));
+        fs::create_directories(path_);
+    }
+    ~TempDir() {
+        std::error_code ec;
+        fs::remove_all(path_, ec);
+    }
+    const fs::path& path() const { return path_; }
+
+private:
+    fs::path path_;
+};
+
+struct Result {
+    int code;
+    std::string out;
+    std::string err;
+};
+
+Result cli(const std::vector<std::string>& args) {
+    std::ostringstream out, err;
+    const int code = kvdb::run(args, out, err);
+    return {code, out.str(), err.str()};
+}
+
+void test_crc32() { CHECK(kvdb::crc32("123456789") == 0xCBF43926U); }
+
+void test_codec_roundtrip_and_torn_tail() {
+    std::string buf = kvdb::encode_record({kvdb::RecordType::Put, "a", "1"});
+    const std::size_t first = buf.size();
+    buf += kvdb::encode_record({kvdb::RecordType::Delete, "a", ""});
+    auto all = kvdb::decode_records(buf);
+    CHECK(all.records.size() == 2);
+    CHECK(all.valid_bytes == buf.size());
+    auto torn = kvdb::decode_records(std::string_view(buf).substr(0, buf.size() - 1));
+    CHECK(torn.records.size() == 1);
+    CHECK(torn.valid_bytes == first);
+    std::string bad = buf;
+    bad[first + 6] ^= 0x40;
+    CHECK(kvdb::decode_records(bad).records.size() == 1);
+}
+
+void test_store_persistence_and_compact() {
+    TempDir dir;
+    {
+        kvdb::Store s(dir.path());
+        s.set("b", "2");
+        s.set("a", "1");
+        s.set("a", "one");
+        CHECK(s.del("b"));
+        CHECK(!s.del("missing"));
+    }
+    kvdb::Store s(dir.path());
+    CHECK(s.get("a") == std::optional<std::string>("one"));
+    CHECK(!s.get("b"));
+    CHECK(s.stats().records == 4);
+    const auto r = s.compact();
+    CHECK(r.after < r.before);
+    CHECK(s.stats().records == 1);
+    CHECK(fs::file_size(dir.path() / "data.log") == r.after);
+    kvdb::Store reopened(dir.path());
+    CHECK(reopened.get("a") == std::optional<std::string>("one"));
+}
+
+void test_truncated_tail_is_discarded_on_write() {
+    TempDir dir;
+    { kvdb::Store s(dir.path()); s.set("k1", "v1"); s.set("k2", "v2"); }
+    const auto log = dir.path() / "data.log";
+    fs::resize_file(log, fs::file_size(log) - 2);
+    {
+        kvdb::Store s(dir.path());
+        CHECK(!s.get("k2"));
+        s.set("k3", "v3");
+    }
+    kvdb::Store s(dir.path());
+    CHECK(s.get("k3") == std::optional<std::string>("v3"));
+    CHECK(fs::file_size(log) == s.stats().log_bytes);
+}
+
+void test_cli() {
+    TempDir dir;
+    const std::string d = (dir.path() / "db").string();
+    CHECK(cli({"--db", d, "set", "x", "hello world"}).out == "OK\n");
+    CHECK(cli({"--db", d, "get", "x"}).out == "hello world\n");
+    CHECK(cli({"--db", d, "get", "nope"}).code == 1);
+    CHECK(cli({"--db", d, "set", "bad key", "v"}).code == 2);
+    CHECK(cli({"--db", d, "scan", "--limit", "0"}).code == 2);
+    CHECK(cli({"--db", d, "scan", "--prefix", "x"}).out == "x\thello world\n");
+    CHECK(cli({}).code == 2);
+    CHECK(cli({"--help"}).out.rfind("usage: kvdb", 0) == 0);
+}
+
+}  // namespace
+
+int main() {
+    const std::vector<std::pair<const char*, std::function<void()>>> tests = {
+        {"crc32", test_crc32},
+        {"codec", test_codec_roundtrip_and_torn_tail},
+        {"store", test_store_persistence_and_compact},
+        {"torn_tail", test_truncated_tail_is_discarded_on_write},
+        {"cli", test_cli},
+    };
+    for (const auto& [name, fn] : tests) {
+        const int before = failures;
+        fn();
+        std::cout << (failures == before ? "PASS " : "FAIL ") << name << "\n";
+    }
+    return failures == 0 ? EXIT_SUCCESS : EXIT_FAILURE;
+}
