index e7cc837..91fe258 100644
--- a/README.md
+++ b/README.md
@@ -1 +1,26 @@
 # kvdb — a tiny log-structured key-value store
+
+A persistent key-value store with an append-only, checksummed write-ahead log
+and compaction. C++20, standard library and POSIX only.
+
+## Build and test
+
+```
+cmake -S . -B build -G Ninja
+cmake --build build
+ctest --test-dir build
+```
+
+## Usage
+
+```
+build/kvdb --db <dir> set <key> <value>
+build/kvdb --db <dir> get <key>
+build/kvdb --db <dir> del <key>
+build/kvdb --db <dir> scan [--prefix <p>] [--limit <n>]
+build/kvdb --db <dir> compact
+build/kvdb --db <dir> stats
+```
+
+Data is stored in `<dir>/data.log`. A record that was only partly written
+(for example after a crash) is ignored and discarded by the next write.
diff --git a/src/cli.cpp b/src/cli.cpp
new file mode 100644
index 0000000..d2aaa27
--- /dev/null
+++ b/src/cli.cpp
@@ -0,0 +1,158 @@
+#include "cli.h"
+
+#include <charconv>
+#include <limits>
+#include <optional>
+#include <ostream>
+#include <sstream>
+#include <stdexcept>
+
+#include "store.h"
+
+namespace kvdb {
+namespace {
+
+constexpr const char* kUsageText =
+    "usage: kvdb --db <dir> <command> [args]\n"
+    "\n"
+    "commands:\n"
+    "  set <key> <value>                  store a value\n"
+    "  get <key>                          print a value\n"
+    "  del <key>                          delete a key\n"
+    "  scan [--prefix <p>] [--limit <n>]  list keys in byte order\n"
+    "  compact                            rewrite the log with live keys only\n"
+    "  stats                              print key and log statistics\n";
+
+class UsageError : public std::runtime_error {
+public:
+    using std::runtime_error::runtime_error;
+};
+
+struct ScanOptions {
+    std::string prefix;
+    std::size_t limit = std::numeric_limits<std::size_t>::max();
+};
+
+void expect_args(const std::vector<std::string>& rest, std::size_t n, const std::string& cmd) {
+    if (rest.size() != n)
+        throw UsageError(cmd + " expects " + std::to_string(n) + " argument(s)");
+}
+
+const std::string& checked_key(const std::string& key) {
+    if (!valid_key(key)) throw UsageError("invalid key");
+    return key;
+}
+
+std::size_t parse_limit(const std::string& s) {
+    std::size_t n = 0;
+    const char* end = s.data() + s.size();
+    auto [p, ec] = std::from_chars(s.data(), end, n);
+    if (s.empty() || ec != std::errc() || p != end || n == 0)
+        throw UsageError("invalid --limit: " + s);
+    return n;
+}
+
+ScanOptions parse_scan(const std::vector<std::string>& rest) {
+    ScanOptions opts;
+    bool have_prefix = false, have_limit = false;
+    for (std::size_t i = 0; i < rest.size(); i += 2) {
+        const std::string& opt = rest[i];
+        if (i + 1 >= rest.size()) throw UsageError("missing value for " + opt);
+        if (opt == "--prefix" && !have_prefix) {
+            have_prefix = true;
+            opts.prefix = rest[i + 1];
+        } else if (opt == "--limit" && !have_limit) {
+            have_limit = true;
+            opts.limit = parse_limit(rest[i + 1]);
+        } else {
+            throw UsageError("unknown or repeated option: " + opt);
+        }
+    }
+    return opts;
+}
+
+int dispatch(const std::string& dir, const std::string& cmd, const std::vector<std::string>& rest,
+             std::ostream& out, std::ostream& err) {
+    if (cmd == "set") {
+        expect_args(rest, 2, cmd);
+        checked_key(rest[0]);
+        if (!valid_value(rest[1])) throw UsageError("invalid value");
+        Store(dir).set(rest[0], rest[1]);
+        out << "OK\n";
+    } else if (cmd == "get") {
+        expect_args(rest, 1, cmd);
+        auto value = Store(dir).get(checked_key(rest[0]));
+        if (!value) {
+            err << "error: key not found: " << rest[0] << "\n";
+            return kNotFound;
+        }
+        out << *value << "\n";
+    } else if (cmd == "del") {
+        expect_args(rest, 1, cmd);
+        Store store(dir);
+        if (!store.del(checked_key(rest[0]))) {
+            err << "error: key not found: " << rest[0] << "\n";
+            return kNotFound;
+        }
+        out << "OK\n";
+    } else if (cmd == "scan") {
+        const ScanOptions opts = parse_scan(rest);
+        for (const auto& [k, v] : Store(dir).scan(opts.prefix, opts.limit))
+            out << k << '\t' << v << '\n';
+    } else if (cmd == "compact") {
+        expect_args(rest, 0, cmd);
+        const CompactResult r = Store(dir).compact();
+        out << "compacted " << r.before << " -> " << r.after << " bytes\n";
+    } else if (cmd == "stats") {
+        expect_args(rest, 0, cmd);
+        const Stats s = Store(dir).stats();
+        out << "keys: " << s.keys << "\nrecords: " << s.records << "\nlog_bytes: " << s.log_bytes
+            << "\n";
+    } else {
+        throw UsageError("unknown command: " + cmd);
+    }
+    return kOk;
+}
+
+}  // namespace
+
+bool valid_key(const std::string& key) {
+    if (key.empty() || key.size() > 256) return false;
+    for (char c : key) {
+        const auto b = static_cast<unsigned char>(c);
+        if (b <= 0x20 || b == 0x7F) return false;
+    }
+    return true;
+}
+
+bool valid_value(const std::string& value) {
+    return value.size() <= 65536 && value.find_first_of("\r\n") == std::string::npos;
+}
+
+int run(const std::vector<std::string>& args, std::ostream& out, std::ostream& err) {
+    if (args.size() == 1 && (args[0] == "--help" || args[0] == "-h")) {
+        out << kUsageText;
+        return kOk;
+    }
+    // Buffer stdout so nothing is printed when the command fails half-way.
+    std::ostringstream buffered;
+    try {
+        if (args.size() < 3 || args[0] != "--db" || args[1].empty())
+            throw UsageError("expected: kvdb --db <dir> <command> [args] (see --help)");
+        const std::vector<std::string> rest(args.begin() + 3, args.end());
+        const int code = dispatch(args[1], args[2], rest, buffered, err);
+        out << buffered.str();
+        return code;
+    } catch (const UsageError& e) {
+        err << "error: " << e.what() << "\n";
+        return kUsage;
+    } catch (const StorageError& e) {
+        err << "error: " << e.what() << "\n";
+        return kIoError;
+    } catch (const std::exception& e) {
+        err << "error: " << e.what() << "\n";
+        return kIoError;
+    }
+}
+
+}  // namespace kvdb
