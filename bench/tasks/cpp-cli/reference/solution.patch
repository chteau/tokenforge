diff --git a/src/codec.cpp b/src/codec.cpp
new file mode 100644
index 0000000..265e5d6
--- /dev/null
+++ b/src/codec.cpp
@@ -0,0 +1,79 @@
+#include "codec.h"
+
+#include <array>
+
+namespace kvdb {
+namespace {
+
+constexpr std::size_t kHeaderSize = 4 + 1 + 4 + 4;
+
+std::array<std::uint32_t, 256> make_crc_table() {
+    std::array<std::uint32_t, 256> table{};
+    for (std::uint32_t i = 0; i < 256; ++i) {
+        std::uint32_t c = i;
+        for (int k = 0; k < 8; ++k) c = (c & 1U) ? 0xEDB88320U ^ (c >> 1) : c >> 1;
+        table[i] = c;
+    }
+    return table;
+}
+
+void put_u32(std::string& out, std::uint32_t v) {
+    for (int i = 0; i < 4; ++i) out.push_back(static_cast<char>((v >> (8 * i)) & 0xFFU));
+}
+
+std::uint32_t get_u32(std::string_view buf, std::size_t pos) {
+    std::uint32_t v = 0;
+    for (int i = 0; i < 4; ++i)
+        v |= static_cast<std::uint32_t>(static_cast<unsigned char>(buf[pos + i])) << (8 * i);
+    return v;
+}
+
+}  // namespace
+
+std::uint32_t crc32(std::string_view data) {
+    static const auto table = make_crc_table();
+    std::uint32_t c = 0xFFFFFFFFU;
+    for (char ch : data) c = table[(c ^ static_cast<unsigned char>(ch)) & 0xFFU] ^ (c >> 8);
+    return c ^ 0xFFFFFFFFU;
+}
+
+std::string encode_record(const Record& record) {
+    std::string body;
+    body.push_back(static_cast<char>(record.type));
+    put_u32(body, static_cast<std::uint32_t>(record.key.size()));
+    put_u32(body, static_cast<std::uint32_t>(record.value.size()));
+    body += record.key;
+    body += record.value;
+    std::string out;
+    out.reserve(body.size() + 4);
+    put_u32(out, crc32(body));
+    out += body;
+    return out;
+}
+
+DecodeResult decode_records(std::string_view buf) {
+    DecodeResult result;
+    std::size_t pos = 0;
+    while (buf.size() - pos >= kHeaderSize) {
+        const std::uint32_t crc = get_u32(buf, pos);
+        const auto type = static_cast<unsigned char>(buf[pos + 4]);
+        const std::uint64_t key_len = get_u32(buf, pos + 5);
+        const std::uint64_t value_len = get_u32(buf, pos + 9);
+        const std::uint64_t total = kHeaderSize + key_len + value_len;
+        if (total > buf.size() - pos) break;  // truncated record
+        if (crc32(buf.substr(pos + 4, total - 4)) != crc) break;
+        if (type != static_cast<unsigned char>(RecordType::Put) &&
+            type != static_cast<unsigned char>(RecordType::Delete))
+            break;
+        Record r;
+        r.type = static_cast<RecordType>(type);
+        r.key = std::string(buf.substr(pos + kHeaderSize, key_len));
+        r.value = std::string(buf.substr(pos + kHeaderSize + key_len, value_len));
+        result.records.push_back(std::move(r));
+        pos += total;
+    }
+    result.valid_bytes = pos;
+    return result;
+}
+
+}  // namespace kvdb
diff --git a/src/codec.h b/src/codec.h
new file mode 100644
index 0000000..52c3a18
--- /dev/null
+++ b/src/codec.h
@@ -0,0 +1,35 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace kvdb {
+
+enum class RecordType : std::uint8_t { Put = 1, Delete = 2 };
+
+struct Record {
+    RecordType type = RecordType::Put;
+    std::string key;
+    std::string value;
+};
+
+// CRC-32 (IEEE 802.3, reflected, polynomial 0xEDB88320).
+std::uint32_t crc32(std::string_view data);
+
+// On-disk layout of one record (all integers little-endian):
+//   u32 crc | u8 type | u32 key_len | u32 value_len | key | value
+// The crc covers everything after itself.
+std::string encode_record(const Record& record);
+
+struct DecodeResult {
+    std::vector<Record> records;
+    std::uint64_t valid_bytes = 0;  // offset just past the last good record
+};
+
+// Decodes records from the start of buf, stopping at the first record that is
+// truncated or fails its checksum.
+DecodeResult decode_records(std::string_view buf);
+
+}  // namespace kvdb
