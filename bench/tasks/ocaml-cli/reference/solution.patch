+(** The binary program format: encoding and decoding. *)
+
+type program = {
+  instrs : (int * Isa.instr) array;  (** (byte offset, instruction) in code order *)
+  code_size : int;
+  data : int32 array;
+}
+
+val memory_words : int
+
+(** Lay out instructions at consecutive offsets. *)
+val make : Isa.instr list -> int32 list -> program
+
+val encode : program -> string
+
+(** Decode a whole file; the error is the message without the ["error: "] prefix. *)
+val decode : string -> (program, string) result
diff --git a/src/disasm.ml b/src/disasm.ml
new file mode 100644
index 0000000..5f9a581
--- /dev/null
+++ b/src/disasm.ml
@@ -0,0 +1,37 @@
+let render (p : Bytecode.program) =
+  let starts = Hashtbl.create 64 in
+  Array.iter (fun (off, _) -> Hashtbl.replace starts off ()) p.instrs;
+  Hashtbl.replace starts p.code_size ();
+  let targets = Hashtbl.create 16 in
+  let check (off, (i : Isa.instr)) =
+    if Isa.operand i.op <> Isa.Target then Ok ()
+    else
+      let t = Isa.target_of i in
+      if Hashtbl.mem starts t then Ok (Hashtbl.replace targets t ())
+      else Error (Printf.sprintf "invalid jump target %d at offset %d" t off)
+  in
+  let rec check_all k =
+    if k >= Array.length p.instrs then Ok ()
+    else Result.bind (check p.instrs.(k)) (fun () -> check_all (k + 1))
+  in
+  Result.map
+    (fun () ->
+      let b = Buffer.create 256 in
+      if Array.length p.data > 0 then (
+        Buffer.add_string b ".data data";
+        Array.iter (fun w -> Buffer.add_string b (" " ^ Int32.to_string w)) p.data;
+        Buffer.add_char b '\n');
+      let label off = if Hashtbl.mem targets off then Printf.bprintf b "L%d:\n" off in
+      Array.iter
+        (fun (off, (i : Isa.instr)) ->
+          label off;
+          Buffer.add_string b ("    " ^ Isa.mnemonic i.op);
+          (match Isa.operand i.op with
+          | Isa.No_operand -> ()
+          | Isa.Value -> Buffer.add_string b (" " ^ Int32.to_string i.arg)
+          | Isa.Target -> Printf.bprintf b " L%d" (Isa.target_of i));
+          Buffer.add_char b '\n')
+        p.instrs;
+      label p.code_size;
+      Buffer.contents b)
+    (check_all 0)
