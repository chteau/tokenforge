diff --git a/src/assembler.ml b/src/assembler.ml
new file mode 100644
index 0000000..c31d7ef
--- /dev/null
+++ b/src/assembler.ml
@@ -0,0 +1,149 @@
+type symbol = Code of int | Data_addr of int
+type arg = No_arg | Lit of int32 | Sym of string
+type pending = { line : int; op : Isa.opcode; arg : arg }
+
+let is_ident s =
+  s <> ""
+  && (match s.[0] with 'A' .. 'Z' | 'a' .. 'z' | '_' -> true | _ -> false)
+  && String.for_all (function 'A' .. 'Z' | 'a' .. 'z' | '0' .. '9' | '_' -> true | _ -> false) s
+
+let tokenize text =
+  let text = match String.index_opt text ';' with Some i -> String.sub text 0 i | None -> text in
+  String.map (function '\t' | '\r' -> ' ' | c -> c) text
+  |> String.split_on_char ' '
+  |> List.filter (fun t -> t <> "")
+
+(* Integer literal: decimal with optional '-', or non-negative hex with 0x. *)
+let parse_int s =
+  let n = String.length s in
+  let digits, base, neg =
+    if n > 2 && String.sub s 0 2 = "0x" then (String.sub s 2 (n - 2), 16, false)
+    else if n > 1 && s.[0] = '-' then (String.sub s 1 (n - 1), 10, true)
+    else (s, 10, false)
+  in
+  let digit c =
+    match c with
+    | '0' .. '9' -> Some (Char.code c - 48)
+    | 'a' .. 'f' when base = 16 -> Some (Char.code c - 87)
+    | 'A' .. 'F' when base = 16 -> Some (Char.code c - 55)
+    | _ -> None
+  in
+  if digits = "" || not (String.for_all (fun c -> digit c <> None) digits) then `Invalid
+  else
+    let cap = 1 lsl 40 in
+    let v = String.fold_left (fun acc c -> min cap ((acc * base) + Option.get (digit c))) 0 digits in
+    let v = if neg then -v else v in
+    if v < Int32.to_int Int32.min_int || v > Int32.to_int Int32.max_int then `Out_of_range
+    else `Ok (Int32.of_int v)
+
+let value_arg tok =
+  match parse_int tok with
+  | `Ok v -> Ok (Lit v)
+  | `Out_of_range -> Error (Printf.sprintf "integer out of range '%s'" tok)
+  | `Invalid when is_ident tok -> Ok (Sym tok)
+  | `Invalid -> Error (Printf.sprintf "invalid operand '%s'" tok)
+
+let instr_args op toks =
+  let m = Isa.mnemonic op in
+  match (Isa.operand op, toks) with
+  | Isa.No_operand, [] -> Ok No_arg
+  | Isa.No_operand, _ -> Error (Printf.sprintf "'%s' expects no operand" m)
+  | _, ([] | _ :: _ :: _) -> Error (Printf.sprintf "'%s' expects 1 operand" m)
+  | Isa.Value, [ tok ] -> value_arg tok
+  | Isa.Target, [ tok ] ->
+      if is_ident tok then Ok (Sym tok) else Error (Printf.sprintf "invalid operand '%s'" tok)
+
+let ( let* ) = Result.bind
+
+let rec iter_result f = function
+  | [] -> Ok ()
+  | x :: rest ->
+      let* () = f x in
+      iter_result f rest
+
+let assemble source =
+  let symbols = Hashtbl.create 32 in
+  let errors = ref [] in
+  let pending = ref [] in
+  let data = ref [] and data_words = ref 0 in
+  let offset = ref 0 in
+  let define name sym =
+    if Hashtbl.mem symbols name then Error (Printf.sprintf "duplicate label '%s'" name)
+    else Ok (Hashtbl.replace symbols name sym)
+  in
+  let label tok =
+    let name = String.sub tok 0 (String.length tok - 1) in
+    if not (is_ident name) then Error (Printf.sprintf "invalid label '%s'" name)
+    else define name (Code !offset)
+  in
+  let data_directive = function
+    | name :: (_ :: _ as values) ->
+        let* () = if is_ident name then Ok () else Error (Printf.sprintf "invalid label '%s'" name) in
+        let* () = define name (Data_addr !data_words) in
+        let* words =
+          List.fold_left
+            (fun acc tok ->
+              let* acc = acc in
+              match parse_int tok with
+              | `Ok v -> Ok (v :: acc)
+              | `Out_of_range -> Error (Printf.sprintf "integer out of range '%s'" tok)
+              | `Invalid -> Error (Printf.sprintf "invalid operand '%s'" tok))
+            (Ok []) values
+        in
+        let count = List.length words in
+        if !data_words + count > Bytecode.memory_words then Error "data section too large"
+        else (
+          data := words @ !data;
+          data_words := !data_words + count;
+          Ok ())
+    | _ -> Error "'.data' expects a name and at least one value"
+  in
+  let statement line toks =
+    let rec split_labels acc = function
+      | t :: rest when String.ends_with ~suffix:":" t -> split_labels (t :: acc) rest
+      | rest -> (List.rev acc, rest)
+    in
+    let labels, body = split_labels [] toks in
+    let* () = iter_result label labels in
+    match body with
+    | [] -> Ok ()
+    | d :: args when String.lowercase_ascii d = ".data" -> data_directive args
+    | d :: _ when d.[0] = '.' -> Error (Printf.sprintf "unknown directive '%s'" d)
+    | m :: args -> (
+        match Isa.of_mnemonic m with
+        | None -> Error (Printf.sprintf "unknown instruction '%s'" m)
+        | Some op ->
+            let* arg = instr_args op args in
+            pending := { line; op; arg } :: !pending;
+            offset := !offset + Isa.size op;
+            Ok ())
+  in
+  String.split_on_char '\n' source
+  |> List.iteri (fun i text ->
+         match statement (i + 1) (tokenize text) with
+         | Ok () -> ()
+         | Error msg -> errors := (i + 1, msg) :: !errors);
+  let resolve p =
+    let arg =
+      match (p.arg, Isa.operand p.op) with
+      | No_arg, _ -> Ok 0l
+      | Lit v, _ -> Ok v
+      | Sym s, Isa.Target -> (
+          match Hashtbl.find_opt symbols s with
+          | Some (Code o) -> Ok (Int32.of_int o)
+          | _ -> Error (Printf.sprintf "undefined label '%s'" s))
+      | Sym s, _ -> (
+          match Hashtbl.find_opt symbols s with
+          | Some (Data_addr a) -> Ok (Int32.of_int a)
+          | _ -> Error (Printf.sprintf "undefined data '%s'" s))
+    in
+    match arg with
+    | Ok arg -> Some { Isa.op = p.op; arg }
+    | Error msg ->
+        errors := (p.line, msg) :: !errors;
+        None
+  in
+  let instrs = List.filter_map resolve (List.rev !pending) in
+  match List.sort (fun (a, _) (b, _) -> compare a b) !errors with
+  | first :: _ -> Error first
+  | [] -> Ok (Bytecode.make instrs (List.rev !data))
