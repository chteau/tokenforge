+++ b/src/isa.mli
@@ -0,0 +1,29 @@
+(** The instruction set of the stack machine. *)
+
+type opcode =
+  | Halt | Push | Pop | Dup | Swap | Over
+  | Add | Sub | Mul | Div | Mod | Neg | Cmp
+  | Jmp | Jz | Jnz | Call | Ret
+  | Load | Store | Print
+
+(** What kind of operand an instruction takes. *)
+type operand = No_operand | Value | Target
+
+(** A decoded instruction; [arg] is [0l] for instructions without operand.
+    For jumps it holds the target offset (interpreted as unsigned). *)
+type instr = { op : opcode; arg : int32 }
+
+val code : opcode -> int
+val of_code : int -> opcode option
+val mnemonic : opcode -> string
+
+(** Case-insensitive lookup. *)
+val of_mnemonic : string -> opcode option
+
+val operand : opcode -> operand
+
+(** Encoded size in bytes. *)
+val size : opcode -> int
+
+(** [target_of i] is the unsigned jump target of a jump or call. *)
+val target_of : instr -> int
diff --git a/src/vm.ml b/src/vm.ml
new file mode 100644
index 0000000..30ec6c1
--- /dev/null
+++ b/src/vm.ml
@@ -0,0 +1,96 @@
+type trap =
+  | Stack_underflow of int
+  | Division_by_zero of int
+  | Bad_jump of int * int
+  | Bad_address of int32 * int
+  | Step_limit
+  | Stack_overflow of int
+
+exception Trap of trap
+
+let max_stack = 1024
+let max_calls = 256
+
+let describe = function
+  | Stack_underflow o -> (Printf.sprintf "trap: stack underflow at offset %d" o, 10)
+  | Division_by_zero o -> (Printf.sprintf "trap: division by zero at offset %d" o, 11)
+  | Bad_jump (t, o) -> (Printf.sprintf "trap: bad jump to %d at offset %d" t o, 12)
+  | Bad_address (a, o) -> (Printf.sprintf "trap: bad address %ld at offset %d" a o, 13)
+  | Step_limit -> ("trap: step limit exceeded", 14)
+  | Stack_overflow o -> (Printf.sprintf "trap: stack overflow at offset %d" o, 15)
+
+let run ~steps ~print (p : Bytecode.program) =
+  let n = Array.length p.instrs in
+  let index = Hashtbl.create (n + 1) in
+  Array.iteri (fun k (off, _) -> Hashtbl.replace index off k) p.instrs;
+  Hashtbl.replace index p.code_size n;
+  let mem = Array.make Bytecode.memory_words 0l in
+  Array.blit p.data 0 mem 0 (Array.length p.data);
+  let stack = Array.make max_stack 0l and sp = ref 0 in
+  let calls = Array.make max_calls 0 and csp = ref 0 in
+  let rec exec pc count =
+    if pc >= n then ()
+    else if count >= steps then raise (Trap Step_limit)
+    else
+      let at, (i : Isa.instr) = p.instrs.(pc) in
+      let need k = if !sp < k then raise (Trap (Stack_underflow at)) in
+      let pop () = decr sp; stack.(!sp) in
+      let push v =
+        if !sp >= max_stack then raise (Trap (Stack_overflow at));
+        stack.(!sp) <- v;
+        incr sp
+      in
+      let binary f = need 2; let b = pop () in let a = pop () in push (f a b) in
+      let divide f = need 2;
+        if stack.(!sp - 1) = 0l then raise (Trap (Division_by_zero at));
+        binary f
+      in
+      let jump t =
+        match Hashtbl.find_opt index t with
+        | Some k -> k
+        | None -> raise (Trap (Bad_jump (t, at)))
+      in
+      let address () =
+        let a = Int32.to_int i.arg in
+        if a < 0 || a >= Bytecode.memory_words then raise (Trap (Bad_address (i.arg, at)));
+        a
+      in
+      let next = pc + 1 in
+      let continue_at pc' = exec pc' (count + 1) in
+      match i.op with
+      | Halt -> ()
+      | Push -> push i.arg; continue_at next
+      | Pop -> need 1; ignore (pop ()); continue_at next
+      | Dup -> need 1; push stack.(!sp - 1); continue_at next
+      | Swap ->
+          need 2;
+          let b = pop () in let a = pop () in
+          push b; push a; continue_at next
+      | Over -> need 2; push stack.(!sp - 2); continue_at next
+      | Add -> binary Int32.add; continue_at next
+      | Sub -> binary Int32.sub; continue_at next
+      | Mul -> binary Int32.mul; continue_at next
+      | Div -> divide Int32.div; continue_at next
+      | Mod -> divide Int32.rem; continue_at next
+      | Neg -> need 1; push (Int32.neg (pop ())); continue_at next
+      | Cmp -> binary (fun a b -> if a < b then -1l else if a > b then 1l else 0l); continue_at next
+      | Jmp -> continue_at (jump (Isa.target_of i))
+      | Jz | Jnz ->
+          need 1;
+          let zero = pop () = 0l in
+          if zero = (i.op = Isa.Jz) then continue_at (jump (Isa.target_of i)) else continue_at next
+      | Call ->
+          if !csp >= max_calls then raise (Trap (Stack_overflow at));
+          let k = jump (Isa.target_of i) in
+          calls.(!csp) <- (if next < n then fst p.instrs.(next) else p.code_size);
+          incr csp;
+          continue_at k
+      | Ret ->
+          if !csp = 0 then raise (Trap (Stack_underflow at));
+          decr csp;
+          continue_at (jump calls.(!csp))
+      | Load -> let a = address () in push mem.(a); continue_at next
+      | Store -> let a = address () in need 1; mem.(a) <- pop (); continue_at next
+      | Print -> need 1; print (pop ()); continue_at next
+  in
+  match exec 0 0 with () -> Ok () | exception Trap t -> Error t
