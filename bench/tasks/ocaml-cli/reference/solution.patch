new file mode 100644
index 0000000..f60b11a
--- /dev/null
+++ b/src/vm.mli
@@ -0,0 +1,18 @@
+(** The virtual machine. *)
+
+type trap =
+  | Stack_underflow of int  (** offset of the faulting instruction *)
+  | Division_by_zero of int
+  | Bad_jump of int * int  (** target, offset *)
+  | Bad_address of int32 * int
+  | Step_limit
+  | Stack_overflow of int
+
+val max_stack : int
+val max_calls : int
+
+(** Run until [halt] or the end of the code. [print] receives every printed value. *)
+val run : steps:int -> print:(int32 -> unit) -> Bytecode.program -> (unit, trap) result
+
+(** The stderr message and exit code for a trap. *)
+val describe : trap -> string * int
