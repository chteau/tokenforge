+type opcode =
+  | Halt | Push | Pop | Dup | Swap | Over
+  | Add | Sub | Mul | Div | Mod | Neg | Cmp
+  | Jmp | Jz | Jnz | Call | Ret
+  | Load | Store | Print
+
+type operand = No_operand | Value | Target
+
+type instr = { op : opcode; arg : int32 }
+
+let table =
+  [ (Halt, 0x00, "halt"); (Push, 0x01, "push"); (Pop, 0x02, "pop");
+    (Dup, 0x03, "dup"); (Swap, 0x04, "swap"); (Over, 0x05, "over");
+    (Add, 0x10, "add"); (Sub, 0x11, "sub"); (Mul, 0x12, "mul");
+    (Div, 0x13, "div"); (Mod, 0x14, "mod"); (Neg, 0x15, "neg");
+    (Cmp, 0x16, "cmp"); (Jmp, 0x20, "jmp"); (Jz, 0x21, "jz");
+    (Jnz, 0x22, "jnz"); (Call, 0x23, "call"); (Ret, 0x24, "ret");
+    (Load, 0x30, "load"); (Store, 0x31, "store"); (Print, 0x40, "print") ]
+
+let find f = List.find (fun entry -> f entry) table
+let code op = match find (fun (o, _, _) -> o = op) with _, c, _ -> c
+let mnemonic op = match find (fun (o, _, _) -> o = op) with _, _, m -> m
+
+let of_code c =
+  List.find_map (fun (o, c', _) -> if c = c' then Some o else None) table
+
+let of_mnemonic s =
+  let s = String.lowercase_ascii s in
+  List.find_map (fun (o, _, m) -> if m = s then Some o else None) table
+
+let operand = function
+  | Push | Load | Store -> Value
+  | Jmp | Jz | Jnz | Call -> Target
+  | _ -> No_operand
+
+let size op = if operand op = No_operand then 1 else 5
+let target_of i = Int32.to_int i.arg land 0xFFFF_FFFF
