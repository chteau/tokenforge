diff --git a/README.md b/README.md
index 3a32531..e294f05 100644
--- a/README.md
+++ b/README.md
@@ -1 +1,22 @@
 # asm — assembler, disassembler and virtual machine for a small stack machine
+
+Assembles a small text assembly language into a binary program file, disassembles it back,
+and runs it on a 32-bit stack virtual machine. OCaml standard library only.
+
+## Build and test
+
+```
+dune build      # produces _build/default/bin/asm.exe
+dune test
+```
+
+## Usage
+
+```
+asm assemble prog.s -o prog.bin
+asm disasm prog.bin
+asm run prog.bin [--steps N]
+```
+
+Layout: `src/` holds the `svm` library (`Isa` instruction table, `Bytecode` binary format,
+`Assembler`, `Disasm`, `Vm`), `bin/` the command-line front end, `test/` the tests.
diff --git a/bin/asm.ml b/bin/asm.ml
new file mode 100644
index 0000000..50cb7b3
--- /dev/null
+++ b/bin/asm.ml
@@ -0,0 +1,61 @@
+let usage =
+  "usage: asm assemble <source.s> -o <out.bin>\n\
+  \       asm disasm <program.bin>\n\
+  \       asm run <program.bin> [--steps <n>]\n\
+  \       asm --help\n"
+
+let fail code msg =
+  prerr_endline msg;
+  exit code
+
+let read_file path =
+  match In_channel.with_open_bin path In_channel.input_all with
+  | s -> s
+  | exception Sys_error _ -> fail 3 ("error: cannot read " ^ path)
+
+let write_file path contents =
+  match Out_channel.with_open_bin path (fun oc -> Out_channel.output_string oc contents) with
+  | () -> ()
+  | exception Sys_error _ -> fail 3 ("error: cannot write " ^ path)
+
+let load path =
+  match Svm.Bytecode.decode (read_file path) with
+  | Ok p -> p
+  | Error msg -> fail 4 ("error: " ^ msg)
+
+let assemble src out =
+  match Svm.Assembler.assemble (read_file src) with
+  | Ok p -> write_file out (Svm.Bytecode.encode p)
+  | Error (line, msg) -> fail 1 (Printf.sprintf "error: line %d: %s" line msg)
+
+let disasm path =
+  match Svm.Disasm.render (load path) with
+  | Ok text -> print_string text
+  | Error msg -> fail 4 ("error: " ^ msg)
+
+let run path steps =
+  let p = load path in
+  let print v = print_string (Int32.to_string v ^ "\n") in
+  match Svm.Vm.run ~steps ~print p with
+  | Ok () -> ()
+  | Error trap ->
+      flush stdout;
+      let msg, code = Svm.Vm.describe trap in
+      fail code msg
+
+let positive s =
+  if s <> "" && String.for_all (function '0' .. '9' -> true | _ -> false) s then
+    match int_of_string_opt s with Some n when n > 0 -> Some n | _ -> None
+  else None
+
+let () =
+  match List.tl (Array.to_list Sys.argv) with
+  | [ ("--help" | "-h") ] -> print_string usage
+  | [ "assemble"; src; "-o"; out ] -> assemble src out
+  | [ "disasm"; path ] -> disasm path
+  | [ "run"; path ] -> run path 1_000_000
+  | [ "run"; path; "--steps"; n ] -> (
+      match positive n with
+      | Some steps -> run path steps
+      | None -> fail 2 ("error: invalid step limit: " ^ n))
+  | _ -> fail 2 "error: invalid arguments (see asm --help)"
