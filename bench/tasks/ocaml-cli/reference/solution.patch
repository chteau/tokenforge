diff --git a/src/bytecode.ml b/src/bytecode.ml
new file mode 100644
index 0000000..53cdd6d
--- /dev/null
+++ b/src/bytecode.ml
@@ -0,0 +1,76 @@
+type program = {
+  instrs : (int * Isa.instr) array;
+  code_size : int;
+  data : int32 array;
+}
+
+let magic = "SVMB"
+let version = 1
+let header_size = 16
+let memory_words = 256
+
+let make instrs data =
+  let offset = ref 0 in
+  let placed =
+    List.map
+      (fun (i : Isa.instr) ->
+        let at = !offset in
+        offset := at + Isa.size i.op;
+        (at, i))
+      instrs
+  in
+  { instrs = Array.of_list placed; code_size = !offset; data = Array.of_list data }
+
+let encode p =
+  let b = Buffer.create (header_size + p.code_size + (4 * Array.length p.data)) in
+  Buffer.add_string b magic;
+  Buffer.add_uint8 b version;
+  Buffer.add_string b "\000\000\000";
+  Buffer.add_int32_le b (Int32.of_int p.code_size);
+  Buffer.add_int32_le b (Int32.of_int (Array.length p.data));
+  Array.iter
+    (fun (_, (i : Isa.instr)) ->
+      Buffer.add_uint8 b (Isa.code i.op);
+      if Isa.operand i.op <> Isa.No_operand then Buffer.add_int32_le b i.arg)
+    p.instrs;
+  Array.iter (Buffer.add_int32_le b) p.data;
+  Buffer.contents b
+
+let u32 s pos = Int32.to_int (String.get_int32_le s pos) land 0xFFFF_FFFF
+
+let decode_code s code_size =
+  let stop = header_size + code_size in
+  let rec go pos acc =
+    if pos >= stop then Ok (List.rev acc)
+    else
+      let off = pos - header_size in
+      let byte = Char.code s.[pos] in
+      match Isa.of_code byte with
+      | None -> Error (Printf.sprintf "unknown opcode 0x%02x at offset %d" byte off)
+      | Some op when pos + Isa.size op > stop ->
+          Error (Printf.sprintf "truncated instruction at offset %d" off)
+      | Some op ->
+          let arg = if Isa.operand op = Isa.No_operand then 0l else String.get_int32_le s (pos + 1) in
+          go (pos + Isa.size op) ((off, { Isa.op; arg }) :: acc)
+  in
+  go header_size []
+
+let decode s =
+  let len = String.length s in
+  if len < header_size then Error "truncated file"
+  else if String.sub s 0 4 <> magic then Error "bad magic"
+  else if Char.code s.[4] <> version then
+    Error (Printf.sprintf "unsupported version %d" (Char.code s.[4]))
+  else
+    let code_size = u32 s 8 and words = u32 s 12 in
+    let expected = header_size + code_size + (4 * words) in
+    if len < expected then Error "truncated file"
+    else if len > expected then Error "trailing data"
+    else if words > memory_words then Error "data section too large"
+    else
+      Result.map
+        (fun instrs ->
+          let base = header_size + code_size in
+          { instrs = Array.of_list instrs; code_size;
+            data = Array.init words (fun i -> String.get_int32_le s (base + (4 * i))) })
+        (decode_code s code_size)
