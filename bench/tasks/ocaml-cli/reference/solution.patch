diff --git a/test/test_svm.ml b/test/test_svm.ml
new file mode 100644
index 0000000..6538b25
--- /dev/null
+++ b/test/test_svm.ml
@@ -0,0 +1,78 @@
+open Svm
+
+let failures = ref 0
+let count = ref 0
+
+let check name cond =
+  incr count;
+  if not cond then (
+    incr failures;
+    Printf.printf "FAIL %s\n" name)
+
+let assemble src =
+  match Assembler.assemble src with
+  | Ok p -> p
+  | Error (l, m) -> failwith (Printf.sprintf "unexpected error line %d: %s" l m)
+
+let run ?(steps = 10_000) src =
+  let out = ref [] in
+  let result = Vm.run ~steps ~print:(fun v -> out := v :: !out) (assemble src) in
+  (List.rev !out, result)
+
+let asm_error src = match Assembler.assemble src with Ok _ -> None | Error e -> Some e
+
+let () =
+  (* encoding *)
+  let bin = Bytecode.encode (assemble "push -2\nadd\n.data x 7") in
+  check "header magic" (String.sub bin 0 5 = "SVMB\001");
+  check "code size" (String.get_int32_le bin 8 = 6l);
+  check "data count" (String.get_int32_le bin 12 = 1l);
+  check "push operand" (String.sub bin 16 5 = "\001\254\255\255\255");
+  check "file length" (String.length bin = 16 + 6 + 4);
+  check "decode roundtrip"
+    (match Bytecode.decode bin with Ok p -> Bytecode.encode p = bin | Error _ -> false);
+  check "bad magic" (Bytecode.decode ("XXXX" ^ String.sub bin 4 22) = Error "bad magic");
+  check "trailing" (Bytecode.decode (bin ^ "z") = Error "trailing data");
+  check "truncated" (Bytecode.decode (String.sub bin 0 20) = Error "truncated file");
+
+  (* execution *)
+  check "arith" (fst (run "push 7\npush 3\nsub\nprint\npush 6\npush 7\nmul\nprint") = [ 4l; 42l ]);
+  check "div trunc" (fst (run "push -7\npush 2\ndiv\nprint\npush -7\npush 2\nmod\nprint") = [ -3l; -1l ]);
+  check "wrap" (fst (run "push 0x7fffffff\npush 1\nadd\nprint") = [ Int32.min_int ]);
+  check "cmp" (fst (run "push 1\npush 2\ncmp\nprint\npush 2\npush 2\ncmp\nprint") = [ -1l; 0l ]);
+  let loop = "push 3\ntop: dup\nprint\npush 1\nsub\ndup\njnz top\npop\n" in
+  check "loop" (run loop = ([ 3l; 2l; 1l ], Ok ()));
+  check "call ret" (fst (run "push 5\ncall sq\nprint\nhalt\nsq: dup\nmul\nret") = [ 25l ]);
+  check "memory" (fst (run ".data v 10 20\nload 1\npush v\nprint\nprint\npush 9\nstore v\nload v\nprint") = [ 0l; 20l; 9l ]);
+
+  (* traps *)
+  check "underflow" (snd (run "push 1\nadd") = Error (Vm.Stack_underflow 5));
+  check "div zero" (snd (run "push 1\npush 0\ndiv") = Error (Vm.Division_by_zero 10));
+  check "bad address" (snd (run "load 256") = Error (Vm.Bad_address (256l, 0)));
+  check "step limit" (snd (run ~steps:5 "l: jmp l") = Error Vm.Step_limit);
+  check "overflow" (snd (run "f: call f") = Error (Vm.Stack_overflow 0));
+  check "output before trap" (run "push 4\nprint\nret" = ([ 4l ], Error (Vm.Stack_underflow 6)));
+
+  (* assembler errors *)
+  check "unknown" (asm_error "push 1\n  foo 3" = Some (2, "unknown instruction 'foo'"));
+  check "operand count" (asm_error "add 1" = Some (1, "'add' expects no operand"));
+  check "missing operand" (asm_error "PUSH" = Some (1, "'push' expects 1 operand"));
+  check "range" (asm_error "push 2147483648" = Some (1, "integer out of range '2147483648'"));
+  check "undefined" (asm_error "jmp nowhere\nbad!" = Some (1, "undefined label 'nowhere'"));
+  check "first line wins" (asm_error "x:\njmp y\nx: halt" = Some (2, "undefined label 'y'"));
+  check "duplicate" (asm_error "a:\na: halt" = Some (2, "duplicate label 'a'"));
+  check "data size" (asm_error (".data a " ^ String.concat " " (List.init 257 string_of_int))
+                     = Some (1, "data section too large"));
+
+  (* disassembly round trip *)
+  let src = ".data t 1 -2\nstart: push t\nload 1\njz done\ncall start\ndone:" in
+  let p = assemble src in
+  (match Disasm.render p with
+  | Ok text ->
+      check "disasm text"
+        (text = ".data data 1 -2\nL0:\n    push 0\n    load 1\n    jz L20\n    call L0\nL20:\n");
+      check "disasm roundtrip" (Bytecode.encode (assemble text) = Bytecode.encode p)
+  | Error _ -> check "disasm ok" false);
+
+  Printf.printf "%d/%d checks passed\n" (!count - !failures) !count;
+  if !failures > 0 then exit 1
