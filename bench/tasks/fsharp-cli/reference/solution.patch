+/// A tiny assertion harness: named checks, a summary, and a failure count.
+module Tally.Tests.Check
+
+let mutable private failures = 0
+let mutable private passed = 0
+
+let test (name: string) (body: unit -> unit) =
+    try
+        body ()
+        passed <- passed + 1
+    with ex ->
+        failures <- failures + 1
+        eprintfn "FAIL %s: %s" name ex.Message
+
+let equal (expected: 'T) (actual: 'T) =
+    if expected <> actual then
+        failwithf "expected %A, got %A" expected actual
+
+let summary () =
+    printfn "%d passed, %d failed" passed failures
+    if failures = 0 then 0 else 1
