+namespace Tally
+
+/// Why a command failed; each case maps to one process exit code.
+type CliError =
+    | Rejected of string // exit 1: well-formed request that is not allowed
+    | Usage of string // exit 2: malformed command line
+    | Storage of string // exit 3: data file problems
+
+module CliError =
+    let exitCode =
+        function
+        | Rejected _ -> 1
+        | Usage _ -> 2
+        | Storage _ -> 3
+
+    let message =
+        function
+        | Rejected m
+        | Usage m
+        | Storage m -> m
+
+/// Minimal computation expression for Result<'T, CliError>.
+type OutcomeBuilder() =
+    member _.Return(x) : Result<'T, CliError> = Ok x
+    member _.ReturnFrom(r: Result<'T, CliError>) = r
+    member _.Bind(r: Result<'T, CliError>, f: 'T -> Result<'U, CliError>) = Result.bind f r
+    member _.Zero() : Result<unit, CliError> = Ok()
+    member _.Combine(r: Result<unit, CliError>, f: unit -> Result<'T, CliError>) = Result.bind f r
+    member _.Delay(f: unit -> Result<'T, CliError>) = f
+    member _.Run(f: unit -> Result<'T, CliError>) = f ()
+
+[<AutoOpen>]
+module OutcomeSyntax =
+    let outcome = OutcomeBuilder()
+
+    let reject fmt = Printf.ksprintf (Rejected >> Error) fmt
+    let usage fmt = Printf.ksprintf (Usage >> Error) fmt
+
+    /// Apply f to each item, stopping at the first failure.
+    let traverse (f: 'a -> Result<'b, CliError>) (items: 'a list) : Result<'b list, CliError> =
+        let folder acc item =
+            match acc with
+            | Error e -> Error e
+            | Ok xs -> f item |> Result.map (fun x -> x :: xs)
+
+        items |> List.fold folder (Ok []) |> Result.map List.rev
