@@ -0,0 +1,57 @@
+/// Parsing, conversion and formatting of money. Amounts are integer cents.
+module Tally.Money
+
+open System
+open System.Globalization
+open System.Text.RegularExpressions
+
+let private amountRe = Regex(@"^[0-9]{1,10}(\.[0-9]{1,2})?$")
+let private rateRe = Regex(@"^[0-9]{1,10}(\.[0-9]{1,6})?$")
+let private nameRe = Regex(@"^[A-Za-z][A-Za-z0-9_-]{0,31}$")
+let private currencyRe = Regex(@"^[A-Z]{3}$")
+
+let maxAmountCents = 100_000_000L
+
+let private parseDecimal (s: string) =
+    Decimal.Parse(s, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture)
+
+let isValidName (s: string) = nameRe.IsMatch s
+let isValidCurrency (s: string) = currencyRe.IsMatch s
+
+/// A positive amount with at most two decimals and at most 1,000,000.00, as cents.
+let parseAmount (s: string) : int64 option =
+    if amountRe.IsMatch s then
+        let cents = int64 (parseDecimal s * 100m)
+        if cents > 0L && cents <= maxAmountCents then Some cents else None
+    else
+        None
+
+/// A positive percentage with at most two decimals, as hundredths of a percent.
+let parsePercent (s: string) : int64 option =
+    if amountRe.IsMatch s then
+        let hundredths = int64 (parseDecimal s * 100m)
+        if hundredths > 0L && hundredths <= 10_000L then Some hundredths else None
+    else
+        None
+
+/// A positive exchange rate with at most six decimals.
+let parseRate (s: string) : decimal option =
+    if rateRe.IsMatch s then
+        let r = parseDecimal s
+        if r > 0m then Some r else None
+    else
+        None
+
+/// Convert cents in a foreign currency to base cents, rounding half to even.
+let convert (cents: int64) (rate: decimal) : int64 =
+    let exact = decimal cents * rate / 100m
+    int64 (Math.Round(exact, 2, MidpointRounding.ToEven) * 100m)
+
+/// 1234 -> "12.34", -5 -> "-0.05".
+let format (cents: int64) =
+    let a = abs cents
+    sprintf "%s%d.%02d" (if cents < 0L then "-" else "") (a / 100L) (a % 100L)
+
+/// Like format, but positive values get a leading '+'.
+let formatSigned (cents: int64) =
+    if cents > 0L then "+" + format cents else format cents
