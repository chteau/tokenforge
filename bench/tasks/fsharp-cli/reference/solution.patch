+++ b/src/Tally/Store.fs
@@ -0,0 +1,134 @@
+/// JSON persistence of the whole book of groups.
+module Tally.Store
+
+open System
+open System.Globalization
+open System.IO
+open System.Text.Json
+open System.Text.Json.Nodes
+open Tally.Domain
+
+let private str (node: JsonNode) (key: string) = node[key].GetValue<string>()
+let private int64Of (node: JsonNode) (key: string) = node[key].GetValue<int64>()
+let private items (node: JsonNode) (key: string) = node[key].AsArray() |> Seq.map id |> List.ofSeq
+
+let private strings (values: string seq) =
+    JsonArray(values |> Seq.map (fun v -> JsonValue.Create(v) :> JsonNode) |> Array.ofSeq)
+
+let private shareToJson (s: Share) =
+    JsonObject(dict [ "member", JsonValue.Create(s.Member) :> JsonNode; "cents", JsonValue.Create(s.Cents) ])
+
+let private entryToJson entry : JsonNode =
+    match entry with
+    | ExpenseEntry e ->
+        JsonObject(
+            dict
+                [ "kind", JsonValue.Create("expense") :> JsonNode
+                  "id", JsonValue.Create(e.Id)
+                  "payer", JsonValue.Create(e.Payer)
+                  "amount", JsonValue.Create(e.Amount)
+                  "currency", JsonValue.Create(e.Currency)
+                  "baseCents", JsonValue.Create(e.BaseCents)
+                  "description", JsonValue.Create(e.Description)
+                  "split", JsonValue.Create(SplitKind.name e.Split)
+                  "shares", JsonArray(e.Shares |> List.map (fun s -> shareToJson s :> JsonNode) |> Array.ofList) ]
+        )
+    | PaymentEntry p ->
+        JsonObject(
+            dict
+                [ "kind", JsonValue.Create("payment") :> JsonNode
+                  "id", JsonValue.Create(p.Id)
+                  "from", JsonValue.Create(p.From)
+                  "to", JsonValue.Create(p.To)
+                  "amount", JsonValue.Create(p.Amount)
+                  "currency", JsonValue.Create(p.Currency)
+                  "baseCents", JsonValue.Create(p.BaseCents) ]
+        )
+
+let private groupToJson (g: Group) : JsonNode =
+    let rates = JsonObject()
+
+    for KeyValue(cur, rate) in g.Rates do
+        rates[cur] <- JsonValue.Create(rate.ToString(CultureInfo.InvariantCulture))
+
+    JsonObject(
+        dict
+            [ "name", JsonValue.Create(g.Name) :> JsonNode
+              "currency", JsonValue.Create(g.Currency)
+              "members", strings g.Members
+              "rates", rates
+              "nextId", JsonValue.Create(g.NextId)
+              "entries", JsonArray(g.Entries |> List.map entryToJson |> Array.ofList) ]
+    )
+
+let private entryOfJson (n: JsonNode) =
+    match str n "kind" with
+    | "expense" ->
+        ExpenseEntry
+            { Id = int (int64Of n "id")
+              Payer = str n "payer"
+              Amount = int64Of n "amount"
+              Currency = str n "currency"
+              BaseCents = int64Of n "baseCents"
+              Description = str n "description"
+              Split = SplitKind.tryParse (str n "split") |> Option.get
+              Shares =
+                items n "shares"
+                |> List.map (fun s ->
+                    { Member = str s "member"
+                      Cents = int64Of s "cents" }) }
+    | "payment" ->
+        PaymentEntry
+            { Id = int (int64Of n "id")
+              From = str n "from"
+              To = str n "to"
+              Amount = int64Of n "amount"
+              Currency = str n "currency"
+              BaseCents = int64Of n "baseCents" }
+    | other -> raise (FormatException $"unknown entry kind {other}")
+
+let private groupOfJson (n: JsonNode) =
+    { Name = str n "name"
+      Currency = str n "currency"
+      Members = items n "members" |> List.map (fun m -> m.GetValue<string>())
+      Rates =
+        n["rates"].AsObject()
+        |> Seq.map (fun kv -> kv.Key, Decimal.Parse(kv.Value.GetValue<string>(), CultureInfo.InvariantCulture))
+        |> Map.ofSeq
+      Entries = items n "entries" |> List.map entryOfJson
+      NextId = int (int64Of n "nextId") }
+
+/// Load the book; a missing file is an empty book.
+let load (path: string) : Result<Book, CliError> =
+    if not (File.Exists path) then
+        Ok Map.empty
+    else
+        try
+            let root = JsonNode.Parse(File.ReadAllText path)
+
+            items root "groups"
+            |> List.map (fun g -> let grp = groupOfJson g in grp.Name, grp)
+            |> Map.ofList
+            |> Ok
+        with ex ->
+            Error(Storage $"cannot read data file {path}: {ex.Message}")
+
+/// Save atomically: write a temporary file next to the target, then rename it.
+let save (path: string) (book: Book) : Result<unit, CliError> =
+    let root =
+        JsonObject(
+            dict
+                [ "version", JsonValue.Create(1) :> JsonNode
+                  "groups", JsonArray(book |> Map.toList |> List.map (snd >> groupToJson) |> Array.ofList) ]
+        )
+
+    let full = Path.GetFullPath path
+    let tmp = Path.Combine(Path.GetDirectoryName full, $".{Path.GetFileName full}.tmp")
+
+    try
+        File.WriteAllText(tmp, root.ToJsonString(JsonSerializerOptions(WriteIndented = true)) + "\n")
+        File.Move(tmp, full, true)
+        Ok()
+    with ex ->
+        (try File.Delete tmp with _ -> ())
+        Error(Storage $"cannot write data file {path}: {ex.Message}")
