+/// Groups, entries, splitting and balances. Pure: no I/O.
+module Tally.Domain
+
+type SplitKind =
+    | Equal
+    | Exact
+    | Percent
+
+module SplitKind =
+    let name =
+        function
+        | Equal -> "equal"
+        | Exact -> "exact"
+        | Percent -> "percent"
+
+    let tryParse =
+        function
+        | "equal" -> Some Equal
+        | "exact" -> Some Exact
+        | "percent" -> Some Percent
+        | _ -> None
+
+type Share = { Member: string; Cents: int64 }
+
+type Expense =
+    { Id: int
+      Payer: string
+      Amount: int64
+      Currency: string
+      BaseCents: int64
+      Description: string
+      Split: SplitKind
+      Shares: Share list }
+
+type Payment =
+    { Id: int
+      From: string
+      To: string
+      Amount: int64
+      Currency: string
+      BaseCents: int64 }
+
+type Entry =
+    | ExpenseEntry of Expense
+    | PaymentEntry of Payment
+
+module Entry =
+    let id =
+        function
+        | ExpenseEntry e -> e.Id
+        | PaymentEntry p -> p.Id
+
+type Group =
+    { Name: string
+      Currency: string
+      Members: string list
+      Rates: Map<string, decimal>
+      Entries: Entry list
+      NextId: int }
+
+/// All groups, keyed by name.
+type Book = Map<string, Group>
+
+let newGroup name currency =
+    { Name = name
+      Currency = currency
+      Members = []
+      Rates = Map.empty
+      Entries = []
+      NextId = 1 }
+
+/// Split `total` cents by integer weights using the largest-remainder method.
+/// Remainder ties go to the participant listed first.
+let allocate (total: int64) (weights: (string * int64) list) : Share list =
+    let w = weights |> List.sumBy snd |> bigint
+    let t = bigint total
+
+    let parts =
+        weights
+        |> List.mapi (fun i (name, wi) ->
+            let q = t * bigint wi
+            i, name, int64 (q / w), q % w)
+
+    let missing = total - (parts |> List.sumBy (fun (_, _, floor, _) -> floor))
+
+    let bonus =
+        parts
+        |> List.sortBy (fun (i, _, _, rem) -> -rem, i)
+        |> List.truncate (int missing)
+        |> List.map (fun (i, _, _, _) -> i)
+        |> Set.ofList
+
+    parts
+    |> List.map (fun (i, name, floor, _) ->
+        { Member = name
+          Cents = floor + (if bonus.Contains i then 1L else 0L) })
+
+/// Base cents of `cents` expressed in `currency`.
+let toBase (group: Group) (currency: string) (cents: int64) : Result<int64, CliError> =
+    if currency = group.Currency then
+        Ok cents
+    else
+        match group.Rates.TryFind currency with
+        | Some rate -> Ok(Money.convert cents rate)
+        | None -> reject "no rate for currency: %s" currency
+
+let requireMember (group: Group) (name: string) =
+    if List.contains name group.Members then Ok name else reject "unknown member: %s" name
+
+let addEntry (group: Group) (makeEntry: int -> Entry) =
+    let entry = makeEntry group.NextId
+
+    { group with
+        Entries = group.Entries @ [ entry ]
+        NextId = group.NextId + 1 },
+    Entry.id entry
+
+let tryEntry (group: Group) (id: int) =
+    group.Entries |> List.tryFind (fun e -> Entry.id e = id)
+
+/// Balance of every member in member order: paid minus consumed, in base cents.
+let balances (group: Group) : (string * int64) list =
+    let deltas =
+        group.Entries
+        |> List.collect (function
+            | ExpenseEntry e -> (e.Payer, e.BaseCents) :: (e.Shares |> List.map (fun s -> s.Member, -s.Cents))
+            | PaymentEntry p -> [ p.From, p.BaseCents; p.To, -p.BaseCents ])
+
+    group.Members
+    |> List.map (fun m -> m, deltas |> List.sumBy (fun (n, c) -> if n = m then c else 0L))
