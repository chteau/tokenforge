+++ b/tests/Tally.Tests/Tests.fs
@@ -0,0 +1,124 @@
+module Tally.Tests.Program
+
+open Tally
+open Tally.Domain
+open Tally.Tests.Check
+
+let cents (shares: Share list) = shares |> List.map (fun s -> s.Cents)
+
+/// Run commands in sequence on a book, failing on the first error.
+let runAll (commands: string list list) =
+    commands
+    |> List.fold
+        (fun (book, _) args ->
+            match Commands.execute book args with
+            | Ok out -> (out.Changed |> Option.defaultValue book), out.Lines
+            | Error e -> failwithf "%A failed: %A" args e)
+        (Map.empty, [])
+
+let trip =
+    [ [ "group"; "add"; "trip"; "EUR" ]
+      [ "member"; "add"; "trip"; "alice" ]
+      [ "member"; "add"; "trip"; "bob" ]
+      [ "member"; "add"; "trip"; "carol" ] ]
+
+let lines commands = runAll (trip @ commands) |> snd
+
+let errorOf commands args =
+    let book, _ = runAll (trip @ commands)
+
+    match Commands.execute book args with
+    | Ok out -> failwithf "expected an error, got %A" out.Lines
+    | Error e -> e
+
+[<EntryPoint>]
+let main _ =
+    test "parse amounts" (fun () ->
+        equal (Some 1250L) (Money.parseAmount "12.5")
+        equal (Some 1200L) (Money.parseAmount "12")
+        equal None (Money.parseAmount "0")
+        equal None (Money.parseAmount "1.234")
+        equal None (Money.parseAmount ".5")
+        equal None (Money.parseAmount "-3")
+        equal (Some 100_000_000L) (Money.parseAmount "1000000.00")
+        equal None (Money.parseAmount "1000000.01"))
+
+    test "format money" (fun () ->
+        equal "3.40" (Money.format 340L)
+        equal "-0.05" (Money.format -5L)
+        equal "+20.00" (Money.formatSigned 2000L)
+        equal "0.00" (Money.formatSigned 0L))
+
+    test "banker's rounding on conversion" (fun () ->
+        equal 512L (Money.convert 1025L 0.5m)
+        equal 518L (Money.convert 1035L 0.5m)
+        equal 2760L (Money.convert 3000L 0.92m))
+
+    test "equal split hands extra cents to the first" (fun () ->
+        equal [ 334L; 333L; 333L ] (allocate 1000L [ "a", 1L; "b", 1L; "c", 1L ] |> cents)
+        equal [ 34L; 33L; 33L ] (allocate 100L [ "a", 1L; "b", 1L; "c", 1L ] |> cents))
+
+    test "largest remainder wins the cent" (fun () ->
+        equal [ 333L; 333L; 334L ] (allocate 1000L [ "a", 3333L; "b", 3333L; "c", 3334L ] |> cents))
+
+    test "exact weights reproduce exact shares" (fun () ->
+        equal [ 1250L; 750L ] (allocate 2000L [ "a", 1250L; "b", 750L ] |> cents))
+
+    test "allocations always sum to the total" (fun () ->
+        for total in [ 1L; 7L; 101L; 99_999L ] do
+            let shares = allocate total [ "a", 7L; "b", 13L; "c", 1L; "d", 29L ]
+            equal total (shares |> List.sumBy (fun s -> s.Cents)))
+
+    test "settle prefers exact matches" (fun () ->
+        let t = Settle.suggest [ "a", 1000L; "b", 500L; "c", -500L; "d", -1000L ]
+        equal [ "c", "b", 500L; "d", "a", 1000L ] (t |> List.map (fun t -> t.Debtor, t.Creditor, t.Cents)))
+
+    test "settle greedy largest first" (fun () ->
+        let t = Settle.suggest [ "a", 3000L; "b", 1000L; "c", -2500L; "d", -1500L ]
+        equal [ "c", "a", 2500L; "d", "b", 1000L; "d", "a", 500L ] (t |> List.map (fun t -> t.Debtor, t.Creditor, t.Cents)))
+
+    test "settle nothing to do" (fun () -> equal [] (Settle.suggest [ "a", 0L; "b", 0L ]))
+
+    test "expense and balances" (fun () ->
+        let out = lines [ [ "expense"; "trip"; "alice"; "30"; "Dinner" ]; [ "balances"; "trip" ] ]
+        equal [ "alice +20.00 EUR"; "bob -10.00 EUR"; "carol -10.00 EUR" ] out)
+
+    test "foreign currency list line" (fun () ->
+        let out =
+            lines
+                [ [ "rate"; "set"; "trip"; "USD"; "0.92" ]
+                  [ "expense"; "trip"; "bob"; "30"; "Taxi"; "--currency"; "USD" ]
+                  [ "list"; "trip" ] ]
+
+        equal [ "#1 expense bob 30.00 USD = 27.60 EUR \"Taxi\"" ] out)
+
+    test "ids are never reused" (fun () ->
+        let out =
+            lines
+                [ [ "expense"; "trip"; "alice"; "3"; "A" ]
+                  [ "rm"; "trip"; "1" ]
+                  [ "expense"; "trip"; "alice"; "3"; "B" ] ]
+
+        equal [ "added expense #2: 3.00 EUR" ] out)
+
+    test "missing rate is rejected" (fun () ->
+        equal
+            (Rejected "no rate for currency: GBP")
+            (errorOf [] [ "expense"; "trip"; "alice"; "3"; "A"; "--currency"; "GBP" ]))
+
+    test "exact shares must add up" (fun () ->
+        match errorOf [] [ "expense"; "trip"; "alice"; "30"; "A"; "--split"; "exact"; "--shares"; "alice=10,bob=19" ] with
+        | Rejected _ -> ()
+        | e -> failwithf "unexpected %A" e)
+
+    test "shares option is a usage error with equal split" (fun () ->
+        match errorOf [] [ "expense"; "trip"; "alice"; "30"; "A"; "--shares"; "alice=30" ] with
+        | Usage _ -> ()
+        | e -> failwithf "unexpected %A" e)
+
+    test "duplicate participant" (fun () ->
+        equal
+            (Rejected "duplicate participant: bob")
+            (errorOf [] [ "expense"; "trip"; "alice"; "30"; "A"; "--among"; "bob,bob" ]))
+
+    summary ()
