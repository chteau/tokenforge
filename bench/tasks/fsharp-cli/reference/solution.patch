@@ -0,0 +1,269 @@
+/// Command parsing and execution against an in-memory book. Pure: no I/O.
+module Tally.Commands
+
+open Tally.Domain
+
+/// Lines to print, and the new book when the command changed data.
+type Output = { Lines: string list; Changed: Book option }
+
+let private show lines = Ok { Lines = lines; Changed = None }
+let private check cond failure = if cond then Ok() else Error failure
+
+let private findGroup (book: Book) name =
+    match book.TryFind name with
+    | Some g -> Ok g
+    | None -> reject "unknown group: %s" name
+
+let private amountOf text =
+    match Money.parseAmount text with
+    | Some c -> Ok c
+    | None -> reject "invalid amount: %s" text
+
+let private currencyOf text =
+    if Money.isValidCurrency text then Ok text else reject "invalid currency: %s" text
+
+/// Parse `--opt value` pairs; every option at most once.
+let private parseOptions (allowed: string list) (args: string list) =
+    let rec go (acc: Map<string, string>) =
+        function
+        | [] -> Ok acc
+        | opt :: rest when List.contains opt allowed ->
+            match rest with
+            | _ when acc.ContainsKey opt -> usage "repeated option: %s" opt
+            | value :: rest' -> go (acc.Add(opt, value)) rest'
+            | [] -> usage "option %s needs a value" opt
+        | other :: _ -> usage "unknown option: %s" other
+
+    go Map.empty args
+
+let private parseShares (text: string) =
+    text.Split(',')
+    |> List.ofArray
+    |> traverse (fun item ->
+        match item.Split('=', 2) with
+        | [| name; value |] -> Ok(name, value)
+        | _ -> usage "invalid --shares item: %s" item)
+
+let private money (group: Group) amount currency baseCents =
+    if currency = group.Currency then
+        sprintf "%s %s" (Money.format amount) currency
+    else
+        sprintf "%s %s = %s %s" (Money.format amount) currency (Money.format baseCents) group.Currency
+
+let entryLine (group: Group) =
+    function
+    | ExpenseEntry e ->
+        sprintf "#%d expense %s %s \"%s\"" e.Id e.Payer (money group e.Amount e.Currency e.BaseCents) e.Description
+    | PaymentEntry p -> sprintf "#%d payment %s -> %s %s" p.Id p.From p.To (money group p.Amount p.Currency p.BaseCents)
+
+let private firstDuplicate (names: string list) =
+    names
+    |> List.countBy id
+    |> List.tryFind (fun (_, n) -> n > 1)
+    |> Option.map fst
+
+let private weightsFor (group: Group) kind (opts: Map<string, string>) =
+    let valued parse what =
+        opts["--shares"]
+        |> parseShares
+        |> Result.bind (
+            traverse (fun (name, v) ->
+                match parse v with
+                | Some w -> Ok(name, w)
+                | None -> reject "invalid %s: %s" what v)
+        )
+
+    match kind with
+    | Equal ->
+        let names =
+            match opts.TryFind "--among" with
+            | Some s -> s.Split(',') |> List.ofArray
+            | None -> group.Members
+
+        Ok(names |> List.map (fun n -> n, 1L))
+    | Exact -> valued Money.parseAmount "amount"
+    | Percent -> valued Money.parsePercent "percentage"
+
+let private addExpense (book: Book) groupName payer amountText desc optArgs =
+    outcome {
+        let! opts = parseOptions [ "--currency"; "--split"; "--among"; "--shares" ] optArgs
+
+        let! kind =
+            match opts.TryFind "--split" with
+            | None -> Ok Equal
+            | Some s ->
+                match SplitKind.tryParse s with
+                | Some k -> Ok k
+                | None -> usage "unknown split type: %s" s
+
+        do!
+            match kind, opts.ContainsKey "--among", opts.ContainsKey "--shares" with
+            | Equal, _, true -> usage "--shares is not allowed with --split equal"
+            | (Exact | Percent), true, _ -> usage "--among is only allowed with --split equal"
+            | (Exact | Percent), _, false -> usage "--shares is required for --split %s" (SplitKind.name kind)
+            | _ -> Ok()
+
+        do! opts.TryFind "--shares" |> Option.map (parseShares >> Result.map ignore) |> Option.defaultValue (Ok())
+        let! group = findGroup book groupName
+        let! _ = requireMember group payer
+        let! cents = amountOf amountText
+        do! check (desc <> "") (Rejected "description must not be empty")
+        let! currency = opts.TryFind "--currency" |> Option.defaultValue group.Currency |> currencyOf
+        let! total = toBase group currency cents
+        let! weights = weightsFor group kind opts
+        let names = List.map fst weights
+        let! _ = traverse (requireMember group) names
+
+        do!
+            match firstDuplicate names with
+            | Some n -> reject "duplicate participant: %s" n
+            | None -> Ok()
+
+        do! check (not names.IsEmpty) (Rejected "expense has no participants")
+        let sum = List.sumBy snd weights
+
+        do!
+            match kind with
+            | Exact when sum <> cents ->
+                reject "exact shares sum to %s but the amount is %s" (Money.format sum) (Money.format cents)
+            | Percent when sum <> 10_000L -> reject "percentages sum to %s, expected 100" (Money.format sum)
+            | _ -> Ok()
+
+        let group', id =
+            addEntry group (fun id ->
+                ExpenseEntry
+                    { Id = id
+                      Payer = payer
+                      Amount = cents
+                      Currency = currency
+                      BaseCents = total
+                      Description = desc
+                      Split = kind
+                      Shares = allocate total weights })
+
+        return
+            { Lines = [ sprintf "added expense #%d: %s %s" id (Money.format total) group.Currency ]
+              Changed = Some(book.Add(groupName, group')) }
+    }
+
+let private addPayment (book: Book) groupName from recipient amountText optArgs =
+    outcome {
+        let! opts = parseOptions [ "--currency" ] optArgs
+        let! group = findGroup book groupName
+        let! _ = requireMember group from
+        let! _ = requireMember group recipient
+        do! check (from <> recipient) (Rejected "a member cannot pay themselves")
+        let! cents = amountOf amountText
+        let! currency = opts.TryFind "--currency" |> Option.defaultValue group.Currency |> currencyOf
+        let! total = toBase group currency cents
+
+        let group', id =
+            addEntry group (fun id ->
+                PaymentEntry
+                    { Id = id
+                      From = from
+                      To = recipient
+                      Amount = cents
+                      Currency = currency
+                      BaseCents = total })
+
+        return
+            { Lines = [ sprintf "added payment #%d: %s %s" id (Money.format total) group.Currency ]
+              Changed = Some(book.Add(groupName, group')) }
+    }
+
+let private entryOf (group: Group) (idText: string) =
+    match System.Int32.TryParse idText with
+    | true, id when id > 0 ->
+        match tryEntry group id with
+        | Some e -> Ok e
+        | None -> reject "unknown entry: %s" idText
+    | _ -> reject "unknown entry: %s" idText
+
+/// Execute one command (arguments after the optional `--data FILE`).
+let execute (book: Book) (args: string list) : Result<Output, CliError> =
+    match args with
+    | [ "group"; "add"; name; currency ] ->
+        outcome {
+            do! check (Money.isValidName name) (Rejected $"invalid name: {name}")
+            let! currency = currencyOf currency
+            do! check (not (book.ContainsKey name)) (Rejected $"group already exists: {name}")
+
+            return
+                { Lines = [ $"created group {name} ({currency})" ]
+                  Changed = Some(book.Add(name, newGroup name currency)) }
+        }
+    | [ "group"; "list" ] ->
+        book
+        |> Map.toList
+        |> List.sortWith (fun (a, _) (b, _) -> System.String.CompareOrdinal(a, b))
+        |> List.map (fun (_, g) -> $"{g.Name} {g.Currency} members={g.Members.Length} entries={g.Entries.Length}")
+        |> show
+    | [ "member"; "add"; groupName; name ] ->
+        outcome {
+            let! group = findGroup book groupName
+            do! check (Money.isValidName name) (Rejected $"invalid name: {name}")
+            do! check (not (List.contains name group.Members)) (Rejected $"member already exists: {name}")
+            let group' = { group with Members = group.Members @ [ name ] }
+
+            return
+                { Lines = [ $"added member {name} to {groupName}" ]
+                  Changed = Some(book.Add(groupName, group')) }
+        }
+    | [ "rate"; "set"; groupName; currency; rateText ] ->
+        outcome {
+            let! group = findGroup book groupName
+            let! currency = currencyOf currency
+            do! check (currency <> group.Currency) (Rejected "cannot set a rate for the base currency")
+            let! rate = Money.parseRate rateText |> Option.map Ok |> Option.defaultValue (reject "invalid rate: %s" rateText)
+            let group' = { group with Rates = group.Rates.Add(currency, rate) }
+
+            return
+                { Lines = [ $"rate {currency}->{group.Currency} {rateText}" ]
+                  Changed = Some(book.Add(groupName, group')) }
+        }
+    | "expense" :: groupName :: payer :: amount :: desc :: opts -> addExpense book groupName payer amount desc opts
+    | "pay" :: groupName :: from :: recipient :: amount :: opts -> addPayment book groupName from recipient amount opts
+    | [ "list"; groupName ] -> findGroup book groupName |> Result.bind (fun g -> g.Entries |> List.map (entryLine g) |> show)
+    | [ "show"; groupName; idText ] ->
+        outcome {
+            let! group = findGroup book groupName
+            let! entry = entryOf group idText
+
+            let shares =
+                match entry with
+                | ExpenseEntry e -> e.Shares |> List.map (fun s -> $"  {s.Member} {Money.format s.Cents}")
+                | PaymentEntry _ -> []
+
+            return! show (entryLine group entry :: shares)
+        }
+    | [ "rm"; groupName; idText ] ->
+        outcome {
+            let! group = findGroup book groupName
+            let! entry = entryOf group idText
+            let id = Entry.id entry
+            let group' = { group with Entries = group.Entries |> List.filter (fun e -> Entry.id e <> id) }
+
+            return
+                { Lines = [ $"removed #{id}" ]
+                  Changed = Some(book.Add(groupName, group')) }
+        }
+    | [ "balances"; groupName ] ->
+        findGroup book groupName
+        |> Result.bind (fun g ->
+            balances g
+            |> List.map (fun (m, c) -> $"{m} {Money.formatSigned c} {g.Currency}")
+            |> show)
+    | [ "settle"; groupName ] ->
+        findGroup book groupName
+        |> Result.bind (fun g ->
+            match Settle.suggest (balances g) with
+            | [] -> show [ "all settled" ]
+            | transfers ->
+                transfers
+                |> List.map (fun t -> $"{t.Debtor} -> {t.Creditor} {Money.format t.Cents} {g.Currency}")
+                |> show)
+    | [] -> usage "missing command (try --help)"
+    | cmd :: _ when List.contains cmd [ "group"; "member"; "rate"; "expense"; "pay"; "list"; "show"; "rm"; "balances"; "settle" ] ->
+        usage "wrong arguments for %s (try --help)" cmd
+    | cmd :: _ -> usage "unknown command: %s" cmd
