+/// Settle-up suggestions. Pure: no I/O.
+module Tally.Settle
+
+type Transfer =
+    { Debtor: string
+      Creditor: string
+      Cents: int64 }
+
+/// Step 1: pair each debtor (member order) with the earliest creditor owed exactly that amount.
+let private exactMatches (names: string list) (start: Map<string, int64>) =
+    let step (bals: Map<string, int64>, acc) debtor =
+        let debt = -bals[debtor]
+
+        if debt <= 0L then
+            bals, acc
+        else
+            match names |> List.tryFind (fun c -> bals[c] = debt) with
+            | Some creditor ->
+                bals.Add(debtor, 0L).Add(creditor, 0L),
+                { Debtor = debtor
+                  Creditor = creditor
+                  Cents = debt }
+                :: acc
+            | None -> bals, acc
+
+    let bals, acc = names |> List.fold step (start, [])
+    bals, List.rev acc
+
+/// Step 2: largest debtor pays largest creditor (ties: member order) until all are zero.
+let rec private greedy (names: string list) (bals: Map<string, int64>) acc =
+    // List.sortBy is stable, so equal amounts keep member order.
+    let debtors = names |> List.filter (fun n -> bals[n] < 0L) |> List.sortBy (fun n -> bals[n])
+    let creditors = names |> List.filter (fun n -> bals[n] > 0L) |> List.sortBy (fun n -> -bals[n])
+
+    match debtors, creditors with
+    | d :: _, c :: _ ->
+        let amount = min -bals[d] bals[c]
+        let next = bals.Add(d, bals[d] + amount).Add(c, bals[c] - amount)
+        greedy names next ({ Debtor = d; Creditor = c; Cents = amount } :: acc)
+    | _ -> List.rev acc
+
+/// Transfers that bring every balance to zero (balances must sum to zero).
+let suggest (balances: (string * int64) list) : Transfer list =
+    let names = balances |> List.map fst
+    let bals, first = exactMatches names (Map.ofList balances)
+    first @ greedy names bals []
