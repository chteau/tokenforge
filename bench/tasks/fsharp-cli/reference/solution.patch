+module Tally.Program
+
+open System
+
+let usageText =
+    """usage: tally [--data FILE] <command> [args...]
+
+commands:
+  group add <group> <CUR>            create a group with a base currency
+  group list                         list groups
+  member add <group> <name>          add a member to a group
+  rate set <group> <CUR> <rate>      1 CUR = rate base currency
+  expense <group> <payer> <amount> <description>
+          [--currency CUR] [--split equal|exact|percent]
+          [--among a,b,...] [--shares a=V,b=V,...]
+  pay <group> <from> <to> <amount> [--currency CUR]
+  list <group>                       list entries
+  show <group> <id>                  show an entry and its shares
+  rm <group> <id>                    remove an entry
+  balances <group>                   member balances
+  settle <group>                     suggested transfers
+
+The data file is --data FILE, else $TALLY_DATA, else ./tally.json."""
+
+let private run (args: string list) =
+    let dataPath, rest =
+        match args with
+        | "--data" :: path :: rest -> Ok path, rest
+        | [ "--data" ] -> Error(Usage "option --data needs a value"), []
+        | rest ->
+            match Environment.GetEnvironmentVariable "TALLY_DATA" with
+            | null
+            | "" -> Ok "tally.json", rest
+            | path -> Ok path, rest
+
+    outcome {
+        let! path = dataPath
+        let! book = Store.load path
+        let! output = Commands.execute book rest
+
+        do!
+            match output.Changed with
+            | Some book' -> Store.save path book'
+            | None -> Ok()
+
+        return output.Lines
+    }
+
+[<EntryPoint>]
+let main argv =
+    match List.ofArray argv with
+    | [ "--help" ]
+    | [ "-h" ] ->
+        stdout.Write(usageText + "\n")
+        0
+    | args ->
+        match run args with
+        | Ok lines ->
+            lines |> List.iter (fun l -> stdout.Write(l + "\n"))
+            0
+        | Error failure ->
+            eprintf "error: %s\n" (CliError.message failure)
+            CliError.exitCode failure
