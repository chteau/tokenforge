diff --git a/tests/cli_reports.rs b/tests/cli_reports.rs
index 3b1a7c8..b655f47 100644
--- a/tests/cli_reports.rs
+++ b/tests/cli_reports.rs
@@ -95,3 +95,20 @@ fn corrupt_cache_is_rebuilt() {
         .read("summary.cache")
         .starts_with("# tally summary cache v1\n"));
 }
+
+#[test]
+fn summaries_follow_edits_that_keep_the_file_size() {
+    let t = sample();
+    t.ok(&["categories"]);
+    t.ok(&["report", "monthly"]);
+    t.ok(&["edit", "1", "--amount", "13.50"]);
+    let out = t.ok(&["categories", "--format", "csv"]);
+    assert!(out.contains("groceries,1,13.50,0.00\n"), "{out}");
+    t.ok(&["rename-category", "rent", "flat"]);
+    let out = t.ok(&["categories", "--format", "csv"]);
+    assert!(out.contains("flat,1,1200.00,0.00\n"), "{out}");
+    let edited = t.read("ledger.txt").replace("|45.20|", "|46.20|");
+    t.write("ledger.txt", &edited);
+    let out = t.ok(&["report", "monthly", "--format", "csv"]);
+    assert!(out.contains("2026-02,2,46.20,2500.00,2453.80\n"), "{out}");
+}
