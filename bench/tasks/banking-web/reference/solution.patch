+++ b/tests/api/transaction-filters.api.test.ts
@@ -0,0 +1,78 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { setup } from "../support/harness.ts";
+
+const descriptions = (body: { items: { description: string }[] }): string[] => body.items.map((i) => i.description);
+
+describe("transaction filters", () => {
+  it("filters by local date range, type, amount and text", async () => {
+    const t = setup();
+    const alice = await t.login("alice");
+    const id = t.accountId("QM-1000-0001");
+    const dates = await alice.get(`/api/accounts/${id}/transactions?from=2026-08-31&to=2026-09-01`);
+    assert.deepEqual(descriptions(dates.json()), ["Gym membership", "Late-night pharmacy"]);
+    const rent = await alice.get(`/api/accounts/${id}/transactions?type=debit&minAmount=1450&maxAmount=1450`);
+    assert.equal(rent.json().total, 3);
+    const search = await alice.get(`/api/accounts/${id}/transactions?q=NORTHWIND&limit=2`);
+    assert.equal(search.json().total, 3);
+    assert.deepEqual(descriptions(search.json()), ["Salary September", "Salary August"]);
+  });
+
+  it("rejects invalid filters with the offending field", async () => {
+    const t = setup();
+    const alice = await t.login("alice");
+    const id = t.accountId("QM-1000-0001");
+    const cases: [string, string][] = [
+      ["from=2026-02-30", "from"],
+      ["type=other", "type"],
+      ["minAmount=1.234", "minAmount"],
+      ["from=2026-09-02&to=2026-09-01", "to"],
+      ["minAmount=5&maxAmount=1", "maxAmount"],
+    ];
+    for (const [query, field] of cases) {
+      const res = await alice.get(`/api/accounts/${id}/transactions?${query}`);
+      assert.equal(res.status, 400, query);
+      assert.equal(res.json().error.details[0].field, field, query);
+    }
+  });
+});
+
+describe("transaction CSV export", () => {
+  it("exports matching entries with escaping and formula protection", async () => {
+    const t = setup();
+    const alice = await t.login("alice");
+    const id = t.accountId("QM-1000-0001");
+    const res = await alice.get(`/api/accounts/${id}/transactions.csv?from=2026-08-27&to=2026-08-27`);
+    assert.equal(res.status, 200);
+    assert.equal(res.headers["content-type"], "text/csv; charset=utf-8");
+    assert.equal(res.headers["content-disposition"], 'attachment; filename="QM-1000-0001-transactions.csv"');
+    assert.equal(
+      res.body,
+      "date,description,counterparty,reference,type,amount,currency,balance_after\r\n" +
+        '2026-08-27,"Dinner at ""The Anchor"", Pier 9",The Anchor,,debit,-38.40,USD,5675.32\r\n',
+    );
+    const formula = await alice.get(`/api/accounts/${id}/transactions.csv?q=concert`);
+    assert.match(formula.body, /\r\n2026-10-05,'=Concert tickets,Lyric Hall Box Office,,debit,-300\.00,USD,6660\.13\r\n$/);
+  });
+
+  it("is limited to accounts the caller may read", async () => {
+    const t = setup();
+    const bob = await t.login("bob");
+    assert.equal((await bob.get(`/api/accounts/${t.accountId("QM-1000-0001")}/transactions.csv`)).status, 404);
+  });
+});
+
+describe("activity page filters", () => {
+  it("pre-fills the form and links to a filtered export", async () => {
+    const t = setup();
+    const alice = await t.login("alice");
+    const id = t.accountId("QM-1000-0001");
+    const res = await alice.page(`/accounts/${id}/transactions?type=credit&q=salary`);
+    assert.equal(res.status, 200);
+    assert.match(res.body, /name="q" value="salary"/);
+    assert.match(res.body, /<option value="credit" selected>/);
+    assert.match(res.body, /Showing 1–3 of 3/);
+    assert.match(res.body, new RegExp(`href="/api/accounts/${id}/transactions\\.csv\\?type=credit&amp;q=salary"`));
+    assert.equal((await alice.page(`/accounts/${id}/transactions?to=never`)).status, 400);
+  });
+});
