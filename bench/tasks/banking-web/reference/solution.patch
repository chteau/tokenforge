+import { type ErrorDetail, validationError } from "../../shared/src/errors.ts";
+import { compareIsoDates, localDateString } from "../../shared/src/dates.ts";
+import { type Currency, parseAmount } from "../../shared/src/money.ts";
+import type { EntryType, LedgerEntry } from "./types.ts";
+
+/** Raw filter values as received from the query string (already shape-validated). */
+export interface TransactionFilterInput {
+  from?: string;
+  to?: string;
+  type?: EntryType;
+  minAmount?: string;
+  maxAmount?: string;
+  q?: string;
+}
+
+export interface TransactionFilter {
+  from?: string;
+  to?: string;
+  type?: EntryType;
+  minMinor?: number;
+  maxMinor?: number;
+  q?: string;
+  /** Calendar dates are compared in this time zone. */
+  timezone: string;
+}
+
+export const FILTER_FIELDS = ["from", "to", "type", "minAmount", "maxAmount", "q"] as const;
+
+export function isFilterActive(input: TransactionFilterInput): boolean {
+  return FILTER_FIELDS.some((field) => input[field] !== undefined && input[field] !== "");
+}
+
+/** Convert amounts to minor units for `currency` and check cross-field rules. */
+export function resolveFilter(input: TransactionFilterInput, currency: Currency, timezone: string): TransactionFilter {
+  const issues: ErrorDetail[] = [];
+  const amount = (field: "minAmount" | "maxAmount"): number | undefined => {
+    const raw = input[field];
+    if (raw === undefined) return undefined;
+    const minor = parseAmount(raw, currency);
+    if (minor === null) {
+      issues.push({ field, message: `must be a valid ${currency} amount` });
+      return undefined;
+    }
+    return minor;
+  };
+  const minMinor = amount("minAmount");
+  const maxMinor = amount("maxAmount");
+  if (input.from && input.to && compareIsoDates(input.from, input.to) > 0) {
+    issues.push({ field: "to", message: "must not be before from" });
+  }
+  if (minMinor !== undefined && maxMinor !== undefined && minMinor > maxMinor) {
+    issues.push({ field: "maxAmount", message: "must not be less than minAmount" });
+  }
+  if (issues.length) throw validationError(issues);
+  const q = input.q?.trim().toLowerCase();
+  return { from: input.from, to: input.to, type: input.type, minMinor, maxMinor, q: q || undefined, timezone };
+}
+
+export function matchesFilter(entry: LedgerEntry, filter: TransactionFilter): boolean {
+  if (filter.type && entry.type !== filter.type) return false;
+  if (filter.minMinor !== undefined && entry.amountMinor < filter.minMinor) return false;
+  if (filter.maxMinor !== undefined && entry.amountMinor > filter.maxMinor) return false;
+  if (filter.from || filter.to) {
+    const day = localDateString(new Date(entry.postedAt), filter.timezone);
+    if (filter.from && compareIsoDates(day, filter.from) < 0) return false;
+    if (filter.to && compareIsoDates(day, filter.to) > 0) return false;
+  }
+  if (filter.q) {
+    const haystack = [entry.description, entry.counterparty ?? "", entry.reference ?? ""].join("\n").toLowerCase();
+    if (!haystack.includes(filter.q)) return false;
+  }
+  return true;
+}
