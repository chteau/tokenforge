@@ -0,0 +1,29 @@
+import { localDateString } from "../../shared/src/dates.ts";
+import { formatDecimal } from "../../shared/src/money.ts";
+import { type LedgerEntry, signedAmount } from "./types.ts";
+
+export const CSV_HEADER = ["date", "description", "counterparty", "reference", "type", "amount", "currency", "balance_after"];
+
+/** Neutralise spreadsheet formulas in free-text cells. */
+function guardText(value: string | null): string {
+  const text = value ?? "";
+  return /^[=+\-@]/.test(text) ? `'${text}` : text;
+}
+
+export function escapeCsvField(value: string): string {
+  return /[",\r\n]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value;
+}
+
+export function entriesToCsv(entries: readonly LedgerEntry[], timezone: string): string {
+  const rows = entries.map((e) => [
+    localDateString(new Date(e.postedAt), timezone),
+    guardText(e.description),
+    guardText(e.counterparty),
+    guardText(e.reference),
+    e.type,
+    formatDecimal(signedAmount(e), e.currency),
+    e.currency,
+    formatDecimal(e.balanceAfterMinor, e.currency),
+  ]);
+  return [CSV_HEADER, ...rows].map((row) => row.map(escapeCsvField).join(",") + "\r\n").join("");
+}
