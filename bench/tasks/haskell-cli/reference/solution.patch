+++ b/src/Sheet/Grid.hs
@@ -0,0 +1,105 @@
+-- | Reading the comma-separated grid and classifying raw cell contents.
+module Sheet.Grid
+  ( Raw (..)
+  , Sheet (..)
+  , parseSheet
+  , splitCells
+  , classify
+  , readNumber
+  , inBounds
+  , rawAt
+  , allRefs
+  ) where
+
+import Data.Char (isDigit)
+import Data.List (dropWhileEnd)
+import qualified Data.Map.Strict as M
+
+import Sheet.Ref
+
+-- | The contents of a cell before evaluation.
+data Raw
+  = RawEmpty
+  | RawNumber Double
+  | RawText String
+  | RawFormula String
+  deriving (Eq, Show)
+
+data Sheet = Sheet
+  { sheetRows :: Int
+  , sheetCols :: Int
+  , sheetCells :: M.Map Ref Raw
+  -- ^ non-empty cells only
+  }
+  deriving (Show)
+
+parseSheet :: String -> Sheet
+parseSheet input = Sheet (length rows) width cells
+  where
+    rows = map (splitCells . dropWhileEnd (== '\r')) (lines input)
+    width = maximum (0 : map length rows)
+    cells =
+      M.fromList
+        [ (Ref r c, raw)
+        | (r, row) <- zip [0 ..] rows
+        , (c, txt) <- zip [0 ..] row
+        , let raw = classify txt
+        , raw /= RawEmpty
+        ]
+
+-- | Split a line at commas that are outside quotes and parentheses.
+splitCells :: String -> [String]
+splitCells = go (0 :: Int) False ""
+  where
+    go _ _ acc [] = [reverse acc]
+    go depth quoted acc (c : cs)
+      | c == '"' = go depth (not quoted) (c : acc) cs
+      | quoted = go depth quoted (c : acc) cs
+      | c == '(' = go (depth + 1) quoted (c : acc) cs
+      | c == ')' = go (max 0 (depth - 1)) quoted (c : acc) cs
+      | c == ',' && depth == 0 = reverse acc : go 0 False "" cs
+      | otherwise = go depth quoted (c : acc) cs
+
+classify :: String -> Raw
+classify txt = case trim txt of
+  "" -> RawEmpty
+  '=' : formula -> RawFormula formula
+  s
+    | Just inner <- unquote s -> RawText inner
+    | Just n <- readNumber s -> RawNumber n
+    | otherwise -> RawText s
+  where
+    trim = dropWhileEnd blank . dropWhile blank
+    blank c = c == ' ' || c == '\t'
+
+-- | Contents of a quoted field, or Nothing if the text is not one.
+unquote :: String -> Maybe String
+unquote ('"' : rest) = go rest
+  where
+    go "\"" = Just ""
+    go ('"' : '"' : more) = ('"' :) <$> go more
+    go ('"' : _) = Nothing
+    go (c : more) = (c :) <$> go more
+    go [] = Nothing
+unquote _ = Nothing
+
+-- | A number literal: optional minus, digits, optional fraction.
+readNumber :: String -> Maybe Double
+readNumber ('-' : rest) = negate <$> unsigned rest
+readNumber s = unsigned s
+
+unsigned :: String -> Maybe Double
+unsigned t = case span isDigit t of
+  (ip@(_ : _), "") -> Just (read (ip ++ ".0"))
+  (ip@(_ : _), '.' : fp@(_ : _)) | all isDigit fp -> Just (read (ip ++ "." ++ fp))
+  _ -> Nothing
+
+inBounds :: Sheet -> Ref -> Bool
+inBounds sheet (Ref r c) = r >= 0 && c >= 0 && r < sheetRows sheet && c < sheetCols sheet
+
+rawAt :: Sheet -> Ref -> Raw
+rawAt sheet ref = M.findWithDefault RawEmpty ref (sheetCells sheet)
+
+-- | Every cell of the grid, row by row.
+allRefs :: Sheet -> [Ref]
+allRefs sheet = [Ref r c | r <- [0 .. sheetRows sheet - 1], c <- [0 .. sheetCols sheet - 1]]
diff --git a/src/Sheet/Output.hs b/src/Sheet/Output.hs
