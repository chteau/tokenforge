--- a/README.md
+++ b/README.md
@@ -1 +1,29 @@
 # cells — a spreadsheet formula evaluator for the command line
+
+Evaluates a comma-separated grid of numbers, text and formulas (`=A1+B2*2`,
+`=SUM(A1:A9)`, `AVG`, `MIN`, `MAX`, `COUNT`, `IF`, comparisons, `&`) in
+dependency order and reports cycles and errors (`#CYCLE!`, `#REF!`, `#DIV/0!`,
+`#VALUE!`, `#NUM!`, `#PARSE!`, `#NAME?`).
+
+## Build
+
+Requires GHC 9.14 (boot packages only).
+
+    make build     # produces build/cells
+    make test      # builds and runs the test suite
+
+## Usage
+
+    cells eval sheet.csv          # print the evaluated grid
+    cells get sheet.csv B3        # print one cell (exit 1 if it is an error)
+    cells errors sheet.csv        # list error cells (exit 1 if any)
+    cells eval -                  # read the sheet from standard input
+
+## Layout
+
+- `src/Sheet/Ref.hs` — cell references
+- `src/Sheet/Grid.hs` — splitting lines into cells and classifying them
+- `src/Sheet/Formula.hs` — formula syntax tree and parser
+- `src/Sheet/Eval.hs` — cycle detection and evaluation
+- `src/Sheet/Format.hs`, `src/Sheet/Output.hs` — number formatting and rendering
+- `app/Main.hs` — command line
diff --git a/app/Main.hs b/app/Main.hs
new file mode 100644
index 0000000..273c1b9
--- /dev/null
+++ b/app/Main.hs
@@ -0,0 +1,70 @@
+module Main (main) where
+
+import Control.Exception (IOException, try)
+import qualified Data.ByteString as BS
+import qualified Data.Text as T
+import qualified Data.Text.Encoding as TE
+import Data.Text.Encoding.Error (lenientDecode)
+import qualified Data.Map as M
+import System.Environment (getArgs)
+import System.Exit (ExitCode (..), exitWith)
+import System.IO (hPutStrLn, hSetEncoding, stderr, stdout, utf8)
+
+import Sheet.Eval
+import Sheet.Grid
+import Sheet.Output
+import Sheet.Ref
+
+usage :: String
+usage =
+  unlines
+    [ "usage: cells <command> <file> [args]"
+    , ""
+    , "  cells eval <file>          print the evaluated grid"
+    , "  cells get <file> <cell>    print the value of one cell"
+    , "  cells errors <file>        list cells whose value is an error"
+    , ""
+    , "<file> may be - for standard input."
+    ]
+
+main :: IO ()
+main = do
+  mapM_ (`hSetEncoding` utf8) [stdout, stderr]
+  args <- getArgs
+  case args of
+    ["--help"] -> putStr usage
+    ["-h"] -> putStr usage
+    ["eval", file] -> do
+      sheet <- loadSheet file
+      putStr (renderGrid sheet (evaluateSheet sheet))
+    ["get", file, cell] -> case parseRef cell of
+      Nothing -> failWith 2 ("invalid cell reference: " ++ cell)
+      Just ref -> do
+        sheet <- loadSheet file
+        if inBounds sheet ref
+          then do
+            let res = M.findWithDefault (Right VEmpty) ref (evaluateSheet sheet)
+            putStrLn (renderValue res)
+            either (const (exitWith (ExitFailure 1))) (const (pure ())) res
+          else failWith 2 ("no such cell: " ++ cell)
+    ["errors", file] -> do
+      sheet <- loadSheet file
+      let ls = errorLines sheet (evaluateSheet sheet)
+      mapM_ putStrLn ls
+      if null ls then pure () else exitWith (ExitFailure 1)
+    [] -> failWith 2 "missing command (try --help)"
+    cmd : _
+      | cmd `elem` ["eval", "get", "errors"] -> failWith 2 ("wrong number of arguments for " ++ cmd)
+      | otherwise -> failWith 2 ("unknown command: " ++ cmd)
+
+loadSheet :: FilePath -> IO Sheet
+loadSheet file = do
+  bytes <- try (if file == "-" then BS.getContents else BS.readFile file)
+  case bytes :: Either IOException BS.ByteString of
+    Left _ -> failWith 3 ("cannot read " ++ file)
+    Right b -> pure (parseSheet (T.unpack (TE.decodeUtf8With lenientDecode b)))
+
+failWith :: Int -> String -> IO a
+failWith code msg = do
+  hPutStrLn stderr ("error: " ++ msg)
+  exitWith (ExitFailure code)
diff --git a/src/Sheet/Eval.hs b/src/Sheet/Eval.hs
new file mode 100644
index 0000000..5bc3e5f
--- /dev/null
+++ b/src/Sheet/Eval.hs
@@ -0,0 +1,174 @@
+-- | Evaluation of a whole sheet: cycle detection, then lazy, memoised
+-- evaluation of every cell.
+module Sheet.Eval
+  ( Value (..)
+  , CellError (..)
+  , Result
+  , evaluateSheet
+  , errorCode
+  ) where
+
+import Data.Graph (SCC (..), stronglyConnComp)
+import qualified Data.Map as M
+import qualified Data.Set as S
+
+import Sheet.Format (formatNumber)
+import Sheet.Formula
+import Sheet.Grid
+import Sheet.Ref
+
+data CellError = ErrParse | ErrName | ErrCycle | ErrRef | ErrDiv0 | ErrValue | ErrNum
+  deriving (Eq, Show)
+
+data Value = VNumber Double | VText String | VEmpty
+  deriving (Eq, Show)
+
+type Result = Either CellError Value
+
+errorCode :: CellError -> String
+errorCode e = case e of
+  ErrParse -> "#PARSE!"
+  ErrName -> "#NAME?"
+  ErrCycle -> "#CYCLE!"
+  ErrRef -> "#REF!"
+  ErrDiv0 -> "#DIV/0!"
+  ErrValue -> "#VALUE!"
+  ErrNum -> "#NUM!"
+
+-- | The value of every cell in the grid.
+evaluateSheet :: Sheet -> M.Map Ref Result
+evaluateSheet sheet = results
+  where
+    formulas = M.mapMaybe asFormula (sheetCells sheet)
+    asFormula (RawFormula src) = Just (parseFormula src)
+    asFormula _ = Nothing
+    graph = [(r, r, dependencies sheet e) | (r, Right e) <- M.toList formulas]
+    cyclic = S.fromList [r | CyclicSCC rs <- stronglyConnComp graph, r <- rs]
+    -- A lazy map: each entry is evaluated on first use, at most once.
+    results = M.fromList [(r, cellResult r) | r <- allRefs sheet]
+    look r
+      | inBounds sheet r = M.findWithDefault (Right VEmpty) r results
+      | otherwise = Left ErrRef
+    cellResult r = case rawAt sheet r of
+      RawEmpty -> Right VEmpty
+      RawNumber n -> Right (VNumber n)
+      RawText t -> Right (VText t)
+      RawFormula _ -> case M.lookup r formulas of
+        Just (Left SyntaxError) -> Left ErrParse
+        Just (Left UnknownFunction) -> Left ErrName
+        Just (Right e)
+          | r `S.member` cyclic -> Left ErrCycle
+          | otherwise -> emptyIsZero <$> evalExpr sheet look e
+        Nothing -> Right VEmpty
+    emptyIsZero VEmpty = VNumber 0
+    emptyIsZero v = v
+
+dependencies :: Sheet -> Expr -> [Ref]
+dependencies sheet e =
+  [ r
+  | (a, b) <- references e
+  , inBounds sheet a && inBounds sheet b
+  , r <- expand a b
+  ]
+
+-- | Cells of a range, row by row.
+expand :: Ref -> Ref -> [Ref]
+expand (Ref r1 c1) (Ref r2 c2) =
+  [Ref r c | r <- [min r1 r2 .. max r1 r2], c <- [min c1 c2 .. max c1 c2]]
+
+evalExpr :: Sheet -> (Ref -> Result) -> Expr -> Result
+evalExpr sheet look = go
+  where
+    go ex = case ex of
+      Number n -> Right (VNumber n)
+      Str s -> Right (VText s)
+      Cell r -> look r
+      Range _ _ -> Left ErrValue
+      Neg a -> go a >>= toNumber >>= numeric . negate
+      Bin op a b -> do
+        x <- go a
+        y <- go b
+        binary op x y
+      Call name args -> call name args
+
+    call "IF" [c, t, f] = do
+      n <- go c >>= toNumber
+      if n /= 0 then go t else go f
+    call "COUNT" args = numeric . fromIntegral . length =<< collect countable args
+    call name args = collect (fmap pure . toNumber) args >>= aggregate name
+
+    countable (VNumber n) = Right [n]
+    countable _ = Right []
+
+    collect direct args = concat <$> mapM one args
+      where
+        one (Range a b)
+          | inBounds sheet a && inBounds sheet b = do
+              vals <- mapM look (expand a b)
+              pure [n | VNumber n <- vals]
+          | otherwise = Left ErrRef
+        one e = go e >>= direct
+
+aggregate :: String -> [Double] -> Result
+aggregate name ns = case name of
+  "SUM" -> numeric (sum ns)
+  "AVG"
+    | null ns -> Left ErrDiv0
+    | otherwise -> numeric (sum ns / fromIntegral (length ns))
+  "MIN" -> numeric (if null ns then 0 else minimum ns)
+  "MAX" -> numeric (if null ns then 0 else maximum ns)
+  _ -> Left ErrName
+
+binary :: BinOp -> Value -> Value -> Result
+binary op x y = case op of
+  Add -> arith (+)
+  Sub -> arith (-)
+  Mul -> arith (*)
+  Div -> do
+    a <- toNumber x
+    b <- toNumber y
+    if b == 0 then Left ErrDiv0 else numeric (a / b)
+  Concat -> Right (VText (toText x ++ toText y))
+  _ -> do
+    o <- compareValues x y
+    Right (VNumber (if holds op o then 1 else 0))
+  where
+    arith f = do
+      a <- toNumber x
+      b <- toNumber y
+      numeric (f a b)
+
+holds :: BinOp -> Ordering -> Bool
+holds op o = case op of
+  Eq -> o == EQ
+  Ne -> o /= EQ
+  Lt -> o == LT
+  Le -> o /= GT
+  Gt -> o == GT
+  _ -> o /= LT
+
+compareValues :: Value -> Value -> Either CellError Ordering
+compareValues x y = case (x, y) of
+  (VText a, VText b) -> Right (compare a b)
+  (VText a, VEmpty) -> Right (compare a "")
+  (VEmpty, VText b) -> Right (compare "" b)
+  (VText _, _) -> Left ErrValue
+  (_, VText _) -> Left ErrValue
+  _ -> compare <$> toNumber x <*> toNumber y
+
+numeric :: Double -> Result
+numeric n
+  | isNaN n || isInfinite n = Left ErrNum
+  | otherwise = Right (VNumber n)
+
+toNumber :: Value -> Either CellError Double
+toNumber v = case v of
+  VNumber n -> Right n
+  VEmpty -> Right 0
+  VText _ -> Left ErrValue
+
+toText :: Value -> String
+toText v = case v of
+  VNumber n -> formatNumber n
+  VText s -> s
+  VEmpty -> ""
