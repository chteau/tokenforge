+module Main (main) where
+
+import Control.Monad (unless)
+import Data.IORef
+import qualified Data.Map as M
+import System.Exit (exitFailure)
+
+import Sheet.Eval
+import Sheet.Format
+import Sheet.Grid
+import Sheet.Output
+import Sheet.Ref
+
+valueOf :: String -> String -> String
+valueOf input cell = case parseRef cell of
+  Nothing -> error ("bad ref in test: " ++ cell)
+  Just r ->
+    let sheet = parseSheet input
+     in renderValue (M.findWithDefault (Right VEmpty) r (evaluateSheet sheet))
+
+evalGrid :: String -> String
+evalGrid input = let s = parseSheet input in renderGrid s (evaluateSheet s)
+
+cases :: [(String, String, String)]
+cases =
+  [ ("refs", showRef (Ref 0 0) ++ showRef (Ref 9 27), "A1AB10")
+  , ("column index", show (map columnIndex ["A", "z", "AA", "AZ"]), "[0,25,26,51]")
+  , ("split respects quotes and parens", show (splitCells "a,\"b,c\",=SUM(A1,B1),d"), show ["a", "\"b,c\"", "=SUM(A1,B1)", "d"])
+  , ("classify number", show (classify " -3.50 "), show (RawNumber (-3.5)))
+  , ("classify non-numbers", show (map classify ["+1", ".5", "1.", "1e3"]), show (map RawText ["+1", ".5", "1.", "1e3"]))
+  , ("classify quoted", show (classify "\"a\"\"b\""), show (RawText "a\"b"))
+  , ("format integer", formatNumber 42, "42")
+  , ("format fraction", formatNumber (1 / 3), "0.333333")
+  , ("format negative zero", formatNumber (-0.0000001), "0")
+  , ("format large", formatNumber 1e20, "100000000000000000000")
+  , ("precedence", valueOf "=1+2*3-4/2" "A1", "5")
+  , ("unary minus", valueOf "=-2*-3" "A1", "6")
+  , ("concat", valueOf "=1.5&\"x\"&A2\n\n" "A1", "1.5x")
+  , ("comparison", valueOf "=1<2,=\"b\"<\"a\",=A9=0" "A1", "1")
+  , ("text comparison", valueOf "=1<2,=\"b\"<\"a\"" "B1", "0")
+  , ("compare mixed", valueOf "=1<\"a\"" "A1", "#VALUE!")
+  , ("sum range skips text", valueOf "1,x,3,=SUM(A1:C1)" "D1", "4")
+  , ("avg empty", valueOf "x,=AVG(A1:A1)" "B1", "#DIV/0!")
+  , ("min max", valueOf "4,-2,9,=MAX(A1:C1)-MIN(A1:C1)" "D1", "11")
+  , ("count", valueOf "1,a,,=COUNT(A1:C1,5,\"t\")" "D1", "2")
+  , ("if lazy", valueOf "=IF(0,1/0,7)" "A1", "7")
+  , ("if text cond", valueOf "=IF(\"y\",1,2)" "A1", "#VALUE!")
+  , ("div zero", valueOf "=1/(2-2)" "A1", "#DIV/0!")
+  , ("text arithmetic", valueOf "abc,=A1+1" "B1", "#VALUE!")
+  , ("empty is zero", valueOf "=B1,," "A1", "0")
+  , ("out of grid", valueOf "=C1,1" "A1", "#REF!")
+  , ("range out of grid", valueOf "=SUM(A1:A5)" "A1", "#REF!")
+  , ("syntax", valueOf "=1+" "A1", "#PARSE!")
+  , ("bare range", valueOf "=A1:B1,2" "A1", "#PARSE!")
+  , ("if arity", valueOf "=IF(1,2)" "A1", "#PARSE!")
+  , ("unknown function", valueOf "=FOO(1)" "A1", "#NAME?")
+  , ("self cycle", valueOf "=A1+1" "A1", "#CYCLE!")
+  , ("cycle via range", valueOf "1,=SUM(A1:C1),=B1" "C1", "#CYCLE!")
+  , ("propagated cycle", valueOf "=B1,=A1,=A1*2" "C1", "#CYCLE!")
+  , ("first error wins", valueOf "=1/0,=Z1,=A1+B1" "C1", "#DIV/0!")
+  , ("case insensitive", valueOf "2,=sum(a1:a1)*b0" "B1", "#REF!")
+  , ("grid padding", evalGrid "1,2,3\n=A1\n", "1,2,3\n1,,\n")
+  , ("grid quoting", evalGrid "\"42\",\"a,b\",=\"\",#x,plain", "\"42\",\"a,b\",\"\",\"#x\",plain\n")
+  ]
+
+main :: IO ()
+main = do
+  failures <- newIORef (0 :: Int)
+  mapM_ (check failures) cases
+  n <- readIORef failures
+  putStrLn (show (length cases - n) ++ "/" ++ show (length cases) ++ " tests passed")
+  unless (n == 0) exitFailure
+  where
+    check failures (name, actual, expected)
+      | actual == expected = pure ()
+      | otherwise = do
+          modifyIORef failures (+ 1)
+          putStrLn ("FAIL " ++ name ++ ": expected " ++ show expected ++ ", got " ++ show actual)
