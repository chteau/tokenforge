index 0000000..3f0574e
--- /dev/null
+++ b/src/Sheet/Formula.hs
@@ -0,0 +1,136 @@
+-- | Formula syntax tree and parser.
+module Sheet.Formula
+  ( Expr (..)
+  , BinOp (..)
+  , FormulaError (..)
+  , parseFormula
+  , references
+  , knownFunctions
+  ) where
+
+import Data.Char (isAsciiLower, isAsciiUpper, toUpper)
+import Data.Functor (($>))
+import Text.Parsec
+import Text.Parsec.String (Parser)
+
+import Sheet.Ref
+
+data BinOp = Add | Sub | Mul | Div | Concat | Eq | Ne | Lt | Le | Gt | Ge
+  deriving (Eq, Show)
+
+data Expr
+  = Number Double
+  | Str String
+  | Cell Ref
+  | Range Ref Ref
+  | Neg Expr
+  | Bin BinOp Expr Expr
+  | Call String [Expr]
+  deriving (Eq, Show)
+
+data FormulaError = SyntaxError | UnknownFunction
+  deriving (Eq, Show)
+
+knownFunctions :: [String]
+knownFunctions = ["SUM", "AVG", "MIN", "MAX", "COUNT", "IF"]
+
+-- | Parse the text after the leading @=@ and validate function calls.
+parseFormula :: String -> Either FormulaError Expr
+parseFormula src = do
+  e <- either (const (Left SyntaxError)) Right (parse (spaces *> expr <* eof) "" src)
+  let calls = callsOf e
+  if any badArity calls
+    then Left SyntaxError
+    else
+      if any ((`notElem` knownFunctions) . fst) calls
+        then Left UnknownFunction
+        else Right e
+  where
+    badArity ("IF", n) = n /= 3
+    badArity (name, n) = name `elem` knownFunctions && n == 0
+
+callsOf :: Expr -> [(String, Int)]
+callsOf ex = case ex of
+  Call name args -> (name, length args) : concatMap callsOf args
+  Neg a -> callsOf a
+  Bin _ a b -> callsOf a ++ callsOf b
+  _ -> []
+
+-- | Every reference in an expression as a (corner, corner) pair; a single
+-- cell is a pair of equal corners.
+references :: Expr -> [(Ref, Ref)]
+references ex = case ex of
+  Cell r -> [(r, r)]
+  Range a b -> [(a, b)]
+  Neg a -> references a
+  Bin _ a b -> references a ++ references b
+  Call _ args -> concatMap references args
+  _ -> []
+
+lexeme :: Parser a -> Parser a
+lexeme p = p <* spaces
+
+sym :: String -> Parser String
+sym = lexeme . try . string
+
+expr :: Parser Expr
+expr = chainl1 concatenation (Bin <$> comparison)
+  where
+    comparison =
+      choice
+        [ sym "<=" $> Le, sym "<>" $> Ne, sym ">=" $> Ge
+        , sym "<" $> Lt, sym ">" $> Gt, sym "=" $> Eq
+        ]
+
+concatenation :: Parser Expr
+concatenation = chainl1 additive (sym "&" $> Bin Concat)
+
+additive :: Parser Expr
+additive = chainl1 term (sym "+" $> Bin Add <|> sym "-" $> Bin Sub)
+
+term :: Parser Expr
+term = chainl1 unary (sym "*" $> Bin Mul <|> sym "/" $> Bin Div)
+
+unary :: Parser Expr
+unary = (sym "-" *> (Neg <$> unary)) <|> primary
+
+primary :: Parser Expr
+primary = number <|> stringLit <|> between (sym "(") (sym ")") expr <|> nameOrRef
+
+number :: Parser Expr
+number = lexeme $ do
+  ip <- many1 digit
+  fp <- option "0" (char '.' *> many1 digit)
+  pure (Number (read (ip ++ "." ++ fp)))
+
+stringLit :: Parser Expr
+stringLit = lexeme (Str <$> (char '"' *> many strChar <* char '"'))
+  where
+    strChar = noneOf "\"" <|> try (string "\"\"" $> '"')
+
+asciiLetter :: Parser Char
+asciiLetter = satisfy (\c -> isAsciiUpper c || isAsciiLower c)
+
+-- | A cell reference, or a function call when the letters are followed by
+-- an opening parenthesis.
+nameOrRef :: Parser Expr
+nameOrRef = do
+  letters <- many1 asciiLetter
+  digits <- many digit
+  if null digits
+    then do
+      spaces
+      args <- between (sym "(") (sym ")") (argument `sepBy` sym ",")
+      pure (Call (map toUpper letters) args)
+    else Cell <$> toRef (letters ++ digits) <* spaces
+
+argument :: Parser Expr
+argument = try (Range <$> refToken <* sym ":" <*> refToken) <|> expr
+  where
+    refToken = lexeme $ do
+      letters <- many1 asciiLetter
+      digits <- many1 digit
+      toRef (letters ++ digits)
+
+toRef :: String -> Parser Ref
+toRef s = maybe (fail ("bad reference " ++ s)) pure (parseRef s)
