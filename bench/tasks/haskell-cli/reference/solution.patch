@@ -0,0 +1,39 @@
+-- | Text formatting of numbers and output fields.
+module Sheet.Format
+  ( formatNumber
+  , needsQuotes
+  , quoteField
+  ) where
+
+import Data.List (dropWhileEnd)
+import Data.Maybe (isJust)
+import Numeric (showFFloat)
+
+import Sheet.Grid (readNumber)
+
+-- | Six decimals, then trailing zeros and a trailing dot removed.
+formatNumber :: Double -> String
+formatNumber x
+  | trimmed == "-0" = "0"
+  | otherwise = trimmed
+  where
+    trimmed = dropWhileEnd (== '.') (dropWhileEnd (== '0') (showFFloat (Just 6) x ""))
+
+-- | Whether a text value must be quoted so that it reads back as the same text.
+needsQuotes :: String -> Bool
+needsQuotes t = case t of
+  [] -> True
+  c : _ ->
+    any (`elem` ",\"()") t
+      || blank c
+      || blank (last t)
+      || c `elem` "=#"
+      || isJust (readNumber t)
+  where
+    blank ch = ch == ' ' || ch == '\t'
+
+quoteField :: String -> String
+quoteField t = '"' : concatMap esc t ++ "\""
+  where
+    esc '"' = "\"\""
+    esc c = [c]
diff --git a/src/Sheet/Formula.hs b/src/Sheet/Formula.hs
