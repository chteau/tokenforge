index 0000000..9126ee3
--- /dev/null
+++ b/src/Sheet/Output.hs
@@ -0,0 +1,41 @@
+-- | Rendering evaluated sheets for the three commands.
+module Sheet.Output
+  ( renderGrid
+  , renderValue
+  , errorLines
+  ) where
+
+import Data.List (intercalate)
+import qualified Data.Map as M
+
+import Sheet.Eval
+import Sheet.Format
+import Sheet.Grid
+import Sheet.Ref
+
+resultAt :: M.Map Ref Result -> Ref -> Result
+resultAt results r = M.findWithDefault (Right VEmpty) r results
+
+-- | The whole grid, one line per row, every row as wide as the grid.
+renderGrid :: Sheet -> M.Map Ref Result -> String
+renderGrid sheet results =
+  unlines
+    [ intercalate "," [field (resultAt results (Ref r c)) | c <- [0 .. sheetCols sheet - 1]]
+    | r <- [0 .. sheetRows sheet - 1]
+    ]
+  where
+    field (Right (VText t)) | needsQuotes t = quoteField t
+    field res = renderValue res
+
+-- | A single value as shown by @get@ (text unquoted).
+renderValue :: Result -> String
+renderValue res = case res of
+  Left e -> errorCode e
+  Right (VNumber n) -> formatNumber n
+  Right (VText t) -> t
+  Right VEmpty -> ""
+
+-- | @<cell> <code>@ for every error cell, row by row.
+errorLines :: Sheet -> M.Map Ref Result -> [String]
+errorLines sheet results =
+  [showRef r ++ " " ++ errorCode e | r <- allRefs sheet, Left e <- [resultAt results r]]
diff --git a/src/Sheet/Ref.hs b/src/Sheet/Ref.hs
new file mode 100644
index 0000000..2d4baa6
--- /dev/null
+++ b/src/Sheet/Ref.hs
@@ -0,0 +1,52 @@
+-- | Cell references such as @A1@, @b7@ or @AA10@.
+module Sheet.Ref
+  ( Ref (..)
+  , parseRef
+  , showRef
+  , columnIndex
+  , columnName
+  ) where
+
+import Data.Char (chr, isAsciiLower, isAsciiUpper, isDigit, ord, toUpper)
+
+-- | A zero-based cell position: row 0 is the first line, column 0 is @A@.
+data Ref = Ref
+  { refRow :: !Int
+  , refCol :: !Int
+  }
+  deriving (Eq, Ord, Show)
+
+-- | Indices saturate here so that absurd references stay out of bounds
+-- instead of overflowing.
+limit :: Int
+limit = 1000000000
+
+-- | Parse a whole string as a reference (letters, then digits).
+parseRef :: String -> Maybe Ref
+parseRef s = case span isLetter s of
+  (letters@(_ : _), digits@(_ : _))
+    | all isDigit digits -> Just (Ref (rowIndex digits) (columnIndex letters))
+  _ -> Nothing
+  where
+    isLetter c = isAsciiUpper c || isAsciiLower c
+
+rowIndex :: String -> Int
+rowIndex ds = fromInteger (min (toInteger limit) (read ds)) - 1
+
+-- | Zero-based index of a column name: @A@ is 0, @Z@ is 25, @AA@ is 26.
+columnIndex :: String -> Int
+columnIndex = subtract 1 . foldl step 0
+  where
+    step acc c = min limit (acc * 26 + ord (toUpper c) - ord 'A' + 1)
+
+-- | Column name of a zero-based index.
+columnName :: Int -> String
+columnName = go . (+ 1)
+  where
+    go n
+      | n <= 0 = ""
+      | otherwise = let (q, r) = (n - 1) `divMod` 26 in go q ++ [chr (ord 'A' + r)]
+
+-- | Canonical upper-case spelling of a reference.
+showRef :: Ref -> String
+showRef (Ref r c) = columnName c ++ show (r + 1)
