+#!/usr/bin/env lua
+-- tpl: render Mustache-style templates with JSON data. See README.md.
+local script_dir = (arg and arg[0] or ""):match("^(.*)/[^/]*$") or "."
+package.path = script_dir .. "/../?.lua;" .. package.path
+os.exit(require("tpl.cli").main(arg))
