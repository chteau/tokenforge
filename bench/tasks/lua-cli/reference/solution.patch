+-- Rendering of parsed templates, including partial loading.
+local context = require("tpl.context")
+local errors = require("tpl.errors")
+local json = require("tpl.json")
+local parser = require("tpl.parser")
+
+local M = {}
+
+-- Insert `indent` at the start of `text` and after every newline that does not end it.
+local function indent_lines(text, indent)
+  if indent == "" or text == "" then return text end
+  local ends_with_newline = text:sub(-1) == "\n"
+  local body = ends_with_newline and text:sub(1, -2) or text
+  return indent .. body:gsub("\n", "\n" .. indent) .. (ends_with_newline and "\n" or "")
+end
+
+local Renderer = {}
+Renderer.__index = Renderer
+
+function Renderer:partial_path(name)
+  local dir = self.partials_dir
+  if dir:sub(-1) == "/" then return dir .. name .. ".mustache" end
+  return dir .. "/" .. name .. ".mustache"
+end
+
+function Renderer:load_partial(node, source)
+  if not self.partials_dir then errors.template(source, node.line, "partial not found: %s", node.name) end
+  local path = self:partial_path(node.name)
+  local f = io.open(path, "rb")
+  if not f then errors.template(source, node.line, "partial not found: %s", node.name) end
+  local text = f:read("a")
+  f:close()
+  if not text then errors.template(source, node.line, "partial not found: %s", node.name) end
+  local indent = node.indent or ""
+  return parser.parse(indent_lines(text, indent), path), path
+end
+
+function Renderer:render_nodes(nodes, stack, out, source, depth)
+  for _, node in ipairs(nodes) do
+    local kind = node.type
+    if kind == "text" then
+      out[#out + 1] = node.value
+    elseif kind == "name" or kind == "&" then
+      local text, container = context.text(context.lookup(stack, node.name))
+      if not text then errors.template(source, node.line, "cannot interpolate %s: %s", container, node.name) end
+      out[#out + 1] = kind == "name" and context.escape(text) or text
+    elseif kind == "#" then
+      local value = context.lookup(stack, node.name)
+      if context.truthy(value) then
+        local items = json.is_array(value) and value or { value }
+        for _, item in ipairs(items) do
+          stack[#stack + 1] = item
+          self:render_nodes(node.children, stack, out, source, depth)
+          stack[#stack] = nil
+        end
+      end
+    elseif kind == "^" then
+      if not context.truthy(context.lookup(stack, node.name)) then
+        self:render_nodes(node.children, stack, out, source, depth)
+      end
+    elseif kind == ">" then
+      if depth + 1 > self.max_depth then
+        errors.template(source, node.line, "partial depth limit exceeded: %s", node.name)
+      end
+      local tree, path = self:load_partial(node, source)
+      self:render_nodes(tree, stack, out, path, depth + 1)
+    end
+  end
+end
+
+--- Render template text with `data`.
+-- opts: source (name for errors), partials_dir (or nil), max_depth.
+function M.render(template, data, opts)
+  local self = setmetatable({ partials_dir = opts.partials_dir, max_depth = opts.max_depth or 10 }, Renderer)
+  local tree = parser.parse(template, opts.source or "-")
+  local out = {}
+  self:render_nodes(tree, { data }, out, opts.source or "-", 0)
+  return table.concat(out)
+end
+
+return M
