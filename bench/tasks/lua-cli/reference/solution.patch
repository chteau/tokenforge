index 0000000..0c3eaf9
--- /dev/null
+++ b/tpl/json.lua
@@ -0,0 +1,212 @@
+-- A strict RFC 8259 JSON decoder.
+--
+-- Arrays and objects are tables tagged with distinct metatables so that `[]` and `{}`
+-- stay distinguishable, and JSON null is the `M.null` sentinel.
+local M = {}
+
+M.null = setmetatable({}, { __tostring = function() return "null" end })
+
+local ARRAY = { __name = "json.array" }
+local OBJECT = { __name = "json.object" }
+
+function M.is_array(v)
+  return type(v) == "table" and getmetatable(v) == ARRAY
+end
+
+function M.is_object(v)
+  return type(v) == "table" and getmetatable(v) == OBJECT
+end
+
+function M.array(t)
+  return setmetatable(t or {}, ARRAY)
+end
+
+function M.object(t)
+  return setmetatable(t or {}, OBJECT)
+end
+
+-- Parse failure at byte index `pos` (#s + 1 means "unexpected end of input").
+local SyntaxError = {}
+
+local function fail(s, pos)
+  local line, line_start = 1, 1
+  local i = s:find("\n", 1, true)
+  while i and i < pos do
+    line = line + 1
+    line_start = i + 1
+    i = s:find("\n", i + 1, true)
+  end
+  error(setmetatable({ line = line, column = pos - line_start + 1 }, SyntaxError), 0)
+end
+
+local function skip_ws(s, i)
+  return s:find("[^ \t\r\n]", i) or #s + 1
+end
+
+local function is_digit(c)
+  return c ~= nil and c >= 48 and c <= 57
+end
+
+local function skip_digits(s, i)
+  return s:find("[^0-9]", i) or #s + 1
+end
+
+local function parse_literal(s, i, word, value)
+  for k = 1, #word do
+    if s:byte(i + k - 1) ~= word:byte(k) then
+      fail(s, i + k - 1)
+    end
+  end
+  return value, i + #word
+end
+
+local function parse_number(s, i)
+  local start = i
+  if s:byte(i) == 45 then -- '-'
+    i = i + 1
+  end
+  local c = s:byte(i)
+  if c == 48 then
+    i = i + 1
+  elseif is_digit(c) then
+    i = skip_digits(s, i)
+  else
+    fail(s, i)
+  end
+  if s:byte(i) == 46 then -- '.'
+    i = i + 1
+    if not is_digit(s:byte(i)) then fail(s, i) end
+    i = skip_digits(s, i)
+  end
+  c = s:byte(i)
+  if c == 101 or c == 69 then -- 'e' / 'E'
+    i = i + 1
+    c = s:byte(i)
+    if c == 43 or c == 45 then i = i + 1 end
+    if not is_digit(s:byte(i)) then fail(s, i) end
+    i = skip_digits(s, i)
+  end
+  return tonumber(s:sub(start, i - 1)), i
+end
+
+local function parse_hex4(s, i)
+  for k = 0, 3 do
+    if not s:sub(i + k, i + k):match("%x") then fail(s, i + k) end
+  end
+  return tonumber(s:sub(i, i + 3), 16), i + 4
+end
+
+local ESCAPES = {
+  [34] = '"', [92] = "\\", [47] = "/", [98] = "\b",
+  [102] = "\f", [110] = "\n", [114] = "\r", [116] = "\t",
+}
+
+local function parse_unicode_escape(s, i)
+  -- s:sub(i - 2, i - 1) == "\\u"
+  local cp, j = parse_hex4(s, i)
+  if cp >= 0xDC00 and cp <= 0xDFFF then fail(s, i) end
+  if cp >= 0xD800 and cp <= 0xDBFF then
+    if s:byte(j) ~= 92 then fail(s, j) end
+    if s:byte(j + 1) ~= 117 then fail(s, j + 1) end
+    local low
+    low, j = parse_hex4(s, j + 2)
+    if low < 0xDC00 or low > 0xDFFF then fail(s, j - 4) end
+    cp = 0x10000 + (cp - 0xD800) * 0x400 + (low - 0xDC00)
+  end
+  return utf8.char(cp), j
+end
+
+local function parse_string(s, i)
+  local buf = {}
+  i = i + 1
+  while true do
+    local j = s:find('[\0-\31"\\]', i)
+    if not j then fail(s, #s + 1) end
+    buf[#buf + 1] = s:sub(i, j - 1)
+    local c = s:byte(j)
+    if c == 34 then
+      return table.concat(buf), j + 1
+    elseif c == 92 then
+      local e = s:byte(j + 1)
+      if e == 117 then
+        buf[#buf + 1], i = parse_unicode_escape(s, j + 2)
+      elseif ESCAPES[e] then
+        buf[#buf + 1] = ESCAPES[e]
+        i = j + 2
+      else
+        fail(s, j + 1)
+      end
+    else
+      fail(s, j)
+    end
+  end
+end
+
+local parse_value
+
+local function parse_array(s, i)
+  local arr = M.array()
+  i = skip_ws(s, i + 1)
+  if s:byte(i) == 93 then return arr, i + 1 end
+  while true do
+    local v
+    v, i = parse_value(s, i)
+    arr[#arr + 1] = v
+    i = skip_ws(s, i)
+    local c = s:byte(i)
+    if c == 93 then return arr, i + 1 end
+    if c ~= 44 then fail(s, i) end
+    i = i + 1
+  end
+end
+
+local function parse_object(s, i)
+  local obj = M.object()
+  i = skip_ws(s, i + 1)
+  if s:byte(i) == 125 then return obj, i + 1 end
+  while true do
+    if s:byte(i) ~= 34 then fail(s, i) end
+    local key, v
+    key, i = parse_string(s, i)
+    i = skip_ws(s, i)
+    if s:byte(i) ~= 58 then fail(s, i) end
+    v, i = parse_value(s, i + 1)
+    obj[key] = v
+    i = skip_ws(s, i)
+    local c = s:byte(i)
+    if c == 125 then return obj, i + 1 end
+    if c ~= 44 then fail(s, i) end
+    i = skip_ws(s, i + 1)
+  end
+end
+
+parse_value = function(s, i)
+  i = skip_ws(s, i)
+  local c = s:byte(i)
+  if c == 123 then return parse_object(s, i)
+  elseif c == 91 then return parse_array(s, i)
+  elseif c == 34 then return parse_string(s, i)
+  elseif c == 116 then return parse_literal(s, i, "true", true)
+  elseif c == 102 then return parse_literal(s, i, "false", false)
+  elseif c == 110 then return parse_literal(s, i, "null", M.null)
+  elseif c == 45 or is_digit(c) then return parse_number(s, i)
+  end
+  fail(s, i)
+end
+
+--- Decode a JSON text. Returns the value, or nil, line, column on a syntax error.
+function M.decode(text)
+  local ok, result = pcall(function()
+    local v, i = parse_value(text, 1)
+    i = skip_ws(text, i)
+    if i <= #text then fail(text, i) end
+    return v
+  end)
+  if ok then return result end
+  if getmetatable(result) == SyntaxError then
+    return nil, result.line, result.column
+  end
+  error(result, 0)
+end
+
+return M
