@@ -0,0 +1,24 @@
+-- Minimal test runner: `lua tests/run.lua` from the repository root.
+package.path = "./?.lua;./tests/?.lua;" .. package.path
+
+local SUITES = { "json_test", "parser_test", "render_test", "cli_test" }
+
+local total, failures = 0, 0
+for _, suite in ipairs(SUITES) do
+  local cases = require(suite)
+  local names = {}
+  for name in pairs(cases) do names[#names + 1] = name end
+  table.sort(names)
+  for _, name in ipairs(names) do
+    total = total + 1
+    local ok, err = pcall(cases[name])
+    if ok then
+      print("ok   " .. suite .. "." .. name)
+    else
+      failures = failures + 1
+      print("FAIL " .. suite .. "." .. name .. ": " .. tostring(err))
+    end
+  end
+end
+print(string.format("tests: %d, failures: %d", total, failures))
+os.exit(failures == 0 and 0 or 1)
diff --git a/tpl/cli.lua b/tpl/cli.lua
new file mode 100644
index 0000000..2c4b2ee
--- /dev/null
+++ b/tpl/cli.lua
@@ -0,0 +1,116 @@
+-- Command-line handling: options, file I/O and exit codes.
+local errors = require("tpl.errors")
+local json = require("tpl.json")
+local render = require("tpl.render")
+
+local M = {}
+
+M.USAGE = [[
+Usage: tpl [options] TEMPLATE
+
+Render a Mustache-style TEMPLATE (a file, or - for stdin) with JSON data.
+
+Options:
+  -d, --data FILE      JSON data file (- for stdin); default: empty object
+  -p, --partials DIR   directory with partial templates (NAME.mustache)
+  -o, --output FILE    write the result to FILE instead of stdout
+      --max-depth N    maximum partial nesting depth (default 10)
+  -h, --help           show this help
+]]
+
+local VALUE_OPTIONS = {
+  ["-d"] = "data", ["--data"] = "data",
+  ["-p"] = "partials", ["--partials"] = "partials",
+  ["-o"] = "output", ["--output"] = "output",
+  ["--max-depth"] = "max_depth",
+}
+
+--- Parse argv into an options table; returns nil when help was requested.
+function M.parse_args(argv)
+  local opts, positional = {}, {}
+  local i = 1
+  while i <= #argv do
+    local a = argv[i]
+    if a == "-h" or a == "--help" then
+      return nil
+    elseif VALUE_OPTIONS[a] then
+      if argv[i + 1] == nil then errors.raise(errors.USAGE, "option " .. a .. " requires a value") end
+      opts[VALUE_OPTIONS[a]] = argv[i + 1]
+      i = i + 1
+    elseif a:sub(1, 1) == "-" and a ~= "-" then
+      errors.raise(errors.USAGE, "unknown option " .. a)
+    else
+      positional[#positional + 1] = a
+    end
+    i = i + 1
+  end
+  if #positional ~= 1 then errors.raise(errors.USAGE, "expected exactly one TEMPLATE argument") end
+  opts.template = positional[1]
+  if opts.max_depth then
+    local n = opts.max_depth:match("^%d+$") and math.tointeger(tonumber(opts.max_depth))
+    if not n then errors.raise(errors.USAGE, "invalid --max-depth: " .. opts.max_depth) end
+    opts.max_depth = n
+  end
+  if opts.template == "-" and opts.data == "-" then
+    errors.raise(errors.USAGE, "template and data cannot both be read from stdin")
+  end
+  return opts
+end
+
+local function read_file(path, code)
+  if path == "-" then return io.stdin:read("a") or "" end
+  local f, err = io.open(path, "rb")
+  local text = f and f:read("a")
+  if f then f:close() end
+  if not text then errors.raise(code, "cannot read " .. path .. ": " .. tostring(err or "read failed")) end
+  return text
+end
+
+local function load_data(path)
+  if not path then return json.object() end
+  local value, line, column = json.decode(read_file(path, errors.DATA))
+  if value == nil then
+    errors.raise(errors.DATA, string.format("%s: invalid JSON at line %d, column %d", path, line, column))
+  end
+  if not json.is_object(value) then errors.raise(errors.DATA, path .. ": top-level value must be an object") end
+  return value
+end
+
+local function write_output(path, text)
+  if not path then
+    io.stdout:write(text)
+    return
+  end
+  local f, err = io.open(path, "wb")
+  if not f then errors.raise(errors.IO, "cannot write " .. path .. ": " .. tostring(err)) end
+  f:write(text)
+  f:close()
+end
+
+local function run(argv)
+  local opts = M.parse_args(argv)
+  if not opts then
+    io.stdout:write(M.USAGE)
+    return
+  end
+  local data = load_data(opts.data)
+  local template = read_file(opts.template, errors.IO)
+  local result = render.render(template, data, {
+    source = opts.template, partials_dir = opts.partials, max_depth = opts.max_depth,
+  })
+  write_output(opts.output, result)
+end
+
+--- Run the tool; returns the process exit code.
+function M.main(argv)
+  local ok, err = pcall(run, argv)
+  if ok then return 0 end
+  if errors.is(err) then
+    io.stderr:write("error: ", err.message, "\n")
+    return err.code
+  end
+  io.stderr:write("error: internal error: ", tostring(err), "\n")
+  return 1
+end
+
+return M
diff --git a/tpl/context.lua b/tpl/context.lua
new file mode 100644
index 0000000..fd77999
--- /dev/null
+++ b/tpl/context.lua
@@ -0,0 +1,56 @@
+-- Context-stack lookup and value conversion rules.
+local json = require("tpl.json")
+
+local M = {}
+
+--- Resolve a (dotted) name against a context stack (innermost frame last).
+-- Returns nil when the name is missing.
+function M.lookup(stack, name)
+  if name == "." then return stack[#stack] end
+  local first, rest = name:match("^([^.]+)(.*)$")
+  local value
+  for i = #stack, 1, -1 do
+    local frame = stack[i]
+    if json.is_object(frame) and frame[first] ~= nil then
+      value = frame[first]
+      break
+    end
+  end
+  if value == nil then return nil end
+  for segment in rest:gmatch("[^.]+") do
+    if not json.is_object(value) or value[segment] == nil then return nil end
+    value = value[segment]
+  end
+  return value
+end
+
+function M.truthy(value)
+  if value == nil or value == json.null or value == false or value == "" then return false end
+  if json.is_array(value) then return #value > 0 end
+  return true
+end
+
+local function number_text(n)
+  if n == math.floor(n) and math.abs(n) < 1e15 then
+    return string.format("%d", math.tointeger(n))
+  end
+  return string.format("%.14g", n)
+end
+
+--- Text of a scalar value; returns nil and "array"/"object" for containers.
+function M.text(value)
+  local t = type(value)
+  if value == nil or value == json.null then return "" end
+  if t == "string" then return value end
+  if t == "number" then return number_text(value) end
+  if t == "boolean" then return tostring(value) end
+  return nil, json.is_array(value) and "array" or "object"
+end
+
+local ESCAPES = { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;", ["'"] = "&#39;" }
+
+function M.escape(s)
+  return (s:gsub("[&<>\"']", ESCAPES))
+end
+
+return M
diff --git a/tpl/errors.lua b/tpl/errors.lua
new file mode 100644
index 0000000..aa2a698
--- /dev/null
+++ b/tpl/errors.lua
@@ -0,0 +1,29 @@
+-- Error values carried through `error()` and turned into exit codes by the CLI.
+local M = {}
+
+M.USAGE = 2
+M.TEMPLATE = 3
+M.DATA = 4
+M.IO = 5
+
+local Error = {}
+Error.__index = Error
+Error.__tostring = function(e)
+  return e.message
+end
+
+--- Raise an error that the command line reports as `error: <message>` with exit `code`.
+function M.raise(code, message)
+  error(setmetatable({ code = code, message = message }, Error), 0)
+end
+
+--- Raise a template error located at `source:line`.
+function M.template(source, line, fmt, ...)
+  M.raise(M.TEMPLATE, string.format("%s:%d: %s", source, line, string.format(fmt, ...)))
+end
+
+function M.is(value)
+  return getmetatable(value) == Error
+end
+
+return M
diff --git a/tpl/json.lua b/tpl/json.lua
