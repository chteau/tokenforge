+-- Template parsing: tokenizer, standalone-line handling and tree building.
+--
+-- A parsed template is a list of nodes:
+--   { type = "text", value = s }
+--   { type = "name" | "&", name = n, line = l }           escaped / raw variable
+--   { type = "#" | "^", name = n, line = l, children = {...} }
+--   { type = ">", name = n, line = l, indent = s }         partial
+local errors = require("tpl.errors")
+
+local M = {}
+
+local SECTION_TYPES = { ["#"] = true, ["^"] = true }
+local STANDALONE_TYPES = { ["#"] = true, ["^"] = true, ["/"] = true, ["!"] = true, [">"] = true, ["="] = true }
+local SIGILS = { ["#"] = true, ["^"] = true, ["/"] = true, [">"] = true, ["&"] = true }
+
+local function trim(s)
+  return s:match("^%s*(.-)%s*$")
+end
+
+local function count_newlines(s)
+  local _, n = s:gsub("\n", "")
+  return n
+end
+
+local function valid_segments(name, sep)
+  if name == "" then return false end
+  for segment in (name .. sep):gmatch("(.-)%" .. sep) do
+    if not segment:match("^[%w_%-]+$") then return false end
+  end
+  return true
+end
+
+function M.valid_name(name)
+  return name == "." or valid_segments(name, ".")
+end
+
+function M.valid_partial_name(name)
+  return valid_segments(name, "/")
+end
+
+-- Append text tokens to `tokens`, split so that each token holds at most one line ending.
+local function add_text(tokens, text)
+  local start = 1
+  while start <= #text do
+    local nl = text:find("\n", start, true)
+    if not nl then
+      tokens[#tokens + 1] = { type = "text", value = text:sub(start) }
+      return
+    end
+    tokens[#tokens + 1] = { type = "text", value = text:sub(start, nl), newline = true }
+    start = nl + 1
+  end
+end
+
+-- Turn the content of one tag into a token, or raise a template error.
+local function make_tag(content, triple, source, line)
+  if triple then
+    local name = trim(content)
+    if not M.valid_name(name) then errors.template(source, line, "invalid tag name '%s'", name) end
+    return { type = "&", name = name, line = line }
+  end
+  local sigil = content:sub(1, 1)
+  if sigil == "!" then
+    return { type = "!", line = line }
+  elseif sigil == "=" then
+    if #content < 2 or content:sub(-1) ~= "=" then errors.template(source, line, "invalid delimiter tag") end
+    local open, close = trim(content:sub(2, -2)):match("^(%S+)%s+(%S+)$")
+    if not open or open:find("=", 1, true) or close:find("=", 1, true) then
+      errors.template(source, line, "invalid delimiter tag")
+    end
+    return { type = "=", line = line, open = open, close = close }
+  end
+  local kind = SIGILS[sigil] and sigil or "name"
+  local name = trim(kind == "name" and content or content:sub(2))
+  if kind == ">" then
+    if not M.valid_partial_name(name) then errors.template(source, line, "invalid partial name '%s'", name) end
+  elseif not M.valid_name(name) then
+    errors.template(source, line, "invalid tag name '%s'", name)
+  end
+  return { type = kind, name = name, line = line }
+end
+
+-- Split `src` into text and tag tokens, checking section nesting on the way so that the
+-- first problem in source order is the one reported.
+local function tokenize(src, source)
+  local tokens, open_sections = {}, {}
+  local open, close = "{{", "}}"
+  local pos, line = 1, 1
+  while pos <= #src do
+    local s = src:find(open, pos, true)
+    if not s then
+      add_text(tokens, src:sub(pos))
+      break
+    end
+    local text = src:sub(pos, s - 1)
+    add_text(tokens, text)
+    line = line + count_newlines(text)
+
+    local triple = open == "{{" and close == "}}" and src:sub(s + 2, s + 2) == "{"
+    local content_start = s + (triple and 3 or #open)
+    local closer = triple and "}}}" or close
+    local e = src:find(closer, content_start, true)
+    if not e then errors.template(source, line, "unclosed tag") end
+    local content = src:sub(content_start, e - 1)
+    local tag = make_tag(content, triple, source, line)
+
+    if SECTION_TYPES[tag.type] then
+      open_sections[#open_sections + 1] = tag
+    elseif tag.type == "/" then
+      local top = open_sections[#open_sections]
+      if not top then errors.template(source, line, "unexpected closing tag '%s'", tag.name) end
+      if top.name ~= tag.name then
+        errors.template(source, line, "mismatched closing tag '%s', expected '%s'", tag.name, top.name)
+      end
+      open_sections[#open_sections] = nil
+    elseif tag.type == "=" then
+      open, close = tag.open, tag.close
+    end
+    tokens[#tokens + 1] = tag
+    line = line + count_newlines(content)
+    pos = e + #closer
+  end
+  local top = open_sections[#open_sections]
+  if top then errors.template(source, top.line, "unclosed section '%s'", top.name) end
+  return tokens
+end
+
+-- Drop the whitespace and line ending around standalone tags.
+local function strip_standalone(tokens)
+  local out = {}
+  local i, n = 1, #tokens
+  while i <= n do
+    local last = i
+    while last < n and not tokens[last].newline do last = last + 1 end
+    local tag, standalone = nil, true
+    for k = i, last do
+      local t = tokens[k]
+      if t.type == "text" then
+        local blank = t.newline and "^[ \t]*\r?\n$" or "^[ \t]*$"
+        if not t.value:match(blank) then standalone = false break end
+      elseif STANDALONE_TYPES[t.type] and not tag then
+        tag = t
+      else
+        standalone = false
+        break
+      end
+    end
+    if standalone and tag then
+      if tag.type == ">" and tokens[i].type == "text" then tag.indent = tokens[i].value end
+      out[#out + 1] = tag
+    else
+      table.move(tokens, i, last, #out + 1, out)
+    end
+    i = last + 1
+  end
+  return out
+end
+
+-- Nest section contents; comments and delimiter changes produce no nodes.
+local function build_tree(tokens)
+  local root = {}
+  local stack, current = {}, root
+  for _, t in ipairs(tokens) do
+    if SECTION_TYPES[t.type] then
+      t.children = {}
+      current[#current + 1] = t
+      stack[#stack + 1] = current
+      current = t.children
+    elseif t.type == "/" then
+      current = table.remove(stack)
+    elseif t.type ~= "!" and t.type ~= "=" then
+      current[#current + 1] = t
+    end
+  end
+  return root
+end
+
+--- Parse template text. `source` names the file in error messages.
+function M.parse(src, source)
+  return build_tree(strip_standalone(tokenize(src, source)))
+end
+
+return M
