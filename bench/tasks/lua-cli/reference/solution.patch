+-- Assertion helpers shared by the test files.
+local M = {}
+
+function M.eq(actual, expected, msg)
+  if actual ~= expected then
+    error(string.format("%sexpected %q, got %q", msg and (msg .. ": ") or "",
+      tostring(expected), tostring(actual)), 2)
+  end
+end
+
+--- Call fn and return the raised error value; fails if nothing was raised.
+function M.raises(fn)
+  local ok, err = pcall(fn)
+  if ok then error("expected an error", 2) end
+  return err
+end
+
+return M
