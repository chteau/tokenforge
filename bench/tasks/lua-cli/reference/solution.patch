+local json = require("tpl.json")
+local h = require("helpers")
+
+local T = {}
+
+function T.scalars_and_containers()
+  local v = json.decode(' {"a": [1, 2.5, -3e2], "b": {}, "c": [], "d": null, "e": true, "f": "x"} ')
+  h.eq(v.a[1], 1)
+  h.eq(v.a[2], 2.5)
+  h.eq(v.a[3], -300.0)
+  h.eq(json.is_object(v.b), true)
+  h.eq(json.is_array(v.c), true)
+  h.eq(v.d, json.null)
+  h.eq(v.e, true)
+  h.eq(v.f, "x")
+end
+
+function T.string_escapes()
+  local v = json.decode('"a\\n\\t\\"\\\\\\/\\u00e9\\ud83d\\ude00"')
+  h.eq(v, 'a\n\t"\\/\u{e9}\u{1F600}')
+end
+
+function T.duplicate_keys_last_wins()
+  h.eq(json.decode('{"k": 1, "k": 2}').k, 2)
+end
+
+local function position(text)
+  local v, line, col = json.decode(text)
+  h.eq(v, nil, "value")
+  return line .. ":" .. col
+end
+
+function T.error_positions()
+  h.eq(position("[1,]"), "1:4")
+  h.eq(position('{"a" 1}'), "1:6")
+  h.eq(position("tru}"), "1:4")
+  h.eq(position("01"), "1:2")
+  h.eq(position("{} x"), "1:4")
+  h.eq(position('{\n  "a": [1,\n'), "3:1")
+  h.eq(position(""), "1:1")
+  h.eq(position('"a\\qb"'), "1:4")
+  h.eq(position('"tab\there"'), "1:5")
+end
+
+return T
