+local parser = require("tpl.parser")
+local errors = require("tpl.errors")
+local h = require("helpers")
+
+local T = {}
+
+local function message(src)
+  local err = h.raises(function() parser.parse(src, "t") end)
+  h.eq(errors.is(err), true, "template error")
+  h.eq(err.code, errors.TEMPLATE, "code")
+  return err.message
+end
+
+function T.names()
+  h.eq(parser.valid_name("."), true)
+  h.eq(parser.valid_name("a.b-c_1"), true)
+  h.eq(parser.valid_name("a..b"), false)
+  h.eq(parser.valid_name("a b"), false)
+  h.eq(parser.valid_partial_name("mail/footer"), true)
+  h.eq(parser.valid_partial_name("../x"), false)
+end
+
+function T.section_tree()
+  local tree = parser.parse("a{{#s}}b{{x}}{{/s}}", "t")
+  h.eq(#tree, 2)
+  h.eq(tree[2].type, "#")
+  h.eq(tree[2].children[2].name, "x")
+end
+
+function T.standalone_lines_removed()
+  local tree = parser.parse("  {{#s}}  \r\nx\n{{/s}}", "t")
+  h.eq(#tree, 1)
+  h.eq(tree[1].children[1].value, "x\n")
+end
+
+function T.standalone_partial_indent()
+  local tree = parser.parse("\t {{> p}}\n", "t")
+  h.eq(tree[1].type, ">")
+  h.eq(tree[1].indent, "\t ")
+end
+
+function T.errors()
+  h.eq(message("x\n{{#a}}\n"), "t:2: unclosed section 'a'")
+  h.eq(message("{{/a}}"), "t:1: unexpected closing tag 'a'")
+  h.eq(message("{{#a}}\n{{/b}}"), "t:2: mismatched closing tag 'b', expected 'a'")
+  h.eq(message("\n\nok {{ x"), "t:3: unclosed tag")
+  h.eq(message("{{a b}}"), "t:1: invalid tag name 'a b'")
+  h.eq(message("{{> a.b}}"), "t:1: invalid partial name 'a.b'")
+  h.eq(message("{{=<% %>}}"), "t:1: invalid delimiter tag")
+  h.eq(message("{{/x}}\n{{bad name}}"), "t:1: unexpected closing tag 'x'")
+end
+
+function T.multiline_comment_counts_lines()
+  h.eq(message("{{! one\ntwo }}\n{{/x}}"), "t:3: unexpected closing tag 'x'")
+end
+
+return T
