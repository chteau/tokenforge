+local cli = require("tpl.cli")
+local errors = require("tpl.errors")
+local h = require("helpers")
+
+local T = {}
+
+local function usage_error(argv)
+  local err = h.raises(function() cli.parse_args(argv) end)
+  h.eq(err.code, errors.USAGE)
+end
+
+function T.parse_options()
+  local o = cli.parse_args({ "page.mustache", "-d", "a.json", "--data", "b.json", "--max-depth", "3" })
+  h.eq(o.template, "page.mustache")
+  h.eq(o.data, "b.json")
+  h.eq(o.max_depth, 3)
+  h.eq(cli.parse_args({ "x", "--help" }), nil)
+end
+
+function T.usage_errors()
+  usage_error({})
+  usage_error({ "a", "b" })
+  usage_error({ "a", "--bogus" })
+  usage_error({ "a", "--data" })
+  usage_error({ "a", "--max-depth", "-1" })
+  usage_error({ "-", "-d", "-" })
+end
+
+return T
