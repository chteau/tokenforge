+local render = require("tpl.render")
+local json = require("tpl.json")
+local h = require("helpers")
+
+local T = {}
+
+local function r(template, data_text, opts)
+  return render.render(template, json.decode(data_text or "{}"), opts or {})
+end
+
+function T.escaping_and_raw()
+  local data = '{"x": "<a href=\\"q\\">&\'"}'
+  h.eq(r("{{x}}", data), "&lt;a href=&quot;q&quot;&gt;&amp;&#39;")
+  h.eq(r("{{{x}}}|{{& x}}", data), '<a href="q">&\'|<a href="q">&\'')
+end
+
+function T.numbers_and_literals()
+  h.eq(r("{{a}} {{b}} {{c}} {{d}} {{e}} {{f}}", '{"a": 2.0, "b": 1.5, "c": 1e20, "d": true, "e": null, "f": -7}'),
+    "2 1.5 1e+20 true  -7")
+end
+
+function T.dotted_and_parent_lookup()
+  local data = '{"user": {"name": "Ann", "tags": ["x"]}, "site": "S"}'
+  h.eq(r("{{user.name}}{{#user}}{{site}}{{name}}{{/user}}{{user.nope.x}}", data), "AnnSAnn")
+  h.eq(r("{{#user.tags}}{{.}}{{user.name}}{{/user.tags}}", data), "xAnn")
+end
+
+function T.null_key_stops_search()
+  h.eq(r("{{#inner}}[{{v}}]{{/inner}}", '{"v": "outer", "inner": {"v": null}}'), "[]")
+end
+
+function T.falsy_values()
+  local data = '{"s": "", "a": [], "f": false, "n": null, "z": 0, "o": {}}'
+  h.eq(r("{{#s}}1{{/s}}{{#a}}2{{/a}}{{#f}}3{{/f}}{{#n}}4{{/n}}{{#m}}5{{/m}}", data), "")
+  h.eq(r("{{^s}}1{{/s}}{{^a}}2{{/a}}{{#z}}{{.}}{{/z}}{{#o}}o{{/o}}", data), "120o")
+end
+
+function T.interpolating_container_fails()
+  local err = h.raises(function() r("\n{{a}}", '{"a": [1]}', { source = "page" }) end)
+  h.eq(err.message, "page:2: cannot interpolate array: a")
+end
+
+function T.set_delimiters()
+  h.eq(r("{{=<% %>=}}<% a %>{{a}}<%={{ }}=%>{{{a}}}", '{"a": "<"}'), "&lt;{{a}}<")
+end
+
+return T
