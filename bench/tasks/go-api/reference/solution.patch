+func TestRefundInvoice(t *testing.T) {
+	tests := []struct {
+		name         string
+		pay          int64 // amount paid before refunding; 0 leaves the invoice open
+		refunds      []int64
+		wantKind     apperr.Kind // for the last refund; KindInternal means success
+		wantStatus   billing.InvoiceStatus
+		wantRefunded int64
+	}{
+		{name: "partial", pay: 1000, refunds: []int64{300}, wantStatus: billing.InvoicePaid, wantRefunded: 300},
+		{name: "full in two steps", pay: 1000, refunds: []int64{300, 700}, wantStatus: billing.InvoiceRefunded, wantRefunded: 1000},
+		{name: "exceeds refundable", pay: 1000, refunds: []int64{600, 401}, wantKind: apperr.KindInvalid, wantStatus: billing.InvoicePaid, wantRefunded: 600},
+		{name: "already refunded", pay: 1000, refunds: []int64{1000, 1}, wantKind: apperr.KindConflict, wantStatus: billing.InvoiceRefunded, wantRefunded: 1000},
+		{name: "open invoice", pay: 0, refunds: []int64{100}, wantKind: apperr.KindConflict, wantStatus: billing.InvoiceOpen},
+		{name: "zero amount", pay: 1000, refunds: []int64{0}, wantKind: apperr.KindInvalid, wantStatus: billing.InvoicePaid},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			f := newBillingFixture(t)
+			ctx := context.Background()
+			inv := f.openInvoice(t, 1000)
+			if tt.pay > 0 {
+				if _, err := f.svc.RecordPayment(ctx, f.admin, inv.ID, RecordPaymentInput{AmountCents: tt.pay, Method: "card"}); err != nil {
+					t.Fatal(err)
+				}
+			}
+			var err error
+			for _, a := range tt.refunds {
+				_, err = f.svc.RefundInvoice(ctx, f.admin, inv.ID, RefundInput{AmountCents: a, Reason: "duplicate charge"})
+			}
+			if tt.wantKind == apperr.KindInternal && err != nil {
+				t.Fatalf("unexpected error %v", err)
+			}
+			if tt.wantKind != apperr.KindInternal && apperr.KindOf(err) != tt.wantKind {
+				t.Fatalf("err = %v, want kind %v", err, tt.wantKind)
+			}
+			got, _ := f.invoices.Get(ctx, inv.ID)
+			if got.Status != tt.wantStatus || got.RefundedCents != tt.wantRefunded {
+				t.Fatalf("status=%s refunded=%d", got.Status, got.RefundedCents)
+			}
