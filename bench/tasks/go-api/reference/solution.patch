+
+// MemoryRefunds is an in-memory RefundRepository.
+type MemoryRefunds struct {
+	mu      sync.RWMutex
+	refunds []billing.Refund
+}
+
+// NewMemoryRefunds returns an empty repository.
+func NewMemoryRefunds() *MemoryRefunds { return &MemoryRefunds{} }
+
+func (m *MemoryRefunds) Create(_ context.Context, r billing.Refund) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.refunds = append(m.refunds, r)
+	return nil
+}
+
+func (m *MemoryRefunds) ListByInvoice(_ context.Context, invoiceID string) ([]billing.Refund, error) {
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	var out []billing.Refund
+	for _, r := range m.refunds {
+		if r.InvoiceID == invoiceID {
+			out = append(out, r)
+		}
+	}
+	return out, nil
+}
