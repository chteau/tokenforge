@@ -0,0 +1,17 @@
+-- Partial and full refunds of paid invoices.
+
+ALTER TABLE invoices
+    ADD COLUMN refunded_cents BIGINT NOT NULL DEFAULT 0 CHECK (refunded_cents >= 0 AND refunded_cents <= paid_cents),
+    DROP CONSTRAINT invoices_status_check,
+    ADD CONSTRAINT invoices_status_check CHECK (status IN ('draft', 'open', 'paid', 'void', 'refunded'));
+
+CREATE TABLE refunds (
+    id           TEXT PRIMARY KEY,
+    invoice_id   TEXT NOT NULL REFERENCES invoices (id),
+    amount_cents BIGINT NOT NULL CHECK (amount_cents > 0),
+    reason       TEXT NOT NULL,
+    refunded_by  TEXT NOT NULL REFERENCES users (id),
+    created_at   TIMESTAMPTZ NOT NULL
+);
+
+CREATE INDEX refunds_invoice_idx ON refunds (invoice_id);
