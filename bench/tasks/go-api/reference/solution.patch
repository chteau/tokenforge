+// RefundInput is the payload for refunding part or all of a paid invoice.
+type RefundInput struct {
+	AmountCents int64  `json:"amount_cents"`
+	Reason      string `json:"reason"`
+}
+
+// RefundInvoice returns money to the customer of a paid invoice. The total
+// refunded can never exceed the amount paid; once everything has been
+// refunded the invoice moves to the refunded status.
+func (s *BillingService) RefundInvoice(ctx context.Context, p auth.Principal, id string, in RefundInput) (billing.Refund, error) {
+	if _, err := s.loadInvoiceFor(ctx, p, id); err != nil {
+		return billing.Refund{}, err
+	}
+	if err := requireRole(p, auth.RoleBillingAdmin); err != nil {
+		return billing.Refund{}, err
+	}
+	v := validation.New()
+	v.Positive("amount_cents", in.AmountCents)
+	v.Required("reason", in.Reason)
+	v.MaxLen("reason", in.Reason, 500)
+	if err := v.Err(); err != nil {
+		return billing.Refund{}, err
+	}
+	now := s.clock.Now()
+	inv, err := s.invoices.Update(ctx, id, func(inv *billing.Invoice) error {
+		if inv.Status != billing.InvoicePaid {
+			return apperr.Conflict("invoice_not_refundable", "only paid invoices can be refunded")
+		}
+		if in.AmountCents > inv.RefundableCents() {
+			return apperr.Invalid("amount_exceeds_refundable", "amount exceeds the refundable balance",
+				map[string]string{"amount_cents": "must not exceed " + strconv.FormatInt(inv.RefundableCents(), 10)})
+		}
+		inv.RefundedCents += in.AmountCents
+		if inv.RefundableCents() == 0 {
+			inv.Status = billing.InvoiceRefunded
+		}
+		inv.UpdatedAt = now
+		return nil
+	})
+	if err != nil {
+		return billing.Refund{}, mapNotFound(err, errInvoiceNotFound)
+	}
+	ref := billing.Refund{
+		ID:          ids.New("ref"),
+		InvoiceID:   inv.ID,
+		AmountCents: in.AmountCents,
+		Reason:      strings.TrimSpace(in.Reason),
+		RefundedBy:  p.UserID,
+		CreatedAt:   now,
+	}
+	if err := s.refunds.Create(ctx, ref); err != nil {
+		return billing.Refund{}, err
+	}
+	if err := s.audit.Record(ctx, p.UserID, audit.ActionInvoiceRefunded, "invoice", inv.ID, map[string]string{
+		"refund_id": ref.ID, "amount_cents": strconv.FormatInt(ref.AmountCents, 10),
+	}); err != nil {
+		return billing.Refund{}, err
+	}
+	s.notifier.NotifyUser(ctx, inv.CustomerID, notifications.TemplateRefundIssued, map[string]string{
+		"Number": inv.Number,
+		"Amount": billing.FormatCents(ref.AmountCents, inv.Currency),
+		"Reason": ref.Reason,
+	})
+	return ref, nil
+}
