diff --git a/test/streak_test.dart b/test/streak_test.dart
new file mode 100644
index 0000000..949bc96
--- /dev/null
+++ b/test/streak_test.dart
@@ -0,0 +1,50 @@
+import 'package:habits/habits.dart';
+
+import 'check.dart';
+
+Habit habit(List<String> days, {int goal = 7}) =>
+    Habit('h', goal, days.map((d) => Date.tryParse(d)!));
+
+Date d(String s) => Date.tryParse(s)!;
+
+void main() {
+  final s = Suite();
+  s.test('current streak ending today', () {
+    final h = habit(['2026-10-06', '2026-10-07', '2026-10-08']);
+    expectEq(h.streaks(d('2026-10-08')).current, 3);
+  });
+  s.test('streak survives until today ends', () {
+    final h = habit(['2026-10-06', '2026-10-07']);
+    expectEq(h.streaks(d('2026-10-08')).current, 2);
+    expectEq(h.streaks(d('2026-10-09')).current, 0);
+  });
+  s.test('streak across year and leap day', () {
+    final h = habit(['2025-12-30', '2025-12-31', '2026-01-01']);
+    expectEq(h.streaks(d('2026-01-01')).current, 3);
+    final leap = habit(['2024-02-28', '2024-02-29', '2024-03-01']);
+    expectEq(leap.streaks(d('2024-03-01')).best, 3);
+  });
+  s.test('best and total ignore future days', () {
+    final h = habit(
+        ['2026-01-01', '2026-01-02', '2026-01-05', '2026-01-06', '2026-01-07']);
+    final st = h.streaks(d('2026-01-06'));
+    expectEq(st.best, 2);
+    expectEq(st.total, 4);
+    expectEq(st.last, d('2026-01-06'));
+  });
+  s.test('weekly streak', () {
+    // Weeks of 2026-09-21, 09-28 meet goal 2; week of 10-05 has one day so far.
+    final h = habit(
+        ['2026-09-21', '2026-09-23', '2026-09-28', '2026-09-29', '2026-10-05'],
+        goal: 2);
+    expectEq(h.streaks(d('2026-10-08')).weekly, 2);
+    h.done.add(d('2026-10-08'));
+    expectEq(h.streaks(d('2026-10-08')).weekly, 3);
+  });
+  s.test('empty habit', () {
+    final st = habit([]).streaks(d('2026-10-08'));
+    expectEq(st.current + st.best + st.total + st.weekly, 0);
+    expectEq(st.last, null);
+  });
+  s.done();
+}
