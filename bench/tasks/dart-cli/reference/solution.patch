+import 'dart:io';
+
+import 'package:habits/habits.dart';
+
+import 'check.dart';
+
+void main() {
+  final s = Suite();
+  final dir = Directory.systemTemp.createTempSync('habits-test-');
+  final file = '${dir.path}/sub/habits.json';
+  (int, String, String) run(List<String> args, {String today = '2026-10-08'}) {
+    final out = StringBuffer();
+    final err = StringBuffer();
+    final code =
+        runCli(['--file', file, ...args], {'HABITS_TODAY': today}, out, err);
+    return (code, out.toString(), err.toString());
+  }
+
+  s.test('add, done and streak', () {
+    expectEq(run(['add', '--goal', '3', 'read']).$2, 'added read\n');
+    expectEq(run(['done', 'read', '2026-10-07']).$2, 'done read 2026-10-07\n');
+    expectEq(run(['done', 'read']).$2, 'done read 2026-10-08\n');
+    expectEq(run(['done', 'read']).$2, 'already done read 2026-10-08\n');
+    expectEq(run(['streak', 'read']).$2,
+        'current: 2\nbest: 2\ntotal: 2\nweekly: 0\nlast: 2026-10-08\n');
+  });
+  s.test('errors and exit codes', () {
+    expectEq(run(['add', 'read']).$1, 1);
+    expectEq(run(['done', 'nope']).$3, 'error: no such habit: nope\n');
+    expectEq(run(['done', 'read', '2026-10-09']).$1, 2);
+    expectEq(run(['add', 'Bad']).$1, 2);
+    expectEq(run(['undo', 'read', '2026-10-01']).$1, 1);
+    expectEq(run(['list'], today: 'soon').$1, 2);
+    expectEq(run(['frobnicate']).$1, 2);
+  });
