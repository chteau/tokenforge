+/// A command-line habit and streak tracker.
+library;
+
+export 'src/cli.dart' show runCli, usage;
+export 'src/date.dart';
+export 'src/habit.dart';
+export 'src/report.dart';
+export 'src/store.dart';
diff --git a/lib/src/cli.dart b/lib/src/cli.dart
new file mode 100644
index 0000000..f384e44
--- /dev/null
+++ b/lib/src/cli.dart
@@ -0,0 +1,197 @@
+import 'date.dart';
+import 'habit.dart';
+import 'report.dart';
+import 'store.dart';
+
+const usage = '''usage: habits [--file <path>] <command> [args]
+
+commands:
+  add <name> [--goal <n>]   register a habit (goal: days per week, 1-7, default 7)
+  remove <name>             delete a habit
+  done <name> [<date>]      mark a day as done (default today)
+  undo <name> [<date>]      unmark a day
+  list                      list habits with their streaks
+  streak <name>             show streak details for a habit
+  report [<date>]           weekly report for the week containing <date>
+
+Dates are YYYY-MM-DD. HABITS_TODAY overrides today's date.''';
+
+/// A failure with an exit code and a message for stderr.
+class CliError implements Exception {
+  final int code;
+  final String message;
+  CliError(this.code, this.message);
+}
+
+CliError _usage(String message) => CliError(2, message);
+
+/// Runs one command. Returns the process exit code.
+int runCli(List<String> args, Map<String, String> env, StringSink out,
+    StringSink err) {
+  try {
+    if (args.length == 1 && (args[0] == '--help' || args[0] == '-h')) {
+      out.writeln(usage);
+      return 0;
+    }
+    final lines = _dispatch(args, env);
+    for (final l in lines) {
+      out.writeln(l);
+    }
+    return 0;
+  } on CliError catch (e) {
+    err.writeln('error: ${e.message}');
+    return e.code;
+  } on StoreException catch (e) {
+    err.writeln('error: ${e.message}');
+    return 3;
+  }
+}
+
+List<String> _dispatch(List<String> args, Map<String, String> env) {
+  var rest = args;
+  var path = 'habits.json';
+  if (rest.isNotEmpty && rest[0] == '--file') {
+    if (rest.length < 2 || rest[1].isEmpty) throw _usage('--file needs a path');
+    path = rest[1];
+    rest = rest.sublist(2);
+  }
+  if (rest.isEmpty) throw _usage('missing command (see --help)');
+  final today = _today(env);
+  final command = rest[0];
+  final params = rest.sublist(1);
+  final store = Store(path);
+  final cmd = Commands(store, today);
+  switch (command) {
+    case 'add':
+      final (name, goal) = _parseAdd(params);
+      return cmd.add(name, goal);
+    case 'remove':
+      return cmd.remove(_name(_exactly(params, 1)[0]));
+    case 'done':
+    case 'undo':
+      _between(params, 1, 2);
+      final name = _name(params[0]);
+      final date = params.length == 2 ? _date(params[1]) : today;
+      return command == 'done' ? cmd.done(name, date) : cmd.undo(name, date);
+    case 'list':
+      _exactly(params, 0);
+      return cmd.list();
+    case 'streak':
+      return cmd.streak(_name(_exactly(params, 1)[0]));
+    case 'report':
+      _between(params, 0, 1);
+      return cmd.report(params.isEmpty ? today : _date(params[0]));
+    default:
+      throw _usage('unknown command: $command');
+  }
+}
+
+Date _today(Map<String, String> env) {
+  final value = env['HABITS_TODAY'] ?? '';
+  if (value.isEmpty) return Date.today();
+  return Date.tryParse(value) ?? (throw _usage('invalid HABITS_TODAY: $value'));
+}
+
+List<String> _exactly(List<String> params, int n) => _between(params, n, n);
+
+List<String> _between(List<String> params, int min, int max) {
+  if (params.length < min) throw _usage('missing argument');
+  if (params.length > max) throw _usage('unexpected argument: ${params[max]}');
+  return params;
+}
+
+String _name(String name) =>
+    isValidName(name) ? name : throw _usage('invalid habit name: $name');
+
+Date _date(String text) =>
+    Date.tryParse(text) ?? (throw _usage('invalid date: $text'));
+
+(String, int) _parseAdd(List<String> params) {
+  String? name;
+  int? goal;
+  for (var i = 0; i < params.length; i++) {
+    final p = params[i];
+    if (p == '--goal') {
+      if (goal != null) throw _usage('--goal given twice');
+      if (i + 1 >= params.length) throw _usage('--goal needs a value');
+      final text = params[++i];
+      final g = RegExp(r'^\d+$').hasMatch(text) ? int.tryParse(text) : null;
+      if (g == null || !isValidGoal(g)) throw _usage('invalid goal: $text');
+      goal = g;
+    } else if (name == null) {
+      name = _name(p);
+    } else {
+      throw _usage('unexpected argument: $p');
+    }
+  }
+  if (name == null) throw _usage('missing habit name');
+  return (name, goal ?? 7);
+}
+
+/// The command implementations, working on a store as of a given day.
+class Commands {
+  final Store store;
+  final Date today;
+
+  Commands(this.store, this.today);
+
+  Habit _find(Map<String, Habit> habits, String name) =>
+      habits[name] ?? (throw CliError(1, 'no such habit: $name'));
+
+  List<String> add(String name, int goal) {
+    final habits = store.load();
+    if (habits.containsKey(name))
+      throw CliError(1, 'habit already exists: $name');
+    habits[name] = Habit(name, goal);
+    store.save(habits);
+    return ['added $name'];
+  }
+
+  List<String> remove(String name) {
+    final habits = store.load();
+    _find(habits, name);
+    habits.remove(name);
+    store.save(habits);
+    return ['removed $name'];
+  }
+
+  List<String> done(String name, Date date) {
+    if (date.isAfter(today)) throw _usage('date is in the future: $date');
+    final habits = store.load();
+    final habit = _find(habits, name);
+    if (!habit.done.add(date)) return ['already done $name $date'];
+    store.save(habits);
+    return ['done $name $date'];
+  }
+
+  List<String> undo(String name, Date date) {
+    final habits = store.load();
+    final habit = _find(habits, name);
+    if (!habit.done.remove(date)) throw CliError(1, 'not done: $name $date');
+    store.save(habits);
+    return ['undone $name $date'];
+  }
+
+  List<String> list() => [
+        for (final h in store.load().values)
+          () {
+            final s = h.streaks(today);
+            return '${h.name}\tgoal ${h.goal}\tcurrent ${s.current}'
+                '\tbest ${s.best}\ttotal ${s.total}';
+          }(),
+      ];
+
+  List<String> streak(String name) {
+    final s = _find(store.load(), name).streaks(today);
+    return [
+      'current: ${s.current}',
+      'best: ${s.best}',
+      'total: ${s.total}',
+      'weekly: ${s.weekly}',
+      'last: ${s.last ?? 'never'}',
+    ];
+  }
+
+  List<String> report(Date day) =>
+      weeklyReport(store.load().values, day, today);
+}
diff --git a/lib/src/date.dart b/lib/src/date.dart
new file mode 100644
index 0000000..fd2515d
--- /dev/null
+++ b/lib/src/date.dart
@@ -0,0 +1,100 @@
+/// A calendar date without time or time zone, stored as days since 1970-01-01.
+class Date implements Comparable<Date> {
+  /// Days since 1970-01-01 (which is day 0).
+  final int epochDay;
+
+  const Date.fromEpochDay(this.epochDay);
+
+  factory Date(int year, int month, int day) {
+    if (month < 1 || month > 12 || day < 1 || day > daysInMonth(year, month)) {
+      throw ArgumentError('invalid date $year-$month-$day');
+    }
+    return Date.fromEpochDay(_daysFromCivil(year, month, day));
+  }
+
+  static final _pattern = RegExp(r'^(\d{4})-(\d{2})-(\d{2})$');
+
+  /// Parses a strict `YYYY-MM-DD` date; returns null if it is malformed or not a real date.
+  static Date? tryParse(String text) {
+    final m = _pattern.firstMatch(text);
+    if (m == null) return null;
+    final y = int.parse(m.group(1)!);
+    final mo = int.parse(m.group(2)!);
+    final d = int.parse(m.group(3)!);
+    if (mo < 1 || mo > 12 || d < 1 || d > daysInMonth(y, mo)) return null;
+    return Date(y, mo, d);
+  }
+
+  /// Today's local calendar date.
+  factory Date.today() {
+    final now = DateTime.now();
+    return Date(now.year, now.month, now.day);
+  }
+
+  static bool isLeapYear(int y) => (y % 4 == 0 && y % 100 != 0) || y % 400 == 0;
+
+  static int daysInMonth(int y, int m) {
+    const days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+    return m == 2 && isLeapYear(y) ? 29 : days[m - 1];
+  }
+
+  // Howard Hinnant's days_from_civil / civil_from_days algorithms.
+  static int _daysFromCivil(int y, int m, int d) {
+    final yy = m <= 2 ? y - 1 : y;
+    final era = (yy >= 0 ? yy : yy - 399) ~/ 400;
+    final yoe = yy - era * 400;
+    final doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) ~/ 5 + d - 1;
+    final doe = yoe * 365 + yoe ~/ 4 - yoe ~/ 100 + doy;
+    return era * 146097 + doe - 719468;
+  }
+
+  List<int> get _civil {
+    final z = epochDay + 719468;
+    final era = (z >= 0 ? z : z - 146096) ~/ 146097;
+    final doe = z - era * 146097;
+    final yoe = (doe - doe ~/ 1460 + doe ~/ 36524 - doe ~/ 146096) ~/ 365;
+    final doy = doe - (365 * yoe + yoe ~/ 4 - yoe ~/ 100);
+    final mp = (5 * doy + 2) ~/ 153;
+    final d = doy - (153 * mp + 2) ~/ 5 + 1;
+    final m = mp < 10 ? mp + 3 : mp - 9;
+    return [yoe + era * 400 + (m <= 2 ? 1 : 0), m, d];
+  }
+
+  int get year => _civil[0];
+  int get month => _civil[1];
+  int get day => _civil[2];
+
+  /// ISO weekday: Monday = 1 ... Sunday = 7.
+  int get weekday => (epochDay + 3) % 7 + 1;
+
+  Date addDays(int n) => Date.fromEpochDay(epochDay + n);
+
+  /// Monday of the ISO week containing this date.
+  Date get weekStart => addDays(1 - weekday);
+
+  /// ISO week-numbering year and week number.
+  (int, int) get isoWeek {
+    final thursday = weekStart.addDays(3);
+    final y = thursday.year;
+    final week = (thursday.epochDay - Date(y, 1, 1).epochDay) ~/ 7 + 1;
+    return (y, week);
+  }
+
+  bool isAfter(Date other) => epochDay > other.epochDay;
+
+  @override
+  int compareTo(Date other) => epochDay.compareTo(other.epochDay);
+
+  @override
+  bool operator ==(Object other) => other is Date && other.epochDay == epochDay;
+
+  @override
+  int get hashCode => epochDay.hashCode;
+
+  @override
+  String toString() {
+    final c = _civil;
+    String two(int v) => v.toString().padLeft(2, '0');
+    return '${c[0].toString().padLeft(4, '0')}-${two(c[1])}-${two(c[2])}';
+  }
+}
