new file mode 100644
index 0000000..2594427
--- /dev/null
+++ b/lib/src/habit.dart
@@ -0,0 +1,68 @@
+import 'date.dart';
+
+final _namePattern = RegExp(r'^[a-z][a-z0-9-]{0,31}$');
+
+bool isValidName(String name) => _namePattern.hasMatch(name);
+
+bool isValidGoal(int goal) => goal >= 1 && goal <= 7;
+
+/// Streak figures for one habit as seen from a given day.
+class Streaks {
+  final int current;
+  final int best;
+  final int total;
+  final int weekly;
+  final Date? last;
+
+  const Streaks(this.current, this.best, this.total, this.weekly, this.last);
+}
+
+/// A habit with a weekly goal and the set of days it was done.
+class Habit {
+  final String name;
+  final int goal;
+  final Set<Date> done;
+
+  Habit(this.name, this.goal, [Iterable<Date> done = const []])
+      : done = done.toSet();
+
+  /// Done dates in ascending order.
+  List<Date> get sortedDone => done.toList()..sort();
+
+  /// Number of days done in the ISO week starting at [monday], up to and including [today].
+  int doneInWeek(Date monday, Date today) {
+    var n = 0;
+    for (var i = 0; i < 7; i++) {
+      final d = monday.addDays(i);
+      if (!d.isAfter(today) && done.contains(d)) n++;
+    }
+    return n;
+  }
+
+  Streaks streaks(Date today) {
+    final days = done.where((d) => !d.isAfter(today)).toList()..sort();
+    var best = 0;
+    var run = 0;
+    for (var i = 0; i < days.length; i++) {
+      run = i > 0 && days[i].epochDay == days[i - 1].epochDay + 1 ? run + 1 : 1;
+      if (run > best) best = run;
+    }
+    final present = days.toSet();
+    var end = today;
+    if (!present.contains(end)) end = today.addDays(-1);
+    var current = 0;
+    while (present.contains(end.addDays(-current))) {
+      current++;
+    }
+    var week = today.weekStart;
+    if (doneInWeek(week, today) < goal) week = week.addDays(-7);
+    var weekly = 0;
+    // goal >= 1, so the loop stops at the latest before the first done day.
+    while (doneInWeek(week, today) >= goal) {
+      weekly++;
+      week = week.addDays(-7);
+    }
+    return Streaks(
+        current, best, days.length, weekly, days.isEmpty ? null : days.last);
+  }
+}
diff --git a/lib/src/report.dart b/lib/src/report.dart
new file mode 100644
index 0000000..4ec1a71
--- /dev/null
+++ b/lib/src/report.dart
@@ -0,0 +1,49 @@
+import 'date.dart';
+import 'habit.dart';
+
+/// Status of a habit's goal for one week, as shown in the report.
+String weekStatus(Habit habit, Date monday, Date today) {
+  final done = habit.doneInWeek(monday, today);
+  if (done >= habit.goal) return 'met';
+  var remaining = 0;
+  for (var i = 0; i < 7; i++) {
+    final d = monday.addDays(i);
+    if (d.isAfter(today)) {
+      remaining++;
+    } else if (d == today && !habit.done.contains(d)) {
+      remaining++;
+    }
+  }
+  if (done + remaining < habit.goal) return 'missed';
+  return 'need ${habit.goal - done}';
+}
+
+/// Renders the weekly report for the ISO week containing [day].
+List<String> weeklyReport(Iterable<Habit> habits, Date day, Date today) {
+  final monday = day.weekStart;
+  final (isoYear, week) = monday.isoWeek;
+  final lines = <String>[
+    'Week $isoYear-W${week.toString().padLeft(2, '0')} '
+        '($monday to ${monday.addDays(6)})',
+  ];
+  final list = habits.toList()..sort((a, b) => a.name.compareTo(b.name));
+  if (list.isEmpty) return lines..add('no habits');
+  final width = list.map((h) => h.name.length).reduce((a, b) => a > b ? a : b);
+  var met = 0;
+  for (final h in list) {
+    final cells = [
+      for (var i = 0; i < 7; i++) _cell(h, monday.addDays(i), today),
+    ];
+    final status = weekStatus(h, monday, today);
+    if (status == 'met') met++;
+    lines.add('${h.name.padRight(width)}  ${cells.join(' ')}  '
+        '${h.doneInWeek(monday, today)}/${h.goal}  $status');
+  }
+  lines.add('$met of ${list.length} goals met');
+  return lines;
+}
+
+String _cell(Habit h, Date d, Date today) {
+  if (d.isAfter(today)) return '-';
+  return h.done.contains(d) ? 'x' : '.';
+}
diff --git a/lib/src/store.dart b/lib/src/store.dart
new file mode 100644
index 0000000..efcef42
--- /dev/null
+++ b/lib/src/store.dart
@@ -0,0 +1,101 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'date.dart';
+import 'habit.dart';
+
+/// Raised when the data file cannot be read, parsed or written.
+class StoreException implements Exception {
+  final String message;
+  StoreException(this.message);
+
+  @override
+  String toString() => message;
+}
+
+/// Loads and saves the habit list as JSON. The only code that touches the data file.
+class Store {
+  final String path;
+
+  Store(this.path);
+
+  /// Habits keyed by name, sorted by name. A missing file means no habits.
+  Map<String, Habit> load() {
+    final file = File(path);
+    if (FileSystemEntity.typeSync(path) == FileSystemEntityType.notFound) {
+      return {};
+    }
+    String text;
+    try {
+      text = file.readAsStringSync();
+    } on FileSystemException catch (e) {
+      throw StoreException(
+          'cannot read $path: ${e.osError?.message ?? e.message}');
+    }
+    final habits = _decode(text);
+    if (habits == null) throw StoreException('corrupt data file: $path');
+    return habits;
+  }
+
+  static Map<String, Habit>? _decode(String text) {
+    Object? data;
+    try {
+      data = jsonDecode(text);
+    } on FormatException {
+      return null;
+    }
+    if (data is! Map<String, Object?>) return null;
+    final list = data['habits'];
+    if (list is! List) return null;
+    final result = <String, Habit>{};
+    for (final entry in list) {
+      if (entry is! Map<String, Object?>) return null;
+      final name = entry['name'];
+      final goal = entry['goal'];
+      final done = entry['done'];
+      if (name is! String || !isValidName(name) || result.containsKey(name)) {
+        return null;
+      }
+      if (goal is! int || !isValidGoal(goal) || done is! List) return null;
+      final dates = <Date>[];
+      for (final d in done) {
+        final date = d is String ? Date.tryParse(d) : null;
+        if (date == null) return null;
+        dates.add(date);
+      }
+      result[name] = Habit(name, goal, dates);
+    }
+    return sorted(result);
+  }
+
+  static Map<String, Habit> sorted(Map<String, Habit> habits) {
+    final names = habits.keys.toList()..sort();
+    return {for (final n in names) n: habits[n]!};
+  }
+
+  /// Atomically replaces the data file with [habits].
+  void save(Map<String, Habit> habits) {
+    final data = {
+      'habits': [
+        for (final h in sorted(habits).values)
+          {
+            'name': h.name,
+            'goal': h.goal,
+            'done': [for (final d in h.sortedDone) d.toString()],
+          },
+      ],
+    };
+    final text = '${const JsonEncoder.withIndent('  ').convert(data)}\n';
+    final target = File(path);
+    final tmp = File('$path.tmp$pid');
+    try {
+      target.parent.createSync(recursive: true);
+      tmp.writeAsStringSync(text, flush: true);
+      tmp.renameSync(path);
+    } on FileSystemException catch (e) {
+      if (tmp.existsSync()) tmp.deleteSync();
+      throw StoreException(
+          'cannot write $path: ${e.osError?.message ?? e.message}');
+    }
+  }
+}
