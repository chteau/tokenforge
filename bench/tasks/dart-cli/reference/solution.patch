@@ -0,0 +1,28 @@
+import 'dart:io';
+
+/// A tiny test harness: run named checks, report failures, set the exit code.
+class Suite {
+  var _failures = 0;
+  var _count = 0;
+
+  void test(String name, void Function() body) {
+    _count++;
+    try {
+      body();
+    } catch (e) {
+      _failures++;
+      stderr.writeln('FAIL $name: $e');
+    }
+  }
+
+  void done() {
+    stdout.writeln('${_count - _failures}/$_count passed');
+    if (_failures > 0) exitCode = 1;
+  }
+}
+
+void expectEq(Object? actual, Object? expected) {
+  if (actual != expected) {
+    throw StateError('expected <$expected>, got <$actual>');
+  }
+}
