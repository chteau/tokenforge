+    File(file).writeAsStringSync('{"habits": 3}');
+    final r = run(['list']);
+    expectEq(r.$1, 3);
+    expectEq(r.$3, 'error: corrupt data file: $file\n');
+  });
+  dir.deleteSync(recursive: true);
+  s.done();
+}
diff --git a/test/date_test.dart b/test/date_test.dart
new file mode 100644
index 0000000..df2d624
--- /dev/null
+++ b/test/date_test.dart
@@ -0,0 +1,41 @@
+import 'package:habits/habits.dart';
+
+import 'check.dart';
+
+void main() {
+  final s = Suite();
+  s.test('parse and format round trip', () {
+    expectEq(Date.tryParse('2026-10-08').toString(), '2026-10-08');
+    expectEq(Date.tryParse('1970-01-01')!.epochDay, 0);
+  });
+  s.test('rejects malformed and impossible dates', () {
+    for (final t in [
+      '2026-1-05',
+      '20260105',
+      '2023-02-29',
+      '2026-04-31',
+      '2026-13-01',
+      'x'
+    ]) {
+      expectEq(Date.tryParse(t), null);
+    }
+    expectEq(Date.tryParse('2024-02-29').toString(), '2024-02-29');
+  });
+  s.test('adding days crosses month and year ends', () {
+    expectEq(Date(2024, 2, 28).addDays(1).toString(), '2024-02-29');
+    expectEq(Date(2023, 2, 28).addDays(1).toString(), '2023-03-01');
+    expectEq(Date(2026, 12, 31).addDays(1).toString(), '2027-01-01');
+  });
+  s.test('weekday', () {
+    expectEq(Date(2026, 10, 8).weekday, 4);
+    expectEq(Date(2026, 10, 5).weekday, 1);
+    expectEq(Date(2026, 10, 11).weekday, 7);
+  });
+  s.test('ISO weeks at year boundaries', () {
+    expectEq(Date(2027, 1, 1).isoWeek, (2026, 53));
+    expectEq(Date(2024, 12, 30).isoWeek, (2025, 1));
+    expectEq(Date(2021, 1, 3).isoWeek, (2020, 53));
+    expectEq(Date(2026, 10, 8).isoWeek, (2026, 41));
+  });
+  s.done();
+}
