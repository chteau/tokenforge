index 0000000..45712f5
--- /dev/null
+++ b/Tests/CronCoreTests/ParserTests.swift
@@ -0,0 +1,44 @@
+import Testing
+@testable import CronCore
+
+private func parseError(_ text: String) -> String? {
+    do {
+        _ = try CronExpression(parsing: text)
+        return nil
+    } catch {
+        return error.description
+    }
+}
+
+@Test func parsesListsRangesStepsAndNames() throws {
+    let e = try CronExpression(parsing: "0,30 9-17/4 */10 jan-MAR SUN,7")
+    #expect(e.minute.values == [0, 30])
+    #expect(e.hour.values == [9, 13, 17])
+    #expect(e.dayOfMonth.values == [1, 11, 21, 31])
+    #expect(e.month.values == [1, 2, 3])
+    #expect(e.dayOfWeek.values == [0])
+}
+
+@Test func startWithStepRunsToFieldMaximum() throws {
+    #expect(try CronExpression(parsing: "50/5 * * * *").minute.values == [50, 55])
+}
+
+@Test func macrosExpand() throws {
+    #expect(try CronExpression(parsing: "@WEEKLY") == CronExpression(parsing: "0 0 * * 0"))
+    #expect(try CronExpression(parsing: "@annually") == CronExpression(parsing: "0 0 1 1 *"))
+}
+
+@Test(arguments: [
+    ("* * * *", "expected 5 fields, got 4"),
+    ("@reboot", "unknown macro \"@reboot\""),
+    ("1,,2 * * * *", "minute: empty item"),
+    ("0 0 * FOO *", "month: invalid value \"FOO\""),
+    ("0 0 * * 08", "day-of-week: value 8 out of range 0-7"),
+    ("0 0 * * FRI-MON", "day-of-week: invalid range FRI-MON"),
+    ("*/0 * * * *", "minute: invalid step \"0\""),
+    ("1-2-3 * * * *", "minute: invalid value \"1-2-3\""),
+    ("60 24 * * *", "minute: value 60 out of range 0-59"),
+])
+func reportsFirstError(input: String, message: String) {
+    #expect(parseError(input) == message)
+}
diff --git a/Tests/CronCoreTests/ScheduleTests.swift b/Tests/CronCoreTests/ScheduleTests.swift
new file mode 100644
index 0000000..cc9146e
--- /dev/null
+++ b/Tests/CronCoreTests/ScheduleTests.swift
@@ -0,0 +1,62 @@
+import Testing
+@testable import CronCore
+
+private func runs(_ expr: String, from: String, count: Int, offset: String = "+00:00") throws -> [String] {
+    let e = try CronExpression(parsing: expr)
+    let o = try #require(UTCOffset(parsing: offset))
+    let start = try #require(parseInstant(from))
+    return e.nextRuns(after: start, count: count, offset: o).map { formatInstant($0, offset: o) }
+}
+
+@Test func civilDateRoundTrip() {
+    for days in [-1, 0, 59, 11_016, 47_541, 100_000] {
+        #expect(CivilDate(daysSinceEpoch: CivilDate(daysSinceEpoch: days).daysSinceEpoch).daysSinceEpoch == days)
+    }
+    #expect(CivilDate(year: 1970, month: 1, day: 1).weekday == 4)
+    #expect(CivilDate(year: 2026, month: 3, day: 1).weekday == 0)
+    #expect(!CivilDate.isLeap(2100) && CivilDate.isLeap(2000) && CivilDate.isLeap(2028))
+}
+
+@Test func parsesInstantsAndOffsets() {
+    #expect(parseInstant("1970-01-01T01:00+01:00") == 0)
+    #expect(parseInstant("2026-02-29T00:00Z") == nil)
+    #expect(parseInstant("2026-01-01T24:00Z") == nil)
+    #expect(UTCOffset(parsing: "-03:45")?.minutes == -225)
+    #expect(UTCOffset(parsing: "+14:01") == nil)
+    #expect(UTCOffset(parsing: "+5:00") == nil)
+}
+
+@Test func nextRunsAreStrictlyAfterStart() throws {
+    #expect(try runs("15 10 * * *", from: "2026-10-08T10:15Z", count: 2)
+        == ["2026-10-09T10:15+00:00", "2026-10-10T10:15+00:00"])
+}
+
+@Test func dayOfMonthOrDayOfWeek() throws {
+    #expect(try runs("0 0 13 * FRI", from: "2026-02-01T00:00Z", count: 3)
+        == ["2026-02-06T00:00+00:00", "2026-02-13T00:00+00:00", "2026-02-20T00:00+00:00"])
+}
+
+@Test func scheduleRunsInOffsetLocalTime() throws {
+    #expect(try runs("0 12 * * *", from: "2026-03-01T05:00Z", count: 2, offset: "+05:30")
+        == ["2026-03-01T12:00+05:30", "2026-03-02T12:00+05:30"])
+}
+
+@Test func skipsNonLeapCenturies() throws {
+    #expect(try runs("0 0 29 2 *", from: "2097-01-01T00:00Z", count: 1) == ["2104-02-29T00:00+00:00"])
+}
+
+@Test func impossibleScheduleFindsNothing() throws {
+    #expect(try runs("0 0 30 2 *", from: "2026-01-01T00:00Z", count: 1).isEmpty)
+}
+
+@Test(arguments: [
+    ("30 9 * * MON-FRI", "At 09:30, on Monday through Friday."),
+    ("*/15 9-17 1,15 * *", "Every 15 minutes past hour 9 through 17, on day 1 and 15 of the month."),
+    ("0 0 * JAN,jul 0", "At 00:00, on Sunday, in January and July."),
+    ("0,30 */3 * * *", "At minute 0 and 30 past every 3 hours."),
+    ("0 8 */2 * MON", "At 08:00, on every 2 days or Monday."),
+    ("1,2,3 5-8/2 * */3 *", "At minute 1, 2 and 3 past hour every 2 from 5 through 8, every 3 months."),
+])
+func explains(input: String, sentence: String) throws {
+    #expect(try CronExpression(parsing: input).explanation() == sentence)
+}
