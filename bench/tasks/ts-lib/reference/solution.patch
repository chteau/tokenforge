+++ b/src/union.ts
@@ -0,0 +1,21 @@
+import { fail, type PathSegment, type RunResult } from "./issues.ts";
+import { Schema, type Infer } from "./schema.ts";
+
+export type UnionOptions = readonly [Schema<unknown>, ...Schema<unknown>[]];
+
+export class UnionSchema<O extends UnionOptions> extends Schema<Infer<O[number]>> {
+  readonly options: O;
+
+  constructor(options: O) {
+    super();
+    this.options = options;
+  }
+
+  run(input: unknown, path: PathSegment[]): RunResult<Infer<O[number]>> {
+    for (const option of this.options) {
+      const r = option.run(input, path);
+      if (r.ok) return r as RunResult<Infer<O[number]>>;
+    }
+    return fail(path, "Invalid input");
+  }
+}
diff --git a/test/schemas.test.ts b/test/schemas.test.ts
new file mode 100644
index 0000000..a05910e
--- /dev/null
+++ b/test/schemas.test.ts
@@ -0,0 +1,53 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { formatPath, s, ValidationError } from "../src/index.ts";
+
+test("primitives validate their type", () => {
+  assert.equal(s.string().parse("a"), "a");
+  assert.equal(s.number().int().parse(2), 2);
+  assert.equal(s.boolean().parse(true), true);
+  assert.throws(() => s.number().parse(NaN), { message: "(root): Expected number, received nan" });
+  assert.throws(() => s.string().parse(undefined), { message: "(root): Required" });
+});
+
+test("string checks report every failure in order", () => {
+  const r = s.string().email().min(10).safeParse("x@y");
+  assert.equal(r.success, false);
+  if (!r.success) {
+    assert.deepEqual(r.error.issues.map((i) => i.message), ["Invalid email", "String must contain at least 10 character(s)"]);
+  }
+  assert.equal(s.string().min(3).trim().safeParse("  a ").success, false);
+});
+
+test("objects strip unknown keys and apply defaults", () => {
+  const User = s.object({ id: s.number(), role: s.enum(["a", "b"]).default("a"), nick: s.string().optional() });
+  assert.deepStrictEqual(User.parse({ id: 1, x: 2 }), { id: 1, role: "a" });
+  assert.throws(() => User.strict().parse({ id: 1, x: 2 }), { message: "(root): Unrecognized key(s) in object: 'x'" });
+});
+
+test("nested issues carry full paths", () => {
+  const Order = s.object({ lines: s.array(s.object({ qty: s.number().positive() })).min(1) });
+  try {
+    Order.parse({ lines: [{ qty: 1 }, { qty: 0 }] });
+    assert.fail("should throw");
+  } catch (e) {
+    assert.ok(e instanceof ValidationError);
+    assert.deepEqual(e.issues, [{ path: ["lines", 1, "qty"], message: "Number must be greater than 0" }]);
+    assert.equal(e.message, "lines[1].qty: Number must be greater than 0");
+  }
+});
+
+test("union, literal, nullable and refine", () => {
+  const U = s.union([s.literal("x"), s.number()]);
+  assert.equal(U.parse(1), 1);
+  assert.throws(() => U.parse("y"), { message: "(root): Invalid input" });
+  assert.equal(s.string().nullable().parse(null), null);
+  const Even = s.number().refine((n) => n % 2 === 0, "Must be even");
+  assert.throws(() => Even.parse(3), { message: "(root): Must be even" });
+});
+
+test("formatPath", () => {
+  assert.equal(formatPath([]), "(root)");
+  assert.equal(formatPath(["a", 0, "b"]), "a[0].b");
+  assert.equal(formatPath([1, 2]), "[1][2]");
+});
