+import { fail, typeName, type Issue, type PathSegment, type RunResult } from "./issues.ts";
+import { TypedSchema, type Schema } from "./schema.ts";
+
+type LengthCheck = { test: (length: number) => boolean; message: string };
+
+export class ArraySchema<T> extends TypedSchema<T[]> {
+  readonly element: Schema<T>;
+  private readonly checks: readonly LengthCheck[];
+
+  constructor(element: Schema<T>, checks: readonly LengthCheck[] = []) {
+    super();
+    this.element = element;
+    this.checks = checks;
+  }
+
+  min(n: number, message?: string): ArraySchema<T> {
+    return new ArraySchema(this.element, [
+      ...this.checks,
+      { test: (len) => len >= n, message: message ?? `Array must contain at least ${n} element(s)` },
+    ]);
+  }
+
+  max(n: number, message?: string): ArraySchema<T> {
+    return new ArraySchema(this.element, [
+      ...this.checks,
+      { test: (len) => len <= n, message: message ?? `Array must contain at most ${n} element(s)` },
+    ]);
+  }
+
+  protected check(input: unknown, path: PathSegment[]): RunResult<T[]> {
+    if (!Array.isArray(input)) return fail(path, `Expected array, received ${typeName(input)}`);
+    const out: T[] = [];
+    const issues: Issue[] = [];
+    input.forEach((item: unknown, i: number) => {
+      const r = this.element.run(item, [...path, i]);
+      if (r.ok) out.push(r.value);
+      else issues.push(...r.issues);
+    });
+    for (const c of this.checks) if (!c.test(input.length)) issues.push({ path, message: c.message });
+    return issues.length ? { ok: false, issues } : { ok: true, value: out };
+  }
+}
