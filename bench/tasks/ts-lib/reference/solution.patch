+++ b/src/object.ts
@@ -0,0 +1,51 @@
+import { fail, typeName, type Issue, type PathSegment, type RunResult } from "./issues.ts";
+import { TypedSchema, type Infer, type Schema } from "./schema.ts";
+
+export type Shape = { [key: string]: Schema<unknown> };
+
+type OptionalKeys<S extends Shape> = { [K in keyof S]: undefined extends Infer<S[K]> ? K : never }[keyof S];
+type RequiredKeys<S extends Shape> = Exclude<keyof S, OptionalKeys<S>>;
+type Flatten<T> = { [K in keyof T]: T[K] } & {};
+
+/** Keys whose schema accepts `undefined` become optional properties. */
+export type ObjectOutput<S extends Shape> = Flatten<
+  { [K in OptionalKeys<S>]?: Infer<S[K]> } & { [K in RequiredKeys<S>]: Infer<S[K]> }
+>;
+
+export class ObjectSchema<S extends Shape> extends TypedSchema<ObjectOutput<S>> {
+  readonly shape: S;
+  private readonly rejectUnknown: boolean;
+
+  constructor(shape: S, rejectUnknown = false) {
+    super();
+    this.shape = shape;
+    this.rejectUnknown = rejectUnknown;
+  }
+
+  /** Report unknown keys instead of silently dropping them. */
+  strict(): ObjectSchema<S> {
+    return new ObjectSchema(this.shape, true);
+  }
+
+  protected check(input: unknown, path: PathSegment[]): RunResult<ObjectOutput<S>> {
+    if (typeof input !== "object" || input === null || Array.isArray(input)) {
+      return fail(path, `Expected object, received ${typeName(input)}`);
+    }
+    const record = input as Record<string, unknown>;
+    const out: Record<string, unknown> = {};
+    const issues: Issue[] = [];
+    for (const key of Object.keys(this.shape)) {
+      const present = Object.prototype.hasOwnProperty.call(record, key);
+      const r = this.shape[key]!.run(present ? record[key] : undefined, [...path, key]);
+      if (!r.ok) issues.push(...r.issues);
+      else if (present || r.value !== undefined) out[key] = r.value;
+    }
+    if (this.rejectUnknown) {
+      const unknown = Object.keys(record).filter((k) => !Object.prototype.hasOwnProperty.call(this.shape, k));
+      if (unknown.length) {
+        issues.push({ path, message: `Unrecognized key(s) in object: ${unknown.map((k) => `'${k}'`).join(", ")}` });
+      }
+    }
+    return issues.length ? { ok: false, issues } : { ok: true, value: out as ObjectOutput<S> };
+  }
+}
diff --git a/src/primitives.ts b/src/primitives.ts
new file mode 100644
index 0000000..ff65181
--- /dev/null
+++ b/src/primitives.ts
@@ -0,0 +1,121 @@
+import { fail, ok, typeName, type Issue, type PathSegment, type RunResult } from "./issues.ts";
+import { TypedSchema } from "./schema.ts";
+
+type Check<T> = { test: (value: T) => boolean; message: string };
+
+function runChecks<T>(value: T, checks: readonly Check<T>[], path: PathSegment[]): RunResult<T> {
+  const issues: Issue[] = checks.filter((c) => !c.test(value)).map((c) => ({ path, message: c.message }));
+  return issues.length ? { ok: false, issues } : ok(value);
+}
+
+const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+export class StringSchema extends TypedSchema<string> {
+  private readonly checks: readonly Check<string>[];
+  private readonly trims: boolean;
+
+  constructor(checks: readonly Check<string>[] = [], trims = false) {
+    super();
+    this.checks = checks;
+    this.trims = trims;
+  }
+
+  private with(test: (v: string) => boolean, message: string): StringSchema {
+    return new StringSchema([...this.checks, { test, message }], this.trims);
+  }
+
+  min(n: number, message?: string): StringSchema {
+    return this.with((v) => v.length >= n, message ?? `String must contain at least ${n} character(s)`);
+  }
+  max(n: number, message?: string): StringSchema {
+    return this.with((v) => v.length <= n, message ?? `String must contain at most ${n} character(s)`);
+  }
+  length(n: number, message?: string): StringSchema {
+    return this.with((v) => v.length === n, message ?? `String must contain exactly ${n} character(s)`);
+  }
+  email(message?: string): StringSchema {
+    return this.with((v) => EMAIL.test(v), message ?? "Invalid email");
+  }
+  regex(pattern: RegExp, message?: string): StringSchema {
+    return this.with((v) => {
+      pattern.lastIndex = 0;
+      return pattern.test(v);
+    }, message ?? "Invalid string");
+  }
+  trim(): StringSchema {
+    return new StringSchema(this.checks, true);
+  }
+
+  protected check(input: unknown, path: PathSegment[]): RunResult<string> {
+    if (typeof input !== "string") return fail(path, `Expected string, received ${typeName(input)}`);
+    return runChecks(this.trims ? input.trim() : input, this.checks, path);
+  }
+}
+
+export class NumberSchema extends TypedSchema<number> {
+  private readonly checks: readonly Check<number>[];
+
+  constructor(checks: readonly Check<number>[] = []) {
+    super();
+    this.checks = checks;
+  }
+
+  private with(test: (v: number) => boolean, message: string): NumberSchema {
+    return new NumberSchema([...this.checks, { test, message }]);
+  }
+
+  int(message?: string): NumberSchema {
+    return this.with((v) => Number.isInteger(v), message ?? "Expected integer, received float");
+  }
+  min(n: number, message?: string): NumberSchema {
+    return this.with((v) => v >= n, message ?? `Number must be greater than or equal to ${n}`);
+  }
+  max(n: number, message?: string): NumberSchema {
+    return this.with((v) => v <= n, message ?? `Number must be less than or equal to ${n}`);
+  }
+  positive(message?: string): NumberSchema {
+    return this.with((v) => v > 0, message ?? "Number must be greater than 0");
+  }
+
+  protected check(input: unknown, path: PathSegment[]): RunResult<number> {
+    if (typeof input !== "number" || Number.isNaN(input)) {
+      return fail(path, `Expected number, received ${typeName(input)}`);
+    }
+    return runChecks(input, this.checks, path);
+  }
+}
+
+export class BooleanSchema extends TypedSchema<boolean> {
+  protected check(input: unknown, path: PathSegment[]): RunResult<boolean> {
+    return typeof input === "boolean" ? ok(input) : fail(path, `Expected boolean, received ${typeName(input)}`);
+  }
+}
+
+export type Primitive = string | number | boolean | null;
+
+export class LiteralSchema<T extends Primitive> extends TypedSchema<T> {
+  readonly value: T;
+  constructor(value: T) {
+    super();
+    this.value = value;
+  }
+  protected check(input: unknown, path: PathSegment[]): RunResult<T> {
+    return input === this.value
+      ? ok(this.value)
+      : fail(path, `Invalid literal value, expected ${JSON.stringify(this.value)}`);
+  }
+}
+
+export class EnumSchema<T extends string> extends TypedSchema<T> {
+  readonly options: readonly T[];
+  constructor(options: readonly T[]) {
+    super();
+    this.options = options;
+  }
+  protected check(input: unknown, path: PathSegment[]): RunResult<T> {
+    if (typeof input === "string" && (this.options as readonly string[]).includes(input)) return ok(input as T);
+    const expected = this.options.map((o) => `'${o}'`).join(" | ");
+    const received = typeof input === "string" ? `'${input}'` : typeName(input);
+    return fail(path, `Invalid enum value. Expected ${expected}, received ${received}`);
+  }
+}
diff --git a/src/schema.ts b/src/schema.ts
new file mode 100644
index 0000000..3c2528c
--- /dev/null
+++ b/src/schema.ts
@@ -0,0 +1,104 @@
+import { fail, ok, ValidationError, type PathSegment, type RunResult } from "./issues.ts";
+
+export type SafeParseResult<T> =
+  | { success: true; data: T }
+  | { success: false; error: ValidationError };
+
+/** Base class of every schema. `T` is the type of a successfully parsed value. */
+export abstract class Schema<T> {
+  /** Validates `input` at `path`. Internal: use `parse` / `safeParse`. */
+  abstract run(input: unknown, path: PathSegment[]): RunResult<T>;
+
+  parse(input: unknown): T {
+    const r = this.run(input, []);
+    if (r.ok) return r.value;
+    throw new ValidationError(r.issues);
+  }
+
+  safeParse(input: unknown): SafeParseResult<T> {
+    const r = this.run(input, []);
+    return r.ok ? { success: true, data: r.value } : { success: false, error: new ValidationError(r.issues) };
+  }
+
+  optional(): Schema<T | undefined> {
+    return new Optional(this);
+  }
+
+  nullable(): Schema<T | null> {
+    return new Nullable(this);
+  }
+
+  default(value: Exclude<T, undefined>): Schema<Exclude<T, undefined>> {
+    return new Default(this, value);
+  }
+
+  refine(check: (value: T) => boolean, message = "Invalid input"): Schema<T> {
+    return new Refined(this, check, message);
+  }
+}
+
+/** Base for schemas that report "Required" when the input is `undefined`. */
+export abstract class TypedSchema<T> extends Schema<T> {
+  protected abstract check(input: unknown, path: PathSegment[]): RunResult<T>;
+
+  run(input: unknown, path: PathSegment[]): RunResult<T> {
+    if (input === undefined) return fail(path, "Required");
+    return this.check(input, path);
+  }
+}
+
+class Optional<T> extends Schema<T | undefined> {
+  private readonly inner: Schema<T>;
+  constructor(inner: Schema<T>) {
+    super();
+    this.inner = inner;
+  }
+  run(input: unknown, path: PathSegment[]): RunResult<T | undefined> {
+    return input === undefined ? ok(undefined) : this.inner.run(input, path);
+  }
+}
+
+class Nullable<T> extends Schema<T | null> {
+  private readonly inner: Schema<T>;
+  constructor(inner: Schema<T>) {
+    super();
+    this.inner = inner;
+  }
+  run(input: unknown, path: PathSegment[]): RunResult<T | null> {
+    return input === null ? ok(null) : this.inner.run(input, path);
+  }
+}
+
+class Default<T> extends Schema<Exclude<T, undefined>> {
+  private readonly inner: Schema<T>;
+  private readonly fallback: Exclude<T, undefined>;
+  constructor(inner: Schema<T>, fallback: Exclude<T, undefined>) {
+    super();
+    this.inner = inner;
+    this.fallback = fallback;
+  }
+  run(input: unknown, path: PathSegment[]): RunResult<Exclude<T, undefined>> {
+    if (input === undefined) return ok(this.fallback);
+    return this.inner.run(input, path) as RunResult<Exclude<T, undefined>>;
+  }
+}
+
+class Refined<T> extends Schema<T> {
+  private readonly inner: Schema<T>;
+  private readonly predicate: (value: T) => boolean;
+  private readonly message: string;
+  constructor(inner: Schema<T>, predicate: (value: T) => boolean, message: string) {
+    super();
+    this.inner = inner;
+    this.predicate = predicate;
+    this.message = message;
+  }
+  run(input: unknown, path: PathSegment[]): RunResult<T> {
+    const r = this.inner.run(input, path);
+    if (!r.ok || this.predicate(r.value)) return r;
+    return fail(path, this.message);
+  }
+}
+
+/** The output type of a schema. */
+export type Infer<S extends Schema<unknown>> = S extends Schema<infer T> ? T : never;
diff --git a/src/union.ts b/src/union.ts
