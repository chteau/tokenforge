+++ b/src/issues.ts
@@ -0,0 +1,46 @@
+export type PathSegment = string | number;
+
+/** One validation problem: where it happened and what went wrong. */
+export interface Issue {
+  path: PathSegment[];
+  message: string;
+}
+
+/** Formats a path like `user.tags[2].name`; the empty path is `(root)`. */
+export function formatPath(path: readonly PathSegment[]): string {
+  if (path.length === 0) return "(root)";
+  let out = "";
+  for (const seg of path) {
+    if (typeof seg === "number") out += `[${seg}]`;
+    else out += out === "" ? seg : `.${seg}`;
+  }
+  return out;
+}
+
+export class ValidationError extends Error {
+  readonly issues: Issue[];
+
+  constructor(issues: Issue[]) {
+    super(issues.map((i) => `${formatPath(i.path)}: ${i.message}`).join("\n"));
+    this.name = "ValidationError";
+    this.issues = issues;
+  }
+}
+
+/** Describes the kind of an unexpected input for "received ..." messages. */
+export function typeName(value: unknown): string {
+  if (value === null) return "null";
+  if (Array.isArray(value)) return "array";
+  if (typeof value === "number" && Number.isNaN(value)) return "nan";
+  return typeof value;
+}
+
+export type RunResult<T> = { ok: true; value: T } | { ok: false; issues: Issue[] };
+
+export function ok<T>(value: T): RunResult<T> {
+  return { ok: true, value };
+}
+
+export function fail<T>(path: PathSegment[], message: string): RunResult<T> {
+  return { ok: false, issues: [{ path, message }] };
+}
