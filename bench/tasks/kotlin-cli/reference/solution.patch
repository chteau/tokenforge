+package mdc
+
+/** Conversion settings; [tocDepth] only matters when [toc] is set. */
+data class Options(val toc: Boolean = false, val tocDepth: Int = 3)
+
+/** Converts a Markdown document (with optional front matter) to an HTML fragment. */
+fun convert(text: String, options: Options = Options()): String {
+    val doc = splitDocument(text)
+    val renderer = HtmlRenderer()
+    val body = renderer.render(parseBlocks(doc.body))
+    val lines = (if (options.toc) renderToc(renderer.headings, options.tocDepth) else emptyList()) + body
+    return if (lines.isEmpty()) "" else lines.joinToString("\n", postfix = "\n")
+}
+
+/** Returns the front matter of [text] as a JSON line (with trailing newline). */
+fun extractFrontMatter(text: String): String = frontMatterJson(splitDocument(text).frontMatter) + "\n"
diff --git a/src/main/kotlin/mdc/FrontMatter.kt b/src/main/kotlin/mdc/FrontMatter.kt
new file mode 100644
index 0000000..d5c95dc
--- /dev/null
+++ b/src/main/kotlin/mdc/FrontMatter.kt
@@ -0,0 +1,82 @@
+package mdc
+
+import java.math.BigInteger
+
+/** Thrown for malformed front matter; the message is the user-facing error text. */
+class FrontMatterException(message: String) : Exception(message)
+
+/** A typed front-matter value. */
+sealed interface FmValue {
+    data object Null : FmValue
+    data class Bool(val value: Boolean) : FmValue
+    data class Num(val value: BigInteger) : FmValue
+    data class Str(val value: String) : FmValue
+    data class Arr(val items: List<String>) : FmValue
+}
+
+/** Front matter (keys in file order) and the remaining document lines. */
+data class Document(val frontMatter: Map<String, FmValue>, val body: List<String>)
+
+private val KEY_LINE = Regex("^([A-Za-z_][A-Za-z0-9_-]*):(.*)$")
+private val INTEGER = Regex("^-?[0-9]+$")
+
+/** Splits [text] into front matter and body lines. */
+fun splitDocument(text: String): Document {
+    val normalized = text.replace("\r\n", "\n")
+    val lines = normalized.split("\n").let { if (normalized.endsWith("\n")) it.dropLast(1) else it }
+    if (lines.firstOrNull() != "---") return Document(emptyMap(), lines)
+    val end = lines.subList(1, lines.size).indexOf("---")
+    if (end < 0) throw FrontMatterException("unterminated front matter")
+    val fm = LinkedHashMap<String, FmValue>()
+    for (idx in 1..end) {
+        val line = lines[idx]
+        if (line.isBlank() || line.startsWith("#")) continue
+        val m = KEY_LINE.matchEntire(line)
+            ?: throw FrontMatterException("front matter line ${idx + 1}: invalid line")
+        val key = m.groupValues[1]
+        if (key in fm) throw FrontMatterException("front matter line ${idx + 1}: duplicate key $key")
+        fm[key] = typedValue(m.groupValues[2].trim())
+    }
+    return Document(fm, lines.subList(end + 2, lines.size))
+}
+
+private fun typedValue(v: String): FmValue = when {
+    v.isEmpty() -> FmValue.Null
+    v == "true" -> FmValue.Bool(true)
+    v == "false" -> FmValue.Bool(false)
+    INTEGER.matches(v) -> FmValue.Num(BigInteger(v))
+    v.length >= 2 && v.startsWith("\"") && v.endsWith("\"") -> FmValue.Str(v.substring(1, v.length - 1))
+    v.startsWith("[") && v.endsWith("]") -> {
+        val inner = v.substring(1, v.length - 1)
+        FmValue.Arr(if (inner.isBlank()) emptyList() else inner.split(",").map { it.trim() })
+    }
+    else -> FmValue.Str(v)
+}
+
+fun jsonString(s: String): String = buildString {
+    append('"')
+    for (c in s) {
+        when {
+            c == '"' -> append("\\\"")
+            c == '\\' -> append("\\\\")
+            c == '\n' -> append("\\n")
+            c == '\r' -> append("\\r")
+            c == '\t' -> append("\\t")
+            c < ' ' -> append("\\u%04x".format(c.code))
+            else -> append(c)
+        }
+    }
+    append('"')
+}
+
+private fun json(v: FmValue): String = when (v) {
+    FmValue.Null -> "null"
+    is FmValue.Bool -> v.value.toString()
+    is FmValue.Num -> v.value.toString()
+    is FmValue.Str -> jsonString(v.value)
+    is FmValue.Arr -> v.items.joinToString(", ", "[", "]") { jsonString(it) }
+}
+
+/** Formats front matter as a one-line JSON object. */
+fun frontMatterJson(fm: Map<String, FmValue>): String =
+    fm.entries.joinToString(", ", "{", "}") { (k, v) -> jsonString(k) + ": " + json(v) }
diff --git a/src/main/kotlin/mdc/Html.kt b/src/main/kotlin/mdc/Html.kt
new file mode 100644
index 0000000..c14c142
--- /dev/null
+++ b/src/main/kotlin/mdc/Html.kt
@@ -0,0 +1,84 @@
+package mdc
+
+/** A rendered heading, as recorded for the table of contents. */
+data class HeadingRef(val level: Int, val text: String, val slug: String)
+
+/** Renders blocks to HTML lines, assigning unique slugs to headings in document order. */
+class HtmlRenderer {
+    private val slugs = Slugger()
+    private val out = mutableListOf<String>()
+    val headings = mutableListOf<HeadingRef>()
+
+    fun render(blocks: List<Block>): List<String> {
+        blocks.forEach { block(it) }
+        return out
+    }
+
+    private fun block(b: Block) {
+        when (b) {
+            is Block.Heading -> {
+                val text = plainText(b.content)
+                val slug = slugs.unique(text)
+                headings.add(HeadingRef(b.level, text, slug))
+                out.add("<h${b.level} id=\"${escapeHtml(slug)}\">${renderInline(b.content)}</h${b.level}>")
+            }
+            is Block.Paragraph -> out.add("<p>" + inlineHtml(b.lines.joinToString("\n")) + "</p>")
+            Block.Rule -> out.add("<hr>")
+            is Block.CodeBlock -> {
+                val cls = b.language?.let { " class=\"language-${escapeHtml(it)}\"" } ?: ""
+                val body = b.lines.joinToString("") { escapeHtml(it) + "\n" }
+                out.add("<pre><code$cls>$body</code></pre>")
+            }
+            is Block.Quote -> {
+                out.add("<blockquote>")
+                b.children.forEach { block(it) }
+                out.add("</blockquote>")
+            }
+            is Block.ListBlock -> list(b)
+            is Block.Table -> table(b)
+        }
+    }
+
+    private fun list(l: Block.ListBlock) {
+        out.add(listOpenTag(l.ordered, l.start))
+        for (item in l.items) {
+            val text = inlineHtml(item.text)
+            if (item.children.isEmpty()) {
+                out.add("<li>$text</li>")
+            } else {
+                out.add("<li>$text")
+                item.children.forEach { list(it) }
+                out.add("</li>")
+            }
+        }
+        out.add(if (l.ordered) "</ol>" else "</ul>")
+    }
+
+    private fun table(t: Block.Table) {
+        fun row(cells: List<String>, tag: String) = cells.indices.joinToString("", "<tr>", "</tr>") { c ->
+            val align = when (t.aligns[c]) {
+                Align.NONE -> ""
+                Align.LEFT -> " align=\"left\""
+                Align.RIGHT -> " align=\"right\""
+                Align.CENTER -> " align=\"center\""
+            }
+            "<$tag$align>${inlineHtml(cells[c])}</$tag>"
+        }
+        out.add("<table>")
+        out.add("<thead>")
+        out.add(row(t.header, "th"))
+        out.add("</thead>")
+        if (t.rows.isNotEmpty()) {
+            out.add("<tbody>")
+            t.rows.forEach { out.add(row(it, "td")) }
+            out.add("</tbody>")
+        }
+        out.add("</table>")
+    }
+}
+
+fun listOpenTag(ordered: Boolean, start: Int): String = when {
+    !ordered -> "<ul>"
+    start != 1 -> "<ol start=\"$start\">"
+    else -> "<ol>"
+}
diff --git a/src/main/kotlin/mdc/Inline.kt b/src/main/kotlin/mdc/Inline.kt
new file mode 100644
index 0000000..3e0e3cc
--- /dev/null
+++ b/src/main/kotlin/mdc/Inline.kt
@@ -0,0 +1,246 @@
+package mdc
+
+/** Escapes the four characters that are special in HTML text and attribute values. */
+fun escapeHtml(s: String): String {
+    val sb = StringBuilder(s.length)
+    for (c in s) {
+        when (c) {
+            '&' -> sb.append("&amp;")
+            '<' -> sb.append("&lt;")
+            '>' -> sb.append("&gt;")
+            '"' -> sb.append("&quot;")
+            else -> sb.append(c)
+        }
+    }
+    return sb.toString()
+}
+
+/** Inline syntax tree. */
+sealed interface Inline {
+    data class Text(val text: String) : Inline
+    data class Code(val code: String) : Inline
+    data class Emphasis(val children: List<Inline>) : Inline
+    data class Strong(val children: List<Inline>) : Inline
+    data class Link(val url: String, val title: String?, val children: List<Inline>) : Inline
+    data class Image(val url: String, val alt: String, val title: String?) : Inline
+}
+
+private const val ESCAPABLE = "\\`*_[]()#+-.!|>"
+
+/** Parses inline Markdown into a list of nodes. */
+fun parseInline(s: String): List<Inline> = InlineParser(s, allowLinks = true).parse()
+
+fun renderInline(nodes: List<Inline>): String = buildString { nodes.forEach { appendHtml(it) } }
+
+/** Plain text of the nodes: markup removed, code and alt text kept, not escaped. */
+fun plainText(nodes: List<Inline>): String = buildString { nodes.forEach { appendPlain(it) } }
+
+fun inlineHtml(s: String): String = renderInline(parseInline(s))
+
+private fun StringBuilder.appendHtml(n: Inline) {
+    when (n) {
+        is Inline.Text -> append(escapeHtml(n.text))
+        is Inline.Code -> append("<code>").append(escapeHtml(n.code)).append("</code>")
+        is Inline.Emphasis -> append("<em>").append(renderInline(n.children)).append("</em>")
+        is Inline.Strong -> append("<strong>").append(renderInline(n.children)).append("</strong>")
+        is Inline.Link -> {
+            append("<a href=\"").append(escapeHtml(n.url)).append('"')
+            n.title?.let { append(" title=\"").append(escapeHtml(it)).append('"') }
+            append('>').append(renderInline(n.children)).append("</a>")
+        }
+        is Inline.Image -> {
+            append("<img src=\"").append(escapeHtml(n.url)).append("\" alt=\"").append(escapeHtml(n.alt)).append('"')
+            n.title?.let { append(" title=\"").append(escapeHtml(it)).append('"') }
+            append('>')
+        }
+    }
+}
+
+private fun StringBuilder.appendPlain(n: Inline) {
+    when (n) {
+        is Inline.Text -> append(n.text)
+        is Inline.Code -> append(n.code)
+        is Inline.Emphasis -> n.children.forEach { appendPlain(it) }
+        is Inline.Strong -> n.children.forEach { appendPlain(it) }
+        is Inline.Link -> n.children.forEach { appendPlain(it) }
+        is Inline.Image -> append(n.alt)
+    }
+}
+
+private class InlineParser(private val s: String, private val allowLinks: Boolean) {
+    private val out = mutableListOf<Inline>()
+    private val text = StringBuilder()
+
+    fun parse(): List<Inline> {
+        var i = 0
+        while (i < s.length) {
+            i = step(i)
+        }
+        flush()
+        return out
+    }
+
+    private fun flush() {
+        if (text.isNotEmpty()) {
+            out.add(Inline.Text(text.toString()))
+            text.clear()
+        }
+    }
+
+    private fun emit(node: Inline) {
+        flush()
+        out.add(node)
+    }
+
+    /** Handles the construct starting at [i] and returns the index after it. */
+    private fun step(i: Int): Int {
+        val c = s[i]
+        return when {
+            c == '\\' && i + 1 < s.length && s[i + 1] in ESCAPABLE -> {
+                text.append(s[i + 1]); i + 2
+            }
+            c == '`' -> codeSpan(i)
+            c == '!' && i + 1 < s.length && s[i + 1] == '[' -> image(i) ?: run { text.append(c); i + 1 }
+            c == '[' && allowLinks -> link(i) ?: run { text.append(c); i + 1 }
+            c == '*' || c == '_' -> emphasis(i)
+            else -> {
+                text.append(c); i + 1
+            }
+        }
+    }
+
+    private fun runLength(i: Int, ch: Char): Int {
+        var j = i
+        while (j < s.length && s[j] == ch) j++
+        return j - i
+    }
+
+    private fun codeSpan(i: Int): Int {
+        val n = runLength(i, '`')
+        var j = i + n
+        while (j < s.length) {
+            if (s[j] == '`') {
+                val m = runLength(j, '`')
+                if (m == n) {
+                    emit(Inline.Code(s.substring(i + n, j)))
+                    return j + m
+                }
+                j += m
+            } else {
+                j++
+            }
+        }
+        text.append(s, i, i + n)
+        return i + n
+    }
+
+    /** Index of the first unescaped ']' at or after [from], or -1. */
+    private fun closingBracket(from: Int): Int {
+        var j = from
+        while (j < s.length) {
+            when (s[j]) {
+                '\\' -> j += 2
+                ']' -> return j
+                else -> j++
+            }
+        }
+        return -1
+    }
+
+    /** Parses `(url "title")` at [open]; returns url, title and the index after ')'. */
+    private fun destination(open: Int): Triple<String, String?, Int>? {
+        if (open >= s.length || s[open] != '(') return null
+        var j = open + 1
+        val start = j
+        while (j < s.length && s[j] != ')' && s[j] != ' ') j++
+        if (j >= s.length) return null
+        val url = s.substring(start, j)
+        if (s[j] == ')') return Triple(url, null, j + 1)
+        // a space: a quoted title must follow
+        if (j + 1 >= s.length || s[j + 1] != '"') return null
+        val endQuote = s.indexOf('"', j + 2)
+        if (endQuote < 0 || endQuote + 1 >= s.length || s[endQuote + 1] != ')') return null
+        return Triple(url, s.substring(j + 2, endQuote), endQuote + 2)
+    }
+
+    private fun image(i: Int): Int? {
+        val close = closingBracket(i + 2)
+        if (close < 0) return null
+        val (url, title, end) = destination(close + 1) ?: return null
+        emit(Inline.Image(url, s.substring(i + 2, close), title))
+        return end
+    }
+
+    private fun link(i: Int): Int? {
+        val close = closingBracket(i + 1)
+        if (close < 0) return null
+        val (url, title, end) = destination(close + 1) ?: return null
+        val children = InlineParser(s.substring(i + 1, close), allowLinks = false).parse()
+        emit(Inline.Link(url, title, children))
+        return end
+    }
+
+    private fun isWordChar(k: Int) = k in s.indices && s[k].isLetterOrDigit()
+
+    private fun intraword(k: Int) = s[k] == '_' && isWordChar(k - 1) && isWordChar(k + 1)
+
+    private fun emphasis(i: Int): Int {
+        val ch = s[i]
+        val run = runLength(i, ch)
+        if (run >= 2) {
+            val close = findStrongCloser(i + 2, ch)
+            if (close > 0 && !s[i + 2].isWhitespace()) {
+                emit(Inline.Strong(parseInline(s.substring(i + 2, close))))
+                return close + 2
+            }
+            text.append(s, i, i + run)
+            return i + run
+        }
+        if (intraword(i) || i + 1 >= s.length || s[i + 1].isWhitespace()) {
+            text.append(ch)
+            return i + 1
+        }
+        val close = findSingleCloser(i + 1, ch)
+        if (close < 0) {
+            text.append(ch)
+            return i + 1
+        }
+        emit(Inline.Emphasis(parseInline(s.substring(i + 1, close))))
+        return close + 1
+    }
+
+    /** Next position >= [from] of a closer, skipping escapes and code spans. */
+    private inline fun scan(from: Int, isCloser: (Int) -> Boolean): Int {
+        var j = from
+        while (j < s.length) {
+            when {
+                s[j] == '\\' -> j += 2
+                s[j] == '`' -> {
+                    val n = runLength(j, '`')
+                    var k = j + n
+                    var found = -1
+                    while (k < s.length) {
+                        if (s[k] == '`') {
+                            val m = runLength(k, '`')
+                            if (m == n) { found = k + m; break }
+                            k += m
+                        } else k++
+                    }
+                    j = if (found > 0) found else j + n
+                }
+                isCloser(j) -> return j
+                else -> j++
+            }
+        }
+        return -1
+    }
+
+    private fun findStrongCloser(from: Int, ch: Char): Int = scan(from) { j ->
+        j > from && j + 1 < s.length && s[j] == ch && s[j + 1] == ch && !s[j - 1].isWhitespace()
+    }
+
+    private fun findSingleCloser(from: Int, ch: Char): Int = scan(from) { j ->
+        j > from && s[j] == ch && s[j - 1] != ch && (j + 1 >= s.length || s[j + 1] != ch) &&
+            !s[j - 1].isWhitespace() && !intraword(j)
+    }
+}
diff --git a/src/main/kotlin/mdc/Main.kt b/src/main/kotlin/mdc/Main.kt
