+++ b/src/main/kotlin/mdc/Main.kt
@@ -0,0 +1,95 @@
+package mdc
+
+import java.io.File
+import java.io.IOException
+import kotlin.system.exitProcess
+
+private const val USAGE = """usage: mdc [--toc] [--toc-depth <n>] [--front-matter] [-o <file>] [<input>]
+
+Converts Markdown to an HTML fragment. Reads <input> or stdin, writes stdout or <file>.
+  --toc            prepend a table of contents
+  --toc-depth <n>  include headings of level <= n in the table of contents (1-6, default 3)
+  --front-matter   print the front matter as JSON instead of HTML
+  -o <file>        write the output to <file>
+"""
+
+private class UsageException(message: String) : Exception(message)
+
+private data class Args(
+    val options: Options,
+    val frontMatter: Boolean,
+    val output: String?,
+    val input: String?,
+)
+
+private fun parseArgs(argv: Array<String>): Args {
+    var toc = false
+    var depth = 3
+    var frontMatter = false
+    var output: String? = null
+    var input: String? = null
+    var k = 0
+    fun value(name: String): String {
+        if (k + 1 >= argv.size) throw UsageException("missing value for $name")
+        return argv[++k]
+    }
+    while (k < argv.size) {
+        when (val a = argv[k]) {
+            "--toc" -> toc = true
+            "--toc-depth" -> {
+                val v = value(a)
+                depth = v.toIntOrNull()?.takeIf { it in 1..6 }
+                    ?: throw UsageException("invalid --toc-depth value: $v")
+            }
+            "--front-matter" -> frontMatter = true
+            "-o" -> output = value(a)
+            else -> when {
+                a.startsWith("-") && a != "-" -> throw UsageException("unknown option: $a")
+                input != null -> throw UsageException("more than one input file")
+                else -> input = a
+            }
+        }
+        k++
+    }
+    return Args(Options(toc, depth), frontMatter, output, input)
+}
+
+private fun fail(code: Int, message: String): Nothing {
+    System.err.println("error: $message")
+    exitProcess(code)
+}
+
+fun main(argv: Array<String>) {
+    if (argv.size == 1 && (argv[0] == "--help" || argv[0] == "-h")) {
+        print(USAGE)
+        return
+    }
+    val args = try {
+        parseArgs(argv)
+    } catch (e: UsageException) {
+        fail(2, e.message ?: "usage error")
+    }
+    val source = args.input
+    val text = try {
+        if (source == null || source == "-") System.`in`.readBytes().toString(Charsets.UTF_8)
+        else File(source).readText(Charsets.UTF_8)
+    } catch (e: IOException) {
+        fail(1, "cannot read $source")
+    }
+    val result = try {
+        if (args.frontMatter) extractFrontMatter(text) else convert(text, args.options)
+    } catch (e: FrontMatterException) {
+        fail(3, e.message ?: "invalid front matter")
+    }
+    val out = args.output
+    if (out == null) {
+        System.out.write(result.toByteArray(Charsets.UTF_8))
+        System.out.flush()
+    } else {
+        try {
+            File(out).writeText(result, Charsets.UTF_8)
+        } catch (e: IOException) {
+            fail(1, "cannot write $out")
+        }
+    }
+}
diff --git a/src/main/kotlin/mdc/Toc.kt b/src/main/kotlin/mdc/Toc.kt
new file mode 100644
index 0000000..194a209
--- /dev/null
+++ b/src/main/kotlin/mdc/Toc.kt
@@ -0,0 +1,61 @@
+package mdc
+
+/** Turns heading text into an anchor slug (without de-duplication). */
+fun slugify(text: String): String {
+    val sb = StringBuilder()
+    for (c in text.lowercase()) {
+        when {
+            c.isLetterOrDigit() -> sb.append(c)
+            c == ' ' || c == '-' -> if (sb.isNotEmpty() && sb.last() != '-') sb.append('-')
+        }
+    }
+    val slug = sb.toString().trim('-')
+    return slug.ifEmpty { "section" }
+}
+
+/** Hands out unique slugs: repeats get the smallest unused `-n` suffix. */
+class Slugger {
+    private val used = mutableSetOf<String>()
+
+    fun unique(text: String): String {
+        val base = slugify(text)
+        var slug = base
+        var n = 1
+        while (slug in used) slug = "$base-${n++}"
+        used.add(slug)
+        return slug
+    }
+}
+
+/** Renders the table of contents for the headings with level <= [depth]; empty when none match. */
+fun renderToc(headings: List<HeadingRef>, depth: Int): List<String> {
+    val included = headings.filter { it.level <= depth }
+    if (included.isEmpty()) return emptyList()
+    val minLevel = included.minOf { it.level }
+    var prev = -1
+    val items = included.map { h ->
+        val d = minOf(h.level - minLevel, prev + 1)
+        prev = d
+        d to h
+    }
+    val out = mutableListOf("<nav class=\"toc\">")
+    var k = 0
+    fun level(d: Int) {
+        out.add("<ul>")
+        while (k < items.size && items[k].first == d) {
+            val h = items[k++].second
+            val link = "<a href=\"#${escapeHtml(h.slug)}\">${escapeHtml(h.text)}</a>"
+            if (k < items.size && items[k].first > d) {
+                out.add("<li>$link")
+                level(d + 1)
+                out.add("</li>")
+            } else {
+                out.add("<li>$link</li>")
+            }
+        }
+        out.add("</ul>")
+    }
+    while (k < items.size) level(0)
+    out.add("</nav>")
+    return out
+}
diff --git a/src/test/kotlin/TestMain.kt b/src/test/kotlin/TestMain.kt
new file mode 100644
index 0000000..5bdce5f
--- /dev/null
+++ b/src/test/kotlin/TestMain.kt
@@ -0,0 +1,94 @@
+import mdc.FrontMatterException
+import mdc.Options
+import mdc.convert
+import mdc.extractFrontMatter
+import mdc.slugify
+import kotlin.system.exitProcess
+
+private var passed = 0
+private val failures = mutableListOf<String>()
+
+private fun test(name: String, body: () -> Unit) {
+    try {
+        body()
+        passed++
+    } catch (e: Throwable) {
+        failures.add("$name: ${e.message}")
+    }
+}
+
+private fun assertEq(expected: Any?, actual: Any?) {
+    if (expected != actual) throw AssertionError("expected <$expected> but was <$actual>")
+}
+
+private fun lines(vararg l: String) = l.joinToString("") { it + "\n" }
+
+fun main() {
+    test("empty input gives empty output") { assertEq("", convert("")) }
+    test("heading with id") { assertEq(lines("<h2 id=\"a-b\">A <em>b</em></h2>"), convert("## A *b*\n")) }
+    test("paragraph joins lines") { assertEq(lines("<p>x\ny</p>"), convert(" x \ny\n")) }
+    test("escaping") { assertEq(lines("<p>&lt;a&gt; &amp; &quot;</p>"), convert("<a> & \"\n")) }
+    test("strong and emphasis nest") {
+        assertEq(lines("<p><strong>a <em>b</em> c</strong></p>"), convert("**a *b* c**\n"))
+    }
+    test("intraword underscore") { assertEq(lines("<p>a_b_c</p>"), convert("a_b_c\n")) }
+    test("code span keeps markup") { assertEq(lines("<p><code>*x* &lt;</code></p>"), convert("`*x* <`\n")) }
+    test("link with title") {
+        assertEq(lines("<p><a href=\"/u\" title=\"T\">go</a></p>"), convert("[go](/u \"T\")\n"))
+    }
+    test("image") { assertEq(lines("<p><img src=\"i.png\" alt=\"pic\"></p>"), convert("![pic](i.png)\n")) }
+    test("fenced code") {
+        assertEq(lines("<pre><code class=\"language-js\">a &lt; b\n</code></pre>"), convert("```js\na < b\n```\n"))
+    }
+    test("nested list") {
+        assertEq(lines("<ol start=\"2\">", "<li>a", "<ul>", "<li>b</li>", "</ul>", "</li>", "</ol>"),
+            convert("2. a\n   - b\n"))
+    }
+    test("blockquote") {
+        assertEq(lines("<blockquote>", "<h1 id=\"t\">t</h1>", "</blockquote>"), convert("> # t\n"))
+    }
+    test("table") {
+        assertEq(
+            lines("<table>", "<thead>", "<tr><th align=\"center\">a</th></tr>", "</thead>", "<tbody>",
+                "<tr><td align=\"center\">1</td></tr>", "</tbody>", "</table>"),
+            convert("|a|\n|:-:|\n|1|\n"),
+        )
+    }
+    test("slugify") {
+        assertEq("hello-world", slugify("Hello, -- World!"))
+        assertEq("section", slugify("!!!"))
+    }
+    test("duplicate slugs") {
+        assertEq(lines("<h1 id=\"a\">a</h1>", "<h1 id=\"a-1\">a</h1>"), convert("# a\n# a\n"))
+    }
+    test("toc") {
+        assertEq(
+            lines("<nav class=\"toc\">", "<ul>", "<li><a href=\"#x\">X</a>", "<ul>", "<li><a href=\"#y\">Y</a></li>",
+                "</ul>", "</li>", "</ul>", "</nav>", "<h1 id=\"x\">X</h1>", "<h2 id=\"y\">Y</h2>"),
+            convert("# X\n## Y\n", Options(toc = true)),
+        )
+    }
+    test("front matter json") {
+        assertEq("{\"t\": \"a\\\"b\", \"n\": -3, \"l\": [\"x\", \"y\"], \"e\": null}\n",
+            extractFrontMatter("---\nt: a\"b\nn: -3\nl: [x, y]\ne:\n---\nbody\n"))
+    }
+    test("front matter removed from html") { assertEq(lines("<p>body</p>"), convert("---\na: 1\n---\nbody\n")) }
+    test("front matter errors") {
+        for ((src, msg) in listOf(
+            "---\na: 1\n" to "unterminated front matter",
+            "---\nbad\n---\n" to "front matter line 2: invalid line",
+            "---\na: 1\na: 2\n---\n" to "front matter line 3: duplicate key a",
+        )) {
+            try {
+                extractFrontMatter(src)
+                throw AssertionError("no error for $src")
+            } catch (e: FrontMatterException) {
+                assertEq(msg, e.message)
+            }
+        }
+    }
+
+    println("$passed passed, ${failures.size} failed")
+    failures.forEach { println("FAIL $it") }
+    if (failures.isNotEmpty()) exitProcess(1)
+}
