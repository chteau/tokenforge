 # mdc — a small Markdown to HTML converter
+
+Converts a subset of Markdown (headings, emphasis, code, links, images, lists,
+blockquotes, tables) to an HTML fragment, with an optional table of contents and
+front-matter extraction to JSON.
+
+## Build
+
+Requires `kotlinc` (2.x) and a JRE; no other dependencies.
+
+    kotlinc src/main/kotlin -include-runtime -d build/mdc.jar
+
+## Test
+
+    kotlinc src/test/kotlin -cp build/mdc.jar -d build/test-classes
+    java -cp build/mdc.jar:build/test-classes TestMainKt
+
+## Usage
+
+    java -jar build/mdc.jar [--toc] [--toc-depth <n>] [--front-matter] [-o <file>] [<input>]
+
+Reads `<input>` (or stdin) and writes HTML to stdout (or `<file>`).
+`--front-matter` prints the document's front matter as a JSON object instead.
diff --git a/src/main/kotlin/mdc/Blocks.kt b/src/main/kotlin/mdc/Blocks.kt
new file mode 100644
index 0000000..4b12792
--- /dev/null
+++ b/src/main/kotlin/mdc/Blocks.kt
@@ -0,0 +1,178 @@
+package mdc
+
+enum class Align { NONE, LEFT, RIGHT, CENTER }
+
+/** Block syntax tree. */
+sealed interface Block {
+    data class Heading(val level: Int, val content: List<Inline>) : Block
+    data class Paragraph(val lines: List<String>) : Block
+    data object Rule : Block
+    data class CodeBlock(val language: String?, val lines: List<String>) : Block
+    data class Quote(val children: List<Block>) : Block
+    data class ListBlock(val ordered: Boolean, val start: Int, val items: List<ListItem>) : Block
+    data class Table(val aligns: List<Align>, val header: List<String>, val rows: List<List<String>>) : Block
+}
+
+data class ListItem(val text: String, val children: List<Block.ListBlock>)
+
+private val HEADING = Regex("^(#{1,6}) (.*)$")
+private val RULE = Regex("^(-{3,}|\\*{3,}|_{3,})$")
+private val LIST_ITEM = Regex("^( *)([-*+]|[0-9]{1,9}\\.) +(.*)$")
+private val DELIM_CELL = Regex("^:?-+:?$")
+private const val FENCE = "```"
+
+/** Parses document lines (front matter already removed) into blocks. */
+fun parseBlocks(lines: List<String>): List<Block> = BlockParser(lines).parse()
+
+private class BlockParser(private val lines: List<String>) {
+    private var i = 0
+
+    fun parse(): List<Block> {
+        val blocks = mutableListOf<Block>()
+        while (i < lines.size) {
+            val line = lines[i]
+            when {
+                line.isBlank() -> i++
+                else -> blocks.addAll(startBlock() ?: listOf(paragraph()))
+            }
+        }
+        return blocks
+    }
+
+    /** Parses the non-paragraph block(s) starting at line [i], or returns null. */
+    private fun startBlock(): List<Block>? {
+        val line = lines[i]
+        HEADING.matchEntire(line)?.let { m ->
+            i++
+            return listOf(Block.Heading(m.groupValues[1].length, parseInline(m.groupValues[2].trim())))
+        }
+        if (RULE.matches(line)) {
+            i++
+            return listOf(Block.Rule)
+        }
+        if (line.startsWith(FENCE)) return listOf(codeBlock())
+        if (line.startsWith(">")) return listOf(quote())
+        if (LIST_ITEM.matches(line)) return lists()
+        return tableAt(i)?.let { listOf(it) }
+    }
+
+    private fun paragraph(): Block {
+        val text = mutableListOf(lines[i++].trim())
+        while (i < lines.size && lines[i].isNotBlank()) {
+            val save = i
+            if (startBlock() != null) {
+                i = save
+                break
+            }
+            text.add(lines[i++].trim())
+        }
+        return Block.Paragraph(text)
+    }
+
+    private fun codeBlock(): Block {
+        val info = lines[i].substring(FENCE.length).trim()
+        val language = info.split(' ').firstOrNull { it.isNotEmpty() }
+        i++
+        val content = mutableListOf<String>()
+        while (i < lines.size && lines[i].trimEnd() != FENCE) content.add(lines[i++])
+        if (i < lines.size) i++ // closing fence
+        return Block.CodeBlock(language, content)
+    }
+
+    private fun quote(): Block {
+        val inner = mutableListOf<String>()
+        while (i < lines.size && lines[i].startsWith(">")) {
+            val rest = lines[i++].substring(1)
+            inner.add(if (rest.startsWith(" ")) rest.substring(1) else rest)
+        }
+        return Block.Quote(parseBlocks(inner))
+    }
+
+    private data class RawItem(val depth: Int, val ordered: Boolean, val number: Int, val text: String)
+
+    /** Parses consecutive list items; a top-level ordered/unordered switch yields several lists. */
+    private fun lists(): List<Block> {
+        val items = mutableListOf<RawItem>()
+        while (i < lines.size) {
+            if (lines[i].isBlank()) {
+                var j = i
+                while (j < lines.size && lines[j].isBlank()) j++
+                if (j < lines.size && LIST_ITEM.matches(lines[j])) i = j else break
+            }
+            val m = LIST_ITEM.matchEntire(lines[i]) ?: break
+            val (indent, marker, text) = m.destructured
+            val depth = if (items.isEmpty()) 0 else minOf(indent.length / 2, items.last().depth + 1)
+            val ordered = marker.endsWith(".")
+            val number = if (ordered) marker.dropLast(1).toInt() else 0
+            items.add(RawItem(depth, ordered, number, text.trimEnd()))
+            i++
+        }
+        return buildLists(items, 0, 0).first
+    }
+
+    /** Builds the lists at [depth] from items starting at [from]; returns them and the index after. */
+    private fun buildLists(items: List<RawItem>, from: Int, depth: Int): Pair<List<Block.ListBlock>, Int> {
+        val lists = mutableListOf<Block.ListBlock>()
+        var k = from
+        while (k < items.size && items[k].depth >= depth) {
+            val ordered = items[k].ordered
+            val start = items[k].number
+            val entries = mutableListOf<ListItem>()
+            while (k < items.size && items[k].depth == depth && items[k].ordered == ordered) {
+                val text = items[k].text
+                val (children, next) = buildLists(items, k + 1, depth + 1)
+                entries.add(ListItem(text, children))
+                k = next
+            }
+            lists.add(Block.ListBlock(ordered, if (ordered) start else 1, entries))
+        }
+        return lists to k
+    }
+
+    private fun splitCells(line: String): List<String> {
+        var s = line.trim()
+        if (s.startsWith("|")) s = s.substring(1)
+        if (s.endsWith("|") && !s.endsWith("\\|")) s = s.dropLast(1)
+        val cells = mutableListOf<String>()
+        val cur = StringBuilder()
+        var k = 0
+        while (k < s.length) {
+            val c = s[k]
+            if (c == '\\' && k + 1 < s.length && s[k + 1] == '|') {
+                cur.append('|'); k += 2; continue
+            }
+            if (c == '|') {
+                cells.add(cur.toString().trim()); cur.clear()
+            } else {
+                cur.append(c)
+            }
+            k++
+        }
+        cells.add(cur.toString().trim())
+        return cells
+    }
+
+    private fun tableAt(at: Int): Block? {
+        if (at + 1 >= lines.size || '|' !in lines[at] || '|' !in lines[at + 1]) return null
+        val header = splitCells(lines[at])
+        val delims = splitCells(lines[at + 1])
+        if (delims.size != header.size || !delims.all { DELIM_CELL.matches(it) }) return null
+        val aligns = delims.map {
+            val left = it.startsWith(":")
+            val right = it.endsWith(":")
+            when {
+                left && right -> Align.CENTER
+                left -> Align.LEFT
+                right -> Align.RIGHT
+                else -> Align.NONE
+            }
+        }
+        i = at + 2
+        val rows = mutableListOf<List<String>>()
+        while (i < lines.size && '|' in lines[i] && lines[i].isNotBlank()) {
+            val cells = splitCells(lines[i++])
+            rows.add(List(header.size) { cells.getOrElse(it) { "" } })
+        }
+        return Block.Table(aligns, header, rows)
+    }
+}
