@@ -0,0 +1,48 @@
+# frozen_string_literal: true
+
+require "test_helper"
+require "zlib"
+
+class CLITest < Minitest::Test
+  include CLIHelper
+
+  def test_text_report
+    input = log_line(path: "/a") + log_line(path: "/a?x=1", status: 404) + "bad line\n"
+    r = run_cli(stdin: input)
+    assert_equal 0, r.code
+    assert_includes r.out, "Requests: 2\nMalformed lines: 1\n"
+    assert_includes r.out, "  200 1 (50.0%)\n  404 1 (50.0%)\n"
+    assert_includes r.out, "Top paths:\n  2 /a\n"
+    assert_equal "warning: skipped 1 malformed line(s)\n", r.err
+  end
+
+  def test_json_and_filters
+    input = log_line(path: "/api/x", status: 500) + log_line(path: "/home", status: 200)
+    r = run_cli("--format", "json", "--status", "5xx", "--path", "/api/*", stdin: input)
+    doc = JSON.parse(r.out)
+    assert_equal 1, doc["requests"]
+    assert_equal({ "500" => 1 }, doc["status"])
+  end
+
+  def test_gzip_input_on_stdin
+    gz = StringIO.new
+    Zlib::GzipWriter.wrap(gz) { |w| w.write(log_line) }
+    r = run_cli("--format", "json", stdin: gz.string)
+    assert_equal 1, JSON.parse(r.out)["requests"]
+  end
+
+  def test_strict_mode
+    r = run_cli("--strict", stdin: log_line + "\noops\n")
+    assert_equal 3, r.code
+    assert_equal "", r.out
+    assert_equal "error: -:3: malformed line\n", r.err
+  end
+
+  def test_usage_and_io_errors
+    assert_equal 2, run_cli("--top", "0").code
+    assert_equal 2, run_cli("--since", "2026-10-11", "--until", "2026-10-10").code
+    r = run_cli("/no/such/file.log")
+    assert_equal 4, r.code
+    assert r.err.start_with?("error: cannot read /no/such/file.log")
+  end
+end
