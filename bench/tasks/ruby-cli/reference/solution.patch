index 0000000..96cb0c9
--- /dev/null
+++ b/lib/logtally/reader.rb
@@ -0,0 +1,42 @@
+# frozen_string_literal: true
+
+require "stringio"
+require "zlib"
+
+module Logtally
+  # Opens inputs (files or "-" for stdin), transparently gunzipping, and yields their lines.
+  class Reader
+    GZIP_MAGIC = "\x1f\x8b".b
+
+    def initialize(stdin)
+      @stdin = stdin
+    end
+
+    # Yields (label, line_number, line) for every line of every input, in order.
+    def each_line(paths)
+      paths = ["-"] if paths.empty?
+      paths.each do |path|
+        io = open_input(path)
+        io.each_line.with_index(1) { |line, number| yield path, number, line }
+      end
+    end
+
+    private
+
+    def open_input(path)
+      raw = path == "-" ? @stdin.binmode.read : File.binread(path)
+      raw.start_with?(GZIP_MAGIC) ? StringIO.new(gunzip(raw)) : StringIO.new(raw)
+    rescue SystemCallError, IOError => e
+      raise InputError, "cannot read #{path}: #{e.message.sub(/ @ .*\z/, '')}"
+    rescue Zlib::Error => e
+      raise InputError, "cannot read #{path}: #{e.message}"
+    end
+
+    # Decompresses every gzip member (concatenated streams) in `data`.
+    def gunzip(data)
+      out = String.new(encoding: Encoding::BINARY)
+      Zlib::GzipReader.zcat(StringIO.new(data)) { |chunk| out << chunk.b }
+      out
+    end
+  end
+end
