+# frozen_string_literal: true
+
+# logtally: access-log statistics from the command line.
+module Logtally
+  # Invalid command-line usage (exit 2).
+  class UsageError < StandardError; end
+
+  # A malformed line in --strict mode (exit 3).
+  class MalformedLineError < StandardError; end
+
+  # An input that cannot be opened, read or decompressed (exit 4).
+  class InputError < StandardError; end
+end
+
+require_relative "logtally/entry"
+require_relative "logtally/line_parser"
+require_relative "logtally/reader"
+require_relative "logtally/filter"
+require_relative "logtally/stats"
+require_relative "logtally/formatter"
+require_relative "logtally/cli"
diff --git a/lib/logtally/cli.rb b/lib/logtally/cli.rb
new file mode 100644
index 0000000..10a573f
--- /dev/null
+++ b/lib/logtally/cli.rb
@@ -0,0 +1,89 @@
+# frozen_string_literal: true
+
+require "optparse"
+
+module Logtally
+  # Command-line entry point: parses options, runs the analysis, maps errors to exit codes.
+  class CLI
+    def initialize(stdout, stderr, stdin)
+      @stdout = stdout
+      @stderr = stderr
+      @stdin = stdin
+    end
+
+    def run(argv)
+      options = parse_options(argv.dup)
+      return 0 if options.nil?
+
+      stats = analyze(options)
+      @stdout.write(Formatter.render(options[:format], stats, options[:top]))
+      @stderr.puts("warning: skipped #{stats.malformed} malformed line(s)") if stats.malformed.positive?
+      0
+    rescue UsageError, OptionParser::ParseError => e
+      fail_with(2, e.message)
+    rescue MalformedLineError => e
+      fail_with(3, e.message)
+    rescue InputError => e
+      fail_with(4, e.message)
+    end
+
+    private
+
+    def analyze(options)
+      stats = Stats.new
+      Reader.new(@stdin).each_line(options[:files]) do |label, number, line|
+        line = line.chomp.delete_suffix("\r")
+        next if line.strip.empty?
+
+        entry = LineParser.parse(line)
+        if entry.nil?
+          raise MalformedLineError, "#{label}:#{number}: malformed line" if options[:strict]
+
+          stats.malformed += 1
+        elsif options[:filter].match?(entry)
+          stats.add(entry)
+        end
+      end
+      stats
+    end
+
+    def parse_options(argv)
+      opts = { format: "text", top: 10, strict: false, statuses: nil, paths: [], since: nil, until: nil }
+      parser = OptionParser.new do |o|
+        o.banner = "Usage: logtally [options] [FILE...]"
+        o.on("--format FORMAT", "text (default) or json") { |v| opts[:format] = v }
+        o.on("--top N", "number of top paths (default 10)") { |v| opts[:top] = v }
+        o.on("--since TIME", "only requests at or after TIME") { |v| opts[:since] = v }
+        o.on("--until TIME", "only requests before TIME") { |v| opts[:until] = v }
+        o.on("--status LIST", "e.g. 200,3xx,5xx") { |v| opts[:statuses] = v }
+        o.on("--path GLOB", "only matching paths (repeatable)") { |v| opts[:paths] << v }
+        o.on("--strict", "fail on the first malformed line") { opts[:strict] = true }
+        o.on("-h", "--help", "show this help") do
+          @stdout.puts(o.help)
+          return nil
+        end
+      end
+      parser.require_exact = true
+      files = parser.parse(argv)
+      build(opts, files)
+    end
+
+    def build(opts, files)
+      raise UsageError, "invalid --format: #{opts[:format]}" unless %w[text json].include?(opts[:format])
+      raise UsageError, "invalid --top: #{opts[:top]}" unless opts[:top].is_a?(Integer) || opts[:top] =~ /\A[1-9]\d*\z/
+
+      filter = Filter.new(
+        since: opts[:since] && Filter.parse_time(opts[:since]),
+        until_time: opts[:until] && Filter.parse_time(opts[:until]),
+        statuses: opts[:statuses] && Filter.parse_statuses(opts[:statuses]),
+        paths: opts[:paths]
+      )
+      { format: opts[:format], top: Integer(opts[:top]), strict: opts[:strict], files: files, filter: filter }
+    end
+
+    def fail_with(code, message)
+      @stderr.puts("error: #{message}")
+      code
+    end
+  end
+end
