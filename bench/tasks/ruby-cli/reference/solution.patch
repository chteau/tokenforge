+++ b/lib/logtally/stats.rb
@@ -0,0 +1,55 @@
+# frozen_string_literal: true
+
+module Logtally
+  # Accumulates counts over entries and derives the report figures.
+  class Stats
+    PERCENTILES = [50, 95, 99].freeze
+
+    attr_reader :requests, :bytes, :first_time, :last_time
+    attr_accessor :malformed
+
+    def initialize
+      @requests = 0
+      @malformed = 0
+      @bytes = 0
+      @first_time = nil
+      @last_time = nil
+      @statuses = Hash.new(0)
+      @paths = Hash.new(0)
+      @durations = []
+    end
+
+    def add(entry)
+      @requests += 1
+      @bytes += entry.bytes
+      @first_time = entry.time if @first_time.nil? || entry.time < @first_time
+      @last_time = entry.time if @last_time.nil? || entry.time > @last_time
+      @statuses[entry.status] += 1
+      @paths[entry.path] += 1
+      @durations << entry.duration if entry.duration
+    end
+
+    # [[code, count], ...] ascending by code.
+    def statuses
+      @statuses.sort
+    end
+
+    # [[path, count], ...] by count desc, then path (bytes) asc.
+    def top_paths(limit)
+      @paths.sort { |(pa, ca), (pb, cb)| [cb, pa.b] <=> [ca, pb.b] }.first(limit)
+    end
+
+    # {50 => v, 95 => v, 99 => v} using the nearest-rank method, or nil without samples.
+    def latency
+      return nil if @durations.empty?
+
+      sorted = @durations.sort
+      n = sorted.size
+      PERCENTILES.to_h { |p| [p, sorted[((p * n) + 99) / 100 - 1]] }
+    end
+
+    def latency_samples
+      @durations.size
+    end
+  end
+end
