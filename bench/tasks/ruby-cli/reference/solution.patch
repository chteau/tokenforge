+# frozen_string_literal: true
+
+require "test_helper"
+
+class LineParserTest < Minitest::Test
+  LINE = '203.0.113.7 - alice [10/Oct/2026:13:55:36 +0200] "GET /api/items?page=2 HTTP/1.1" 200 2326 ' \
+         '"-" "curl/8.5.0" 0.042'
+
+  def test_parses_combined_line_with_request_time
+    e = Logtally::LineParser.parse(LINE)
+    assert_equal "/api/items", e.path
+    assert_equal 200, e.status
+    assert_equal 2326, e.bytes
+    assert_in_delta 0.042, e.duration
+    assert_equal Time.utc(2026, 10, 10, 11, 55, 36).to_i, e.time
+  end
+
+  def test_request_time_is_optional
+    e = Logtally::LineParser.parse(LINE.delete_suffix(" 0.042"))
+    assert_nil e.duration
+  end
+
+  def test_escaped_quotes_and_invalid_utf8_in_user_agent
+    line = LINE.sub('"curl/8.5.0"', "\"a \\\"quoted\\\" \xFF agent\"".b)
+    refute_nil Logtally::LineParser.parse(line)
+  end
+
+  def test_rejects_malformed_lines
+    ["garbage", LINE.sub("Oct", "Foo"), LINE.sub("10/Oct", "31/Feb"), LINE.sub(" 200 ", " 600 "),
+     LINE.sub("GET /api", "get /api"), LINE.sub(" 2326 ", " 12x ")].each do |bad|
+      assert_nil Logtally::LineParser.parse(bad), bad
+    end
+  end
+end
