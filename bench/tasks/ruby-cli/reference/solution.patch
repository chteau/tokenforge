index b77357d..7e3f406 100644
--- a/README.md
+++ b/README.md
@@ -1 +1,23 @@
 # logtally — access-log statistics from the command line
+
+Reads nginx/Apache combined-format access logs (plain or gzip, files or stdin) and
+reports request counts, status codes, top paths, bytes and latency percentiles.
+Ruby 4.0, standard library only.
+
+## Usage
+
+```
+bin/logtally [--format text|json] [--top N] [--since TIME] [--until TIME]
+             [--status 200,3xx] [--path GLOB]... [--strict] [FILE...]
+```
+
+The optional last field of each line is the request time in seconds (nginx
+`$request_time`); it feeds the p50/p95/p99 latency figures.
+
+Exit codes: 0 ok, 2 usage error, 3 malformed line with `--strict`, 4 unreadable input.
+
+## Tests
+
+```
+ruby -Ilib -Itest -e 'Dir.glob("test/**/*_test.rb").sort.each { |f| require File.expand_path(f) }'
+```
