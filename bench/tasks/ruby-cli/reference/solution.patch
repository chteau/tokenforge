+# frozen_string_literal: true
+
+require "minitest/autorun"
+require "stringio"
+require "logtally"
+
+module CLIHelper
+  Result = Struct.new(:code, :out, :err)
+
+  def run_cli(*args, stdin: "")
+    out = StringIO.new
+    err = StringIO.new
+    code = Logtally::CLI.new(out, err, StringIO.new(stdin.b)).run(args)
+    Result.new(code, out.string, err.string)
+  end
+
+  def log_line(path: "/", status: 200, time: "10/Oct/2026:12:00:00 +0000", bytes: "100", rt: " 0.010")
+    %(10.0.0.1 - - [#{time}] "GET #{path} HTTP/1.1" #{status} #{bytes} "-" "test-agent"#{rt}\n)
+  end
+end
