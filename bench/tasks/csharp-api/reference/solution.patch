+using LibraryApi.Domain;
+using LibraryApi.Storage;
+
+namespace LibraryApi.Endpoints;
+
+public static class LoanEndpoints
+{
+    public static void MapLoans(this WebApplication app)
+    {
+        app.MapGet("/loans", (HttpRequest req, LibraryStore store) =>
+        {
+            var q = new Http.Query(req.Query);
+            var memberId = q.Int("memberId", 1, int.MaxValue, null);
+            var bookId = q.Int("bookId", 1, int.MaxValue, null);
+            var status = q.OneOf("status", null, "active", "overdue", "returned");
+            var paging = q.Page();
+            if (q.Errors.Count > 0) return Results.ValidationProblem(q.Errors);
+            var loans = store.ListLoans(memberId, bookId, status);
+            return Results.Ok(PageView<LoanView>.Create(loans, paging.Page, paging.PageSize));
+        });
+
+        app.MapGet("/loans/{id}", (string id, LibraryStore store) =>
+            int.TryParse(id, out var n) && store.GetLoan(n) is { } loan
+                ? Results.Ok(loan)
+                : Http.NotFound($"loan {id} not found"));
+
+        app.MapPost("/loans", async (HttpRequest req, LibraryStore store) =>
+        {
+            if (await Http.ReadBodyAsync<LoanInput>(req) is not { } input) return Http.MalformedBody();
+            var errors = Validation.Loan(input);
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            return Http.From(store.AddLoan(input), l => Results.Created($"/loans/{l.Id}", l));
+        });
+
+        app.MapPost("/loans/{id}/return", (string id, LibraryStore store) =>
+            int.TryParse(id, out var n)
+                ? Http.From(store.ReturnLoan(n), Results.Ok)
+                : Http.NotFound($"loan {id} not found"));
+    }
+}
