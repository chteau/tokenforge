+namespace LibraryApi.Domain;
+
+public static class LoanRules
+{
+    public const int LoanDays = 14;
+    public const int MaxActiveLoans = 3;
+    public const int FinePerDayCents = 25;
+    public const int FineCapCents = 1000;
+
+    public static int DaysOverdue(Loan loan, DateTime now)
+    {
+        var end = loan.ReturnedAt ?? now;
+        return Math.Max(0, (end.Date - loan.DueAt.Date).Days);
+    }
+
+    public static int FineCents(Loan loan, DateTime now) =>
+        Math.Min(FineCapCents, FinePerDayCents * DaysOverdue(loan, now));
+
+    public static string Status(Loan loan, DateTime now) =>
+        loan.ReturnedAt is not null ? "returned" : DaysOverdue(loan, now) > 0 ? "overdue" : "active";
+
+    public static LoanView View(Loan loan, DateTime now) =>
+        new(loan.Id, loan.BookId, loan.MemberId, loan.LoanedAt, loan.DueAt, loan.ReturnedAt,
+            Status(loan, now), DaysOverdue(loan, now), FineCents(loan, now));
+}
