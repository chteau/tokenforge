+namespace LibraryApi.Domain;
+
+public static class Validation
+{
+    public static Dictionary<string, string[]> Book(BookInput input)
+    {
+        var errors = new Dictionary<string, string[]>();
+        if (input.Isbn is null || input.Isbn.Length != 13 || !input.Isbn.All(char.IsAsciiDigit))
+        {
+            errors["isbn"] = ["must be exactly 13 digits"];
+        }
+        RequireText(errors, "title", input.Title, 200);
+        RequireText(errors, "author", input.Author, 100);
+        if (input.Year is < 1450 or > 2100)
+        {
+            errors["year"] = ["must be between 1450 and 2100"];
+        }
+        if (input.Copies is < 1 or > 100)
+        {
+            errors["copies"] = ["must be between 1 and 100"];
+        }
+        return errors;
+    }
+
+    public static Dictionary<string, string[]> Member(MemberInput input)
+    {
+        var errors = new Dictionary<string, string[]>();
+        RequireText(errors, "name", input.Name, 100);
+        if (!IsEmail(input.Email))
+        {
+            errors["email"] = ["must be a valid email address"];
+        }
+        return errors;
+    }
+
+    public static Dictionary<string, string[]> Loan(LoanInput input)
+    {
+        var errors = new Dictionary<string, string[]>();
+        if (input.BookId < 1)
+        {
+            errors["bookId"] = ["must be a positive integer"];
+        }
+        if (input.MemberId < 1)
+        {
+            errors["memberId"] = ["must be a positive integer"];
+        }
+        return errors;
+    }
+
+    private static void RequireText(Dictionary<string, string[]> errors, string field, string? value, int max)
+    {
+        if (string.IsNullOrWhiteSpace(value))
+        {
+            errors[field] = ["is required"];
+        }
+        else if (value.Length > max)
+        {
+            errors[field] = [$"must be at most {max} characters"];
+        }
+    }
+
+    private static bool IsEmail(string? email)
+    {
+        if (string.IsNullOrEmpty(email) || email.Length > 254 || email.Any(char.IsWhiteSpace))
+        {
+            return false;
+        }
+        var parts = email.Split('@');
+        if (parts.Length != 2 || parts[0].Length == 0)
+        {
+            return false;
+        }
+        var domain = parts[1];
+        for (var i = 1; i < domain.Length - 1; i++)
+        {
+            if (domain[i] == '.')
+            {
+                return true;
+            }
+        }
+        return false;
+    }
+}
