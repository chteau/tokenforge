+using LibraryApi;
+using LibraryApi.Domain;
+using LibraryApi.Storage;
+
+namespace LibraryApi.Tests;
+
+public class LoanRulesTests
+{
+    private static readonly DateTime Now = new(2026, 3, 10, 9, 0, 0, DateTimeKind.Utc);
+
+    private static Loan LoanDue(DateTime due, DateTime? returned = null) =>
+        new(1, 1, 1, due.AddDays(-14), due, returned);
+
+    [Fact]
+    public void LoanDueTodayIsNotOverdue()
+    {
+        var loan = LoanDue(Now.AddHours(-2));
+        Assert.Equal(0, LoanRules.DaysOverdue(loan, Now));
+        Assert.Equal("active", LoanRules.Status(loan, Now));
+    }
+
+    [Fact]
+    public void FineIsChargedPerCalendarDayAndCapped()
+    {
+        Assert.Equal(100, LoanRules.FineCents(LoanDue(Now.AddDays(-4)), Now));
+        Assert.Equal(1000, LoanRules.FineCents(LoanDue(Now.AddDays(-90)), Now));
+    }
+
+    [Fact]
+    public void ReturnedLoanFineIsFixedAtReturnTime()
+    {
+        var due = Now.AddDays(-10);
+        var loan = LoanDue(due, due.AddDays(2));
+        Assert.Equal(50, LoanRules.FineCents(loan, Now));
+        Assert.Equal("returned", LoanRules.Status(loan, Now));
+    }
+}
+
+public class LibraryStoreTests
+{
+    private static readonly FixedClock Clock = new(new DateTime(2026, 3, 10, 9, 0, 0, DateTimeKind.Utc));
+
+    private static LibraryStore NewStore() => new(new SeedData
+    {
+        Books = [new Book(1, "9780000000011", "A", "Author", 2000, 1)],
+        Members = [new Member(1, "Ada", "ada@example.org")],
+    }, Clock);
+
+    [Fact]
+    public void LoanUsesClockAndBlocksLastCopy()
+    {
+        var store = NewStore();
+        var first = store.AddLoan(new LoanInput(1, 1));
+        Assert.Equal(Outcome.Ok, first.Outcome);
+        Assert.Equal(Clock.UtcNow.AddDays(14), first.Value!.DueAt);
+        Assert.Equal(Outcome.Conflict, store.AddLoan(new LoanInput(1, 1)).Outcome);
+    }
+
+    [Fact]
+    public void DuplicateIsbnAndEmailConflict()
+    {
+        var store = NewStore();
+        Assert.Equal(Outcome.Conflict, store.AddBook(new BookInput("9780000000011", "B", "C", 2001, 1)).Outcome);
+        Assert.Equal(Outcome.Conflict, store.AddMember(new MemberInput("X", "ADA@example.org")).Outcome);
+    }
+
+    [Theory]
+    [InlineData("a@example.org", true)]
+    [InlineData("a@example", false)]
+    [InlineData("a@b@example.org", false)]
+    [InlineData("a b@example.org", false)]
+    public void EmailValidation(string email, bool valid)
+    {
+        Assert.Equal(valid, Validation.Member(new MemberInput("Name", email)).Count == 0);
+    }
+}
