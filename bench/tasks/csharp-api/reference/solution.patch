+using LibraryApi.Domain;
+using LibraryApi.Storage;
+
+namespace LibraryApi.Endpoints;
+
+public static class BookEndpoints
+{
+    public static void MapBooks(this WebApplication app)
+    {
+        app.MapGet("/books", (HttpRequest req, LibraryStore store) =>
+        {
+            var q = new Http.Query(req.Query);
+            var sort = q.OneOf("sort", "id", "id", "-id", "title", "-title", "year", "-year")!;
+            var available = q.OneOf("available", null, "true", "false");
+            var paging = q.Page();
+            if (q.Errors.Count > 0) return Results.ValidationProblem(q.Errors);
+            var books = store.ListBooks(q.Text("author"), available is null ? null : available == "true",
+                sort.TrimStart('-'), sort.StartsWith('-'));
+            return Results.Ok(PageView<BookView>.Create(books, paging.Page, paging.PageSize));
+        });
+
+        app.MapGet("/books/{id}", (string id, LibraryStore store) =>
+            int.TryParse(id, out var n) && store.GetBook(n) is { } book
+                ? Results.Ok(book)
+                : Http.NotFound($"book {id} not found"));
+
+        app.MapPost("/books", async (HttpRequest req, LibraryStore store) =>
+        {
+            if (await Http.ReadBodyAsync<BookInput>(req) is not { } input) return Http.MalformedBody();
+            var errors = Validation.Book(input);
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            return Http.From(store.AddBook(input), b => Results.Created($"/books/{b.Id}", b));
+        });
+
+        app.MapDelete("/books/{id}", (string id, LibraryStore store) =>
+            int.TryParse(id, out var n)
+                ? Http.From(store.DeleteBook(n), _ => Results.NoContent())
+                : Http.NotFound($"book {id} not found"));
+    }
+}
