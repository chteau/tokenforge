+using LibraryApi.Domain;
+
+namespace LibraryApi.Storage;
+
+/// <summary>In-memory library data. Every operation runs under one lock so rules stay consistent.</summary>
+public sealed class LibraryStore
+{
+    private readonly object _gate = new();
+    private readonly IClock _clock;
+    private readonly SortedDictionary<int, Book> _books = new();
+    private readonly SortedDictionary<int, Member> _members = new();
+    private readonly SortedDictionary<int, Loan> _loans = new();
+    private int _nextBookId;
+    private int _nextMemberId;
+    private int _nextLoanId;
+
+    public LibraryStore(SeedData seed, IClock clock)
+    {
+        _clock = clock;
+        foreach (var b in seed.Books) _books[b.Id] = b;
+        foreach (var m in seed.Members) _members[m.Id] = m;
+        foreach (var l in seed.Loans) _loans[l.Id] = l;
+        _nextBookId = _books.Keys.DefaultIfEmpty(0).Max() + 1;
+        _nextMemberId = _members.Keys.DefaultIfEmpty(0).Max() + 1;
+        _nextLoanId = _loans.Keys.DefaultIfEmpty(0).Max() + 1;
+    }
+
+    public List<BookView> ListBooks(string? author, bool? available, string sort, bool descending)
+    {
+        lock (_gate)
+        {
+            IEnumerable<BookView> q = _books.Values.Select(BookViewOf);
+            if (!string.IsNullOrEmpty(author))
+            {
+                q = q.Where(b => b.Author.Contains(author, StringComparison.OrdinalIgnoreCase));
+            }
+            if (available is bool want)
+            {
+                q = q.Where(b => (b.AvailableCopies > 0) == want);
+            }
+            var list = q.ToList();
+            int Compare(BookView a, BookView b)
+            {
+                var c = sort switch
+                {
+                    "title" => string.CompareOrdinal(a.Title, b.Title),
+                    "year" => a.Year.CompareTo(b.Year),
+                    _ => a.Id.CompareTo(b.Id),
+                };
+                return c != 0 ? (descending ? -c : c) : a.Id.CompareTo(b.Id);
+            }
+            list.Sort(Compare);
+            return list;
+        }
+    }
+
+    public BookView? GetBook(int id)
+    {
+        lock (_gate) return _books.TryGetValue(id, out var b) ? BookViewOf(b) : null;
+    }
+
+    public Result<BookView> AddBook(BookInput input)
+    {
+        lock (_gate)
+        {
+            if (_books.Values.Any(b => b.Isbn == input.Isbn))
+            {
+                return Result<BookView>.Conflict($"a book with isbn {input.Isbn} already exists");
+            }
+            var book = new Book(_nextBookId++, input.Isbn!, input.Title!, input.Author!, input.Year, input.Copies);
+            _books[book.Id] = book;
+            return Result<BookView>.Ok(BookViewOf(book));
+        }
+    }
+
+    public Result<bool> DeleteBook(int id)
+    {
+        lock (_gate)
+        {
+            if (!_books.ContainsKey(id)) return Result<bool>.NotFound($"book {id} not found");
+            if (_loans.Values.Any(l => l.BookId == id && l.ReturnedAt is null))
+            {
+                return Result<bool>.Conflict($"book {id} has unreturned loans");
+            }
+            _books.Remove(id);
+            return Result<bool>.Ok(true);
+        }
+    }
+
+    public MemberView? GetMember(int id)
+    {
+        lock (_gate) return _members.TryGetValue(id, out var m) ? MemberViewOf(m) : null;
+    }
+
+    public Result<MemberView> AddMember(MemberInput input)
+    {
+        lock (_gate)
+        {
+            if (_members.Values.Any(m => string.Equals(m.Email, input.Email, StringComparison.OrdinalIgnoreCase)))
+            {
+                return Result<MemberView>.Conflict($"a member with email {input.Email} already exists");
+            }
+            var member = new Member(_nextMemberId++, input.Name!, input.Email!);
+            _members[member.Id] = member;
+            return Result<MemberView>.Ok(MemberViewOf(member));
+        }
+    }
+
+    public List<LoanView> ListLoans(int? memberId, int? bookId, string? status)
+    {
+        lock (_gate)
+        {
+            var now = _clock.UtcNow;
+            return _loans.Values
+                .Where(l => memberId is null || l.MemberId == memberId)
+                .Where(l => bookId is null || l.BookId == bookId)
+                .Select(l => LoanRules.View(l, now))
+                .Where(v => status is null || v.Status == status)
+                .ToList();
+        }
+    }
+
+    public LoanView? GetLoan(int id)
+    {
+        lock (_gate) return _loans.TryGetValue(id, out var l) ? LoanRules.View(l, _clock.UtcNow) : null;
+    }
+
+    public Result<LoanView> AddLoan(LoanInput input)
+    {
+        lock (_gate)
+        {
+            var now = _clock.UtcNow;
+            if (!_members.ContainsKey(input.MemberId)) return Result<LoanView>.NotFound($"member {input.MemberId} not found");
+            if (!_books.TryGetValue(input.BookId, out var book)) return Result<LoanView>.NotFound($"book {input.BookId} not found");
+            var open = _loans.Values.Where(l => l.MemberId == input.MemberId && l.ReturnedAt is null).ToList();
+            if (open.Any(l => LoanRules.DaysOverdue(l, now) > 0))
+            {
+                return Result<LoanView>.Conflict($"member {input.MemberId} has overdue loans");
+            }
+            if (open.Count >= LoanRules.MaxActiveLoans)
+            {
+                return Result<LoanView>.Conflict($"member {input.MemberId} already has {LoanRules.MaxActiveLoans} unreturned loans");
+            }
+            if (Available(book) <= 0)
+            {
+                return Result<LoanView>.Conflict($"book {book.Id} has no available copy");
+            }
+            var loan = new Loan(_nextLoanId++, book.Id, input.MemberId, now, now.AddDays(LoanRules.LoanDays), null);
+            _loans[loan.Id] = loan;
+            return Result<LoanView>.Ok(LoanRules.View(loan, now));
+        }
+    }
+
+    public Result<LoanView> ReturnLoan(int id)
+    {
+        lock (_gate)
+        {
+            var now = _clock.UtcNow;
+            if (!_loans.TryGetValue(id, out var loan)) return Result<LoanView>.NotFound($"loan {id} not found");
+            if (loan.ReturnedAt is not null) return Result<LoanView>.Conflict($"loan {id} was already returned");
+            loan = loan with { ReturnedAt = now };
+            _loans[id] = loan;
+            return Result<LoanView>.Ok(LoanRules.View(loan, now));
+        }
+    }
+
+    private int Available(Book book) =>
+        book.Copies - _loans.Values.Count(l => l.BookId == book.Id && l.ReturnedAt is null);
+
+    private BookView BookViewOf(Book b) => new(b.Id, b.Isbn, b.Title, b.Author, b.Year, b.Copies, Available(b));
+
+    private MemberView MemberViewOf(Member m)
+    {
+        var now = _clock.UtcNow;
+        var loans = _loans.Values.Where(l => l.MemberId == m.Id).ToList();
+        return new MemberView(m.Id, m.Name, m.Email, loans.Count(l => l.ReturnedAt is null),
+            loans.Sum(l => LoanRules.FineCents(l, now)));
+    }
+}
