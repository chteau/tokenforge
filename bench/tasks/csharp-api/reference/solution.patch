+namespace LibraryApi.Domain;
+
+public sealed record Book(int Id, string Isbn, string Title, string Author, int Year, int Copies);
+
+public sealed record Member(int Id, string Name, string Email);
+
+public sealed record Loan(int Id, int BookId, int MemberId, DateTime LoanedAt, DateTime DueAt, DateTime? ReturnedAt);
+
+public sealed class SeedData
+{
+    public List<Book> Books { get; set; } = [];
+    public List<Member> Members { get; set; } = [];
+    public List<Loan> Loans { get; set; } = [];
+}
+
+public sealed record BookInput(string? Isbn, string? Title, string? Author, int Year, int Copies);
+
+public sealed record MemberInput(string? Name, string? Email);
+
+public sealed record LoanInput(int BookId, int MemberId);
+
+public sealed record BookView(int Id, string Isbn, string Title, string Author, int Year, int Copies, int AvailableCopies);
+
+public sealed record MemberView(int Id, string Name, string Email, int ActiveLoans, int TotalFinesCents);
+
+public sealed record LoanView(int Id, int BookId, int MemberId, DateTime LoanedAt, DateTime DueAt, DateTime? ReturnedAt,
+    string Status, int DaysOverdue, int FineCents);
+
+public sealed record PageView<T>(IReadOnlyList<T> Items, int Page, int PageSize, int TotalItems, int TotalPages)
+{
+    public static PageView<T> Create(IReadOnlyList<T> all, int page, int pageSize)
+    {
+        var items = all.Skip((page - 1) * pageSize).Take(pageSize).ToList();
+        var totalPages = (all.Count + pageSize - 1) / pageSize;
+        return new PageView<T>(items, page, pageSize, all.Count, totalPages);
+    }
+}
+
+public enum Outcome { Ok, NotFound, Conflict }
+
+public readonly record struct Result<T>(Outcome Outcome, T? Value, string? Detail)
+{
+    public static Result<T> Ok(T value) => new(Outcome.Ok, value, null);
+    public static Result<T> NotFound(string detail) => new(Outcome.NotFound, default, detail);
+    public static Result<T> Conflict(string detail) => new(Outcome.Conflict, default, detail);
+}
