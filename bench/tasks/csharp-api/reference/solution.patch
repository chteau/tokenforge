--- /dev/null
+++ b/src/LibraryApi/Program.cs
@@ -0,0 +1,68 @@
+using System.Text.Json;
+using LibraryApi;
+using LibraryApi.Domain;
+using LibraryApi.Endpoints;
+using LibraryApi.Storage;
+
+var builder = WebApplication.CreateBuilder(args);
+var config = builder.Configuration;
+
+static string? Setting(IConfiguration config, string arg, string env)
+{
+    var value = config[arg];
+    if (string.IsNullOrEmpty(value)) value = config[env];
+    return string.IsNullOrEmpty(value) ? null : value;
+}
+
+IClock clock = new SystemClock();
+if (Setting(config, "now", "LIBRARY_NOW") is { } nowText)
+{
+    if (!FixedClock.TryParse(nowText, out var fixedClock))
+    {
+        Console.Error.WriteLine($"invalid --now value: {nowText}");
+        return 1;
+    }
+    clock = fixedClock!;
+}
+
+var seedPath = Setting(config, "seed", "LIBRARY_SEED") ?? Path.Combine("data", "seed.json");
+SeedData seed;
+try
+{
+    seed = JsonSerializer.Deserialize<SeedData>(File.ReadAllText(seedPath), new JsonSerializerOptions(JsonSerializerDefaults.Web))
+        ?? throw new JsonException("seed file is empty");
+}
+catch (Exception ex) when (ex is IOException or JsonException or UnauthorizedAccessException)
+{
+    Console.Error.WriteLine($"cannot load seed file {seedPath}: {ex.Message}");
+    return 1;
+}
+
+var apiKey = Setting(config, "LIBRARY_API_KEY", "LIBRARY_API_KEY") ?? "dev-key";
+
+builder.Services.AddSingleton(clock);
+builder.Services.AddSingleton(new LibraryStore(seed, clock));
+builder.Services.AddProblemDetails();
+
+var app = builder.Build();
+
+// Write routes (POST/DELETE) need the API key; checked before routing, binding or lookups.
+app.Use(async (ctx, next) =>
+{
+    if ((HttpMethods.IsPost(ctx.Request.Method) || HttpMethods.IsDelete(ctx.Request.Method))
+        && ctx.Request.Headers["X-Api-Key"].ToString() != apiKey)
+    {
+        await Results.Problem(statusCode: StatusCodes.Status401Unauthorized, detail: "missing or invalid API key")
+            .ExecuteAsync(ctx);
+        return;
+    }
+    await next(ctx);
+});
+
+app.MapGet("/health", (IClock c) => Results.Ok(new { status = "ok", now = c.UtcNow }));
+app.MapBooks();
+app.MapMembers();
+app.MapLoans();
+
+app.Run();
+return 0;
