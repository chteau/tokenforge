@@ -0,0 +1,73 @@
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using LibraryApi.Domain;
+
+namespace LibraryApi.Endpoints;
+
+/// <summary>Shared HTTP plumbing: body reading, query parsing and problem responses.</summary>
+public static class Http
+{
+    private static readonly JsonSerializerOptions ReadOptions = new(JsonSerializerDefaults.Web)
+    {
+        NumberHandling = JsonNumberHandling.Strict,
+    };
+
+    public static async Task<T?> ReadBodyAsync<T>(HttpRequest request) where T : class
+    {
+        try
+        {
+            return await JsonSerializer.DeserializeAsync<T>(request.Body, ReadOptions, request.HttpContext.RequestAborted);
+        }
+        catch (JsonException)
+        {
+            return null;
+        }
+    }
+
+    public static IResult MalformedBody() =>
+        Results.Problem(statusCode: StatusCodes.Status400BadRequest, detail: "request body must be a valid JSON object");
+
+    public static IResult NotFound(string detail) =>
+        Results.Problem(statusCode: StatusCodes.Status404NotFound, detail: detail);
+
+    public static IResult From<T>(Result<T> result, Func<T, IResult> ok) => result.Outcome switch
+    {
+        Outcome.Ok => ok(result.Value!),
+        Outcome.NotFound => NotFound(result.Detail!),
+        _ => Results.Problem(statusCode: StatusCodes.Status409Conflict, detail: result.Detail),
+    };
+
+    /// <summary>Collects query-parameter errors; empty values count as absent.</summary>
+    public sealed class Query(IQueryCollection query)
+    {
+        public Dictionary<string, string[]> Errors { get; } = new();
+
+        public string? Text(string name)
+        {
+            var v = query[name].ToString();
+            return v.Length == 0 ? null : v;
+        }
+
+        public int? Int(string name, int min, int max, int? fallback)
+        {
+            var v = Text(name);
+            if (v is null) return fallback;
+            if (int.TryParse(v, out var n) && n >= min && n <= max) return n;
+            Errors[name] = [max == int.MaxValue ? $"must be an integer >= {min}" : $"must be between {min} and {max}"];
+            return fallback;
+        }
+
+        public string? OneOf(string name, string? fallback, params string[] allowed)
+        {
+            var v = Text(name);
+            if (v is null) return fallback;
+            if (allowed.Contains(v)) return v;
+            Errors[name] = [$"must be one of {string.Join(", ", allowed)}"];
+            return fallback;
+        }
+
+        public PageArgs Page() => new(Int("page", 1, int.MaxValue, 1)!.Value, Int("pageSize", 1, 50, 10)!.Value);
+    }
+
+    public readonly record struct PageArgs(int Page, int PageSize);
+}
