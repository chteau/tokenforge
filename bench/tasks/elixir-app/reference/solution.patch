+defmodule Jobq.CLI.ParserTest do
+  use ExUnit.Case, async: true
+
+  import Jobq.CLI.Parser, only: [parse: 1]
+
+  test "help" do
+    assert parse(["--help"]) == :help
+    assert parse(["-h"]) == :help
+  end
+
+  test "commands with options in any position" do
+    assert parse(["add", "--priority", "3", "mail", "--payload", "--x"]) ==
+             {:add, "mail", %{priority: 3, payload: "--x"}}
+
+    assert parse(["take"]) == {:take, nil, %{}}
+    assert parse(["fail", "4", "--error", "oops"]) == {:fail, 4, %{error: "oops"}}
+    assert parse(["list", "--state", "dead"]) == {:list, nil, %{state: :dead}}
+  end
+
+  test "usage errors" do
+    for args <- [
+          [],
+          ["nope"],
+          ["add"],
+          ["add", "bad name"],
+          ["add", "a", "b"],
+          ["add", "a", "--priority", "10"],
+          ["add", "a", "--delay", "1", "--at", "2"],
+          ["add", "a", "--priority", "1", "--priority", "2"],
+          ["add", "a", "--payload"],
+          ["ack", "0"],
+          ["ack", "x"],
+          ["take", "--lease", "0"],
+          ["stats", "--lease", "5"],
+          ["list", "--state", "queued"],
+          ["fail", "1", "--error", "a\nb"]
+        ] do
+      assert {:error, _} = parse(args), inspect(args)
+    end
+  end
+end
diff --git a/test/jobq/store_test.exs b/test/jobq/store_test.exs
new file mode 100644
index 0000000..9a473c0
--- /dev/null
+++ b/test/jobq/store_test.exs
@@ -0,0 +1,31 @@
+defmodule Jobq.StoreTest do
+  use ExUnit.Case, async: true
+
+  alias Jobq.{Core, Store}
+
+  @moduletag :tmp_dir
+
+  test "missing file is an empty queue", %{tmp_dir: dir} do
+    assert Store.load(Path.join(dir, "none")) == {:ok, Core.new()}
+  end
+
+  test "round trip leaves no temporary file", %{tmp_dir: dir} do
+    path = Path.join(dir, "state")
+    {:ok, _, q} = Core.add(Core.new(), "a", %{payload: "x"}, 5)
+    assert Store.save(path, q) == :ok
+    assert Store.load(path) == {:ok, q}
+    assert File.ls!(dir) == ["state"]
+  end
+
+  test "corrupt file is an error", %{tmp_dir: dir} do
+    path = Path.join(dir, "state")
+    File.write!(path, "garbage")
+    assert Store.load(path) == {:error, :load}
+    File.write!(path, :erlang.term_to_binary(:other))
+    assert Store.load(path) == {:error, :load}
+  end
+
+  test "unwritable location is an error", %{tmp_dir: dir} do
+    assert Store.save(Path.join([dir, "missing", "state"]), Core.new()) == {:error, :save}
+  end
+end
