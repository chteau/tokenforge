--- /dev/null
+++ b/test/jobq/cli_test.exs
@@ -0,0 +1,50 @@
+defmodule Jobq.CLITest do
+  use ExUnit.Case, async: true
+
+  alias Jobq.CLI
+
+  @moduletag :tmp_dir
+
+  setup %{tmp_dir: dir} do
+    server = start_supervised!({Jobq.Queue, name: nil})
+    {:ok, server: server, path: Path.join(dir, "state")}
+  end
+
+  defp jobq(ctx, args, now) do
+    {code, out, err} =
+      CLI.run(args, %{"JOBQ_STATE" => ctx.path, "JOBQ_NOW" => "#{now}"}, ctx.server)
+
+    {code, IO.iodata_to_binary(out), IO.iodata_to_binary(err)}
+  end
+
+  test "add, take, ack across invocations", ctx do
+    assert jobq(ctx, ["add", "mail", "--payload", "hi"], 10) == {0, "1\n", ""}
+    assert jobq(ctx, ["take"], 10) == {0, "1\tmail\thi\n", ""}
+    assert jobq(ctx, ["ack", "1"], 20) == {0, "done 1\n", ""}
+    assert jobq(ctx, ["list"], 20) == {0, "1\tdone\t0\t1/3\t10\tmail\n", ""}
+  end
+
+  test "error codes", ctx do
+    assert jobq(ctx, ["take"], 10) == {4, "", "error: no job ready\n"}
+    assert jobq(ctx, ["show", "9"], 10) == {1, "", "error: job not found: 9\n"}
+    assert {2, "", "error: " <> _} = jobq(ctx, ["bogus"], 10)
+    jobq(ctx, ["add", "a"], 10)
+    assert jobq(ctx, ["ack", "1"], 10) == {5, "", "error: job 1 is ready\n"}
+  end
+
+  test "read-only commands do not create the state file", ctx do
+    assert {0, _, ""} = jobq(ctx, ["stats"], 10)
+    refute File.exists?(ctx.path)
+  end
+
+  test "corrupt state file", ctx do
+    File.write!(ctx.path, "junk")
+    assert jobq(ctx, ["stats"], 10) == {3, "", "error: cannot load state: #{ctx.path}\n"}
+    assert File.read!(ctx.path) == "junk"
+  end
+
+  test "invalid JOBQ_NOW", ctx do
+    assert {2, "", "error: invalid JOBQ_NOW\n"} =
+             CLI.run(["stats"], %{"JOBQ_STATE" => ctx.path, "JOBQ_NOW" => "soon"}, ctx.server)
+  end
+end
diff --git a/test/jobq/core_test.exs b/test/jobq/core_test.exs
new file mode 100644
index 0000000..f5cf281
--- /dev/null
+++ b/test/jobq/core_test.exs
@@ -0,0 +1,80 @@
+defmodule Jobq.CoreTest do
+  use ExUnit.Case, async: true
+
+  alias Jobq.Core
+
+  defp add(q, name, attrs \\ %{}, now \\ 100) do
+    {:ok, _job, q} = Core.add(q, name, attrs, now)
+    q
+  end
+
+  test "ids are sequential and never reused" do
+    q = Core.new() |> add("a") |> add("b")
+    {:ok, _, q} = Core.cancel(q, 2, 100)
+    {:ok, job, _} = Core.add(q, "c", %{}, 100)
+    assert job.id == 3
+  end
+
+  test "take orders by priority, then run_at, then id" do
+    q =
+      Core.new()
+      |> add("low")
+      |> add("late", %{priority: 5, at: 90})
+      |> add("early", %{priority: 5, at: 50})
+      |> add("future", %{priority: 9, delay: 10})
+
+    {:ok, first, q} = Core.take(q, 60, 100)
+    {:ok, second, q} = Core.take(q, 60, 100)
+    {:ok, third, q} = Core.take(q, 60, 100)
+    assert {first.name, second.name, third.name} == {"early", "late", "low"}
+    assert first.status == :running and first.attempts == 1 and first.lease_until == 160
+    assert Core.take(q, 60, 100) == {:error, :no_job_ready}
+  end
+
+  test "failures back off exponentially and end in the dead state" do
+    q = add(Core.new(), "job", %{max_attempts: 3, backoff: 10})
+    {:ok, _, q} = Core.take(q, 60, 100)
+    {:ok, job, q} = Core.fail(q, 1, "boom", 105)
+    assert job.status == :queued and job.run_at == 115 and job.last_error == "boom"
+    {:ok, _, q} = Core.take(q, 60, 115)
+    {:ok, job, q} = Core.fail(q, 1, "boom", 120)
+    assert job.run_at == 140
+    {:ok, _, q} = Core.take(q, 60, 140)
+    {:ok, job, q} = Core.fail(q, 1, "boom", 141)
+    assert job.status == :dead and job.run_at == 140
+    {:ok, job, _} = Core.retry(q, 1, 500)
+    assert job.status == :queued and job.attempts == 0 and job.run_at == 500
+  end
+
+  test "retry delay is capped at an hour" do
+    assert Core.retry_delay(10, 1) == 10
+    assert Core.retry_delay(10, 4) == 80
+    assert Core.retry_delay(1000, 3) == 3600
+  end
+
+  test "expired leases fail at the lease end" do
+    q = add(Core.new(), "job")
+    {:ok, _, q} = Core.take(q, 30, 100)
+    assert Core.expire_leases(q, 129) == q
+    q = Core.expire_leases(q, 500)
+    {:ok, job} = Core.get(q, 1)
+    assert job.status == :queued and job.run_at == 140 and job.last_error == "lease expired"
+  end
+
+  test "wrong state and unknown ids" do
+    q = add(Core.new(), "job")
+    assert Core.ack(q, 1, 100) == {:error, {:wrong_state, 1, :ready}}
+    assert Core.ack(q, 7, 100) == {:error, {:not_found, 7}}
+  end
+
+  test "stats and purge" do
+    q = Core.new() |> add("a", %{at: 40}) |> add("b", %{delay: 50}) |> add("c")
+    {:ok, _, q} = Core.take(q, 60, 100)
+    {:ok, _, q} = Core.ack(q, 1, 100)
+    stats = Core.stats(q, 100)
+    assert %{ready: 1, scheduled: 1, done: 1, total: 3, next_run_at: 150} = stats
+    assert stats.oldest_ready_age == 0
+    assert {:ok, 1, q} = Core.purge(q)
+    assert Enum.map(Core.list(q, nil, 100), & &1.id) == [2, 3]
+  end
+end
