+++ b/lib/jobq/queue.ex
@@ -0,0 +1,83 @@
+defmodule Jobq.Queue do
+  @moduledoc """
+  GenServer holding the in-memory queue. It is loaded from a state file,
+  updated through the client API and saved back when something changed.
+  """
+  use GenServer
+
+  alias Jobq.{Core, Store}
+
+  @type server :: GenServer.server()
+
+  def start_link(opts \\ []) do
+    GenServer.start_link(__MODULE__, :ok, name: Keyword.get(opts, :name, __MODULE__))
+  end
+
+  @doc "Replaces the in-memory queue with the contents of `path`."
+  @spec load(server(), Path.t()) :: :ok | {:error, :load}
+  def load(server \\ __MODULE__, path), do: GenServer.call(server, {:load, path})
+
+  @doc "Saves the queue if it changed since it was loaded or last saved."
+  @spec save(server()) :: :ok | {:error, :save}
+  def save(server \\ __MODULE__), do: GenServer.call(server, :save)
+
+  def expire_leases(server \\ __MODULE__, now), do: update(server, {:expire_leases, now})
+  def add(server \\ __MODULE__, name, attrs, now), do: update(server, {:add, name, attrs, now})
+  def take(server \\ __MODULE__, lease, now), do: update(server, {:take, lease, now})
+  def ack(server \\ __MODULE__, id, now), do: update(server, {:ack, id, now})
+  def fail(server \\ __MODULE__, id, error, now), do: update(server, {:fail, id, error, now})
+  def retry(server \\ __MODULE__, id, now), do: update(server, {:retry, id, now})
+  def cancel(server \\ __MODULE__, id, now), do: update(server, {:cancel, id, now})
+  def purge(server \\ __MODULE__), do: update(server, :purge)
+
+  def get(server \\ __MODULE__, id), do: GenServer.call(server, {:read, &Core.get(&1, id)})
+
+  def list(server \\ __MODULE__, state, now),
+    do: GenServer.call(server, {:read, &Core.list(&1, state, now)})
+
+  def stats(server \\ __MODULE__, now),
+    do: GenServer.call(server, {:read, &Core.stats(&1, now)})
+
+  defp update(server, op), do: GenServer.call(server, {:update, op})
+
+  # Server callbacks
+
+  @impl true
+  def init(:ok), do: {:ok, %{queue: Core.new(), saved: Core.new(), path: nil}}
+
+  @impl true
+  def handle_call({:load, path}, _from, state) do
+    case Store.load(path) do
+      {:ok, queue} -> {:reply, :ok, %{state | queue: queue, saved: queue, path: path}}
+      {:error, _} = error -> {:reply, error, state}
+    end
+  end
+
+  def handle_call(:save, _from, %{queue: queue, saved: queue} = state),
+    do: {:reply, :ok, state}
+
+  def handle_call(:save, _from, state) do
+    case Store.save(state.path, state.queue) do
+      :ok -> {:reply, :ok, %{state | saved: state.queue}}
+      error -> {:reply, error, state}
+    end
+  end
+
+  def handle_call({:read, fun}, _from, state), do: {:reply, fun.(state.queue), state}
+
+  def handle_call({:update, op}, _from, state) do
+    case apply_op(state.queue, op) do
+      {:ok, result, queue} -> {:reply, {:ok, result}, %{state | queue: queue}}
+      {:error, _} = error -> {:reply, error, state}
+    end
+  end
+
+  defp apply_op(q, {:expire_leases, now}), do: {:ok, :ok, Core.expire_leases(q, now)}
+  defp apply_op(q, {:add, name, attrs, now}), do: Core.add(q, name, attrs, now)
+  defp apply_op(q, {:take, lease, now}), do: Core.take(q, lease, now)
+  defp apply_op(q, {:ack, id, now}), do: Core.ack(q, id, now)
+  defp apply_op(q, {:fail, id, error, now}), do: Core.fail(q, id, error, now)
+  defp apply_op(q, {:retry, id, now}), do: Core.retry(q, id, now)
+  defp apply_op(q, {:cancel, id, now}), do: Core.cancel(q, id, now)
+  defp apply_op(q, :purge), do: Core.purge(q)
+end
diff --git a/lib/jobq/store.ex b/lib/jobq/store.ex
new file mode 100644
index 0000000..7924196
--- /dev/null
+++ b/lib/jobq/store.ex
@@ -0,0 +1,46 @@
+defmodule Jobq.Store do
+  @moduledoc "Reads and atomically writes the queue state file."
+
+  alias Jobq.Core
+
+  @format {:jobq_state, 1}
+
+  @doc "Loads the queue from `path`; a missing file is an empty queue."
+  @spec load(Path.t()) :: {:ok, Core.t()} | {:error, :load}
+  def load(path) do
+    case File.read(path) do
+      {:ok, binary} -> decode(binary)
+      {:error, :enoent} -> {:ok, Core.new()}
+      {:error, _} -> {:error, :load}
+    end
+  end
+
+  @doc "Writes the queue to a temporary file next to `path`, then renames it over `path`."
+  @spec save(Path.t(), Core.t()) :: :ok | {:error, :save}
+  def save(path, %Core{} = queue) do
+    tmp = path <> ".tmp"
+    binary = :erlang.term_to_binary({@format, queue})
+
+    with :ok <- File.write(tmp, binary, [:binary]),
+         :ok <- File.rename(tmp, path) do
+      :ok
+    else
+      _ ->
+        File.rm(tmp)
+        {:error, :save}
+    end
+  end
+
+  defp decode(binary) do
+    case :erlang.binary_to_term(binary, [:safe]) do
+      {@format, %Core{jobs: jobs, next_id: next_id} = queue}
+      when is_map(jobs) and is_integer(next_id) ->
+        {:ok, queue}
+
+      _ ->
+        {:error, :load}
+    end
+  rescue
+    ArgumentError -> {:error, :load}
+  end
+end
