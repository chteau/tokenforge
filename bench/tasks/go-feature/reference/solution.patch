+++ b/internal/notifications/scheduled_test.go
@@ -0,0 +1,51 @@
+package notifications
+
+import (
+	"testing"
+	"time"
+	_ "time/tzdata"
+)
+
+func TestPreferencesQuiet(t *testing.T) {
+	night := &QuietHours{Start: "22:00", End: "07:00"}
+	lunch := &QuietHours{Start: "12:00", End: "13:30"}
+	tests := []struct {
+		name  string
+		prefs Preferences
+		at    string
+		want  bool
+	}{
+		{"no quiet hours", Preferences{Timezone: "UTC"}, "2026-07-01T23:00:00Z", false},
+		{"wrap: late evening", Preferences{Timezone: "UTC", QuietHours: night}, "2026-07-01T22:00:00Z", true},
+		{"wrap: early morning", Preferences{Timezone: "UTC", QuietHours: night}, "2026-07-01T06:59:00Z", true},
+		{"wrap: end is exclusive", Preferences{Timezone: "UTC", QuietHours: night}, "2026-07-01T07:00:00Z", false},
+		{"daytime window", Preferences{Timezone: "UTC", QuietHours: lunch}, "2026-07-01T13:29:00Z", true},
+		{"daytime window outside", Preferences{Timezone: "UTC", QuietHours: lunch}, "2026-07-01T21:00:00Z", false},
+		{"time zone applied", Preferences{Timezone: "America/New_York", QuietHours: night}, "2026-07-01T03:00:00Z", true},
+		{"time zone applied outside", Preferences{Timezone: "America/New_York", QuietHours: night}, "2026-07-01T12:00:00Z", false},
+		{"winter offset", Preferences{Timezone: "Europe/Berlin", QuietHours: night}, "2026-01-15T21:30:00Z", true},
+		{"summer offset", Preferences{Timezone: "Europe/Berlin", QuietHours: night}, "2026-07-15T05:30:00Z", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			at, _ := time.Parse(time.RFC3339, tt.at)
+			if got := tt.prefs.Quiet(at); got != tt.want {
+				t.Fatalf("Quiet(%s) = %v, want %v", tt.at, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestParseClockAndBackoff(t *testing.T) {
+	for _, bad := range []string{"", "7:00", "24:00", "12:60", "ab:cd", "12:00:00"} {
+		if _, err := ParseClock(bad); err == nil {
+			t.Errorf("ParseClock(%q) accepted", bad)
+		}
+	}
+	if m, err := ParseClock("23:59"); err != nil || m != 23*60+59 {
+		t.Fatalf("ParseClock(23:59) = %d, %v", m, err)
+	}
+	if RetryBackoff(1) != time.Minute || RetryBackoff(2) != 2*time.Minute {
+		t.Fatalf("backoff = %v, %v", RetryBackoff(1), RetryBackoff(2))
+	}
+}
diff --git a/internal/repositories/memory_notifications.go b/internal/repositories/memory_notifications.go
new file mode 100644
index 0000000..944766e
--- /dev/null
+++ b/internal/repositories/memory_notifications.go
@@ -0,0 +1,144 @@
+package repositories
+
+import (
+	"context"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/acme/meridian/internal/notifications"
+)
+
+// MemoryScheduledNotifications is an in-memory ScheduledNotificationRepository.
+type MemoryScheduledNotifications struct {
+	mu    sync.RWMutex
+	byID  map[string]notifications.Scheduled
+	byKey map[string]string // userID + "\x00" + key -> id
+}
+
+// NewMemoryScheduledNotifications returns an empty repository.
+func NewMemoryScheduledNotifications() *MemoryScheduledNotifications {
+	return &MemoryScheduledNotifications{byID: map[string]notifications.Scheduled{}, byKey: map[string]string{}}
+}
+
+func cloneScheduled(n notifications.Scheduled) notifications.Scheduled {
+	if n.SentAt != nil {
+		t := *n.SentAt
+		n.SentAt = &t
+	}
+	return n
+}
+
+func (m *MemoryScheduledNotifications) Create(_ context.Context, n notifications.Scheduled) (notifications.Scheduled, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if _, ok := m.byID[n.ID]; ok {
+		return notifications.Scheduled{}, ErrDuplicate
+	}
+	if n.IdempotencyKey != "" {
+		k := n.UserID + "\x00" + n.IdempotencyKey
+		if id, ok := m.byKey[k]; ok {
+			return cloneScheduled(m.byID[id]), ErrDuplicate
+		}
+		m.byKey[k] = n.ID
+	}
+	m.byID[n.ID] = cloneScheduled(n)
+	return cloneScheduled(n), nil
+}
+
+func (m *MemoryScheduledNotifications) Get(_ context.Context, id string) (notifications.Scheduled, error) {
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	n, ok := m.byID[id]
+	if !ok {
+		return notifications.Scheduled{}, ErrNotFound
+	}
+	return cloneScheduled(n), nil
+}
+
+func (m *MemoryScheduledNotifications) GetByIdempotencyKey(_ context.Context, userID, key string) (notifications.Scheduled, error) {
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	id, ok := m.byKey[userID+"\x00"+key]
+	if !ok {
+		return notifications.Scheduled{}, ErrNotFound
+	}
+	return cloneScheduled(m.byID[id]), nil
+}
+
+func (m *MemoryScheduledNotifications) Update(_ context.Context, id string, fn func(*notifications.Scheduled) error) (notifications.Scheduled, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	cur, ok := m.byID[id]
+	if !ok {
+		return notifications.Scheduled{}, ErrNotFound
+	}
+	n := cloneScheduled(cur)
+	if err := fn(&n); err != nil {
+		return notifications.Scheduled{}, err
+	}
+	n.ID, n.UserID, n.IdempotencyKey = cur.ID, cur.UserID, cur.IdempotencyKey
+	m.byID[id] = cloneScheduled(n)
+	return n, nil
+}
+
+func (m *MemoryScheduledNotifications) list(match func(notifications.Scheduled) bool) []notifications.Scheduled {
+	out := []notifications.Scheduled{}
+	for _, n := range m.byID {
+		if match(n) {
+			out = append(out, cloneScheduled(n))
+		}
+	}
+	slices.SortFunc(out, func(a, b notifications.Scheduled) int {
+		if c := a.SendAt.Compare(b.SendAt); c != 0 {
+			return c
+		}
+		return strings.Compare(a.ID, b.ID)
+	})
+	return out
+}
+
+func (m *MemoryScheduledNotifications) ListDue(_ context.Context, now time.Time) ([]notifications.Scheduled, error) {
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	return m.list(func(n notifications.Scheduled) bool {
+		return n.Status == notifications.StatusPending && !n.NextAttemptAt.After(now)
+	}), nil
+}
+
+// MemoryPreferences is an in-memory PreferenceRepository.
+type MemoryPreferences struct {
+	mu    sync.RWMutex
+	prefs map[string]notifications.Preferences
+}
+
+// NewMemoryPreferences returns an empty repository.
+func NewMemoryPreferences() *MemoryPreferences {
+	return &MemoryPreferences{prefs: map[string]notifications.Preferences{}}
+}
+
+func (m *MemoryPreferences) Get(_ context.Context, userID string) (notifications.Preferences, error) {
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	p, ok := m.prefs[userID]
+	if !ok {
+		return notifications.Preferences{}, ErrNotFound
+	}
+	if p.QuietHours != nil {
+		q := *p.QuietHours
+		p.QuietHours = &q
+	}
+	return p, nil
+}
+
+func (m *MemoryPreferences) Put(_ context.Context, userID string, p notifications.Preferences) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if p.QuietHours != nil {
+		q := *p.QuietHours
+		p.QuietHours = &q
+	}
+	m.prefs[userID] = p
+	return nil
+}
