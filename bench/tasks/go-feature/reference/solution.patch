diff --git a/internal/notifications/scheduled.go b/internal/notifications/scheduled.go
new file mode 100644
index 0000000..04668ae
--- /dev/null
+++ b/internal/notifications/scheduled.go
@@ -0,0 +1,104 @@
+package notifications
+
+import (
+	"fmt"
+	"time"
+)
+
+// Channel is the delivery channel of a scheduled notification.
+type Channel string
+
+const (
+	ChannelEmail Channel = "email"
+	ChannelSMS   Channel = "sms"
+)
+
+// ScheduledStatus is the lifecycle state of a scheduled notification.
+type ScheduledStatus string
+
+const (
+	StatusPending ScheduledStatus = "pending"
+	StatusSent    ScheduledStatus = "sent"
+	StatusFailed  ScheduledStatus = "failed"
+)
+
+// MaxAttempts is the number of delivery attempts before a notification fails.
+const MaxAttempts = 3
+
+// RetryBackoff returns the delay before the next attempt after the given
+// number of failed attempts: 1m, 2m, 4m, ...
+func RetryBackoff(failedAttempts int) time.Duration {
+	return time.Minute << (failedAttempts - 1)
+}
+
+// Scheduled is a message a user asked to be delivered at a later time.
+type Scheduled struct {
+	ID             string          `json:"id"`
+	UserID         string          `json:"user_id"`
+	Channel        Channel         `json:"channel"`
+	Subject        string          `json:"subject,omitempty"`
+	Body           string          `json:"body"`
+	SendAt         time.Time       `json:"send_at"`
+	Status         ScheduledStatus `json:"status"`
+	Attempts       int             `json:"attempts"`
+	NextAttemptAt  time.Time       `json:"next_attempt_at"`
+	SentAt         *time.Time      `json:"sent_at,omitempty"`
+	IdempotencyKey string          `json:"-"`
+	CreatedAt      time.Time       `json:"created_at"`
+}
+
+// SamePayload reports whether two requests describe the same notification.
+func (s Scheduled) SamePayload(o Scheduled) bool {
+	return s.Channel == o.Channel && s.Subject == o.Subject && s.Body == o.Body && s.SendAt.Equal(o.SendAt)
+}
+
+// QuietHours is a daily window, in the user's time zone, during which no
+// scheduled notifications are delivered. Start is inclusive, End exclusive;
+// a window with Start after End wraps around midnight.
+type QuietHours struct {
+	Start string `json:"start"`
+	End   string `json:"end"`
+}
+
+// Preferences are a user's notification settings.
+type Preferences struct {
+	Timezone   string      `json:"timezone"`
+	QuietHours *QuietHours `json:"quiet_hours"`
+}
+
+// DefaultPreferences apply to users who never saved any.
+func DefaultPreferences() Preferences { return Preferences{Timezone: "UTC"} }
+
+// ParseClock parses "HH:MM" into minutes after midnight.
+func ParseClock(s string) (int, error) {
+	if len(s) != 5 || s[2] != ':' {
+		return 0, fmt.Errorf("invalid time of day %q", s)
+	}
+	t, err := time.Parse("15:04", s)
+	if err != nil {
+		return 0, fmt.Errorf("invalid time of day %q", s)
+	}
+	return t.Hour()*60 + t.Minute(), nil
+}
+
+// Quiet reports whether instant t falls within the user's quiet hours.
+func (p Preferences) Quiet(t time.Time) bool {
+	if p.QuietHours == nil {
+		return false
+	}
+	loc, err := time.LoadLocation(p.Timezone)
+	if err != nil {
+		return false
+	}
+	start, err1 := ParseClock(p.QuietHours.Start)
+	end, err2 := ParseClock(p.QuietHours.End)
+	if err1 != nil || err2 != nil || start == end {
+		return false
+	}
+	local := t.In(loc)
+	m := local.Hour()*60 + local.Minute()
+	if start < end {
+		return m >= start && m < end
+	}
+	return m >= start || m < end
+}
diff --git a/internal/notifications/scheduled_test.go b/internal/notifications/scheduled_test.go
