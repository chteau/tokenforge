+// DispatchInterval is how often RunBackground delivers due notifications.
+const DispatchInterval = 30 * time.Second
+
 // RunBackground starts periodic maintenance jobs until ctx is canceled.
 func (a *App) RunBackground(ctx context.Context) {
+	go func() {
+		t := time.NewTicker(DispatchInterval)
+		defer t.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-t.C:
+				if _, err := a.Scheduling.Dispatch(ctx); err != nil {
+					a.Logger.ErrorContext(ctx, "notification dispatch failed", "err", err)
+				}
+			}
+		}
