diff --git a/internal/handlers/notifications.go b/internal/handlers/notifications.go
new file mode 100644
index 0000000..b67fa45
--- /dev/null
+++ b/internal/handlers/notifications.go
@@ -0,0 +1,71 @@
+package handlers
+
+import (
+	"net/http"
+
+	"github.com/acme/meridian/internal/notifications"
+	"github.com/acme/meridian/internal/services"
+	"github.com/acme/meridian/pkg/httpx"
+)
+
+type notificationHandler struct {
+	responder
+	scheduling *services.SchedulingService
+}
+
+func (h *notificationHandler) getPreferences(w http.ResponseWriter, r *http.Request) {
+	prefs, err := h.scheduling.GetPreferences(r.Context(), principal(r))
+	if err != nil {
+		h.fail(w, r, err)
+		return
+	}
+	httpx.WriteJSON(w, http.StatusOK, prefs)
+}
+
+func (h *notificationHandler) putPreferences(w http.ResponseWriter, r *http.Request) {
+	var in notifications.Preferences
+	if !h.decode(w, r, &in) {
+		return
+	}
+	prefs, err := h.scheduling.UpdatePreferences(r.Context(), principal(r), in)
+	if err != nil {
+		h.fail(w, r, err)
+		return
+	}
+	httpx.WriteJSON(w, http.StatusOK, prefs)
+}
+
+func (h *notificationHandler) schedule(w http.ResponseWriter, r *http.Request) {
+	var in services.ScheduleInput
+	if !h.decode(w, r, &in) {
+		return
+	}
+	n, created, err := h.scheduling.Schedule(r.Context(), principal(r), r.Header.Get("Idempotency-Key"), in)
+	if err != nil {
+		h.fail(w, r, err)
+		return
+	}
+	status := http.StatusOK
+	if created {
+		status = http.StatusCreated
+	}
+	httpx.WriteJSON(w, status, n)
+}
+
+func (h *notificationHandler) get(w http.ResponseWriter, r *http.Request) {
+	n, err := h.scheduling.Get(r.Context(), principal(r), r.PathValue("id"))
+	if err != nil {
+		h.fail(w, r, err)
+		return
+	}
+	httpx.WriteJSON(w, http.StatusOK, n)
+}
+
+func (h *notificationHandler) dispatch(w http.ResponseWriter, r *http.Request) {
+	res, err := h.scheduling.RunDispatch(r.Context(), principal(r))
+	if err != nil {
+		h.fail(w, r, err)
+		return
+	}
+	httpx.WriteJSON(w, http.StatusOK, res)
+}
