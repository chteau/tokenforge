diff --git a/internal/services/scheduling.go b/internal/services/scheduling.go
new file mode 100644
index 0000000..9b6fa68
--- /dev/null
+++ b/internal/services/scheduling.go
@@ -0,0 +1,266 @@
+package services
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/acme/meridian/internal/apperr"
+	"github.com/acme/meridian/internal/auth"
+	"github.com/acme/meridian/internal/clock"
+	"github.com/acme/meridian/internal/notifications"
+	"github.com/acme/meridian/internal/repositories"
+	"github.com/acme/meridian/internal/validation"
+	"github.com/acme/meridian/pkg/ids"
+)
+
+var errNotificationNotFound = apperr.NotFound("notification_not_found", "notification not found")
+
+// MaxScheduleAhead bounds how far in the future a notification can be scheduled.
+const MaxScheduleAhead = 30 * 24 * time.Hour
+
+// SchedulingService manages notification preferences, scheduled
+// notifications and their delivery.
+type SchedulingService struct {
+	repo   repositories.ScheduledNotificationRepository
+	prefs  repositories.PreferenceRepository
+	users  repositories.UserRepository
+	email  notifications.EmailSender
+	sms    notifications.SMSSender
+	clock  clock.Clock
+	logger *slog.Logger
+
+	dispatchMu sync.Mutex // serialises dispatch passes so nothing is delivered twice
+}
+
+// NewSchedulingService returns a SchedulingService.
+func NewSchedulingService(repo repositories.ScheduledNotificationRepository, prefs repositories.PreferenceRepository, usersRepo repositories.UserRepository, email notifications.EmailSender, sms notifications.SMSSender, clk clock.Clock, logger *slog.Logger) *SchedulingService {
+	return &SchedulingService{repo: repo, prefs: prefs, users: usersRepo, email: email, sms: sms, clock: clk, logger: logger}
+}
+
+func (s *SchedulingService) preferences(ctx context.Context, userID string) (notifications.Preferences, error) {
+	p, err := s.prefs.Get(ctx, userID)
+	if errors.Is(err, repositories.ErrNotFound) {
+		return notifications.DefaultPreferences(), nil
+	}
+	return p, err
+}
+
+// GetPreferences returns the caller's notification preferences.
+func (s *SchedulingService) GetPreferences(ctx context.Context, p auth.Principal) (notifications.Preferences, error) {
+	return s.preferences(ctx, p.UserID)
+}
+
+// UpdatePreferences replaces the caller's notification preferences.
+func (s *SchedulingService) UpdatePreferences(ctx context.Context, p auth.Principal, in notifications.Preferences) (notifications.Preferences, error) {
+	v := validation.New()
+	v.Required("timezone", in.Timezone)
+	if in.Timezone != "" {
+		_, err := time.LoadLocation(in.Timezone)
+		v.Check(err == nil && in.Timezone != "Local", "timezone", "must be an IANA time zone name")
+	}
+	if q := in.QuietHours; q != nil {
+		start, err1 := notifications.ParseClock(q.Start)
+		end, err2 := notifications.ParseClock(q.End)
+		v.Check(err1 == nil, "quiet_hours.start", "must be a time of day in HH:MM format")
+		v.Check(err2 == nil, "quiet_hours.end", "must be a time of day in HH:MM format")
+		v.Check(err1 != nil || err2 != nil || start != end, "quiet_hours.end", "must differ from start")
+	}
+	if err := v.Err(); err != nil {
+		return notifications.Preferences{}, err
+	}
+	if err := s.prefs.Put(ctx, p.UserID, in); err != nil {
+		return notifications.Preferences{}, err
+	}
+	return in, nil
+}
+
+// ScheduleInput is the payload for scheduling a notification.
+type ScheduleInput struct {
+	Channel string `json:"channel"`
+	Subject string `json:"subject"`
+	Body    string `json:"body"`
+	SendAt  string `json:"send_at"`
+}
+
+// Schedule creates a pending notification for the caller. With an
+// idempotency key, repeating an identical request returns the original
+// notification (created == false); reusing the key for a different payload
+// is a conflict.
+func (s *SchedulingService) Schedule(ctx context.Context, p auth.Principal, key string, in ScheduleInput) (n notifications.Scheduled, created bool, err error) {
+	v := validation.New()
+	v.OneOf("channel", in.Channel, string(notifications.ChannelEmail), string(notifications.ChannelSMS))
+	if in.Channel == string(notifications.ChannelEmail) {
+		v.Required("subject", in.Subject)
+	}
+	v.MaxLen("subject", in.Subject, 200)
+	v.Required("body", in.Body)
+	v.MaxLen("body", in.Body, 2000)
+	v.MaxLen("idempotency_key", key, 128)
+	sendAt, perr := time.Parse(time.RFC3339, in.SendAt)
+	v.Check(perr == nil, "send_at", "must be an RFC 3339 timestamp")
+	if err := v.Err(); err != nil {
+		return notifications.Scheduled{}, false, err
+	}
+	now := s.clock.Now()
+	n = notifications.Scheduled{
+		ID: ids.New("ntf"), UserID: p.UserID, Channel: notifications.Channel(in.Channel),
+		Subject: in.Subject, Body: in.Body, SendAt: sendAt.UTC(), Status: notifications.StatusPending,
+		NextAttemptAt: sendAt.UTC(), IdempotencyKey: key, CreatedAt: now,
+	}
+	if key != "" {
+		existing, err := s.repo.GetByIdempotencyKey(ctx, p.UserID, key)
+		if err == nil {
+			return replay(existing, n)
+		}
+		if !errors.Is(err, repositories.ErrNotFound) {
+			return notifications.Scheduled{}, false, err
+		}
+	}
+
+	v = validation.New()
+	v.Check(!n.SendAt.Before(now), "send_at", "must not be in the past")
+	v.Check(!n.SendAt.After(now.Add(MaxScheduleAhead)), "send_at", "must be at most 30 days ahead")
+	if n.Channel == notifications.ChannelSMS {
+		u, err := s.users.Get(ctx, p.UserID)
+		if err != nil {
+			return notifications.Scheduled{}, false, mapNotFound(err, errUserNotFound)
+		}
+		v.Check(u.Phone != "", "channel", "no phone number on file")
+	}
+	if err := v.Err(); err != nil {
+		return notifications.Scheduled{}, false, err
+	}
+
+	stored, err := s.repo.Create(ctx, n)
+	if errors.Is(err, repositories.ErrDuplicate) && key != "" {
+		return replay(stored, n)
+	}
+	if err != nil {
+		return notifications.Scheduled{}, false, err
+	}
+	return stored, true, nil
+}
+
+func replay(existing, req notifications.Scheduled) (notifications.Scheduled, bool, error) {
+	if !existing.SamePayload(req) {
+		return notifications.Scheduled{}, false, apperr.Conflict("idempotency_key_reused", "the idempotency key was already used for a different request")
+	}
+	return existing, false, nil
+}
+
+func (s *SchedulingService) loadFor(ctx context.Context, p auth.Principal, id string) (notifications.Scheduled, error) {
+	n, err := s.repo.Get(ctx, id)
+	if err != nil {
+		return notifications.Scheduled{}, mapNotFound(err, errNotificationNotFound)
+	}
+	if n.UserID != p.UserID && !p.Is(auth.RoleAdmin) {
+		return notifications.Scheduled{}, errNotificationNotFound
+	}
+	return n, nil
+}
+
+// Get returns one of the caller's scheduled notifications.
+func (s *SchedulingService) Get(ctx context.Context, p auth.Principal, id string) (notifications.Scheduled, error) {
+	return s.loadFor(ctx, p, id)
+}
+
+// DispatchResult summarises one dispatch pass.
+type DispatchResult struct {
+	Sent     int `json:"sent"`
+	Retried  int `json:"retried"`
+	Failed   int `json:"failed"`
+	Deferred int `json:"deferred"`
+}
+
+// RunDispatch runs a dispatch pass on behalf of an admin.
+func (s *SchedulingService) RunDispatch(ctx context.Context, p auth.Principal) (DispatchResult, error) {
+	if err := requireRole(p, auth.RoleAdmin); err != nil {
+		return DispatchResult{}, err
+	}
+	return s.Dispatch(ctx)
+}
+
+var errNoLongerPending = errors.New("notification is no longer pending")
+
+// Dispatch delivers every pending notification that is due at the current
+// time, unless the recipient is in their quiet hours. Failed deliveries are
+// retried with exponential backoff up to notifications.MaxAttempts.
+func (s *SchedulingService) Dispatch(ctx context.Context) (DispatchResult, error) {
+	s.dispatchMu.Lock()
+	defer s.dispatchMu.Unlock()
+
+	var res DispatchResult
+	now := s.clock.Now()
+	due, err := s.repo.ListDue(ctx, now)
+	if err != nil {
+		return res, err
+	}
+	for _, n := range due {
+		prefs, err := s.preferences(ctx, n.UserID)
+		if err != nil {
+			return res, err
+		}
+		if prefs.Quiet(now) {
+			res.Deferred++
+			continue
+		}
+		sendErr := s.deliver(ctx, n)
+		updated, err := s.repo.Update(ctx, n.ID, func(cur *notifications.Scheduled) error {
+			if cur.Status != notifications.StatusPending {
+				return errNoLongerPending
+			}
+			cur.Attempts++
+			switch {
+			case sendErr == nil:
+				cur.Status = notifications.StatusSent
+				cur.SentAt = &now
+			case cur.Attempts >= notifications.MaxAttempts:
+				cur.Status = notifications.StatusFailed
+			default:
+				cur.NextAttemptAt = now.Add(notifications.RetryBackoff(cur.Attempts))
+			}
+			return nil
+		})
+		if errors.Is(err, errNoLongerPending) {
+			continue
+		}
+		if err != nil {
+			return res, err
+		}
+		switch updated.Status {
+		case notifications.StatusSent:
+			res.Sent++
+		case notifications.StatusFailed:
+			res.Failed++
+		default:
+			res.Retried++
+		}
+		if sendErr != nil {
+			s.logger.WarnContext(ctx, "scheduled notification delivery failed", "id", n.ID, "attempt", updated.Attempts, "err", sendErr)
+		}
+	}
+	return res, nil
+}
+
+func (s *SchedulingService) deliver(ctx context.Context, n notifications.Scheduled) error {
+	u, err := s.users.Get(ctx, n.UserID)
+	if err != nil {
+		return fmt.Errorf("load recipient: %w", err)
+	}
+	switch n.Channel {
+	case notifications.ChannelEmail:
+		return s.email.SendEmail(ctx, notifications.Email{To: u.Email, Subject: n.Subject, Body: n.Body})
+	case notifications.ChannelSMS:
+		if strings.TrimSpace(u.Phone) == "" {
+			return errors.New("recipient has no phone number")
+		}
+		return s.sms.SendSMS(ctx, notifications.SMS{To: u.Phone, Body: n.Body})
+	default:
+		return fmt.Errorf("unknown channel %q", n.Channel)
+	}
+}
diff --git a/internal/services/scheduling_test.go b/internal/services/scheduling_test.go
new file mode 100644
index 0000000..b1ae122
--- /dev/null
+++ b/internal/services/scheduling_test.go
@@ -0,0 +1,132 @@
+package services
+
+import (
+	"context"
+	"io"
+	"log/slog"
+	"testing"
+	"time"
+	_ "time/tzdata"
+
+	"github.com/acme/meridian/internal/apperr"
+	"github.com/acme/meridian/internal/auth"
+	"github.com/acme/meridian/internal/clock"
+	"github.com/acme/meridian/internal/notifications"
+	"github.com/acme/meridian/internal/repositories"
+	"github.com/acme/meridian/internal/users"
+)
+
+type schedulingFixture struct {
+	svc   *SchedulingService
+	clock *clock.Fake
+	email *notifications.FakeEmailSender
+	user  auth.Principal
+}
+
+func newSchedulingFixture(t *testing.T) *schedulingFixture {
+	t.Helper()
+	clk := clock.NewFake(time.Date(2026, 7, 1, 12, 0, 0, 0, time.UTC))
+	usersRepo := repositories.NewMemoryUsers()
+	_ = usersRepo.Create(context.Background(), users.User{ID: "usr_1", Email: "u@example.com"})
+	email := &notifications.FakeEmailSender{}
+	svc := NewSchedulingService(repositories.NewMemoryScheduledNotifications(), repositories.NewMemoryPreferences(), usersRepo,
+		email, &notifications.FakeSMSSender{}, clk, slog.New(slog.NewTextHandler(io.Discard, nil)))
+	return &schedulingFixture{svc: svc, clock: clk, email: email, user: auth.Principal{UserID: "usr_1", Role: auth.RoleUser}}
+}
+
+func (f *schedulingFixture) schedule(t *testing.T, key string, at time.Time) notifications.Scheduled {
+	t.Helper()
+	n, _, err := f.svc.Schedule(context.Background(), f.user, key, ScheduleInput{Channel: "email", Subject: "Hi", Body: "Hello", SendAt: at.Format(time.RFC3339)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+func TestScheduleIdempotency(t *testing.T) {
+	f := newSchedulingFixture(t)
+	at := f.clock.Now().Add(time.Hour)
+	first := f.schedule(t, "k1", at)
+	in := ScheduleInput{Channel: "email", Subject: "Hi", Body: "Hello", SendAt: at.In(time.FixedZone("x", 7200)).Format(time.RFC3339)}
+	again, created, err := f.svc.Schedule(context.Background(), f.user, "k1", in)
+	if err != nil || created || again.ID != first.ID {
+		t.Fatalf("replay = %+v created=%v err=%v", again, created, err)
+	}
+	in.Body = "changed"
+	if _, _, err := f.svc.Schedule(context.Background(), f.user, "k1", in); apperr.KindOf(err) != apperr.KindConflict {
+		t.Fatalf("reuse: %v", err)
+	}
+}
+
+func TestDispatchRetriesWithBackoff(t *testing.T) {
+	f := newSchedulingFixture(t)
+	ctx := context.Background()
+	n := f.schedule(t, "", f.clock.Now())
+	f.email.FailNext(3)
+
+	steps := []struct {
+		advance time.Duration
+		want    DispatchResult
+	}{
+		{0, DispatchResult{Retried: 1}},
+		{59 * time.Second, DispatchResult{}},
+		{time.Second, DispatchResult{Retried: 1}},
+		{2 * time.Minute, DispatchResult{Failed: 1}},
+		{time.Hour, DispatchResult{}},
+	}
+	for i, st := range steps {
+		f.clock.Advance(st.advance)
+		got, err := f.svc.Dispatch(ctx)
+		if err != nil || got != st.want {
+			t.Fatalf("step %d: got %+v, %v; want %+v", i, got, err, st.want)
+		}
+	}
+	got, _ := f.svc.Get(ctx, f.user, n.ID)
+	if got.Status != notifications.StatusFailed || got.Attempts != 3 {
+		t.Fatalf("final = %+v", got)
+	}
+}
+
+func TestDispatchHonoursQuietHours(t *testing.T) {
+	f := newSchedulingFixture(t)
+	ctx := context.Background()
+	if _, err := f.svc.UpdatePreferences(ctx, f.user, notifications.Preferences{
+		Timezone: "Asia/Tokyo", QuietHours: &notifications.QuietHours{Start: "21:00", End: "08:00"},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	f.schedule(t, "", f.clock.Now()) // 12:00 UTC is 21:00 in Tokyo
+	if got, _ := f.svc.Dispatch(ctx); got != (DispatchResult{Deferred: 1}) {
+		t.Fatalf("during quiet hours: %+v", got)
+	}
+	f.clock.Advance(11 * time.Hour) // 08:00 in Tokyo
+	if got, _ := f.svc.Dispatch(ctx); got != (DispatchResult{Sent: 1}) {
+		t.Fatalf("after quiet hours: %+v", got)
+	}
+	if len(f.email.Sent()) != 1 {
+		t.Fatalf("sent = %+v", f.email.Sent())
+	}
+}
+
+func TestUpdatePreferencesValidation(t *testing.T) {
+	f := newSchedulingFixture(t)
+	tests := []struct {
+		name  string
+		in    notifications.Preferences
+		field string
+	}{
+		{"unknown zone", notifications.Preferences{Timezone: "Mars/Olympus"}, "timezone"},
+		{"empty zone", notifications.Preferences{}, "timezone"},
+		{"bad start", notifications.Preferences{Timezone: "UTC", QuietHours: &notifications.QuietHours{Start: "25:00", End: "07:00"}}, "quiet_hours.start"},
+		{"equal bounds", notifications.Preferences{Timezone: "UTC", QuietHours: &notifications.QuietHours{Start: "07:00", End: "07:00"}}, "quiet_hours.end"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			_, err := f.svc.UpdatePreferences(context.Background(), f.user, tt.in)
+			e, ok := apperr.As(err)
+			if !ok || e.Fields[tt.field] == "" {
+				t.Fatalf("err = %v, want field %q", err, tt.field)
+			}
+		})
+	}
+}
diff --git a/migrations/0004_scheduled_notifications.sql b/migrations/0004_scheduled_notifications.sql
new file mode 100644
index 0000000..1f02400
--- /dev/null
+++ b/migrations/0004_scheduled_notifications.sql
@@ -0,0 +1,28 @@
+-- Scheduled notifications and per-user delivery preferences.
+
+CREATE TABLE notification_preferences (
+    user_id           TEXT PRIMARY KEY REFERENCES users (id),
+    timezone          TEXT NOT NULL DEFAULT 'UTC',   -- IANA zone name
+    quiet_hours_start TIME,                          -- local time, inclusive
+    quiet_hours_end   TIME,                          -- local time, exclusive; may wrap midnight
+    CHECK ((quiet_hours_start IS NULL) = (quiet_hours_end IS NULL))
+);
+
+CREATE TABLE scheduled_notifications (
+    id              TEXT PRIMARY KEY,                -- ntf_<16 hex>
+    user_id         TEXT NOT NULL REFERENCES users (id),
+    channel         TEXT NOT NULL CHECK (channel IN ('email', 'sms')),
+    subject         TEXT,
+    body            TEXT NOT NULL,
+    send_at         TIMESTAMPTZ NOT NULL,
+    status          TEXT NOT NULL CHECK (status IN ('pending', 'sent', 'failed')),
+    attempts        INTEGER NOT NULL DEFAULT 0,
+    next_attempt_at TIMESTAMPTZ NOT NULL,
+    sent_at         TIMESTAMPTZ,
+    idempotency_key TEXT,
+    created_at      TIMESTAMPTZ NOT NULL
+);
+
+CREATE UNIQUE INDEX scheduled_notifications_idem_key ON scheduled_notifications (user_id, idempotency_key)
+    WHERE idempotency_key IS NOT NULL;
+CREATE INDEX scheduled_notifications_due_idx ON scheduled_notifications (next_attempt_at) WHERE status = 'pending';
