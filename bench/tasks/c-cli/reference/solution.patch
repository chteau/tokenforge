diff --git a/README.md b/README.md
index 61854c1..8e9ffdd 100644
--- a/README.md
+++ b/README.md
@@ -1 +1,28 @@
 # csvq — query CSV files from the command line
+
+`csvq` reads a CSV file (RFC 4180) and selects columns, filters rows, sorts and
+aggregates them, writing CSV to standard output.
+
+## Build and test
+
+```
+make            # builds ./csvq (C11, -Wall -Wextra)
+make test       # builds and runs tests/test_csvq
+make EXTRA_CFLAGS="-fsanitize=address,undefined"   # instrumented build
+```
+
+## Usage
+
+```
+csvq [--select COLS] [--where EXPR]... [--sort KEYS] [--group-by COLS]
+     [--agg LIST] [--limit N] [FILE]
+```
+
+```
+csvq sales.csv --where "amount > 50" --select rep,amount --sort amount:desc
+csvq sales.csv --group-by region --agg "count,sum(amount),avg(amount)"
+```
+
+Operators: `=`, `!=`, `<`, `<=`, `>`, `>=`, `contains`. Aggregates: `count`,
+`sum(col)`, `avg(col)`, `min(col)`, `max(col)`. Exit codes: 0 success, 2 usage
+error, 3 input error.
diff --git a/src/cli.c b/src/cli.c
new file mode 100644
index 0000000..cea390a
--- /dev/null
+++ b/src/cli.c
@@ -0,0 +1,169 @@
+#include "cli.h"
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "csv.h"
+#include "query.h"
+#include "util.h"
+
+static const char USAGE[] =
+    "usage: csvq [OPTIONS] [FILE]\n"
+    "\n"
+    "Query a CSV file (or standard input when FILE is omitted or '-').\n"
+    "\n"
+    "  --select COLS       output only these comma-separated columns\n"
+    "  --where EXPR        keep rows matching EXPR (repeatable, all must match)\n"
+    "                      operators: = != < <= > >= contains\n"
+    "  --sort KEYS         sort by comma-separated columns, each optionally :asc or :desc\n"
+    "  --group-by COLS     group rows by these columns\n"
+    "  --agg LIST          aggregates: count, sum(c), avg(c), min(c), max(c)\n"
+    "  --limit N           output at most N rows\n"
+    "  -h, --help          show this help\n";
+
+typedef struct {
+    Query query;
+    const char *file;
+    int seen_select, seen_sort, seen_group, seen_agg, seen_limit;
+} Options;
+
+static int usage_error(FILE *err, const char *fmt, const char *arg)
+{
+    fputs("error: ", err);
+    fprintf(err, fmt, arg);
+    fputc('\n', err);
+    return EXIT_USAGE;
+}
+
+static int parse_limit(const char *s, long *out)
+{
+    if (*s == '\0' || strlen(s) > 18)
+        return -1;
+    for (const char *p = s; *p; p++)
+        if (*p < '0' || *p > '9')
+            return -1;
+    *out = strtol(s, NULL, 10);
+    return 0;
+}
+
+/* Returns -1 to continue, or an exit code. */
+static int parse_args(int argc, char **argv, Options *o, FILE *out, FILE *err)
+{
+    Query *q = &o->query;
+    for (int i = 1; i < argc; i++) {
+        const char *a = argv[i];
+        if (strcmp(a, "-h") == 0 || strcmp(a, "--help") == 0) {
+            fputs(USAGE, out);
+            return EXIT_OK;
+        }
+        if (a[0] != '-' || strcmp(a, "-") == 0) {
+            if (o->file)
+                return usage_error(err, "unexpected argument: %s", a);
+            o->file = a;
+            continue;
+        }
+        int *seen = strcmp(a, "--select") == 0     ? &o->seen_select
+                    : strcmp(a, "--sort") == 0     ? &o->seen_sort
+                    : strcmp(a, "--group-by") == 0 ? &o->seen_group
+                    : strcmp(a, "--agg") == 0      ? &o->seen_agg
+                    : strcmp(a, "--limit") == 0    ? &o->seen_limit
+                                                   : NULL;
+        if (!seen && strcmp(a, "--where") != 0)
+            return usage_error(err, "unknown option: %s", a);
+        if (i + 1 >= argc)
+            return usage_error(err, "option %s requires a value", a);
+        if (seen && (*seen)++)
+            return usage_error(err, "option %s given more than once", a);
+        const char *v = argv[++i];
+
+        if (strcmp(a, "--where") == 0) {
+            Condition c;
+            if (parse_condition(v, &c) != 0)
+                return usage_error(err, "invalid expression: %s", v);
+            q->conds = xrealloc(q->conds, (q->nconds + 1) * sizeof *q->conds);
+            q->conds[q->nconds++] = c;
+        } else if (seen == &o->seen_select) {
+            q->has_select = 1;
+            if (split_list(v, &q->select) != 0)
+                return usage_error(err, "invalid column list: %s", v);
+        } else if (seen == &o->seen_group) {
+            q->has_group = 1;
+            if (split_list(v, &q->group_by) != 0)
+                return usage_error(err, "invalid column list: %s", v);
+        } else if (seen == &o->seen_sort) {
+            if (parse_sort_keys(v, &q->sort, &q->nsort) != 0)
+                return usage_error(err, "invalid column list: %s", v);
+        } else if (seen == &o->seen_agg) {
+            if (parse_aggregates(v, &q->aggs, &q->naggs) != 0)
+                return usage_error(err, "invalid aggregate: %s", v);
+        } else if (parse_limit(v, &q->limit) != 0) {
+            return usage_error(err, "invalid limit: %s", v);
+        }
+    }
+    if (q->has_select && (q->has_group || q->naggs > 0))
+        return usage_error(err, "%s", "--select cannot be combined with --group-by or --agg");
+    return -1;
+}
+
+static int load_table(const char *file, FILE *in, Table *t, FILE *err)
+{
+    FILE *f = in;
+    const char *name = file && strcmp(file, "-") != 0 ? file : NULL;
+    if (name) {
+        f = fopen(name, "rb");
+        if (!f) {
+            fprintf(err, "error: %s: %s\n", name, strerror(errno));
+            return EXIT_INPUT;
+        }
+    }
+    size_t len = 0;
+    char *data = read_all(f, &len);
+    if (name)
+        fclose(f);
+    if (!data) {
+        fprintf(err, "error: %s: read error\n", name ? name : "<stdin>");
+        return EXIT_INPUT;
+    }
+    CsvError e;
+    int rc = csv_parse(data, len, t, &e);
+    free(data);
+    if (rc != 0) {
+        if (e.line)
+            fprintf(err, "error: line %zu: %s\n", e.line, e.msg);
+        else
+            fprintf(err, "error: %s\n", e.msg);
+        return EXIT_INPUT;
+    }
+    return EXIT_OK;
+}
+
+int cli_run(int argc, char **argv, FILE *in, FILE *out, FILE *err)
+{
+    Options o;
+    memset(&o, 0, sizeof o);
+    query_init(&o.query);
+    int rc = parse_args(argc, argv, &o, out, err);
+    if (rc >= 0) {
+        query_free(&o.query);
+        return rc;
+    }
+
+    Table input, result;
+    rc = load_table(o.file, in, &input, err);
+    if (rc == EXIT_OK) {
+        const char *bad = NULL;
+        if (query_run(&o.query, &input, &result, &bad) != 0) {
+            fprintf(err, "error: unknown column: %s\n", bad);
+            rc = EXIT_USAGE;
+        } else {
+            csv_write_record(out, result.header.fields, result.header.nfields);
+            for (size_t r = 0; r < result.nrows; r++)
+                csv_write_record(out, result.rows[r].fields, result.rows[r].nfields);
+            table_free(&result);
+        }
+        table_free(&input);
+    }
+    query_free(&o.query);
+    return rc;
+}
