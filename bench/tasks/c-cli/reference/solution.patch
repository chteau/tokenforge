+#ifndef CSVQ_CLI_H
+#define CSVQ_CLI_H
+
+#include <stdio.h>
+
+enum { EXIT_OK = 0, EXIT_USAGE = 2, EXIT_INPUT = 3 };
+
+/* Runs csvq with the given arguments (argv[0] is the program name).
+ * Results go to `out`, error messages to `err`. Returns the exit code. */
+int cli_run(int argc, char **argv, FILE *in, FILE *out, FILE *err);
+
+#endif
diff --git a/src/csv.c b/src/csv.c
new file mode 100644
index 0000000..c9a1d14
--- /dev/null
+++ b/src/csv.c
@@ -0,0 +1,232 @@
+#include "csv.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "util.h"
+
+void table_init(Table *t)
+{
+    memset(t, 0, sizeof *t);
+}
+
+void table_add_row(Table *t, Record row)
+{
+    if (t->nrows == t->cap) {
+        t->cap = t->cap ? t->cap * 2 : 64;
+        t->rows = xrealloc(t->rows, t->cap * sizeof *t->rows);
+    }
+    t->rows[t->nrows++] = row;
+}
+
+void record_free(Record *r)
+{
+    for (size_t i = 0; i < r->nfields; i++)
+        free(r->fields[i]);
+    free(r->fields);
+    r->fields = NULL;
+    r->nfields = 0;
+}
+
+void table_free(Table *t)
+{
+    record_free(&t->header);
+    for (size_t i = 0; i < t->nrows; i++)
+        record_free(&t->rows[i]);
+    free(t->rows);
+    table_init(t);
+}
+
+char *read_all(FILE *f, size_t *len)
+{
+    size_t cap = 4096, n = 0;
+    char *buf = xmalloc(cap);
+    for (;;) {
+        if (n == cap) {
+            cap *= 2;
+            buf = xrealloc(buf, cap);
+        }
+        size_t got = fread(buf + n, 1, cap - n, f);
+        n += got;
+        if (got == 0)
+            break;
+    }
+    if (ferror(f)) {
+        free(buf);
+        return NULL;
+    }
+    *len = n;
+    return buf;
+}
+
+/* Parser state over an in-memory buffer. */
+typedef struct {
+    const char *s;
+    size_t len;
+    size_t pos;
+    size_t line;
+    CsvError *err;
+} Parser;
+
+static int fail(Parser *p, size_t line, const char *msg)
+{
+    p->err->line = line;
+    snprintf(p->err->msg, sizeof p->err->msg, "%s", msg);
+    return -1;
+}
+
+/* Length of the line terminator at the current position (0 if none). */
+static size_t eol_len(const Parser *p)
+{
+    if (p->pos < p->len && p->s[p->pos] == '\n')
+        return 1;
+    if (p->pos + 1 < p->len && p->s[p->pos] == '\r' && p->s[p->pos + 1] == '\n')
+        return 2;
+    return 0;
+}
+
+static int at_field_end(const Parser *p)
+{
+    return p->pos >= p->len || p->s[p->pos] == ',' || eol_len(p) > 0;
+}
+
+static int parse_field(Parser *p, char **out)
+{
+    StrBuf sb;
+    sb_init(&sb);
+    if (p->pos < p->len && p->s[p->pos] == '"') {
+        size_t start_line = p->line;
+        p->pos++;
+        for (;;) {
+            if (p->pos >= p->len) {
+                sb_free(&sb);
+                return fail(p, start_line, "unterminated quoted field");
+            }
+            char c = p->s[p->pos];
+            if (c == '"') {
+                if (p->pos + 1 < p->len && p->s[p->pos + 1] == '"') {
+                    sb_putc(&sb, '"');
+                    p->pos += 2;
+                    continue;
+                }
+                p->pos++;
+                break;
+            }
+            if (c == '\n')
+                p->line++;
+            sb_putc(&sb, c);
+            p->pos++;
+        }
+        if (!at_field_end(p)) {
+            sb_free(&sb);
+            return fail(p, p->line, "unexpected character after closing quote");
+        }
+    } else {
+        while (!at_field_end(p)) {
+            char c = p->s[p->pos];
+            if (c == '"') {
+                sb_free(&sb);
+                return fail(p, p->line, "unexpected quote in unquoted field");
+            }
+            sb_putc(&sb, c);
+            p->pos++;
+        }
+    }
+    *out = sb_take(&sb);
+    sb_free(&sb);
+    return 0;
+}
+
+/* Parses one record starting at the current position (which is not at EOF). */
+static int parse_record(Parser *p, Record *rec)
+{
+    rec->fields = NULL;
+    rec->nfields = 0;
+    rec->line = p->line;
+    for (;;) {
+        char *field;
+        if (parse_field(p, &field) != 0) {
+            record_free(rec);
+            return -1;
+        }
+        rec->fields = xrealloc(rec->fields, (rec->nfields + 1) * sizeof *rec->fields);
+        rec->fields[rec->nfields++] = field;
+        if (p->pos < p->len && p->s[p->pos] == ',') {
+            p->pos++;
+            continue;
+        }
+        size_t e = eol_len(p);
+        if (e) {
+            p->pos += e;
+            p->line++;
+        }
+        return 0;
+    }
+}
+
+int csv_parse(const char *data, size_t len, Table *out, CsvError *err)
+{
+    Parser p = {data, len, 0, 1, err};
+    int have_header = 0;
+    table_init(out);
+    if (len >= 3 && memcmp(data, "\xEF\xBB\xBF", 3) == 0)
+        p.pos = 3;
+    while (p.pos < p.len) {
+        size_t e = eol_len(&p);
+        if (e) { /* empty line */
+            p.pos += e;
+            p.line++;
+            continue;
+        }
+        Record rec;
+        if (parse_record(&p, &rec) != 0) {
+            table_free(out);
+            return -1;
+        }
+        if (!have_header) {
+            out->header = rec;
+            have_header = 1;
+            continue;
+        }
+        if (rec.nfields != out->header.nfields) {
+            char msg[96];
+            snprintf(msg, sizeof msg, "expected %zu fields, got %zu", out->header.nfields,
+                     rec.nfields);
+            size_t line = rec.line;
+            record_free(&rec);
+            table_free(out);
+            return fail(&p, line, msg);
+        }
+        table_add_row(out, rec);
+    }
+    if (!have_header) {
+        table_free(out);
+        return fail(&p, 0, "empty input");
+    }
+    return 0;
+}
+
+void csv_write_field(FILE *out, const char *field)
+{
+    if (strpbrk(field, ",\"\r\n") == NULL) {
+        fputs(field, out);
+        return;
+    }
+    fputc('"', out);
+    for (const char *c = field; *c; c++) {
+        if (*c == '"')
+            fputc('"', out);
+        fputc(*c, out);
+    }
+    fputc('"', out);
+}
+
+void csv_write_record(FILE *out, char *const *fields, size_t n)
+{
+    for (size_t i = 0; i < n; i++) {
+        if (i)
+            fputc(',', out);
+        csv_write_field(out, fields[i]);
+    }
+    fputc('\n', out);
+}
diff --git a/src/csv.h b/src/csv.h
new file mode 100644
index 0000000..e41b0f9
--- /dev/null
+++ b/src/csv.h
@@ -0,0 +1,42 @@
+#ifndef CSVQ_CSV_H
+#define CSVQ_CSV_H
+
+#include <stdio.h>
+#include <stddef.h>
+
+/* One CSV record. `line` is the 1-based physical line on which it starts. */
+typedef struct {
+    char **fields;
+    size_t nfields;
+    size_t line;
+} Record;
+
+/* A parsed CSV document: the header plus data rows. */
+typedef struct {
+    Record header;
+    Record *rows;
+    size_t nrows;
+    size_t cap;
+} Table;
+
+typedef struct {
+    size_t line; /* 0 when the error is not tied to a line */
+    char msg[128];
+} CsvError;
+
+/* Parses RFC 4180 text. Returns 0 on success, -1 with *err filled otherwise. */
+int csv_parse(const char *data, size_t len, Table *out, CsvError *err);
+
+/* Reads a whole stream into memory. Returns NULL on a read error. */
+char *read_all(FILE *f, size_t *len);
+
+void table_init(Table *t);
+void table_add_row(Table *t, Record row);
+void record_free(Record *r);
+void table_free(Table *t);
+
+/* Writes one field, quoting it when it contains a comma, quote, CR or LF. */
+void csv_write_field(FILE *out, const char *field);
+void csv_write_record(FILE *out, char *const *fields, size_t n);
+
+#endif
