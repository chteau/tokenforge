+
+test_validation_strict_and_lenient <- function() {
+  qs <- read_schema(write_temp(SCHEMA_LINES))
+  v <- values_matrix(c("3", "40", "north", "email;chat"), c("6", "x", "east", "email;;chat"))
+  expect_error_code(check_answers(v, qs, FALSE), EXIT_DATA, "row 2: invalid value for 'sat': '6'")
+  res <- check_answers(v, qs, TRUE)
+  stopifnot(res$invalid == 4, all(res$values[2, ] == ""), res$values[1, "tools"] == "email;chat")
+}
+
+test_numeric_format <- function() {
+  q <- list(id = "age", type = "numeric", levels = character(0))
