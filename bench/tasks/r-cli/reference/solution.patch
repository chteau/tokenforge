@@ -0,0 +1,22 @@
+# Shared helpers for the test files (sourced by each of them).
+expect_error_code <- function(expr, code, message = NULL) {
+  err <- tryCatch({
+    force(expr)
+    NULL
+  }, surveystat_error = function(e) e)
+  if (is.null(err)) stop("expected a surveystat error")
+  if (err$code != code) stop("expected exit code ", code, ", got ", err$code, ": ", conditionMessage(err))
+  if (!is.null(message) && conditionMessage(err) != message) {
+    stop("expected message '", message, "', got '", conditionMessage(err), "'")
+  }
+  invisible(err)
+}
+
+write_temp <- function(lines) {
+  path <- tempfile(fileext = ".csv")
+  writeLines(lines, path)
+  path
+}
+
+SCHEMA_LINES <- c("question,type,levels", "sat,likert,", "age,numeric,",
+                  "region,single,north;south", "tools,multi,email;chat;phone")
diff --git a/tests/run.R b/tests/run.R
new file mode 100644
index 0000000..44a925c
--- /dev/null
+++ b/tests/run.R
@@ -0,0 +1,26 @@
+# Minimal test runner: `Rscript tests/run.R` from the repository root.
+# Every function named test_* in tests/test_*.R is a test; it fails if it signals an error.
+app <- new.env()
+for (f in sort(list.files("R", pattern = "\\.R$", full.names = TRUE))) sys.source(f, envir = app)
+
+total <- 0L
+failures <- 0L
+for (file in sort(list.files("tests", pattern = "^test_.*\\.R$", full.names = TRUE))) {
+  suite <- new.env(parent = app)
+  sys.source(file, envir = suite)
+  for (name in sort(grep("^test_", ls(suite), value = TRUE))) {
+    total <- total + 1L
+    err <- tryCatch({
+      suite[[name]]()
+      NULL
+    }, error = function(e) conditionMessage(e))
+    if (is.null(err)) {
+      cat("ok   ", basename(file), " ", name, "\n", sep = "")
+    } else {
+      failures <- failures + 1L
+      cat("FAIL ", basename(file), " ", name, ": ", err, "\n", sep = "")
+    }
+  }
+}
+cat(sprintf("tests: %d, failures: %d\n", total, failures))
+quit(save = "no", status = if (failures == 0L) 0L else 1L)
