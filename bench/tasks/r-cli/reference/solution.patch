+#!/usr/bin/env Rscript
+# surveystat: summarise survey responses. See README.md.
+local({
+  file_arg <- grep("^--file=", commandArgs(trailingOnly = FALSE), value = TRUE)[1]
+  root <- file.path(dirname(sub("^--file=", "", file_arg)), "..")
+  env <- new.env()
+  for (f in sort(list.files(file.path(root, "R"), pattern = "\\.R$", full.names = TRUE))) {
+    sys.source(f, envir = env, keep.source = FALSE)
+  }
+  quit(save = "no", status = env$main(commandArgs(trailingOnly = TRUE)))
+})
