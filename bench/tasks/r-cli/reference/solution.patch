+test_chi_square_matches_chisq_test <- function() {
+  tab <- matrix(c(10L, 20L, 0L, 30L, 15L, 0L, 0L, 0L, 0L), nrow = 3)
+  cs <- chi_square(tab)
+  ref <- suppressWarnings(chisq.test(matrix(c(10, 20, 30, 15), nrow = 2)))
+  stopifnot(cs$statistic == sprintf("%.4f", ref$statistic), cs$df == 1L)
+  stopifnot(is.null(chi_square(matrix(c(1L, 2L, 0L, 0L), nrow = 2))))
+}
