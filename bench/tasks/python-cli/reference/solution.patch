+"""Command-line interface."""
+from __future__ import annotations
+
+import argparse
+import sys
+
+from ledgerstat import output, reports
+from ledgerstat.config import load_config
+from ledgerstat.errors import FatalError
+from ledgerstat.parsing import filter_dates, load_files, parse_date
+
+PROG = "ledgerstat"
+
+
+def _date_arg(text: str):
+    try:
+        return parse_date(text)
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"invalid date {text!r} (expected YYYY-MM-DD)") from None
+
+
+def _positive_int(text: str) -> int:
+    try:
+        value = int(text)
+    except ValueError:
+        value = 0
+    if value < 1:
+        raise argparse.ArgumentTypeError(f"must be a positive integer: {text!r}")
+    return value
+
+
+def build_parser() -> argparse.ArgumentParser:
+    """Create the argument parser with one sub-command per report."""
+    parser = argparse.ArgumentParser(prog=PROG, description="Spending reports from bank CSV exports.")
+    common = argparse.ArgumentParser(add_help=False)
+    common.add_argument("files", nargs="+", metavar="FILE", help="CSV export(s) to read")
+    common.add_argument("--format", choices=output.FORMATS, default="table")
+    common.add_argument("--from", dest="start", type=_date_arg, metavar="YYYY-MM-DD")
+    common.add_argument("--to", dest="end", type=_date_arg, metavar="YYYY-MM-DD")
+    common.add_argument("--strict", action="store_true", help="fail on any invalid row")
+    sub = parser.add_subparsers(dest="command", required=True, metavar="COMMAND")
+    sub.add_parser("categories", parents=[common], help="totals per category")
+    sub.add_parser("monthly", parents=[common], help="totals per month")
+    merchants = sub.add_parser("merchants", parents=[common], help="top merchants by expenses")
+    merchants.add_argument("--top", type=_positive_int, default=5, metavar="N")
+    budget = sub.add_parser("budget", parents=[common], help="monthly budget alerts")
+    budget.add_argument("--config", required=True, metavar="PATH", help="TOML budget file")
+    budget.add_argument("--alerts-only", action="store_true", help="hide rows with status ok")
+    return parser
+
+
+def run(args: argparse.Namespace) -> int:
+    """Execute a parsed command; return the exit code."""
+    config = load_config(args.config) if args.command == "budget" else None
+    loaded = load_files(args.files)
+    for bad in loaded.bad_rows:
+        print(f"{PROG}: {bad}", file=sys.stderr)
+    if loaded.bad_rows:
+        print(f"{PROG}: skipped {len(loaded.bad_rows)} invalid row(s)", file=sys.stderr)
+        if args.strict:
+            return 1
+    transactions = filter_dates(loaded.transactions, args.start, args.end)
+    if args.command == "categories":
+        report = reports.categories_report(transactions)
+    elif args.command == "monthly":
+        report = reports.monthly_report(transactions)
+    elif args.command == "merchants":
+        report = reports.merchants_report(transactions, args.top)
+    else:
+        report = reports.budget_report(transactions, config, args.alerts_only)
+    sys.stdout.write(output.render(report, args.format))
+    if loaded.bad_rows:
+        return 1
+    if args.command == "budget" and any(r["status"] == "over" for r in report.rows):
+        return 3
+    return 0
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Entry point used by `python -m ledgerstat`."""
+    parser = build_parser()
+    args = parser.parse_args(argv)
+    if args.start and args.end and args.start > args.end:
+        parser.error("--from is later than --to")
+    try:
+        return run(args)
+    except FatalError as exc:
+        print(f"{PROG}: error: {exc}", file=sys.stderr)
+        return 2
