@@ -0,0 +1,114 @@
+"""Reading and validating bank-export CSV files."""
+from __future__ import annotations
+
+import csv
+import datetime as dt
+import re
+from dataclasses import dataclass, field
+from decimal import Decimal
+
+from ledgerstat.errors import FatalError
+
+REQUIRED_COLUMNS = ("date", "merchant", "category", "amount")
+_AMOUNT = re.compile(r"[+-]?\d+(?:\.\d{1,2})?")
+_DATE = re.compile(r"\d{4}-\d{2}-\d{2}")
+
+
+@dataclass(frozen=True)
+class Transaction:
+    date: dt.date
+    merchant: str
+    category: str
+    amount: Decimal
+
+    @property
+    def month(self) -> str:
+        return self.date.strftime("%Y-%m")
+
+
+@dataclass
+class BadRow:
+    path: str
+    line: int
+    reason: str
+
+    def __str__(self) -> str:
+        return f"{self.path}:{self.line}: {self.reason}"
+
+
+@dataclass
+class LoadResult:
+    transactions: list[Transaction] = field(default_factory=list)
+    bad_rows: list[BadRow] = field(default_factory=list)
+
+
+def parse_date(text: str) -> dt.date:
+    """Parse a strict YYYY-MM-DD date; raise ValueError otherwise."""
+    if not _DATE.fullmatch(text):
+        raise ValueError(f"invalid date {text!r}")
+    try:
+        return dt.date.fromisoformat(text)
+    except ValueError:
+        raise ValueError(f"invalid date {text!r}") from None
+
+
+def parse_amount(text: str) -> Decimal:
+    """Parse an amount such as -12.5 or +3.40 into a Decimal."""
+    if not _AMOUNT.fullmatch(text):
+        raise ValueError(f"invalid amount {text!r}")
+    return Decimal(text)
+
+
+def parse_row(values: dict[str, str]) -> Transaction:
+    """Build a Transaction from trimmed field values; raise ValueError on bad data."""
+    date = parse_date(values["date"])
+    merchant = values["merchant"]
+    if not merchant:
+        raise ValueError("empty merchant")
+    category = values["category"].lower() or "uncategorized"
+    return Transaction(date, merchant, category, parse_amount(values["amount"]))
+
+
+def read_file(path: str, result: LoadResult) -> None:
+    """Append the valid transactions and bad rows of one CSV file to result."""
+    try:
+        with open(path, newline="", encoding="utf-8-sig") as fh:
+            reader = csv.reader(fh)
+            header = next(reader, None)
+            columns = [h.strip().lower() for h in header] if header else []
+            missing = [c for c in REQUIRED_COLUMNS if c not in columns]
+            if missing:
+                raise FatalError(f"{path}: missing column(s): {', '.join(missing)}")
+            index = {c: columns.index(c) for c in REQUIRED_COLUMNS}
+            for row in reader:
+                if not row or all(not cell.strip() for cell in row) and len(row) == 1:
+                    continue
+                line = reader.line_num
+                if len(row) != len(columns):
+                    result.bad_rows.append(
+                        BadRow(path, line, f"expected {len(columns)} fields, got {len(row)}"))
+                    continue
+                try:
+                    values = {c: row[i].strip() for c, i in index.items()}
+                    result.transactions.append(parse_row(values))
+                except ValueError as exc:
+                    result.bad_rows.append(BadRow(path, line, str(exc)))
+    except FatalError:
+        raise
+    except (OSError, UnicodeDecodeError, csv.Error) as exc:
+        raise FatalError(f"cannot read {path}: {exc}") from None
+
+
+def load_files(paths: list[str]) -> LoadResult:
+    """Read every file in order and combine the results."""
+    result = LoadResult()
+    for path in paths:
+        read_file(path, result)
+    return result
+
+
+def filter_dates(transactions: list[Transaction], start: dt.date | None,
+                 end: dt.date | None) -> list[Transaction]:
+    """Keep transactions dated within [start, end]; either bound may be None."""
+    return [t for t in transactions
+            if (start is None or t.date >= start) and (end is None or t.date <= end)]
