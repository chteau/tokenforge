@@ -0,0 +1,78 @@
+import io
+import json
+import os
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from decimal import Decimal
+
+from ledgerstat.cli import main
+from ledgerstat.parsing import parse_amount, parse_date
+from ledgerstat.reports import budget_status
+
+SAMPLE = """date,merchant,category,amount
+2026-01-03,Green Grocer,Groceries,-54.20
+2026-01-05,ACME Corp,Salary,2500.00
+2026-01-09,Cafe Lune,Dining,-12.5
+2026-02-01,City Rent,Housing,-950
+"""
+
+
+class ParsingTests(unittest.TestCase):
+    def test_amounts(self):
+        self.assertEqual(parse_amount("-12.5"), Decimal("-12.5"))
+        self.assertEqual(parse_amount("+3.40"), Decimal("3.40"))
+        for bad in ("1,000", "$5", "1.234", "", "abc"):
+            with self.assertRaises(ValueError):
+                parse_amount(bad)
+
+    def test_dates(self):
+        self.assertEqual(str(parse_date("2026-02-28")), "2026-02-28")
+        for bad in ("2026-02-30", "2026-1-5", "05/01/2026"):
+            with self.assertRaises(ValueError):
+                parse_date(bad)
+
+    def test_budget_status(self):
+        self.assertEqual(budget_status(Decimal(100), Decimal(101), Decimal("0.8")), "over")
+        self.assertEqual(budget_status(Decimal(100), Decimal(80), Decimal("0.8")), "warning")
+        self.assertEqual(budget_status(Decimal(100), Decimal(10), Decimal("0.8")), "ok")
+
+
+class CliTests(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "tx.csv")
+        with open(self.path, "w") as fh:
+            fh.write(SAMPLE)
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def run_cli(self, *args):
+        out, err = io.StringIO(), io.StringIO()
+        with redirect_stdout(out), redirect_stderr(err):
+            code = main(list(args))
+        return code, out.getvalue(), err.getvalue()
+
+    def test_categories_json(self):
+        code, out, _ = self.run_cli("categories", self.path, "--format", "json")
+        self.assertEqual(code, 0)
+        doc = json.loads(out)
+        self.assertEqual(doc["categories"][0]["category"], "housing")
+        self.assertEqual(doc["total"]["count"], 4)
+
+    def test_bad_row_reported(self):
+        with open(self.path, "a") as fh:
+            fh.write("2026-13-01,X,Y,-1\n")
+        code, _, err = self.run_cli("monthly", self.path)
+        self.assertEqual(code, 1)
+        self.assertIn(f"{self.path}:6:", err)
+
+    def test_missing_file(self):
+        code, _, err = self.run_cli("monthly", self.path + ".nope")
+        self.assertEqual(code, 2)
+        self.assertIn("error", err)
+
+
+if __name__ == "__main__":
+    unittest.main()
