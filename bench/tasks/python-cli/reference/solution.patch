+"""Loading the TOML budget configuration."""
+from __future__ import annotations
+
+import tomllib
+from dataclasses import dataclass
+from decimal import Decimal
+
+from ledgerstat.errors import FatalError
+
+
+@dataclass(frozen=True)
+class BudgetConfig:
+    budgets: dict[str, Decimal]
+    warn_ratio: Decimal
+
+
+def _number(value: object) -> Decimal | None:
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        return None
+    return Decimal(str(value))
+
+
+def load_config(path: str) -> BudgetConfig:
+    """Read and validate a budget config; raise FatalError with a 'config:' message."""
+    try:
+        with open(path, "rb") as fh:
+            data = tomllib.load(fh)
+    except OSError as exc:
+        raise FatalError(f"config: cannot read {path}: {exc}") from None
+    except tomllib.TOMLDecodeError as exc:
+        raise FatalError(f"config: {path}: invalid TOML: {exc}") from None
+    raw = data.get("budgets")
+    if not isinstance(raw, dict):
+        raise FatalError(f"config: {path}: missing [budgets] table")
+    budgets: dict[str, Decimal] = {}
+    for name, value in raw.items():
+        limit = _number(value)
+        if limit is None or limit < 0:
+            raise FatalError(f"config: invalid budget for {name!r}: {value!r}")
+        budgets[name.strip().lower()] = limit
+    settings = data.get("settings", {})
+    if not isinstance(settings, dict):
+        raise FatalError(f"config: {path}: [settings] must be a table")
+    ratio = _number(settings.get("warn_ratio", 0.8))
+    if ratio is None or not 0 < ratio <= 1:
+        raise FatalError(f"config: invalid warn_ratio: {settings.get('warn_ratio')!r}")
+    return BudgetConfig(budgets, ratio)
