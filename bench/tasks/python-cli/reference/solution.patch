+"""Rendering reports as table, CSV or JSON text."""
+from __future__ import annotations
+
+import csv
+import io
+import json
+from decimal import Decimal
+
+from ledgerstat.reports import Report
+
+FORMATS = ("table", "json", "csv")
+
+
+def format_money(value: Decimal) -> str:
+    """Two decimals, no thousands separator."""
+    return f"{value.quantize(Decimal('0.01')):.2f}"
+
+
+def _cell(value: object) -> str:
+    return format_money(value) if isinstance(value, Decimal) else str(value)
+
+
+def _json_value(value: object) -> object:
+    return float(value.quantize(Decimal("0.01"))) if isinstance(value, Decimal) else value
+
+
+def render_table(report: Report) -> str:
+    """Aligned plain-text table, or 'No transactions.' when empty."""
+    if not report.rows:
+        return "No transactions.\n"
+    header = report.columns
+    body = [[_cell(r[c]) for c in header] for r in report.rows]
+    total = None
+    if report.total is not None:
+        total = ["TOTAL"] + [_cell(report.total[c]) for c in header[1:]]
+    everything = [header] + body + ([total] if total else [])
+    widths = [max(len(line[i]) for line in everything) for i in range(len(header))]
+
+    def fmt(cells: list[str]) -> str:
+        parts = [cell.ljust(w) if col in report.text_columns else cell.rjust(w)
+                 for cell, w, col in zip(cells, widths, header)]
+        return "  ".join(parts).rstrip()
+
+    sep = "  ".join("-" * w for w in widths)
+    lines = [fmt(header), sep] + [fmt(row) for row in body]
+    if total:
+        lines += [sep, fmt(total)]
+    return "\n".join(lines) + "\n"
+
+
+def render_csv(report: Report) -> str:
+    """CSV with a header line and no total."""
+    buf = io.StringIO()
+    writer = csv.writer(buf, lineterminator="\n")
+    writer.writerow(report.columns)
+    for row in report.rows:
+        writer.writerow([_cell(row[c]) for c in report.columns])
+    return buf.getvalue()
+
+
+def render_json(report: Report) -> str:
+    """JSON document keyed by the report name (plus 'total' when present)."""
+    doc: dict[str, object] = {
+        report.name: [{c: _json_value(r[c]) for c in report.columns} for r in report.rows]}
+    if report.total is not None:
+        doc["total"] = {k: _json_value(v) for k, v in report.total.items()}
+    return json.dumps(doc, indent=2) + "\n"
+
+
+def render(report: Report, fmt: str) -> str:
+    """Render a report in the requested format."""
+    return {"table": render_table, "csv": render_csv, "json": render_json}[fmt](report)
