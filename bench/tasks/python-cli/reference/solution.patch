@@ -0,0 +1,93 @@
+"""Report computations. Each report returns a Report with typed rows."""
+from __future__ import annotations
+
+from collections import defaultdict
+from dataclasses import dataclass, field
+from decimal import Decimal
+
+from ledgerstat.config import BudgetConfig
+from ledgerstat.parsing import Transaction
+
+ZERO = Decimal("0")
+
+
+@dataclass
+class Report:
+    name: str
+    columns: list[str]
+    rows: list[dict[str, object]]
+    total: dict[str, object] | None = None
+    text_columns: set[str] = field(default_factory=set)
+
+
+def _sums(transactions: list[Transaction]) -> dict[str, object]:
+    income = sum((t.amount for t in transactions if t.amount > 0), ZERO)
+    expenses = -sum((t.amount for t in transactions if t.amount < 0), ZERO)
+    return {"count": len(transactions), "income": income, "expenses": expenses,
+            "net": income - expenses}
+
+
+def _grouped(transactions: list[Transaction], key) -> dict[str, list[Transaction]]:
+    groups: dict[str, list[Transaction]] = defaultdict(list)
+    for t in transactions:
+        groups[key(t)].append(t)
+    return groups
+
+
+def categories_report(transactions: list[Transaction]) -> Report:
+    """Per-category totals sorted by expenses (desc) then name."""
+    rows = [{"category": c, **_sums(ts)}
+            for c, ts in _grouped(transactions, lambda t: t.category).items()]
+    rows.sort(key=lambda r: (-r["expenses"], r["category"]))
+    return Report("categories", ["category", "count", "income", "expenses", "net"], rows,
+                  _sums(transactions), {"category"})
+
+
+def monthly_report(transactions: list[Transaction]) -> Report:
+    """Per-month totals in chronological order."""
+    groups = _grouped(transactions, lambda t: t.month)
+    rows = [{"month": m, **_sums(groups[m])} for m in sorted(groups)]
+    return Report("months", ["month", "count", "income", "expenses", "net"], rows,
+                  _sums(transactions), {"month"})
+
+
+def merchants_report(transactions: list[Transaction], top: int) -> Report:
+    """The top merchants by expenses."""
+    spending = [t for t in transactions if t.amount < 0]
+    groups = _grouped(spending, lambda t: t.merchant)
+    stats = sorted(((-sum((t.amount for t in ts), ZERO), m, len(ts)) for m, ts in groups.items()),
+                   key=lambda s: (-s[0], s[1]))
+    rows = [{"rank": i, "merchant": m, "count": n, "expenses": e}
+            for i, (e, m, n) in enumerate(stats[:top], start=1)]
+    return Report("merchants", ["rank", "merchant", "count", "expenses"], rows,
+                  None, {"merchant"})
+
+
+def budget_status(budget: Decimal, spent: Decimal, warn_ratio: Decimal) -> str:
+    """Return 'over', 'warning' or 'ok'."""
+    if spent > budget:
+        return "over"
+    if spent >= warn_ratio * budget:
+        return "warning"
+    return "ok"
+
+
+def budget_report(transactions: list[Transaction], config: BudgetConfig,
+                  alerts_only: bool = False) -> Report:
+    """Budget vs. spending for every (month, budgeted category) pair."""
+    months = sorted({t.month for t in transactions})
+    spent: dict[tuple[str, str], Decimal] = defaultdict(lambda: ZERO)
+    for t in transactions:
+        if t.amount < 0:
+            spent[(t.month, t.category)] -= t.amount
+    rows = []
+    for month in months:
+        for category in sorted(config.budgets):
+            limit, used = config.budgets[category], spent[(month, category)]
+            status = budget_status(limit, used, config.warn_ratio)
+            if alerts_only and status == "ok":
+                continue
+            rows.append({"month": month, "category": category, "budget": limit, "spent": used,
+                         "remaining": limit - used, "status": status})
+    return Report("budgets", ["month", "category", "budget", "spent", "remaining", "status"],
+                  rows, None, {"month", "category", "status"})
