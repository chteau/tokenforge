+++ b/test/markdown.test.mjs
@@ -0,0 +1,24 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { renderInline, renderMarkdown } from "../src/markdown.mjs";
+import { escapeHtml } from "../src/escape.mjs";
+
+test("escapeHtml escapes the five special characters", () => {
+  assert.equal(escapeHtml(`<a href="x">&'</a>`), "&lt;a href=&quot;x&quot;&gt;&amp;&#39;&lt;/a&gt;");
+});
+
+test("inline: strong, em, links, code spans", () => {
+  assert.equal(renderInline("**a** *b*"), "<strong>a</strong> <em>b</em>");
+  assert.equal(renderInline("[x *y*](http://e.com?a=1&b=2)"), '<a href="http://e.com?a=1&amp;b=2">x <em>y</em></a>');
