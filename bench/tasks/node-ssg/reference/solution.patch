@@ -0,0 +1,32 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdirSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { build } from "../src/build.mjs";
+
+function site() {
+  const dir = mkdtempSync(join(tmpdir(), "ssg-test-"));
+  mkdirSync(join(dir, "layouts"));
+  mkdirSync(join(dir, "content"));
+  writeFileSync(join(dir, "layouts", "base.html"), "<title>{{ title }}</title>{{ content }}");
+  writeFileSync(join(dir, "content", "a.md"), "---\ntitle: A\ndate: 2024-01-01\ntags: [x]\n---\nHi");
+  writeFileSync(join(dir, "content", "b.md"), "---\ntitle: B\ndate: 2024-02-01\ndraft: true\n---\nHi");
+  return dir;
+}
+
+test("build writes posts, index, tags and feed; drafts optional", () => {
+  const src = site();
+  const out = join(src, "out");
+  assert.deepEqual(build(src, out), { posts: 1, tags: 1 });
+  assert.match(readFileSync(join(out, "index.html"), "utf8"), /\/posts\/a\//);
+  assert.match(readFileSync(join(out, "tags", "x", "index.html"), "utf8"), /Tag: x/);
+  assert.match(readFileSync(join(out, "feed.xml"), "utf8"), /<updated>2024-01-01T00:00:00Z<\/updated>/);
+  const out2 = join(src, "out2");
+  assert.deepEqual(build(src, out2, { drafts: true }), { posts: 2, tags: 1 });
+});
+
+test("missing layout raises exit code 3", () => {
+  const src = mkdtempSync(join(tmpdir(), "ssg-test-"));
+  assert.throws(() => build(src, join(src, "out")), (err) => err.exitCode === 3);
+});
diff --git a/test/frontmatter.test.mjs b/test/frontmatter.test.mjs
new file mode 100644
index 0000000..d8fe74b
--- /dev/null
+++ b/test/frontmatter.test.mjs
@@ -0,0 +1,33 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { parseFrontMatter } from "../src/frontmatter.mjs";
+import { postSlug, slugify } from "../src/slug.mjs";
+import { renderTemplate } from "../src/template.mjs";
+
+test("parses supported keys", () => {
+  const fm = parseFrontMatter("---\ntitle: 'A: b'\ndate: 2024-02-29\ntags: [x, , y ]\ndraft: true\n---\nbody", "a.md");
+  assert.deepEqual(fm, { title: "A: b", date: "2024-02-29", tags: ["x", "y"], draft: true, body: "body" });
+});
+
+test("rejects invalid front matter with the file name", () => {
+  const bad = [
+    "no front matter",
+    "---\ntitle: x\n",
+    "---\ntitle: x\ndate: 2023-02-29\n---\n",
+    "---\ntitle: x\ndate: 2024-01-01\nfoo: 1\n---\n",
+    "---\ntitle: x\ntitle: y\ndate: 2024-01-01\n---\n",
+    "---\ndate: 2024-01-01\n---\n",
+    "---\ntitle: x\ndate: 2024-01-01\ntags: a\n---\n",
+    "---\ntitle: x\ndate: 2024-01-01\ndraft: no\n---\n",
+  ];
+  for (const src of bad) assert.throws(() => parseFrontMatter(src, "bad.md"), /bad\.md/);
+});
+
+test("slugs", () => {
+  assert.equal(slugify("  Hello, World!  "), "hello-world");
+  assert.equal(postSlug("2024-03-01-Hello World!.md"), "hello-world");
+});
+
+test("template substitution is single pass", () => {
+  assert.equal(renderTemplate("{{title}}|{{ content }}|{{ nope }}", { title: "T", content: "{{ title }}" }), "T|{{ title }}|");
+});
diff --git a/test/markdown.test.mjs b/test/markdown.test.mjs
