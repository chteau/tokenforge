--- /dev/null
+++ b/src/slug.mjs
@@ -0,0 +1,10 @@
+/** Lower-case, collapse non [a-z0-9] runs to "-", trim dashes. */
+export function slugify(text) {
+  return String(text).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
+}
+
+/** Slug for a post file name such as "2024-03-01-Hello World!.md". */
+export function postSlug(fileName) {
+  const base = fileName.replace(/\.md$/, "").replace(/^\d{4}-\d{2}-\d{2}-/, "");
+  return slugify(base);
+}
diff --git a/src/template.mjs b/src/template.mjs
new file mode 100644
index 0000000..87bf176
--- /dev/null
+++ b/src/template.mjs
@@ -0,0 +1,6 @@
+/** Single-pass {{ name }} substitution; unknown names become "". */
+export function renderTemplate(template, vars) {
+  return template.replace(/\{\{\s*([A-Za-z0-9_]+)\s*\}\}/g, (_, name) =>
+    Object.hasOwn(vars, name) ? String(vars[name]) : "",
+  );
+}
