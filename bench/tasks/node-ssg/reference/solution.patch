@@ -1 +1,13 @@
 # ssg — a small static site generator
+
+Turns a folder of Markdown posts into a static HTML blog. Plain Node.js, no dependencies.
+
+```
+node bin/ssg.mjs build <src> <out> [--drafts]
+node bin/ssg.mjs --help
+```
+
+Input: `site.json` (optional), `layouts/base.html`, `content/*.md`, `static/**`.
+Output: `posts/<slug>/index.html`, `index.html`, `tags/<tag>/index.html`, `feed.xml` and the static files.
+
+Run the tests with `node --test`.
diff --git a/bin/ssg.mjs b/bin/ssg.mjs
new file mode 100644
index 0000000..7fcb810
--- /dev/null
+++ b/bin/ssg.mjs
@@ -0,0 +1,45 @@
+#!/usr/bin/env node
+import { existsSync, statSync } from "node:fs";
+import { build } from "../src/build.mjs";
+import { SsgError, EXIT_USAGE } from "../src/errors.mjs";
+
+const USAGE = `Usage:
+  ssg build <src> <out> [--drafts]   build the site in <src> into <out>
+  ssg --help                         show this help
+
+Options:
+  --drafts   include posts marked draft: true
+`;
+
+function parseArgs(argv) {
+  if (argv.includes("--help") || argv.includes("-h")) return { help: true };
+  if (argv.length === 0) throw new SsgError("no command given", EXIT_USAGE);
+  const [command, ...rest] = argv;
+  if (command !== "build") throw new SsgError(`unknown command: ${command}`, EXIT_USAGE);
+  const positional = [];
+  let drafts = false;
+  for (const arg of rest) {
+    if (arg === "--drafts") drafts = true;
+    else if (arg.startsWith("-")) throw new SsgError(`unknown option: ${arg}`, EXIT_USAGE);
+    else positional.push(arg);
+  }
+  if (positional.length !== 2) throw new SsgError("build needs exactly <src> and <out>", EXIT_USAGE);
+  const [src, out] = positional;
+  if (!existsSync(src) || !statSync(src).isDirectory()) throw new SsgError(`not a directory: ${src}`, EXIT_USAGE);
+  return { src, out, drafts };
+}
+
+try {
+  const args = parseArgs(process.argv.slice(2));
+  if (args.help) {
+    process.stdout.write(USAGE);
+  } else {
+    const { posts, tags } = build(args.src, args.out, { drafts: args.drafts });
+    process.stdout.write(`built ${posts} posts, ${tags} tags into ${args.out}\n`);
+  }
+} catch (err) {
+  if (!(err instanceof SsgError)) throw err;
+  process.stderr.write(`error: ${err.message}\n`);
+  if (err.exitCode === EXIT_USAGE) process.stderr.write(USAGE);
+  process.exitCode = err.exitCode;
+}
