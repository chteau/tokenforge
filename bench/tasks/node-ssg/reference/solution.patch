diff --git a/src/build.mjs b/src/build.mjs
new file mode 100644
index 0000000..91e38bc
--- /dev/null
+++ b/src/build.mjs
@@ -0,0 +1,89 @@
+import { cpSync, existsSync, mkdirSync, readdirSync, readFileSync, statSync, writeFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { SsgError, EXIT_LAYOUT } from "./errors.mjs";
+import { escapeHtml } from "./escape.mjs";
+import { parseFrontMatter } from "./frontmatter.mjs";
+import { renderMarkdown } from "./markdown.mjs";
+import { postSlug, slugify } from "./slug.mjs";
+import { renderTemplate } from "./template.mjs";
+import { atomFeed, indexContent, postContent, sortPosts, tagContent } from "./pages.mjs";
+
+function readSite(src) {
+  const file = join(src, "site.json");
+  const site = { title: "Untitled Site", url: "" };
+  if (!existsSync(file)) return site;
+  let data;
+  try {
+    data = JSON.parse(readFileSync(file, "utf8"));
+  } catch (err) {
+    throw new SsgError(`site.json: invalid JSON (${err.message})`);
+  }
+  if (data === null || typeof data !== "object" || Array.isArray(data)) {
+    throw new SsgError("site.json: must contain a JSON object");
+  }
+  if (data.title !== undefined) site.title = String(data.title);
+  if (data.url !== undefined) site.url = String(data.url).replace(/\/$/, "");
+  return site;
+}
+
+function readPosts(src) {
+  const dir = join(src, "content");
+  if (!existsSync(dir)) return [];
+  const names = readdirSync(dir).filter((n) => n.endsWith(".md") && statSync(join(dir, n)).isFile()).sort();
+  const bySlug = new Map();
+  const posts = [];
+  for (const name of names) {
+    const meta = parseFrontMatter(readFileSync(join(dir, name), "utf8"), name);
+    const slug = postSlug(name);
+    if (bySlug.has(slug)) throw new SsgError(`${name}: duplicate slug "${slug}" (also used by ${bySlug.get(slug)})`);
+    bySlug.set(slug, name);
+    const seen = new Set();
+    const tags = [];
+    for (const tag of meta.tags) {
+      const s = slugify(tag);
+      if (seen.has(s)) continue;
+      seen.add(s);
+      tags.push({ name: tag, slug: s });
+    }
+    posts.push({ ...meta, slug, tags, html: renderMarkdown(meta.body) });
+  }
+  return posts;
+}
+
+function write(out, rel, text) {
+  const file = join(out, rel);
+  mkdirSync(dirname(file), { recursive: true });
+  writeFileSync(file, text);
+}
+
+/** Build the site in `src` into `out`. Throws SsgError on invalid input. */
+export function build(src, out, { drafts = false } = {}) {
+  const layoutFile = join(src, "layouts", "base.html");
+  if (!existsSync(layoutFile)) throw new SsgError(`missing layout file: ${layoutFile}`, EXIT_LAYOUT);
+  const layout = readFileSync(layoutFile, "utf8");
+  const site = readSite(src);
+  const posts = sortPosts(readPosts(src).filter((p) => drafts || !p.draft));
+
+  const page = (title, content) =>
+    renderTemplate(layout, { title: escapeHtml(title), site_title: escapeHtml(site.title), content });
+
+  mkdirSync(out, { recursive: true });
+  const staticDir = join(src, "static");
+  if (existsSync(staticDir)) cpSync(staticDir, out, { recursive: true });
+
+  for (const post of posts) write(out, join("posts", post.slug, "index.html"), page(post.title, postContent(post)));
+  write(out, "index.html", page(site.title, indexContent(site.title, posts)));
+
+  const tags = new Map();
+  for (const post of posts) {
+    for (const tag of post.tags) {
+      if (!tags.has(tag.slug)) tags.set(tag.slug, { name: tag.name, posts: [] });
+      tags.get(tag.slug).posts.push(post);
+    }
+  }
+  for (const [slug, tag] of tags) {
+    write(out, join("tags", slug, "index.html"), page(`Tag: ${tag.name}`, tagContent(tag.name, tag.posts)));
+  }
+  write(out, "feed.xml", atomFeed(site, posts));
+  return { posts: posts.length, tags: tags.size };
+}
