+/** An error that maps to a process exit code. */
+export class SsgError extends Error {
+  constructor(message, exitCode = 1) {
+    super(message);
+    this.name = "SsgError";
+    this.exitCode = exitCode;
+  }
+}
+
+export const EXIT_CONTENT = 1;
+export const EXIT_USAGE = 2;
+export const EXIT_LAYOUT = 3;
diff --git a/src/escape.mjs b/src/escape.mjs
new file mode 100644
index 0000000..fee113c
--- /dev/null
+++ b/src/escape.mjs
@@ -0,0 +1,6 @@
+const ENTITIES = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" };
+
+/** Escape text for HTML/XML content and attribute values. */
+export function escapeHtml(text) {
+  return String(text).replace(/[&<>"']/g, (ch) => ENTITIES[ch]);
+}
diff --git a/src/frontmatter.mjs b/src/frontmatter.mjs
new file mode 100644
index 0000000..f36e750
--- /dev/null
+++ b/src/frontmatter.mjs
@@ -0,0 +1,62 @@
+import { SsgError } from "./errors.mjs";
+
+const KEYS = new Set(["title", "date", "tags", "draft"]);
+
+function unquote(value) {
+  if (value.length >= 2 && (value[0] === '"' || value[0] === "'") && value.at(-1) === value[0]) {
+    return value.slice(1, -1);
+  }
+  return value;
+}
+
+export function isValidDate(value) {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
+  if (!m) return false;
+  const [y, mo, d] = [Number(m[1]), Number(m[2]), Number(m[3])];
+  const dt = new Date(Date.UTC(y, mo - 1, d));
+  return dt.getUTCFullYear() === y && dt.getUTCMonth() === mo - 1 && dt.getUTCDate() === d;
+}
+
+function parseTags(raw, fail) {
+  if (!raw.startsWith("[") || !raw.endsWith("]")) fail("tags must be a list like [a, b]");
+  return raw.slice(1, -1).split(",").map((t) => t.trim()).filter(Boolean);
+}
+
+/**
+ * Split a post source into front matter and body. Pure: `name` is only used in messages.
+ * Returns { title, date, tags, draft, body }.
+ */
+export function parseFrontMatter(source, name) {
+  const fail = (msg) => {
+    throw new SsgError(`${name}: ${msg}`);
+  };
+  const lines = source.replace(/\r\n?/g, "\n").split("\n");
+  if (lines[0].trimEnd() !== "---") fail("missing front matter (first line must be ---)");
+  const end = lines.findIndex((l, i) => i > 0 && l.trimEnd() === "---");
+  if (end === -1) fail("front matter is not closed with ---");
+
+  const raw = {};
+  for (const line of lines.slice(1, end)) {
+    if (!line.trim()) continue;
+    const idx = line.indexOf(":");
+    if (idx === -1) fail(`invalid front matter line: ${line.trim()}`);
+    const key = line.slice(0, idx).trim();
+    const value = line.slice(idx + 1).trim();
+    if (!KEYS.has(key)) fail(`unknown front matter key: ${key}`);
+    if (Object.hasOwn(raw, key)) fail(`duplicate front matter key: ${key}`);
+    raw[key] = value;
+  }
+
+  const title = raw.title === undefined ? "" : unquote(raw.title);
+  if (!title) fail("missing title");
+  const date = raw.date === undefined ? "" : unquote(raw.date);
+  if (!isValidDate(date)) fail(`missing or invalid date: ${date}`);
+  const tags = raw.tags === undefined ? [] : parseTags(raw.tags, fail);
+  let draft = false;
+  if (raw.draft !== undefined) {
+    const v = unquote(raw.draft);
+    if (v !== "true" && v !== "false") fail(`draft must be true or false: ${v}`);
+    draft = v === "true";
+  }
+  return { title, date, tags, draft, body: lines.slice(end + 1).join("\n") };
+}
diff --git a/src/markdown.mjs b/src/markdown.mjs
new file mode 100644
index 0000000..4c71755
--- /dev/null
+++ b/src/markdown.mjs
@@ -0,0 +1,63 @@
+import { escapeHtml } from "./escape.mjs";
+
+const FENCE = /^```/;
+const HEADING = /^(#{1,6}) (.*)$/;
+const UL_ITEM = /^[-*] (.*)$/;
+const OL_ITEM = /^\d+\. (.*)$/;
+
+/** Render inline Markdown (code spans, links, strong, emphasis) of a text fragment. */
+export function renderInline(text) {
+  const codes = [];
+  let out = escapeHtml(text).replace(/`([^`]+)`/g, (_, code) => {
+    codes.push(`<code>${code}</code>`);
+    return `\u0000${codes.length - 1}\u0000`;
+  });
+  out = out
+    .replace(/\[([^\]]*)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>')
+    .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
+    .replace(/\*(.+?)\*/g, "<em>$1</em>");
+  return out.replace(/\u0000(\d+)\u0000/g, (_, i) => codes[Number(i)]);
+}
+
+function startsBlock(line) {
+  return FENCE.test(line) || HEADING.test(line) || UL_ITEM.test(line) || OL_ITEM.test(line);
+}
+
+/** Render a Markdown body to HTML (blocks joined with "\n"). */
+export function renderMarkdown(source) {
+  const lines = source.replace(/\r\n?/g, "\n").split("\n");
+  const blocks = [];
+  let i = 0;
+  while (i < lines.length) {
+    const line = lines[i];
+    if (!line.trim()) {
+      i++;
+    } else if (FENCE.test(line)) {
+      const lang = line.slice(3).trim();
+      const body = [];
+      i++;
+      while (i < lines.length && lines[i].trimEnd() !== "```") body.push(lines[i++]);
+      i++;
+      const open = lang ? `<pre><code class="language-${escapeHtml(lang)}">` : "<pre><code>";
+      blocks.push(`${open}${escapeHtml(body.join("\n"))}</code></pre>`);
+    } else if (HEADING.test(line)) {
+      const [, hashes, text] = HEADING.exec(line);
+      blocks.push(`<h${hashes.length}>${renderInline(text.trim())}</h${hashes.length}>`);
+      i++;
+    } else if (UL_ITEM.test(line) || OL_ITEM.test(line)) {
+      const re = UL_ITEM.test(line) ? UL_ITEM : OL_ITEM;
+      const tag = re === UL_ITEM ? "ul" : "ol";
+      const items = [];
+      while (i < lines.length && re.test(lines[i])) {
+        items.push(`<li>${renderInline(re.exec(lines[i])[1].trim())}</li>`);
+        i++;
+      }
+      blocks.push(`<${tag}>${items.join("")}</${tag}>`);
+    } else {
+      const para = [];
+      while (i < lines.length && lines[i].trim() && !startsBlock(lines[i])) para.push(lines[i++].trim());
+      blocks.push(`<p>${renderInline(para.join(" "))}</p>`);
+    }
+  }
+  return blocks.join("\n");
+}
diff --git a/src/pages.mjs b/src/pages.mjs
new file mode 100644
index 0000000..e9c9de2
--- /dev/null
+++ b/src/pages.mjs
@@ -0,0 +1,65 @@
+import { escapeHtml } from "./escape.mjs";
+
+/** Sort posts: date descending, then slug ascending. */
+export function sortPosts(posts) {
+  return [...posts].sort((a, b) =>
+    a.date !== b.date ? (a.date < b.date ? 1 : -1) : a.slug < b.slug ? -1 : a.slug > b.slug ? 1 : 0,
+  );
+}
+
+function postItems(posts) {
+  return posts
+    .map(
+      (p) =>
+        `<li><a href="/posts/${p.slug}/">${escapeHtml(p.title)}</a> <time datetime="${p.date}">${p.date}</time></li>`,
+    )
+    .join("\n");
+}
+
+export function postContent(post) {
+  const parts = [
+    "<article>",
+    `<h1>${escapeHtml(post.title)}</h1>`,
+    `<p class="meta"><time datetime="${post.date}">${post.date}</time></p>`,
+  ];
+  if (post.tags.length) {
+    const items = post.tags.map((t) => `<li><a href="/tags/${t.slug}/">${escapeHtml(t.name)}</a></li>`);
+    parts.push(`<ul class="tags">${items.join("")}</ul>`);
+  }
+  parts.push(post.html, "</article>");
+  return parts.join("\n");
+}
+
+export function indexContent(siteTitle, posts) {
+  return `<h1>${escapeHtml(siteTitle)}</h1>\n<ul class="posts">\n${postItems(posts)}\n</ul>`;
+}
+
+export function tagContent(name, posts) {
+  return `<h1>Tag: ${escapeHtml(name)}</h1>\n<ul class="posts">\n${postItems(posts)}\n</ul>`;
+}
+
+export function atomFeed(site, posts) {
+  const url = site.url;
+  const entries = posts.slice(0, 10).map((p) =>
+    [
+      "<entry>",
+      `<title>${escapeHtml(p.title)}</title>`,
+      `<link href="${escapeHtml(url)}/posts/${p.slug}/"/>`,
+      `<id>${escapeHtml(url)}/posts/${p.slug}/</id>`,
+      `<updated>${p.date}T00:00:00Z</updated>`,
+      "</entry>",
+    ].join("\n"),
+  );
+  const updated = posts.length ? posts[0].date : "1970-01-01";
+  return [
+    '<?xml version="1.0" encoding="utf-8"?>',
+    '<feed xmlns="http://www.w3.org/2005/Atom">',
+    `<title>${escapeHtml(site.title)}</title>`,
+    `<link href="${escapeHtml(url)}/"/>`,
+    `<id>${escapeHtml(url)}/</id>`,
+    `<updated>${updated}T00:00:00Z</updated>`,
+    ...entries,
+    "</feed>",
+    "",
+  ].join("\n");
+}
diff --git a/src/slug.mjs b/src/slug.mjs
new file mode 100644
