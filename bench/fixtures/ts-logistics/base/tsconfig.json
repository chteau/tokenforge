{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "lib": ["es2023"]
  },
  "include": ["types/**/*.d.ts", "packages/**/*.ts", "services/**/*.ts", "tools/**/*.ts"]
}
