diff --git a/internal/services/exports.go b/internal/services/exports.go
new file mode 100644
index 0000000..59bc3c6
--- /dev/null
+++ b/internal/services/exports.go
@@ -0,0 +1,248 @@
+package services
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/csv"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"strconv"
+	"time"
+
+	"github.com/acme/meridian/internal/apperr"
+	"github.com/acme/meridian/internal/auth"
+	"github.com/acme/meridian/internal/billing"
+	"github.com/acme/meridian/internal/clock"
+	"github.com/acme/meridian/internal/exports"
+	"github.com/acme/meridian/internal/repositories"
+	"github.com/acme/meridian/internal/validation"
+	"github.com/acme/meridian/pkg/ids"
+)
+
+// FlagInvoiceExports gates the export endpoints.
+const FlagInvoiceExports = "invoice_exports"
+
+const maxExportRange = 366 * 24 * time.Hour
+
+var errExportNotFound = apperr.NotFound("export_not_found", "export not found")
+
+// ExportService produces CSV exports of invoices in the background.
+type ExportService struct {
+	invoices repositories.InvoiceRepository
+	flags    *FlagService
+	audit    *AuditService
+	clock    clock.Clock
+	logger   *slog.Logger
+	dir      string
+	secret   []byte
+	linkTTL  time.Duration
+
+	jobs map[string]*exports.Job
+}
+
+// ExportConfig configures where exports are written and how download links are signed.
+type ExportConfig struct {
+	Dir     string
+	Secret  []byte
+	LinkTTL time.Duration
+}
+
+// NewExportService returns an ExportService.
+func NewExportService(invoices repositories.InvoiceRepository, flagSvc *FlagService, auditSvc *AuditService, clk clock.Clock, logger *slog.Logger, cfg ExportConfig) *ExportService {
+	return &ExportService{
+		invoices: invoices, flags: flagSvc, audit: auditSvc, clock: clk, logger: logger,
+		dir: cfg.Dir, secret: cfg.Secret, linkTTL: cfg.LinkTTL,
+		jobs: map[string]*exports.Job{},
+	}
+}
+
+// InvoiceExportInput selects the invoices to export. From and To are
+// calendar dates (YYYY-MM-DD) and both are inclusive.
+type InvoiceExportInput struct {
+	CustomerID string `json:"customer_id"`
+	From       string `json:"from"`
+	To         string `json:"to"`
+	FileName   string `json:"file_name"`
+}
+
+// RequestInvoiceExport queues an export of invoices created in the date range.
+func (s *ExportService) RequestInvoiceExport(ctx context.Context, p auth.Principal, in InvoiceExportInput) (exports.Job, error) {
+	if !s.flags.IsEnabled(ctx, FlagInvoiceExports, p.UserID) {
+		return exports.Job{}, apperr.Forbidden("feature_disabled", "invoice exports are not enabled for this account")
+	}
+	from, errFrom := time.Parse(time.DateOnly, in.From)
+	to, errTo := time.Parse(time.DateOnly, in.To)
+	v := validation.New()
+	v.Check(errFrom == nil, "from", "must be a date in YYYY-MM-DD format")
+	v.Check(errTo == nil, "to", "must be a date in YYYY-MM-DD format")
+	if errFrom == nil && errTo == nil {
+		v.Check(!to.Before(from), "to", "must not be before from")
+		v.Check(to.Sub(from) <= maxExportRange, "to", "range must not exceed one year")
+	}
+	v.MaxLen("file_name", in.FileName, 100)
+	if err := v.Err(); err != nil {
+		return exports.Job{}, err
+	}
+
+	customerID := p.UserID
+	if in.CustomerID != "" {
+		customerID = in.CustomerID
+	}
+	job := &exports.Job{
+		ID:          ids.New("exp"),
+		RequestedBy: p.UserID,
+		CustomerID:  customerID,
+		From:        from,
+		To:          to,
+		Status:      exports.StatusPending,
+		FileName:    in.FileName,
+		CreatedAt:   s.clock.Now(),
+	}
+	if job.FileName == "" {
+		job.FileName = "invoices-" + in.From + "-" + in.To
+	}
+	job.SetPath(filepath.Join(s.dir, job.FileName+".csv"))
+	s.jobs[job.ID] = job
+
+	if err := s.audit.Record(ctx, p.UserID, "invoice.export_requested", "export", job.ID, map[string]string{
+		"customer_id": customerID, "from": in.From, "to": in.To,
+	}); err != nil {
+		return exports.Job{}, err
+	}
+	go s.run(job)
+	return *job, nil
+}
+
+func (s *ExportService) run(job *exports.Job) {
+	ctx := context.Background()
+	rows, err := s.writeCSV(ctx, job)
+	now := s.clock.Now()
+	job.CompletedAt = &now
+	if err != nil {
+		s.logger.ErrorContext(ctx, "invoice export failed", "export_id", job.ID, "err", err)
+		job.Status = exports.StatusFailed
+		return
+	}
+	job.Rows = rows
+	job.Status = exports.StatusCompleted
+}
+
+func (s *ExportService) writeCSV(ctx context.Context, job *exports.Job) (int, error) {
+	list, err := s.invoices.List(ctx, repositories.InvoiceFilter{CustomerID: job.CustomerID})
+	if err != nil {
+		return 0, err
+	}
+	if err := os.MkdirAll(s.dir, 0o750); err != nil {
+		return 0, err
+	}
+	f, err := os.Create(job.Path())
+	if err != nil {
+		return 0, err
+	}
+	defer f.Close()
+
+	w := csv.NewWriter(f)
+	_ = w.Write([]string{"number", "status", "currency", "subtotal", "tax", "total", "paid", "issued_at", "due_at"})
+	rows := 0
+	for _, inv := range list {
+		if inv.CreatedAt.Before(job.From) || !inv.CreatedAt.Before(job.To) {
+			continue
+		}
+		if err := w.Write(invoiceRecord(inv)); err != nil {
+			return rows, err
+		}
+		rows++
+	}
+	w.Flush()
+	return rows, w.Error()
+}
+
+func invoiceRecord(inv billing.Invoice) []string {
+	return []string{
+		csvSafe(inv.Number),
+		string(inv.Status),
+		inv.Currency,
+		centsToDecimal(inv.SubtotalCents),
+		centsToDecimal(inv.TaxCents),
+		centsToDecimal(inv.TotalCents),
+		centsToDecimal(inv.PaidCents),
+		formatOptionalTime(inv.IssuedAt),
+		formatOptionalTime(inv.DueAt),
+	}
+}
+
+// csvSafe neutralises values that spreadsheet applications would evaluate as formulas.
+func csvSafe(s string) string {
+	if s != "" && (s[0] == '=' || s[0] == '+' || s[0] == '-' || s[0] == '@') {
+		return "'" + s
+	}
+	return s
+}
+
+func centsToDecimal(c int64) string {
+	sign := ""
+	if c < 0 {
+		sign, c = "-", -c
+	}
+	return fmt.Sprintf("%s%d.%02d", sign, c/100, c%100)
+}
+
+func formatOptionalTime(t *time.Time) string {
+	if t == nil {
+		return ""
+	}
+	return t.UTC().Format(time.RFC3339)
+}
+
+// GetExport returns an export job. The requester and billing admins can see it.
+func (s *ExportService) GetExport(ctx context.Context, p auth.Principal, id string) (exports.Job, error) {
+	job, ok := s.jobs[id]
+	if !ok || (job.RequestedBy != p.UserID && !p.Is(auth.RoleBillingAdmin)) {
+		return exports.Job{}, errExportNotFound
+	}
+	out := *job
+	if out.Status == exports.StatusCompleted {
+		out.DownloadURL = s.downloadURL(job.ID)
+	}
+	return out, nil
+}
+
+func (s *ExportService) downloadURL(id string) string {
+	var expires int64
+	if s.linkTTL > 0 {
+		expires = s.clock.Now().Add(s.linkTTL).Unix()
+	}
+	return fmt.Sprintf("/v1/exports/%s/download?expires=%d&sig=%s", id, expires, s.sign(id, expires))
+}
+
+func (s *ExportService) sign(id string, expires int64) string {
+	mac := hmac.New(sha256.New, s.secret)
+	mac.Write([]byte(id + ":" + strconv.FormatInt(expires, 10)))
+	return hex.EncodeToString(mac.Sum(nil))
+}
+
+// OpenDownload verifies a signed download link and opens the export file.
+// The caller must close the returned reader.
+func (s *ExportService) OpenDownload(ctx context.Context, id string, expires int64, sig string) (io.ReadCloser, string, error) {
+	expected := s.sign(id, expires)
+	if !hmac.Equal([]byte(sig), []byte(expected)) {
+		return nil, "", apperr.Forbidden("invalid_signature", fmt.Sprintf("signature mismatch: got %s, expected %s", sig, expected))
+	}
+	if expires != 0 && s.clock.Now().Unix() > expires {
+		return nil, "", apperr.Forbidden("link_expired", "the download link has expired")
+	}
+	job, ok := s.jobs[id]
+	if !ok || job.Status != exports.StatusCompleted {
+		return nil, "", errExportNotFound
+	}
+	f, err := os.Open(job.Path())
+	if err != nil {
+		return nil, "", fmt.Errorf("open export %s: %w", id, err)
+	}
+	return f, job.FileName + ".csv", nil
+}
