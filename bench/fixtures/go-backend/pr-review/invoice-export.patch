@@ -0,0 +1,115 @@
+package services
+
+import (
+	"context"
+	"io"
+	"log/slog"
+	"net/url"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/acme/meridian/internal/apperr"
+	"github.com/acme/meridian/internal/auth"
+	"github.com/acme/meridian/internal/exports"
+	"github.com/acme/meridian/internal/flags"
+	"github.com/acme/meridian/internal/repositories"
+)
+
+func newExportFixture(t *testing.T) (*ExportService, *billingFixture) {
+	t.Helper()
+	bf := newBillingFixture(t)
+	flagRepo := repositories.NewMemoryFlags()
+	_ = flagRepo.Put(context.Background(), flags.Flag{Key: FlagInvoiceExports, Enabled: true, RolloutPercent: 100})
+	auditSvc := NewAuditService(repositories.NewMemoryAudit(), bf.clock)
+	svc := NewExportService(bf.invoices, NewFlagService(flagRepo, auditSvc, bf.clock), auditSvc, bf.clock,
+		slog.New(slog.NewTextHandler(io.Discard, nil)), ExportConfig{Dir: t.TempDir(), Secret: []byte("export-secret"), LinkTTL: time.Hour})
+	return svc, bf
+}
+
+func waitForExport(t *testing.T, svc *ExportService, p auth.Principal, id string) exports.Job {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		job, err := svc.GetExport(context.Background(), p, id)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if job.Status != exports.StatusPending {
+			return job
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatal("export did not finish")
+	return exports.Job{}
+}
+
+func TestInvoiceExport(t *testing.T) {
+	svc, bf := newExportFixture(t)
+	ctx := context.Background()
+	bf.openInvoice(t, 1250) // created 2026-05-01
+	bf.clock.Advance(3 * 24 * time.Hour)
+	bf.openInvoice(t, 990) // created 2026-05-04
+
+	job, err := svc.RequestInvoiceExport(ctx, bf.customer, InvoiceExportInput{From: "2026-04-01", To: "2026-05-31"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if job.Status != exports.StatusPending || job.CustomerID != "usr_c" {
+		t.Fatalf("job = %+v", job)
+	}
+	done := waitForExport(t, svc, bf.customer, job.ID)
+	if done.Status != exports.StatusCompleted || done.Rows != 2 {
+		t.Fatalf("done = %+v", done)
+	}
+
+	u, err := url.Parse(done.DownloadURL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	expires, _ := strconv.ParseInt(u.Query().Get("expires"), 10, 64)
+	f, name, err := svc.OpenDownload(ctx, job.ID, expires, u.Query().Get("sig"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	data, _ := io.ReadAll(f)
+	lines := strings.Split(strings.TrimSpace(string(data)), "\n")
+	if name != "invoices-2026-04-01-2026-05-31.csv" || len(lines) != 3 || !strings.HasPrefix(lines[0], "number,status") {
+		t.Fatalf("name=%s csv=%q", name, data)
+	}
+	if !strings.Contains(string(data), ",12.50,") {
+		t.Fatalf("amounts not formatted: %q", data)
+	}
+
+	if _, _, err := svc.OpenDownload(ctx, job.ID, expires, "deadbeef"); apperr.KindOf(err) != apperr.KindForbidden {
+		t.Fatalf("bad signature: %v", err)
+	}
+	stranger := auth.Principal{UserID: "usr_x", Role: auth.RoleUser}
+	if _, err := svc.GetExport(ctx, stranger, job.ID); apperr.KindOf(err) != apperr.KindNotFound {
+		t.Fatalf("stranger: %v", err)
+	}
+}
