diff --git a/internal/exports/exports.go b/internal/exports/exports.go
new file mode 100644
index 0000000..fbe6400
--- /dev/null
+++ b/internal/exports/exports.go
@@ -0,0 +1,36 @@
+// Package exports defines asynchronous data export jobs.
+package exports
+
+import "time"
+
+// Status is the lifecycle state of an export job.
+type Status string
+
+const (
+	StatusPending   Status = "pending"
+	StatusCompleted Status = "completed"
+	StatusFailed    Status = "failed"
+)
+
+// Job is a requested export of invoices to a CSV file.
+type Job struct {
+	ID          string     `json:"id"`
+	RequestedBy string     `json:"requested_by"`
+	CustomerID  string     `json:"customer_id"`
+	From        time.Time  `json:"from"`
+	To          time.Time  `json:"to"`
+	Status      Status     `json:"status"`
+	Rows        int        `json:"rows"`
+	FileName    string     `json:"file_name"`
+	DownloadURL string     `json:"download_url,omitempty"`
+	CreatedAt   time.Time  `json:"created_at"`
+	CompletedAt *time.Time `json:"completed_at,omitempty"`
+
+	path string
+}
+
+// Path returns the location of the generated file on disk.
+func (j *Job) Path() string { return j.path }
+
+// SetPath records where the generated file is stored.
+func (j *Job) SetPath(p string) { j.path = p }
diff --git a/internal/handlers/exports.go b/internal/handlers/exports.go
new file mode 100644
index 0000000..8a0a40a
--- /dev/null
+++ b/internal/handlers/exports.go
@@ -0,0 +1,59 @@
+package handlers
+
+import (
+	"io"
+	"net/http"
+	"strconv"
+
+	"github.com/acme/meridian/internal/services"
+	"github.com/acme/meridian/pkg/httpx"
+)
+
+type exportHandler struct {
+	responder
+	exports *services.ExportService
+}
+
+func (h *exportHandler) createInvoiceExport(w http.ResponseWriter, r *http.Request) {
+	var in services.InvoiceExportInput
+	if !h.decode(w, r, &in) {
+		return
+	}
+	job, err := h.exports.RequestInvoiceExport(r.Context(), principal(r), in)
+	if err != nil {
+		httpx.WriteError(w, http.StatusInternalServerError, httpx.ErrorDetail{Code: "export_failed", Message: err.Error()})
+		return
+	}
+	httpx.WriteJSON(w, http.StatusAccepted, job)
+}
+
+func (h *exportHandler) get(w http.ResponseWriter, r *http.Request) {
+	job, err := h.exports.GetExport(r.Context(), principal(r), r.PathValue("id"))
+	if err != nil {
+		h.fail(w, r, err)
+		return
+	}
+	httpx.WriteJSON(w, http.StatusOK, job)
+}
+
+// download serves a finished export. It is authorised by the signed link
+// returned from GET /v1/exports/{id}, so it does not require a bearer token.
+func (h *exportHandler) download(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	expires, err := strconv.ParseInt(q.Get("expires"), 10, 64)
+	if err != nil {
+		httpx.WriteError(w, http.StatusBadRequest, httpx.ErrorDetail{Code: "invalid_link", Message: "malformed download link"})
+		return
+	}
+	f, name, err := h.exports.OpenDownload(r.Context(), r.PathValue("id"), expires, q.Get("sig"))
+	if err != nil {
+		h.fail(w, r, err)
+		return
+	}
+	defer f.Close()
+	w.Header().Set("Content-Type", "text/csv; charset=utf-8")
+	w.Header().Set("Content-Disposition", `attachment; filename="`+name+`"`)
+	if _, err := io.Copy(w, f); err != nil {
+		h.logger.WarnContext(r.Context(), "export download interrupted", "err", err)
+	}
+}
