@@ -0,0 +1,50 @@
+use super::Context;
+use crate::cli::BudgetArgs;
+use crate::error::{Error, Result};
+use crate::model::validate;
+use crate::output::{Cell, Column, Table};
+use crate::report;
+use crate::util::Date;
+
+pub fn run(ctx: &mut Context, args: BudgetArgs) -> Result<()> {
+    let store = ctx.store()?;
+    match args {
+        BudgetArgs::Set { category, amount } => {
+            let category = validate::category(&category)?;
+            let amount = validate::amount(amount)?;
+            let mut budgets = store.load_budgets()?;
+            budgets.insert(category.clone(), amount);
+            store.save_budgets(&budgets)?;
+            ctx.say(&format!(
+                "set budget for '{category}' to {}",
+                amount.to_decimal()
+            ))
+        }
+        BudgetArgs::List => {
+            let mut table = Table::new(vec![Column::left("category"), Column::right("limit")]);
+            for (category, limit) in store.load_budgets()? {
+                table.push(vec![Cell::text(category), Cell::Money(limit)]);
+            }
+            ctx.render(&table)
+        }
+        BudgetArgs::Remove { category } => {
+            let category = category.trim().to_lowercase();
+            let mut budgets = store.load_budgets()?;
+            if budgets.remove(&category).is_none() {
+                return Err(Error::NotFound(format!(
+                    "no budget for category '{category}'"
+                )));
+            }
+            store.save_budgets(&budgets)?;
+            ctx.say(&format!("removed budget for '{category}'"))
+        }
+        BudgetArgs::Status { month } => {
+            let month = month.unwrap_or_else(|| Date::today_utc().year_month());
+            let budgets = store.load_budgets()?;
+            let ledger = store.load()?;
+            let warn_percent = ctx.config.get_count("budget.warn_percent");
+            let table = report::budget_status(&budgets, &ledger.entries, month, warn_percent);
+            ctx.render(&table)
+        }
+    }
+}
