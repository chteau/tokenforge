+#[test]
+fn status_warn_percent_from_config_and_env() {
+    let t = sample();
+    t.write("config.ini", "[budget]\nwarn_percent = 90\n");
+    let csv = t.ok(&["budget", "status", "--month", "2026-03", "--format", "csv"]);
+    assert!(
+        csv.contains("groceries,300.00,240.00,60.00,80.0%,ok\n"),
+        "{csv}"
+    );
+    let cfg = t.ok(&["config", "--format", "csv"]);
+    assert!(cfg.contains("budget.warn_percent,90,file\n"), "{cfg}");
+
+    let t = t.env("TALLY_BUDGET_WARN_PERCENT", "50");
+    let csv = t.ok(&["budget", "status", "--month", "2026-03", "--format", "csv"]);
+    assert!(csv.contains("80.0%,warning\n"), "{csv}");
+
+    let t = t.env("TALLY_BUDGET_WARN_PERCENT", "lots");
+    let (code, err) = t.fail(&["budget", "status"]);
+    assert_eq!(code, 1);
+    assert!(
+        err.contains("budget.warn_percent: expected a whole number"),
+        "{err}"
+    );
+}
+
+#[test]
+fn status_defaults_to_current_month() {
+    let t = sample();
+    let csv = t.ok(&["budget", "status", "--format", "csv"]);
+    // No sample entry falls in the current month.
+    assert!(
+        csv.contains("groceries,300.00,0.00,300.00,0.0%,ok\n"),
+        "{csv}"
+    );
+}
