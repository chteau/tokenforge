+#[test]
+fn usage_and_init_errors() {
+    let t = Tally::new();
+    for args in [
+        &["budget"][..],
+        &["budget", "show"],
+        &["budget", "set", "food"],
+        &["budget", "set", "food", "1", "2"],
+        &["budget", "list", "x"],
+        &["budget", "remove"],
+        &["budget", "status", "--month", "2026-13"],
+        &["budget", "status", "extra"],
+    ] {
+        assert_eq!(t.fail(args).0, 2, "{args:?}");
+    }
+    assert!(t
+        .ok(&["help", "budget"])
+        .starts_with("usage: tally budget set"));
+    assert!(t.ok(&["help"]).contains("budget"));
+
+    let bare = Tally::bare();
+    let expected = bare.fail(&["list"]);
+    for args in [
+        &["budget", "set", "food", "1"][..],
+        &["budget", "list"],
+        &["budget", "remove", "food"],
+        &["budget", "status"],
+    ] {
+        assert_eq!(bare.fail(args), expected, "{args:?}");
+    }
+    assert!(!bare.dir.join("budgets.txt").exists());
+}
