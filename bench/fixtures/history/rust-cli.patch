@@ -0,0 +1,99 @@
+//! Monthly budgets, stored in `budgets.txt` next to the ledger.
+//!
+//! ```text
+//! # tally budgets v1
+//! eating-out|100.00
+//! groceries|300.00
+//! ```
+//!
+//! One `category|limit` pair per line, escaped like the ledger (see
+//! [`codec`](super::codec)). Blank lines and lines starting with `#` are
+//! ignored.
+
+use std::collections::BTreeMap;
+use std::path::Path;
+
+use super::codec;
+use crate::error::Error;
+use crate::error::Result;
+use crate::model::validate;
+use crate::util::Money;
+
+pub const BUDGETS_FILE: &str = "budgets.txt";
+pub const HEADER: &str = "# tally budgets v1";
+
+/// Monthly limit per category, ordered by category.
+pub type Budgets = BTreeMap<String, Money>;
+
+pub fn parse_budgets(text: &str, path: &Path) -> Result<Budgets> {
+    let mut budgets = Budgets::new();
+    for (idx, raw) in text.lines().enumerate() {
+        let line = raw.trim_end_matches('\r');
+        if line.trim().is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let corrupt = |message: String| Error::Corrupt {
+            path: path.to_path_buf(),
+            line: idx + 1,
+            message,
+        };
+        let fields = codec::split_fields(line).map_err(corrupt)?;
+        let [category, limit] = fields.as_slice() else {
+            return Err(corrupt(format!(
+                "expected 2 fields, found {}",
+                fields.len()
+            )));
+        };
+        let category = validate::category(category).map_err(|e| corrupt(e.to_string()))?;
+        let limit = Money::parse(limit)
+            .map_err(&corrupt)
+            .and_then(|m| validate::amount(m).map_err(|e| corrupt(e.to_string())))?;
+        if budgets.insert(category.clone(), limit).is_some() {
+            return Err(corrupt(format!("duplicate budget for '{category}'")));
+        }
+    }
+    Ok(budgets)
+}
+
+pub fn render_budgets(budgets: &Budgets) -> String {
+    let mut out = String::new();
+    out.push_str(HEADER);
+    out.push('\n');
+    for (category, limit) in budgets {
+        out.push_str(&codec::join_fields(&[
+            category.as_str(),
+            &limit.to_decimal(),
+        ]));
+        out.push('\n');
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn round_trips_through_text() {
+        let mut b = Budgets::new();
+        b.insert("rent".to_string(), Money(120_000));
+        b.insert("groceries".to_string(), Money(30_050));
+        let text = render_budgets(&b);
+        assert_eq!(text, "# tally budgets v1\ngroceries|300.50\nrent|1200.00\n");
+        assert_eq!(parse_budgets(&text, Path::new("b")).unwrap(), b);
+    }
+
+    #[test]
+    fn rejects_bad_lines() {
+        for text in [
+            "food\n",
+            "food|abc\n",
+            "Bad Cat|1\n",
+            "food|0\n",
+            "a|1\na|2\n",
+        ] {
+            let err = parse_budgets(text, Path::new("b")).unwrap_err();
+            assert!(matches!(err, Error::Corrupt { .. }), "{text}: {err}");
+        }
+    }
+}
