+/// Each budget compared with the expenses of `month`, with a totals footer.
+/// A category is `warning` once spending reaches `warn_percent` % of its limit.
+pub fn budget_status(
+    budgets: &Budgets,
+    entries: &[Entry],
+    month: YearMonth,
+    warn_percent: usize,
+) -> Table {
+    let mut spent: BTreeMap<&str, Money> = BTreeMap::new();
+    for e in entries {
+        if e.kind == Kind::Expense && month.contains(e.date) {
+            *spent.entry(e.category.as_str()).or_default() += e.amount;
+        }
+    }
+
+    let mut table = Table::new(vec![
+        Column::left("category"),
+        Column::right("limit"),
+        Column::right("spent"),
+        Column::right("remaining"),
+        Column::right("used"),
+        Column::left("status"),
+    ]);
+    let (mut total_limit, mut total_spent) = (Money::ZERO, Money::ZERO);
+    for (category, &limit) in budgets {
+        let spent = spent.get(category.as_str()).copied().unwrap_or_default();
+        let status = if spent > limit {
+            "over"
+        } else if i128::from(spent.cents()) * 100
+            >= i128::from(limit.cents()) * warn_percent as i128
+        {
+            "warning"
+        } else {
+            "ok"
+        };
+        table.push(vec![
+            Cell::text(category.clone()),
+            Cell::Money(limit),
+            Cell::Money(spent),
+            Cell::Money(limit - spent),
+            Cell::Percent(percent_tenths(spent.cents(), limit.cents())),
+            Cell::text(status),
+        ]);
+        total_limit += limit;
+        total_spent += spent;
+    }
+    table.footer = Some(vec![
+        Cell::text("total"),
+        Cell::Money(total_limit),
+        Cell::Money(total_spent),
+        Cell::Money(total_limit - total_spent),
+        Cell::Percent(percent_tenths(total_spent.cents(), total_limit.cents())),
+        Cell::Empty,
+    ]);
+    table
+}
+
