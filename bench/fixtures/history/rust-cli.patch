+mod common;
+
+use common::Tally;
+
+fn sample() -> Tally {
+    let t = Tally::new();
+    t.ok(&["budget", "set", "Groceries", "300"]);
+    t.ok(&["budget", "set", "eating-out", "100"]);
+    t.ok(&["budget", "set", "rent", "1200"]);
+    t.ok(&["add", "2026-03-02", "240", "groceries"]);
+    t.ok(&["add", "2026-03-05", "45", "eating-out"]);
+    t.ok(&["add", "2026-03-20", "80", "eating-out"]);
+    t.ok(&["add", "2026-03-21", "60", "groceries", "--income"]);
+    t.ok(&["add", "2026-03-25", "2500", "salary", "--income"]);
+    t.ok(&["add", "2026-02-28", "999", "groceries"]);
+    t
+}
+
+#[test]
+fn set_normalises_and_replaces() {
+    let t = Tally::new();
+    assert_eq!(
+        t.ok(&["budget", "set", " Groceries ", "300"]),
+        "set budget for 'groceries' to 300.00\n"
+    );
+    t.ok(&["budget", "set", "groceries", "250.5"]);
+    assert_eq!(
+        t.ok(&["budget", "list", "--format", "csv"]),
+        "category,limit\ngroceries,250.50\n"
+    );
+    assert_eq!(
+        t.read("budgets.txt"),
+        "# tally budgets v1\ngroceries|250.50\n"
+    );
+    assert!(!t.read("ledger.txt").contains("groceries"));
+}
+
+#[test]
+fn set_rejects_like_add() {
+    let t = Tally::new();
+    for (args, code) in [
+        (["budget", "set", "bad cat", "1"], 1),
+        (["budget", "set", "food", "0"], 1),
+        (["budget", "set", "food", "-5"], 1),
+        (["budget", "set", "food", "1000000.01"], 1),
+        (["budget", "set", "food", "1.234"], 2),
+    ] {
+        let (got, err) = t.fail(&args);
+        let add = t.fail(&["add", "2026-01-01", args[3], args[2]]);
+        assert_eq!((got, err), add, "{args:?}");
+        assert_eq!(got, code, "{args:?}");
+    }
+    t.ok(&["budget", "set", "food", "1000000.00"]);
+}
+
+#[test]
+fn list_formats() {
+    let t = sample();
+    let expected = "\
+CATEGORY       LIMIT
+eating-out   $100.00
+groceries    $300.00
+rent        $1200.00
+";
+    assert_eq!(t.ok(&["budget", "list"]), expected);
+    assert_eq!(
+        t.ok(&["budget", "list", "--format", "csv"]),
+        "category,limit\neating-out,100.00\ngroceries,300.00\nrent,1200.00\n"
+    );
+    let empty = Tally::new();
+    assert_eq!(empty.ok(&["budget", "list"]), "(no rows)\n");
+    assert_eq!(empty.ok(&["budget", "list", "--format", "json"]), "[]\n");
+    assert_eq!(
+        empty.ok(&["budget", "list", "--format", "csv"]),
+        "category,limit\n"
+    );
+    let t = t.env("TALLY_OUTPUT_FORMAT", "csv");
+    assert!(t.ok(&["budget", "list"]).starts_with("category,limit\n"));
+}
+
+#[test]
+fn remove_budget() {
+    let t = sample();
+    assert_eq!(
+        t.ok(&["budget", "remove", " Groceries"]),
+        "removed budget for 'groceries'\n"
+    );
+    let (code, err) = t.fail(&["budget", "remove", "groceries"]);
+    assert_eq!(code, 3);
+    assert!(err.contains("no budget for category 'groceries'"), "{err}");
+    assert!(!t.ok(&["budget", "list"]).contains("groceries"));
+}
+
+#[test]
+fn status_all_formats() {
+    let t = sample();
+    let expected = "\
+CATEGORY       LIMIT    SPENT  REMAINING    USED  STATUS
+eating-out   $100.00  $125.00    -$25.00  125.0%  over
+groceries    $300.00  $240.00     $60.00   80.0%  warning
+rent        $1200.00    $0.00   $1200.00    0.0%  ok
+---------------------------------------------------------
+total       $1600.00  $365.00   $1235.00   22.8%
+";
+    assert_eq!(t.ok(&["budget", "status", "--month", "2026-03"]), expected);
+    assert_eq!(
+        t.ok(&["budget", "status", "--month", "2026-03", "--format", "csv"]),
+        "\
+category,limit,spent,remaining,used,status
+eating-out,100.00,125.00,-25.00,125.0%,over
+groceries,300.00,240.00,60.00,80.0%,warning
+rent,1200.00,0.00,1200.00,0.0%,ok
+"
+    );
+    assert_eq!(
+        t.ok(&["budget", "status", "--month", "2026-03", "--format", "json"]),
+        r#"[
+  {"category": "eating-out", "limit": 100.00, "spent": 125.00, "remaining": -25.00, "used": 125.0, "status": "over"},
+  {"category": "groceries", "limit": 300.00, "spent": 240.00, "remaining": 60.00, "used": 80.0, "status": "warning"},
+  {"category": "rent", "limit": 1200.00, "spent": 0.00, "remaining": 1200.00, "used": 0.0, "status": "ok"}
+]
+"#
+    );
+}
