+#[test]
+fn rename_category_moves_budget() {
+    let t = sample();
+    t.ok(&["rename-category", "eating-out", "dining"]);
+    let csv = t.ok(&["budget", "list", "--format", "csv"]);
+    assert_eq!(
+        csv,
+        "category,limit\ndining,100.00\ngroceries,300.00\nrent,1200.00\n"
+    );
+
+    // The target keeps its own budget; the old one is dropped.
+    t.ok(&["rename-category", "dining", "groceries"]);
+    let csv = t.ok(&["budget", "list", "--format", "csv"]);
+    assert_eq!(csv, "category,limit\ngroceries,300.00\nrent,1200.00\n");
+}
