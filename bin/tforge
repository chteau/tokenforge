#!/usr/bin/env node
import { spawn } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { EXAMPLE_PLAN, loadPlan, planPath, topoOrder } from '../lib/plan.mjs';
import { buildSystemPrompt, buildTaskPrompt, runPlan } from '../lib/runner.mjs';
import { commandCosts } from '../lib/insights.mjs';
import { formatLedger, formatSessions, listTranscripts, meterLedger, meterSessions } from '../lib/meter.mjs';
import { FORGE_DIR, fmtUsd, projectRoot, readJson, spawnable } from '../lib/util.mjs';
import { TERSE_LEVELS, configFile, terseLevel, writeConfig } from '../lib/config.mjs';
import { installStatusline, removeStatusline } from '../lib/limits.mjs';
import { LEAN_DENY, leanOff, leanOn, leanStatus } from '../lib/lean.mjs';
import { buildIndex, formatRecall, recall, sessionDetail } from '../lib/memory.mjs';
import { daemonStart, daemonState, daemonStop, uiStart, uiState, uiStop } from '../lib/ui-control.mjs';
import { formatGc, gc } from '../lib/gc.mjs';
import { HANDOFF_MAX_H, pruneSnapshots, staleHandoff } from '../hooks/checkpoint.mjs';
import { pluginBuildHash } from '../lib/version.mjs';
import { installOpencode, opencodePluginFile, removeOpencode } from '../lib/opencode.mjs';

const VERSION = JSON.parse(fs.readFileSync(new URL('../.claude-plugin/plugin.json', import.meta.url), 'utf8')).version;

const HELP = `tforge ${VERSION}: run a build plan with small, stateless Claude workers.

Usage: tforge <command> [options]

  init                 write an example .forge/plan.json
  validate             check .forge/plan.json and print the task order
  run                  run pending tasks, then the plan's final check
      --only a,b         run only these task ids
      --force a,b        rerun these tasks even if done (--force-all: everything)
      -j, --concurrency N  parallel workers (default 2)
      --dry-run          show prompt sizes, run nothing
      --no-integrate     skip the final check and integration fixes
      --detach           run in the background (log: .forge/run.log); then use: tforge wait
      --proxy            send the workers through the local API proxy (started if needed; also
                         TFORGE_RUN_PROXY=1 or "proxy": true in the plan)
  wait                 block until a detached run ends (max --timeout S, default 540), print its summary
  status               task states and spend so far
  prompt <id>          print the exact system and task prompt a worker gets
  meter [files...]     token usage of Claude Code sessions
      --last N           newest N sessions for this project (default 5)
      --all              all projects
      --commands         rank Bash commands by what their results cost (pick what to route next)
      --json             machine-readable output

  terse [full|lite|off|status]  reply style injected at session start (saved in ~/.config/tokenforge)
  recall <words> [-n N] [--json]  search this project's past sessions (prompts, commits, files touched); --session ID for one
  lean [off|on|balanced|max|ultra|status]   fixed context per request, measured: off 16.9k, on 11.9k (no agent-
                                orchestration tools), balanced ~9.8k (also unused built-in skills; the default),
                                max 5.8k (no skills, subagents, web, git instructions), ultra 4.4k (also no Read/Edit/Write).
                                Edits only tokenforge's own entries in your Claude Code settings
  ui [--port N] [--detach | --stop | --status]
                       local dashboard: token usage, limits and resets, sessions, code map (127.0.0.1 only)
  proxy [--port N] [--detach | --stop | --status]
                       local API proxy (127.0.0.1, default port 7879): logs each request's size and real usage,
                       and compresses tool results the first time they are sent (whole-file Reads fold long bodies,
                       Bash output is cleaned and capped with the full text kept in a file, big JSON is crushed).
                       Compressed results are remembered, so later requests resend the same bytes and the prompt
                       cache holds. TFORGE_PROXY_COMPRESS=0: log only; TFORGE_PROXY_FOLD=0: no Read folding;
                       TFORGE_PROXY_CAP=N chars (0: no cap); TFORGE_PROXY_UPSTREAM: where to forward
  proxy report [--days N] [--json]  what went through the proxy: tokens, cache reads/writes, chars not sent
  claude [args...]     run claude through the proxy (started in the background if needed)
  statusline --setup   status line with your savings ("TF -45% today") and real limits; wraps an existing one
  statusline --remove  restore the status line exactly as it was (TFORGE_STATUSLINE=0: no automatic setup)
  gc [--dry-run] [--json]  free disk: scratch of ended Claude Code sessions (/tmp/claude-<uid>), tokenforge
                       leftovers, snapshots no longer relevant, automatic handoffs a later session worked
                       from (moved to .forge/handoffs/). Runs by itself every 6h, every 10 min on a nearly
                       full disk (TFORGE_GC=0: never)
  opencode install|remove [--project]  plugin file for opencode (~/.config/opencode/plugins, or .opencode/plugins
                       with --project): the Bash router and the session-start policy, same hooks as Claude Code
  version              tokenforge version and plugin build hash (the hash benchmark runs record); -v: version only

Options: -C <dir> project root (default: current directory)
Env: TFORGE_CLAUDE  claude binary to use (default: claude)`;

function parseArgs(argv) {
  const o = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    const val = () => {
      if (i + 1 >= argv.length) throw new Error(`${a} needs a value`);
      return argv[++i];
    };
    if (a === '-C') o.root = val();
    else if (a === '--only') o.only = val().split(',');
    else if (a === '--force') o.force = val().split(',');
    else if (a === '--force-all') o.forceAll = true;
    else if (a === '-j' || a === '--concurrency') o.concurrency = Number(val());
    else if (a === '--dry-run') o.dryRun = true;
    else if (a === '--no-integrate') o.noIntegrate = true;
    else if (a === '--last') o.last = Number(val());
    else if (a === '--all') o.all = true;
    else if (a === '--commands') o.commands = true;
    else if (a === '--json') o.json = true;
    else if (a === '--detach') o.detach = true;
    else if (a === '--timeout') o.timeout = Number(val());
    else if (a === '--port') o.port = Number(val());
    else if (a === '--stop') o.stop = true;
    else if (a === '--status') o.status = true;
    else if (a === '--setup') o.setup = true;
    else if (a === '--remove') o.remove = true;
    else if (a === '--project') o.project = true;
    else if (a === '--session') o.session = val();
    else if (a === '--refresh') o.refresh = true;
    else if (a === '--auto') o.auto = true;
    else if (a === '-n') o.n = Number(val());
    else if (a === '--days') o.days = Number(val());
    else if (a === '--proxy') o.proxy = true;
    else if (a === '-h' || a === '--help') o.help = true;
    else if (a === '-v' || a === '--version') o.version = true;
    else if (a.startsWith('-')) throw new Error(`unknown option ${a}`);
    else o._.push(a);
  }
  return o;
}

async function ensureProxy(port) {
  const st = daemonState('proxy');
  if (st) return st;
  return daemonStart('proxy', { port, detach: true });
}

// Workers inherit this process's env: point it at the proxy unless it already goes there.
async function useProxy() {
  const st = await ensureProxy(Number(process.env.TFORGE_PROXY_PORT) || undefined);
  if (!st) return console.error('tforge: the proxy did not start (see ~/.cache/tokenforge/proxy.log); workers call the API directly');
  const url = `http://127.0.0.1:${st.port}`;
  if (process.env.ANTHROPIC_BASE_URL !== url) process.env.ANTHROPIC_BASE_URL = url;
  console.log(`workers go through the tokenforge proxy (${url}); see: tforge proxy report`);
}

// Claude Code keeps ANTHROPIC_BASE_URL for the whole session: if the proxy dies, every request fails. Restart it on
// the same port. Several sessions may race to do it; the loser's proxy fails to bind and exits.
function superviseProxy(port, everyMs = Number(process.env.TFORGE_PROXY_WATCH_MS) || 2000) {
  let busy = false;
  setInterval(async () => {
    if (busy || daemonState('proxy')) return;
    busy = true;
    try {
      await daemonStart('proxy', { port, detach: true });
    } catch {}
    busy = false;
  }, everyMs).unref();
}

// `tforge claude ...`: everything after the command goes to claude untouched.
async function runClaude(args) {
  const st = await ensureProxy(Number(process.env.TFORGE_PROXY_PORT) || undefined);
  const env = { ...process.env };
  if (st) {
    env.ANTHROPIC_BASE_URL = `http://127.0.0.1:${st.port}`;
    superviseProxy(st.port);
  } else console.error('tforge: the proxy did not start (see ~/.cache/tokenforge/proxy.log); running claude directly');
  const sp = spawnable(process.env.TFORGE_CLAUDE || 'claude', args, { env });
  const child = spawn(sp.cmd, sp.args, { stdio: 'inherit', env, ...sp.opts });
  for (const sig of ['SIGINT', 'SIGTERM']) process.on(sig, () => {});
  child.on('error', (e) => {
    console.error(`tforge: ${e.message}`);
    process.exit(127);
  });
  child.on('exit', (code, sig) => process.exit(code ?? (sig ? 1 : 0)));
  return new Promise(() => {});
}

async function main() {
  if (process.argv[2] === 'claude') return runClaude(process.argv.slice(3));
  const o = parseArgs(process.argv.slice(2));
  if (o.version) return console.log(VERSION);
  const cmd = o._.shift();
  if (o.help || !cmd || cmd === 'help') return console.log(HELP);
  const root = path.resolve(o.root || process.cwd());

  switch (cmd) {
    case 'version':
      if (o.json) return console.log(JSON.stringify({ version: VERSION, plugin_sha256: pluginBuildHash() }));
      return console.log(`tokenforge ${VERSION}\nbuild ${pluginBuildHash()} (sha256 of the plugin files)`);
    case 'init': {
      const file = planPath(root);
      if (fs.existsSync(file)) throw new Error(`${file} already exists`);
      fs.mkdirSync(path.join(root, FORGE_DIR, 'cheats'), { recursive: true });
      fs.writeFileSync(file, JSON.stringify(EXAMPLE_PLAN, null, 2) + '\n');
      ensureGitignore(root);
      console.log(`wrote ${path.relative(process.cwd(), file)}`);
      return;
    }
    case 'validate': {
      const plan = loadPlan(root);
      const order = topoOrder(plan.tasks);
      console.log(`plan ok: ${order.length} task(s)`);
      for (const t of order) {
        const deps = t.deps?.length ? ` <- ${t.deps.join(',')}` : '';
        console.log(`  ${t.id} [${t.model || plan.defaults.model}] ${t.files.join(', ')}${deps}${t.verify ? '' : '  (no verify)'}`);
      }
      if (!plan.verify) console.log('  warning: no final "verify" command; integration errors will not be caught');
      const noCheck = order.filter((t) => !t.verify).length;
      if (noCheck) console.log(`  warning: ${noCheck} task(s) without verify pass as soon as their files exist`);
      for (const w of plan.warnings) console.log(`  warning: ${w}`);
      return;
    }
    case 'run': {
      ensureGitignore(root);
      const plan = loadPlan(root);
      const live = runningPid(root);
      if (live && live !== process.pid) throw new Error(`a run is already in progress (pid ${live}); use: tforge wait`);
      if (o.detach) return detach(root);
      const detached = process.env.TFORGE_DETACHED === '1';
      if (detached) fs.writeFileSync(runFile(root, 'run.pid'), String(process.pid));
      if (!o.dryRun && (o.proxy || process.env.TFORGE_RUN_PROXY === '1' || plan.proxy === true)) await useProxy();
      let ok = false;
      try {
        ok = (await runPlan(root, o)).ok;
      } finally {
        if (detached) {
          fs.writeFileSync(runFile(root, 'run.exit'), ok ? '0' : '1');
          fs.rmSync(runFile(root, 'run.pid'), { force: true });
        }
      }
      process.exitCode = ok ? 0 : 1;
      return;
    }
    case 'wait': {
      process.exitCode = await waitRun(root, (o.timeout || 540) * 1000);
      return;
    }
    case 'status': {
      const plan = loadPlan(root);
      const state = readJson(path.join(root, FORGE_DIR, 'state.json'), { tasks: {} });
      for (const t of topoOrder(plan.tasks)) {
        const s = state.tasks[t.id];
        console.log(`  ${(s?.status || 'pending').padEnd(8)} ${t.id}${s?.costUsd ? `  ${fmtUsd(s.costUsd)}` : ''}${s?.reason ? `  (${s.reason})` : ''}`);
      }
      const l = meterLedger(root);
      if (l) console.log(formatLedger(l));
      return;
    }
    case 'prompt': {
      const plan = loadPlan(root);
      const t = plan.tasks.find((x) => x.id === o._[0]);
      if (!t) throw new Error(`no task ${o._[0]}`);
      console.log('=== SYSTEM ===\n' + buildSystemPrompt(root, plan) + '\n=== TASK ===\n' + buildTaskPrompt(root, plan, t));
      return;
    }
    case 'meter': {
      const files = o._.length ? o._.map((f) => path.resolve(f)) : listTranscripts({ cwd: root, all: o.all }).slice(0, o.last || 5);
      if (!files.length) throw new Error('no transcripts found (pass files, or use --all)');
      if (o.commands) {
        const rows = commandCosts(files);
        if (o.json) return console.log(JSON.stringify(rows, null, 2));
        return console.log(['cmd'.padEnd(24) + 'calls  est.tokens  avg result', ...rows.map((r) => r.cmd.padEnd(24) + String(r.calls).padStart(5) + String(r.estTokens).padStart(12) + String(r.avgResultTokens).padStart(12))].join('\n'));
      }
      const rows = meterSessions(files);
      const ledger = meterLedger(root);
      if (o.json) return console.log(JSON.stringify({ sessions: rows, ledger }, null, 2));
      console.log(formatSessions(rows));
      if (ledger) console.log(formatLedger(ledger));
      return;
    }
    case 'opencode': {
      const want = o._[0];
      const opts = { project: o.project, root };
      if (want === 'install') return console.log(`tforge opencode: wrote ${installOpencode(opts)}; restart opencode`);
      if (want === 'remove') {
        const f = removeOpencode(opts);
        return console.log(f ? `tforge opencode: removed ${f}` : `tforge opencode: nothing to remove at ${opencodePluginFile(opts)}`);
      }
      throw new Error('opencode: install or remove [--project]');
    }
    case 'terse': {
      const want = o._[0] || 'status';
      if (want === 'status') return console.log(`terse: ${terseLevel()}${process.env.TFORGE_TERSE ? ' (from TFORGE_TERSE)' : ''}`);
      if (!TERSE_LEVELS.includes(want)) throw new Error(`terse: one of ${TERSE_LEVELS.join('|')}|status`);
      writeConfig({ terse: want });
      console.log(`terse: ${want} (saved to ${configFile()}; applies to this and new sessions)`);
      return;
    }
    case 'recall': {
      const root = o.root || process.cwd();
      if (o.session) return console.log(sessionDetail(root, o.session));
      if (o.refresh) return void buildIndex(root);
      if (!o._.length) throw new Error('recall: give some words (feature, file or bug names), or --session ID');
      const r = recall(root, o._.join(' '), { limit: o.n || 5, exclude: process.env.CLAUDE_CODE_SESSION_ID || null });
      return console.log(o.json ? JSON.stringify(r, null, 2) : formatRecall(r));
    }
    case 'lean': {
      const want = o._[0] || 'status';
      if (['on', 'balanced', 'max', 'ultra'].includes(want)) {
        const added = leanOn(undefined, want);
        const st = leanStatus();
        console.log(`lean: ${st.level}${added.length ? `; denied ${added.join(', ')}` : ''} (${st.file}). Applies to sessions started from now on.`);
      } else if (want === 'off') {
        const removed = leanOff();
        console.log(removed.length ? `lean: off; removed ${removed.join(', ')} from ${leanStatus().file}.` : 'lean: nothing of ours to remove');
      } else if (want === 'status') {
        const st = leanStatus();
        console.log(`lean: ${st.level === 'partial' ? `partial (${st.active.length}/${LEAN_DENY.length})` : st.level} (${st.file})`);
      } else throw new Error('lean: on|balanced|max|ultra|off|status');
      return;
    }
    case 'ui': {
      if (o.stop) return console.log(uiStop() ? 'tforge ui: stopped' : 'tforge ui: not running');
      const st = uiState();
      if (o.status) return console.log(st ? `tforge ui: running at http://127.0.0.1:${st.port}/ (pid ${st.pid})` : 'tforge ui: not running');
      if (st) return console.log(`tforge ui: already running at http://127.0.0.1:${st.port}/`);
      if (o.detach) {
        const r = await uiStart({ port: o.port, detach: true });
        return console.log(r ? `tforge ui: http://127.0.0.1:${r.port}/` : 'tforge ui: failed to start (see ~/.cache/tokenforge/ui.log)');
      }
      const { listen } = await import('../lib/ui-server.mjs');
      const { port } = await listen(o.port || Number(process.env.TFORGE_UI_PORT) || 7878);
      await uiStart({ port, foreground: true });
      console.log(`tforge ui: http://127.0.0.1:${port}/  (Ctrl+C to stop)`);
      return new Promise(() => {});
    }
    case 'proxy': {
      const proxy = await import('../lib/proxy.mjs');
      if (o._[0] === 'report') {
        const days = o.days || 1;
        const r = proxy.proxyReport({ days });
        return console.log(o.json ? JSON.stringify(r, null, 2) : proxy.formatReport(r, days));
      }
      if (o._.length) throw new Error('usage: tforge proxy [--port N] [--detach | --stop | --status] | tforge proxy report');
      if (o.stop) return console.log(daemonStop('proxy') ? 'tforge proxy: stopped' : 'tforge proxy: not running');
      const st = daemonState('proxy');
      const hint = (p) => `ANTHROPIC_BASE_URL=http://127.0.0.1:${p} claude   (or: tforge claude)`;
      if (o.status) return console.log(st ? `tforge proxy: running on 127.0.0.1:${st.port} (pid ${st.pid}); use: ${hint(st.port)}` : 'tforge proxy: not running');
      if (st) return console.log(`tforge proxy: already running on 127.0.0.1:${st.port}; use: ${hint(st.port)}`);
      if (o.detach) {
        const r = await daemonStart('proxy', { port: o.port, detach: true });
        return console.log(r ? `tforge proxy: running on 127.0.0.1:${r.port}; use: ${hint(r.port)}` : 'tforge proxy: failed to start (see ~/.cache/tokenforge/proxy.log)');
      }
      const r = await proxy.startProxy({ port: o.port || Number(process.env.TFORGE_PROXY_PORT) || proxy.DEFAULT_PORT });
      await daemonStart('proxy', { port: r.port, foreground: true });
      // sessions depend on it: a bug in one request is logged, not fatal
      process.on('uncaughtException', (e) => console.error(`tforge proxy: ${new Date().toISOString()} ${e.stack || e}`));
      console.log(`tforge proxy: 127.0.0.1:${r.port} -> ${r.upstream} (Codex /v1/responses -> ${r.openaiUpstream})  (Ctrl+C to stop)\nuse: ${hint(r.port)}`);
      return new Promise(() => {});
    }
    case 'statusline': {
      if (o.remove) {
        const r = removeStatusline();
        return console.log(r.removed ? `tforge statusline: removed; ${r.restored ? 'your previous status line is back' : 'no status line set, as before'}.` : `tforge statusline: nothing to remove (${r.reason}).`);
      }
      if (!o.setup) throw new Error('usage: tforge statusline --setup | --remove');
      const r = installStatusline();
      if (r.already) return console.log('tforge statusline: already set up.');
      console.log(`tforge statusline: set in your Claude Code settings${r.wrapped ? '; your status line keeps running and the savings are appended to it' : ''}.`);
      console.log('It shows an estimate of tokens saved today and records your real 5-hour and weekly limits for the dashboard. Undo: tforge statusline --remove');
      return;
    }
    case 'gc': {
      const r = gc({ dryRun: o.dryRun, sessionId: o.session });
      if (r.busy) return o.auto || console.log('tforge gc: another gc is running');
      const project = projectRoot(root);
      const snapshots = pruneSnapshots(project, { dryRun: o.dryRun });
      const handoff = staleHandoff(project, HANDOFF_MAX_H, { dryRun: o.dryRun });
      if (o.auto) return;
      return console.log(o.json ? JSON.stringify({ ...r, snapshots, handoff }, null, 2) : formatGc(r, snapshots, handoff));
    }
    default:
      throw new Error(`unknown command ${cmd} (see tforge --help)`);
  }
}

const runFile = (root, name) => path.join(root, FORGE_DIR, name);

function runningPid(root) {
  let pid;
  try {
    pid = Number(fs.readFileSync(runFile(root, 'run.pid'), 'utf8'));
    process.kill(pid, 0);
    return pid;
  } catch {
    return 0;
  }
}

function detach(root) {
  const args = process.argv.slice(2).filter((a) => a !== '--detach');
  const log = fs.openSync(runFile(root, 'run.log'), 'w');
  fs.rmSync(runFile(root, 'run.exit'), { force: true });
  const child = spawn(process.execPath, [fileURLToPath(import.meta.url), ...args], {
    cwd: process.cwd(),
    env: { ...process.env, TFORGE_DETACHED: '1' },
    detached: true,
    stdio: ['ignore', log, log],
  });
  child.unref();
  fs.writeFileSync(runFile(root, 'run.pid'), String(child.pid));
  console.log(`tforge: run started (pid ${child.pid}); log .forge/run.log. Next: tforge wait`);
}

function progress(log) {
  const ok = (log.match(/^ {2}ok /gm) || []).length;
  const bad = (log.match(/^ {2}x /gm) || []).length;
  const cur = [...log.matchAll(/^ {2}> (\S+)/gm)].map((m) => m[1]).slice(-2);
  return `${ok} passed, ${bad} failed attempt(s) so far${cur.length ? `; latest: ${cur.join(', ')}` : ''}`;
}

async function waitRun(root, timeoutMs) {
  const t0 = Date.now();
  const logFile = runFile(root, 'run.log');
  while (runningPid(root)) {
    if (Date.now() - t0 > timeoutMs) {
      console.log(`tforge: still running (${progress(fs.readFileSync(logFile, 'utf8'))}). Call tforge wait again.`);
      return 3;
    }
    await new Promise((r) => setTimeout(r, 2000));
  }
  if (!fs.existsSync(logFile)) {
    console.log('tforge: no detached run found');
    return 2;
  }
  const log = fs.readFileSync(logFile, 'utf8');
  const i = log.lastIndexOf('\ntforge: ');
  console.log((i >= 0 ? log.slice(i + 1) : log.split('\n').slice(-30).join('\n')).trim());
  let code = 1;
  try {
    code = Number(fs.readFileSync(runFile(root, 'run.exit'), 'utf8'));
  } catch {}
  return code;
}

function ensureGitignore(root) {
  const gi = path.join(root, FORGE_DIR, '.gitignore');
  fs.mkdirSync(path.dirname(gi), { recursive: true });
  let have = '';
  try {
    have = fs.readFileSync(gi, 'utf8');
  } catch {}
  const lines = have.split('\n');
  const add = ['state.json', 'ledger.jsonl', '.worker-system.md', 'run.log', 'run.pid', 'run.exit'].filter((l) => !lines.includes(l));
  if (add.length) fs.appendFileSync(gi, (have && !have.endsWith('\n') ? '\n' : '') + add.join('\n') + '\n');
}

main().catch((e) => {
  console.error(`tforge: ${e.message}`);
  process.exit(2);
});
